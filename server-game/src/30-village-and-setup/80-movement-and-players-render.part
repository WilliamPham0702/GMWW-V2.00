  };
  if(seating){
    for(let i=0;i<seatCount;i++){const seatId=i+1,m=bySeat.get(seatId)||null,pos=positions[i]||[50,57];make(m,pos,seatId)}
    // Only overflow participants have no place: never hash-spawn unassigned
