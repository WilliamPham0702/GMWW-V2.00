const PLAY_ROOM_REGISTRY_KEY='gmww_v306_room_registry';
const playRoomUiState={stage:'rooms',selectedCode:'',editorMode:'',lastTapCode:'',lastTapAt:0,modeTouched:false,pendingMode:'',modeSaving:false};
const PLAY_ROOM_MODE_CYCLE=['online','offline','demo','live'];
function nextPlayRoomMode(current,hasSelected=true){
  if(!hasSelected)return 'online'; // First touch in Tập hợp explicitly selects Online.
  const at=PLAY_ROOM_MODE_CYCLE.indexOf(current);
  return PLAY_ROOM_MODE_CYCLE[(at+1)%PLAY_ROOM_MODE_CYCLE.length];
}
// Chế độ hiển thị của phòng: LIVE = DEMO + lớp show (room.live).
const playRoomModeOf=room=>room?.demo===true?(room.live===true?'live':'demo'):room?.roomMode==='offline'?'offline':'online';
// LIVE: bong bóng thoại của bot hiện trên đầu nhân vật (chỉ nội dung công khai do server gửi).
const liveBubbles=new Map();
function liveShowBubble(line){
  if(!line||!line.loginId||!line.text)return;
  let layer=document.getElementById('liveBubbleLayer');
  if(!layer){layer=document.createElement('div');layer.id='liveBubbleLayer';document.body.appendChild(layer)}
  const old=liveBubbles.get(line.loginId);if(old){old.el.remove();cancelAnimationFrame(old.raf)}
  const el=document.createElement('div');el.className='live-bubble';el.textContent=line.text;layer.appendChild(el);
  const born=performance.now(),life=Math.min(9000,3800+line.text.length*60),entry={el,raf:0};liveBubbles.set(line.loginId,entry);
  const tick=now=>{
    const token=document.querySelector('.play-player-token[data-play-player-id="'+String(line.loginId).replace(/"/g,'')+'"]'),age=now-born;
    if(!token||age>life){el.remove();if(liveBubbles.get(line.loginId)===entry)liveBubbles.delete(line.loginId);return}
    const r=token.getBoundingClientRect(),w=el.offsetWidth||140;
    el.style.left=Math.max(6,Math.min(window.innerWidth-w-6,r.left+r.width/2-w/2))+'px';
    el.style.top=Math.max(6,r.top-el.offsetHeight-6)+'px';
    el.style.opacity=age<200?String(age/200):age>life-400?String(Math.max(0,(life-age)/400)):'1';
    entry.raf=requestAnimationFrame(tick)};
  entry.raf=requestAnimationFrame(tick);
}
function playRoomRegistry(){try{const v=JSON.parse(localStorage.getItem(PLAY_ROOM_REGISTRY_KEY)||'[]');return Array.isArray(v)?v:[]}catch{return []}}
function savePlayRoomRegistry(rows){try{localStorage.setItem(PLAY_ROOM_REGISTRY_KEY,JSON.stringify((rows||[]).slice(0,30)))}catch{}}
function rememberPlayRoom(roomCode,gmToken,room={}){
  roomCode=String(roomCode||'');gmToken=String(gmToken||'');if(!roomCode)return;
  // V3.329: phòng mở từ máy GM khác (PC/iPhone) không có gmToken riêng; lệnh GM dùng token chung nên vẫn lưu.
  const prior=playRoomRegistry().find(x=>String(x.roomCode)===roomCode);if(!gmToken)gmToken=String(prior?.gmToken||'');
  const rows=playRoomRegistry().filter(x=>String(x.roomCode)!==roomCode);
  rows.unshift({roomCode,gmToken,roomName:playReadableRoomName(room.roomName||document.getElementById('playCreateRoomName')?.value),roomMode:playRoomModeOf(room),seatCount:Math.max(1,Math.min(30,Number(room.seatCount)||playSceneState.seatCount||12)),demo:room.demo===true,enabled:room.enabled!==false,updatedAt:Date.now()});savePlayRoomRegistry(rows)
}
function forgetPlayRoom(roomCode){savePlayRoomRegistry(playRoomRegistry().filter(x=>String(x.roomCode)!==String(roomCode||'')))}
function setPlayRoomUiStage(stage){playRoomUiState.stage=stage;renderPlayCreateRoomSheet()}
async function selectPlayExistingRoom(r){
  if(typeof demoStop==='function')await demoStop('room_change');
  playRoomUiState.selectedCode=String(r.roomCode||'');playRoomUiState.editorMode='';playRoomUiState.stage='mode';playRoomUiState.modeTouched=true;
  playSceneState.roomCode=String(r.roomCode);playSceneState.gmToken=String(r.gmToken);playSceneState.roomMode=playRoomModeOf(r);playSceneState.seatCount=Math.max(1,Math.min(30,Number(r.seatCount)||12));playSceneState.roomEnabled=r.enabled!==false;savePlayScene();gmwwSendGmPresence(true);renderPlayCreateRoomSheet();
  const data=await playSyncRoom(true);
  if(!data){if(!isLivePlayRoom()){forgetPlayRoom(r.roomCode);playRoomUiState.selectedCode='';playRoomUiState.stage='rooms'}renderPlayCreateRoomSheet();return}
  // Repair only legacy auto-generated rooms; never change intentionally sized rooms.
  const legacy=/^(Phòng GMWW|Phòng Online)$/i.test(String(data.room?.roomName||'').trim());
  const idle=['lobby','waiting'].includes(String(data.room?.phase||'lobby').toLowerCase());
  if(legacy&&idle){
    if(Number(data.room?.seatCount)===12&&!data.room?.seatsLocked&&!(data.players||[]).length){
      await playUpdateRoomSettings({seatCount:24});
    }
    try{const renamed=await playRoomApi('/rename',{method:'POST',body:JSON.stringify({roomName:'Làng Asahi'})});playSceneRuntime.room=renamed.room||playSceneRuntime.room}catch(err){playFlashError(err.message)}
    rememberPlayRoom(playSceneState.roomCode,playSceneState.gmToken,playSceneRuntime.room||{});
    renderPlayScene();
  }
  // Local room badges must be reconciled even when no legacy rename ran.
  rememberPlayRoom(playSceneState.roomCode,playSceneState.gmToken,playSceneRuntime.room||data.room||{});
  renderPlayCreateRoomSheet()
}
/* V3.329: một bản chung cho mọi máy GM — danh sách phòng của GM (Offline/Online/Demo/Live) lấy thêm từ server,
   nên PC và iPhone mở cùng một phòng (cùng ván trên Durable Object). Khóa thiết bị chống hai máy ghi đè nhau. */
const sharedRoomRegistry={at:0,busy:false};
function mergeServerRoomsIntoRegistry(rooms){
  const rows=playRoomRegistry(),known=new Set(rows.map(x=>String(x.roomCode)));let added=0;
  for(const r of Array.isArray(rooms)?rooms:[]){
    const code=String(r?.code||'');
    if(r?.playerRoom===true||!/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/.test(code)||known.has(code))continue;
    const phase=String(r.phase||'').toLowerCase();if(phase==='deleted')continue;
    rows.push({roomCode:code,gmToken:'',roomName:playReadableRoomName(r.roomName),roomMode:playRoomModeOf(r),seatCount:Math.max(1,Math.min(30,Number(r.seatCount)||12)),demo:r.demo===true,enabled:r.enabled!==false,updatedAt:Date.parse(r.updatedAt||'')||0,shared:true});
    known.add(code);added++;
  }
  if(added)savePlayRoomRegistry(rows);
  return added;
}
async function syncSharedRoomRegistry(force=false){
  if(sharedRoomRegistry.busy||(!force&&Date.now()-sharedRoomRegistry.at<15000))return;
  sharedRoomRegistry.busy=true;sharedRoomRegistry.at=Date.now();
  try{const data=await gmApi('/api/gm/rooms',{method:'GET'});if(mergeServerRoomsIntoRegistry(data?.rooms))renderPlayCreatedRooms()}
  catch(err){console.warn('GMWW_SHARED_ROOMS',err)}
  finally{sharedRoomRegistry.busy=false}
}
function renderPlayCreatedRooms(){
  const list=document.getElementById('playCreatedRoomList');if(!list)return;
  if(typeof syncSharedRoomRegistry==='function')void syncSharedRoomRegistry();
  list.replaceChildren();
  playRoomRegistry().forEach(r=>{
    const b=document.createElement('button');b.type='button';b.className='play-created-room'+(String(r.roomCode)===String(playRoomUiState.selectedCode)?' active':'');
    b.innerHTML='<span><b>'+playEsc(playReadableRoomName(r.roomName))+'</b><small>'+playEsc(r.live===true?'LIVE':r.demo===true?'DEMO':(r.roomMode||'online').toUpperCase())+'</small></span><i class="'+(r.enabled!==false?'on':'')+'">'+(r.enabled!==false?'ON':'OFF')+'</i>';
    b.onclick=async()=>{
      const now=Date.now(),code=String(r.roomCode),doubleTap=playRoomUiState.lastTapCode===code&&(now-playRoomUiState.lastTapAt)<480;
      playRoomUiState.lastTapCode=code;playRoomUiState.lastTapAt=now;
      if(doubleTap){if(String(playSceneState.roomCode)!==code)await selectPlayExistingRoom(r);openPlayRoomEditor(false);return}
      await selectPlayExistingRoom(r);
    };
    list.appendChild(b);
  });
}
/* V3.316 Phòng người chơi: rooms created by players (online) are managed from the same room sheet.
   The list comes from the GM room directory; tapping a room attaches it to the Chơi screen in GM mode (watch + run). */
const playerRoomsState={rows:[],loading:false,error:'',timer:0};
const PLAYER_ROOM_PHASE_LABEL={lobby:'Sảnh chờ',waiting:'Sảnh chờ',role_delivery:'Phát vai',running:'Đang chơi',started:'Đang chơi',playing:'Đang chơi',ended:'Kết thúc'};
function playerRoomAgo(iso){const t=Date.parse(iso||'');if(!Number.isFinite(t))return '';const m=Math.max(0,Math.round((Date.now()-t)/60000));return m<1?'vừa xong':m<60?m+' phút trước':Math.round(m/60)+' giờ trước'}
async function loadPlayerRooms(){
  if(playerRoomsState.loading)return;playerRoomsState.loading=true;
  try{
    const data=await gmApi('/api/gm/rooms',{method:'GET'});
    playerRoomsState.rows=(Array.isArray(data?.rooms)?data.rooms:[]).filter(r=>r&&r.playerRoom===true&&r.code).sort((a,b)=>(String(b.phase)==='running')-(String(a.phase)==='running')||String(b.updatedAt||'').localeCompare(String(a.updatedAt||'')));
    playerRoomsState.error='';
  }catch(err){playerRoomsState.error=err?.message||'Không đọc được danh sách phòng.'}
  finally{playerRoomsState.loading=false;renderPlayerRooms()}
}
function renderPlayerRooms(){
  const list=document.getElementById('playPlayerRoomList');if(!list)return;
  const count=document.getElementById('playPlayerRoomsCount'),note=document.getElementById('playPlayerRoomNote'),rows=playerRoomsState.rows;
  if(count)count.textContent=rows.length+' phòng';
  if(note)note.textContent=playerRoomsState.error||(rows.length?'Chạm một phòng để quan sát và điều hành với quyền GM.':'Chưa có phòng nào do người chơi tạo.');
  list.replaceChildren();
  for(const r of rows){
    const code=String(r.code),current=String(playSceneState.roomCode)===code,phase=String(r.phase||'lobby').toLowerCase();
    const b=document.createElement('button');b.type='button';b.setAttribute('role','listitem');b.className='play-player-room'+(current?' active':'')+(phase==='running'?' running':'');
    const ago=playerRoomAgo(r.updatedAt);
    b.innerHTML='<span><b>'+playEsc(playReadableRoomName(r.roomName))+'</b><small>'+playEsc(code+' • '+(PLAYER_ROOM_PHASE_LABEL[phase]||phase)+' • '+(Number(r.playerCount)||0)+'/'+(Number(r.seatCount)||0)+' người'+(ago?' • '+ago:''))+'</small></span><i>'+(current?'ĐANG XEM':'XEM')+'</i>';
    b.onclick=()=>observePlayerRoom(r);
    const row=document.createElement('div');row.className='play-player-room-row';row.setAttribute('role','listitem');b.removeAttribute('role');
    const del=document.createElement('button');del.type='button';del.className='play-player-room-del';del.textContent='XOÁ';del.setAttribute('aria-label','Xoá phòng '+code);
    del.onclick=()=>void deletePlayerRoom(r);
    row.append(b,del);list.appendChild(row);
  }
}
async function deletePlayerRoom(r){
  const code=String(r?.code||'');if(!/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/.test(code))return;
  if(!confirm('Xoá phòng '+code+' ('+playReadableRoomName(r.roomName)+')? Người chơi trong phòng sẽ bị đưa ra.'))return;
  try{
    await gmApi('/api/gm/rooms/'+encodeURIComponent(code),{method:'DELETE'});
    if(String(playSceneState.roomCode)===code){playSceneState.roomCode='';playSceneState.gmToken='';playSceneRuntime.room=null;savePlayScene();renderPlayScene()}
    playerRoomsState.error='';
  }catch(err){playerRoomsState.error=err?.message||'Không xoá được phòng.'}
  void loadPlayerRooms();
}
async function observePlayerRoom(r){
  const code=String(r?.code||'');if(!/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/.test(code))return;
  try{
    if(typeof demoStop==='function')await demoStop('room_change');
    playSceneState.roomCode=code;playSceneState.gmToken='';playSceneState.roomMode='online';
    playSceneState.seatCount=Math.max(1,Math.min(30,Number(r.seatCount)||12));playSceneState.roomEnabled=r.enabled!==false;
    savePlayScene();gmwwSendGmPresence(true);
    const data=await playSyncRoom(true);
    if(!data){if(!isLivePlayRoom())clearStalePlayRoom();playerRoomsState.error='Không vào được phòng '+code+'. Có thể phòng đã đóng.';renderPlayerRooms();void loadPlayerRooms();return}
    if(playSceneState.step==='lobby'||playSceneState.step==='room'){playSceneState.step='seats';savePlayScene()}
    playRoomUiState.stage='rooms';playRoomUiState.selectedCode='';playRoomUiState.editorMode='';
    document.getElementById('playCreateRoomSheet')?.classList.add('hidden');
    renderPlayScene();
  }catch(err){playerRoomsState.error=err?.message||'Không vào được phòng.';renderPlayerRooms()}
}
function bindPlayerRoomsCard(){
  const sheet=document.getElementById('playCreateRoomSheet'),card=document.getElementById('playPlayerRoomsCard');
  if(!sheet||!card||card.dataset.bound==='1')return;card.dataset.bound='1';
  document.getElementById('playPlayerRoomsRefresh')?.addEventListener('click',()=>void loadPlayerRooms());
  const sync=()=>{const open=!sheet.classList.contains('hidden');clearInterval(playerRoomsState.timer);playerRoomsState.timer=0;if(open){void loadPlayerRooms();playerRoomsState.timer=setInterval(()=>{if(!document.hidden)void loadPlayerRooms()},5000)}};
  new MutationObserver(sync).observe(sheet,{attributes:true,attributeFilter:['class']});sync();
}
