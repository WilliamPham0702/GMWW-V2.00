{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gmww-b-staging-synthetic",
  "main": "./b-staging-worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "STAGE3_SYNTHETIC_ROOM",
        "class_name": "Stage3SyntheticState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "b-stage3-e2e-v1",
      "new_sqlite_classes": [
        "Stage3SyntheticState"
      ]
    }
  ]
}
