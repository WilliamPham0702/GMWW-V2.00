{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gmww-b-backup-archive",
  "main": "./b-backup-archive-worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKUP_ARCHIVE",
        "class_name": "BackupArchiveDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "b-stage4-archive-v1",
      "new_sqlite_classes": [
        "BackupArchiveDO"
      ]
    }
  ]
}
