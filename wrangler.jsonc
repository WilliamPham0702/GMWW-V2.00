{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gmww-v2-00",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/gmww-sea-background.png", "/gmww-sea-background.webp", "/favicon.svg"]
  },
  "observability": { "enabled": true }
}
