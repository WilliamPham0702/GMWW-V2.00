{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gmww-v2-00",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "ROOMS", "class_name": "RoomDurableObject" }
      ]
    }
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" }
    ]
  },
  "exports": {
    "RoomDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "MemberDurableObject": { "type": "durable-object", "state": "deleted" }
  },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/gmww-sea-background.webp", "/favicon.svg", "/updates/runtime/*", "/updates/latest.json"]
  },
  "observability": { "enabled": true, "redact_query_string": true, "issues": { "enabled": true } }
}
