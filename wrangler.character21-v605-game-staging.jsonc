{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gmww-character21-v605-game-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "char21-v605-isolated-v1",
      "new_sqlite_classes": [
        "RoomDurableObject"
      ]
    }
  ],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/village",
      "/village/*",
      "/gmww-sea-background.webp",
      "/favicon.svg",
      "/updates/runtime/*",
      "/updates/latest.json"
    ]
  },
  "vars": {
    "GMWW_CHAR21_STAGING": "1"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true
  }
}
