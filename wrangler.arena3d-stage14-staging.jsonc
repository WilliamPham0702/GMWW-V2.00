{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gmww-arena3d-stage14-staging",
  "main": "src/arena3d-stage-worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" }
    ]
  },
  "exports": {
    "RoomDurableObject": { "type": "durable-object", "storage": "sqlite" }
  },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/village", "/village/*", "/gmww-sea-background.webp", "/favicon.svg"]
  },
  "observability": { "enabled": true, "redact_query_string": true }
}
