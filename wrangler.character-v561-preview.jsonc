{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gmww-character-v561-preview",
  "main": "src/character-v561-preview-worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
