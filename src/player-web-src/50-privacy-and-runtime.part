r!important;\n  object-position:center 24%!important;\n  border:0!important;\n  border-radius:0!important\n}\n#game .role-body{\n  position:relative!important;\n  z-index:3!important;\n  flex:0 0 auto!important;\n  margin:0!important;\n  padding:9px 8px 7px!important;\n  background:transparent!important;\n  border:0!important;\n  box-shadow:none!important\n}\n#game .faction{\n  width:max-content!important;\n  max-width:90%!important;\n  min-height:29px!important;\n  margin:-1px auto 7px!important;\n  padding:5px 14px!important;\n  display:flex!important;\n  align-items:center!important;\n  justify-content:center!important;\n  border:1px solid rgba(219,166,87,.78)!important;\n  border-radius:999px!important;\n  background:linear-gradient(180deg,rgba(53,25,31,.97),rgba(23,15,20,.97))!important;\n  color:#f4cf86!important;\n  font-size:10px!important;\n  font-weight:900!important;\n  line-height:1.1!important;\n  letter-spacing:.08em!important;\n  text-transform:uppercase!important;\n  box-shadow:0 5px 13px rgba(0,0,0,.35),inset 0 0 0 1px rgba(255,225,168,.05)!important\n}\n#game .info{\n  margin:0!important;\n  padding:9px 12px 10px!important;\n  border:1px solid rgba(203,148,72,.48)!important;\n  border-radius:12px!important;\n  background:linear-gradient(180deg,rgba(17,15,20,.94),rgba(7,10,15,.97))!important;\n  box-shadow:0 7px 18px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,226,164,.05)!important\n}\n#game .info b{\n  display:block!important;\n  margin:0 0 5px!important;\n  padding:0!important;\n  color:#dbae66!important;\n  font-family:var(--head)!important;\n  font-size:11px!important;\n  font-weight:900!important;\n  line-height:1.1!important;\n  letter-spacing:.11em!important;\n  text-transform:uppercase!important\n}\n#game .info p{\n  margin:0!important;\n  padding:0!important;\n  max-height:80px!important;\n  overflow:auto!important;\n  color:#efe7e8!important;\n  font-size:10.5px!important;\n  line-height:1.48!important;\n  text-align:left!important;\n  background:transparent!important;\n  border:0!important;\n  box-shadow:none!important\n}\n#game .dead-banner{width:min(96vw,416px)!important}\n@media(max-width:360px){\n  #game .role-stage{width:99vw!important;padding:3px!important}\n  #game .role-card-shell{width:97vw!important}\n  #game .role-front{padding:7px!important}\n  #game .role-name{margin:0 6px 7px!important;min-height:44px!important;font-size:22px!important}\n  #game .role-art{margin:0 5px!important}\n  #game .role-body{padding:8px 6px 6px!important}\n  #game .info p{max-height:72px!important;font-size:10px!important}\n}";document.head.appendChild(cleanStyle);const flipStyle=document.createElement('style');flipStyle.id='gmww-role-flip-safari';flipStyle.textContent="#game .role-card-shell{position:relative!important;perspective:none!important;-webkit-perspective:none!important}\n#game .role-card{position:relative!important;transform:none!important;-webkit-transform:none!important;transform-style:flat!important;-webkit-transform-style:flat!important}\n#game .role-face{position:absolute!important;inset:0!important;backface-visibility:visible!important;-webkit-backface-visibility:visible!important;transform:none!important;-webkit-transform:none!important;transition:opacity .18s ease,visibility .18s ease,filter .18s ease!important}\n#game .role-back{display:grid!important;opacity:1!important;visibility:visible!important;z-index:2!important;pointer-events:auto!important}\n#game .role-front{opacity:0!important;visibility:hidden!important;z-index:1!important;pointer-events:none!important}\n#game .role-card.revealed .role-back{opacity:0!important;visibility:hidden!important;z-index:1!important;pointer-events:none!important}\n#game .role-card.revealed .role-front{opacity:1!important;visibility:visible!important;z-index:2!important;pointer-events:auto!important}\n#game .role-card-shell.gmww-effect-locked #roleCard{filter:saturate(.45) brightness(.78)!important}\n#gmwwRoleEffect{position:absolute;inset:0;z-index:30;display:none;align-items:center;justify-content:center;border-radius:25px;overflow:hidden;pointer-events:auto;text-align:center;padding:22px;box-sizing:border-box}\n#gmwwRoleEffect.show{display:flex}\n#gmwwRoleEffect .fx-wrap{width:100%;padding:24px 18px;border:1px solid rgba(255,255,255,.22);border-radius:22px;backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);box-shadow:0 18px 48px #000b}\n#gmwwRoleEffect .fx-icon{font-size:64px;line-height:1;margin-bottom:10px}\n#gmwwRoleEffect .fx-title{font:900 24px/1.08 var(--head);letter-spacing:.04em;margin-bottom:8px}\n#gmwwRoleEffect .fx-msg{font-size:13px;line-height:1.45;color:#f5f5f5}\n#gmwwRoleEffect.fx-frozen{background:linear-gradient(180deg,rgba(5,34,60,.72),rgba(2,10,22,.88))}\n#gmwwRoleEffect.fx-frozen .fx-wrap{background:linear-gradient(180deg,rgba(14,58,96,.88),rgba(5,20,36,.92));border-color:#7cd8ff}.fx-frozen .fx-title{color:#bcecff}\n#gmwwRoleEffect.fx-expelled{background:linear-gradient(180deg,rgba(56,34,10,.72),rgba(14,9,3,.90))}\n#gmwwRoleEffect.fx-expelled .fx-wrap{background:linear-gradient(180deg,rgba(86,52,16,.88),rgba(27,17,7,.94));border-color:#e8a94e}.fx-expelled .fx-title{color:#ffd38a}\n#gmwwRoleEffect.fx-dead{background:linear-gradient(180deg,rgba(55,5,12,.78),rgba(10,3,6,.94))}\n#gmwwRoleEffect.fx-dead .fx-wrap{background:linear-gradient(180deg,rgba(89,16,27,.90),rgba(24,5,10,.95));border-color:#e45a67}.fx-dead .fx-title{color:#ff9aa4}\nhtml,body{overscroll-behavior-y:none!important}";document.head.appendChild(flipStyle);const assetFxStyle=document.createElement('style');assetFxStyle.id='gmww-cardback-effects-v2';assetFxStyle.textContent="#game .role-back{position:absolute!important;overflow:hidden!important;background:#05070c!important}\n#game .role-back:after,#game .role-back:before{display:none!important;content:none!important}\n#game .role-back .gmww-card-back-img{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;display:block!important;object-fit:cover!important;object-position:center!important;border:0!important;border-radius:24px!important;z-index:1!important;opacity:1!important;visibility:visible!important;filter:none!important}\n#gmwwRoleEffect{position:absolute!important;inset:0!important;z-index:12!important;display:none!important;align-items:center!important;justify-content:center!important;flex-direction:column!important;padding:34px 20px!important;box-sizing:border-box!important;border:0!important;border-radius:24px!important;overflow:hidden!important;text-align:center!important;pointer-events:auto!important;backdrop-filter:saturate(.7) blur(1.5px)!important;-webkit-backdrop-filter:saturate(.7) blur(1.5px)!important}\n#gmwwRoleEffect.show{display:flex!important}\n#gmwwRoleEffect .fx-icon{font-size:78px!important;line-height:1!important;margin:0 0 14px!important;filter:drop-shadow(0 8px 18px #000)!important}\n#gmwwRoleEffect .fx-title{font:900 clamp(25px,7vw,34px)/1.05 var(--head)!important;letter-spacing:.045em!important;margin:0 0 10px!important;text-shadow:0 3px 12px #000,0 0 22px currentColor!important}\n#gmwwRoleEffect .fx-msg{max-width:88%!important;font-size:13px!important;line-height:1.45!important;color:#fff!important;text-shadow:0 2px 8px #000!important}\n#gmwwRoleEffect.fx-frozen{background:radial-gradient(circle at 50% 42%,rgba(94,205,255,.08),rgba(5,30,52,.74) 68%,rgba(1,10,20,.88))!important;box-shadow:inset 0 0 0 2px rgba(133,222,255,.76),inset 0 0 56px rgba(81,188,255,.42)!important}\n#gmwwRoleEffect.fx-frozen .fx-title{color:#c8f2ff!important}\n#gmwwRoleEffect.fx-expelled{background:radial-gradient(circle at 50% 42%,rgba(245,180,78,.08),rgba(63,39,12,.76) 68%,rgba(15,9,3,.90))!important;box-shadow:inset 0 0 0 2px rgba(234,176,85,.78),inset 0 0 54px rgba(166,101,22,.38)!important}\n#gmwwRoleEffect.fx-expelled .fx-title{color:#ffd48a!important}\n#gmwwRoleEffect.fx-dead{background:radial-gradient(circle at 50% 42%,rgba(224,70,88,.10),rgba(58,5,13,.80) 68%,rgba(10,2,5,.94))!important;box-shadow:inset 0 0 0 2px rgba(224,75,91,.78),inset 0 0 58px rgba(164,25,42,.42)!important}\n#gmwwRoleEffect.fx-dead .fx-title{color:#ff9ca8!important}\n";document.head.appendChild(assetFxStyle);const markFxStyle=document.createElement('style');markFxStyle.id='gmww-marked-effect-v1';markFxStyle.textContent=`#gmwwRoleEffect.fx-marked{background:radial-gradient(circle at 50% 40%,rgba(190,89,255,.16),rgba(47,13,67,.82) 66%,rgba(10,4,18,.96))!important;box-shadow:inset 0 0 0 2px rgba(205,137,255,.84),inset 0 0 62px rgba(126,44,185,.48)!important}#gmwwRoleEffect.fx-marked .fx-title{color:#e8c2ff!important}#gmwwRoleEffect.fx-marked .fx-msg{font-size:14px!important;margin-bottom:20px!important}#gmwwRoleEffect .fx-actions{display:none;width:min(92%,330px);grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:8px;position:relative;z-index:2}#gmwwRoleEffect.fx-marked .fx-actions{display:grid}#gmwwRoleEffect .fx-actions button{min-height:74px;border:1px solid #b77ae7;border-radius:18px;background:linear-gradient(180deg,#21132f,#0e0b15);color:#fff;font-size:38px;font-weight:900;box-shadow:0 10px 25px #0008,inset 0 0 0 1px #ffffff12}#gmwwRoleEffect .fx-actions button.gold{border-color:#e0ad55;background:linear-gradient(180deg,#5b3b14,#26180b)}#gmwwRoleEffect .fx-actions button:active{transform:scale(.97)}`;document.head.appendChild(markFxStyle);
  document.addEventListener('pointerdown',unlockGmwwAudio,{passive:true});document.addEventListener('pointerup',unlockGmwwAudio,{passive:true});document.addEventListener('touchend',unlockGmwwAudio,{passive:true});document.addEventListener('click',unlockGmwwAudio,{passive:true});document.addEventListener('keydown',unlockGmwwAudio,{passive:true});
  let gmwwPullStartY=0,gmwwPullTarget=null;
  const isInteractiveTarget=el=>!!el?.closest?.('button,input,textarea,select,label,a,[role="button"],[data-gmww-avatar],#avatarLibraryModal,.avatar-library,.avatar-grid,.profile-edit-panel');
  const canScrollUpFrom=el=>{for(let n=el;n&&n!==document.body;n=n.parentElement){try{const cs=getComputedStyle(n);if(/auto|scroll/.test(cs.overflowY)&&n.scrollTop>0)return true}catch{}}return window.scrollY>0};
  document.addEventListener('touchstart',e=>{if(e.touches?.length===1){gmwwPullStartY=e.touches[0].clientY;gmwwPullTarget=e.target}registerRoleActivity()},{passive:true,capture:true});
  document.addEventListener('touchmove',e=>{if(e.touches?.length!==1||isInteractiveTarget(gmwwPullTarget)||isInteractiveTarget(e.target))return;const dy=e.touches[0].clientY-gmwwPullStartY;if(dy<=28||canScrollUpFrom(gmwwPullTarget))return;try{e.preventDefault()}catch{}},{passive:false,capture:true});['pointerdown','wheel','scroll','keydown'].forEach(ev=>document.addEventListener(ev,registerRoleActivity,{passive:true,capture:true}));
  // Replace mock-only handlers with real online actions while keeping the exact canonical HTML/CSS.
  $$('#profile .profile-exit-btn,#profile .linkline button').forEach(btn=>btn.onclick=logout);
  const changeBtn=$('.change-pass .secondary');if(changeBtn)changeBtn.onclick=changePassword;
  document.addEventListener('click',e=>{
    const t=e.target?.closest?.('#profileAvatarButton,#profileSaveButton,#profileEditPanel>summary,[data-gmww-avatar]');
    if(!t)return;
    e.preventDefault();
    if(t.id==='profileAvatarButton'||t.matches?.('#profileEditPanel>summary')){openProfileAvatarLibrary();return}
    if(t.id==='profileSaveButton'){saveProfile();return}
    if(t.dataset?.gmwwAvatar)selectAvatarChoice(t.dataset.gmwwAvatar);
  });
  const chooseBtn=$('#profile .primary.gold');if(chooseBtn)chooseBtn.onclick=openRooms;
  const back=$('#rooms .back');if(back)back.onclick=()=>{state.roomNavigationAuthorized=false;enterVillage()};
  await Promise.allSettled([loadAvatars(),restore()]);
  startWebUpdateWatch();
  if(state.member){renderProfile();state.roomNavigationAuthorized=false;await enterVillage();await autoResumeActiveRoom({stayInVillage:true})}else go('login');
  document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'){checkWebUpdate();if(state.member&&!state.participantId)autoResumeActiveRoom({stayInVillage:true});else{sendPresence();refreshPrivateRole(true).then(()=>ensureRoleGameView(2600))}}});
  window.addEventListener('pageshow',()=>{if(state.member&&!state.participantId)autoResumeActiveRoom({stayInVillage:true});else if(state.member&&state.participantId)ensureRoleGameView(3200)});
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
