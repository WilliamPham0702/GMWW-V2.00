function clearRolePrivacyTimer(){if(gmwwRolePrivacyTimer){clearTimeout(gmwwRolePrivacyTimer);gmwwRolePrivacyTimer=null}}
function closeRoleForPrivacy(){
  clearRolePrivacyTimer();
  if(!state.roleOpen)return;
  state.roleOpen=false;
  $('#roleCard')?.classList.remove('revealed');
  const hint=$('#roleHint');if(hint)hint.textContent='Vai Trò của bạn được giữ bí mật.';
  playPageFlipSound(false);
}
function armRolePrivacyTimer(){
  clearRolePrivacyTimer();
  if(!state.roleOpen||!state.role)return;
  gmwwRolePrivacyTimer=setTimeout(closeRoleForPrivacy,ROLE_PRIVACY_IDLE_MS);
}
function registerRoleActivity(){
  if(state.roleOpen&&$('#game')?.classList.contains('active'))armRolePrivacyTimer();
}
function toggleRole(){
  if(!state.role||roleIsEffectLocked())return;
  const opening=!state.roleOpen;
  state.artifactFocus='role';
  playPageFlipSound(opening);
  state.roleOpen=opening;
  $('#roleCard')?.classList.toggle('revealed',state.roleOpen);
  const hint=$('#roleHint');if(hint)hint.textContent=state.roleOpen?'Vai Trò đang hiển thị.':'Vai Trò của bạn được giữ bí mật.';
  if(opening)armRolePrivacyTimer();else clearRolePrivacyTimer();
  if(state.roleOpen&&!state.role.viewedAt)api('/api/rooms/'+state.roomCode+'/role/viewed',{method:'POST',headers:auth(),body:JSON.stringify({roleIndex:Number(state.roleIndex||0),roleId:String(state.role?.roleId||'')})}).then(d=>{state.role.viewedAt=d.viewedAt;if(state.roles[state.roleIndex])state.roles[state.roleIndex].viewedAt=d.viewedAt;state.artifactFocus='';renderArtifactStack()}).catch(()=>{})
}
window.toggleRole=toggleRole;
function setDead(dead){state.dead=dead;$('#roleCard')?.classList.toggle('dead',dead);$('#artifactCard')?.classList.toggle('dead',dead);$('#deadBanner').classList.toggle('show',dead);$('#gameStatePill').textContent=dead?'ĐÃ CHẾT':'ĐANG SỐNG';$('#gameStatusText').textContent=dead?'Bạn đã chết. Bạn vẫn có thể xem lại Vai Trò của mình.':'Đang chờ Quản Trò gọi Vai Trò của bạn.'}

function resultFactionKey(v){
  const raw=String(v||'').trim();if(!raw)return'';const n=raw.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase();if(n.includes('phe dan')||n==='dan')return'dan';if(n.includes('phe soi')||n==='soi')return'soi';if(n.includes('phe ba')||n.includes('phe thu 3')||n.includes('phe thu ba')||n==='ba')return'ba';if(n.includes('phe khac')||n==='khac')return'khac';return n.replace(/[^a-z0-9]+/g,' ').trim();
}
function displayFaction(v){const k=resultFactionKey(v);if(k==='dan')return'Phe Dân';if(k==='soi')return'Phe Sói';if(k==='ba')return'Phe Ba';if(k==='khac')return'Phe Khác';return String(v||'').replace(/^[^A-Za-zÀ-ỹ0-9]+/u,'').trim()||'Phe chiến thắng'}

function gmwwPrepareSeaVictory(){
  if(!document.getElementById('gmwwSeaVictoryStyle')){
    const style=document.createElement('style');style.id='gmwwSeaVictoryStyle';style.textContent="#resultOverlay.show{background:radial-gradient(circle at 50% 10%,rgba(23,130,149,.4),rgba(2,20,39,.89))!important;backdrop-filter:blur(9px)}\n#resultOverlay .gmww-sea-win-emblem{display:block;margin:0 auto 12px;font-size:37px;letter-spacing:.22em;color:#ffe4a4;text-shadow:0 0 22px #70e9e1;animation:gmww-sea-emblem 2.8s ease-in-out infinite}\n#resultOverlay h2{color:#ffe8ad!important;text-shadow:0 0 20px #44aabb88;line-height:1.35!important;font-weight:1000!important;letter-spacing:.065em}\n#resultOverlay p{color:#d3f8f5!important;letter-spacing:.035em}\n#resultOverlay[data-gmww-victory=\"true\"] h2{color:#fff2bd!important}\n#resultOverlay.show:before{content:\"\";position:absolute;pointer-events:none;inset:0;background:radial-gradient(circle at 20% 22%,#b6f9e322 2px,transparent 4px),radial-gradient(circle at 65% 60%,#c4f9e533 3px,transparent 5px),radial-gradient(circle at 82% 24%,#b6f9e522 2px,transparent 4px);background-size:150px 230px;animation:gmww-sea-ripples 11s linear infinite}\n@keyframes gmww-sea-emblem{0%,100%{opacity:.7;transform:translateY(3px)}50%{opacity:1;transform:translateY(-5px)}}\n@keyframes gmww-sea-ripples{from{background-position:0 0}to{background-position:0 -230px}}\n@media(prefers-reduced-motion:reduce){#resultOverlay .gmww-sea-win-emblem,#resultOverlay.show:before{animation:none!important}}";
    document.head.append(style);
  }
  const overlay=document.getElementById('resultOverlay'),heading=overlay?.querySelector('h2');
  if(heading&&!overlay.querySelector('.gmww-sea-win-emblem')){
    const emblem=document.createElement('span');emblem.className='gmww-sea-win-emblem';
    emblem.setAttribute('aria-hidden','true');emblem.textContent='✦ 🐚 🏆 ✦';heading.before(emblem);
  }
}
function showResult(faction,matchId=''){
  const roomMatch=String(state.room?.matchId||''),currentMatch=String(state.role?.matchId||roomMatch||''),incoming=String(matchId||'');if(roomMatch&&incoming&&roomMatch!==incoming)return;
  clearDrunkDraw();
  const roleRows=Array.isArray(state.roles)&&state.roles.length?state.roles:(state.role?[state.role]:[]),playerFactions=roleRows.map(x=>{const pc=x?.roleCard||{};return pc.faction??x?.faction??x?.factionName??''}),winner=displayFaction(faction),hasWinner=!!resultFactionKey(faction),isWinner=hasWinner&&playerFactions.some(x=>resultFactionKey(x)===resultFactionKey(faction)),matchKey=resultMatchKey(incoming||currentMatch),key=matchKey+'|'+resultFactionKey(faction);
  if(dismissedResultKey()===matchKey||state.lastResultKey===key)return;state.lastResultKey=key;
  if(!hasWinner){closeResult().catch(()=>{});return}
  gmwwPrepareSeaVictory();$('#resultOverlay').dataset.gmwwVictory=String(isWinner);
  const layer=$('#confettiLayer');layer.innerHTML='';if(isWinner){const colors=['#ffd66d','#ff6e6e','#7de2ff','#9bff92','#d18aff','#fff'];for(let i=0;i<80;i++){const c=document.createElement('i');c.className='confetti';c.style.left=Math.random()*100+'%';c.style.background=colors[i%colors.length];c.style.animationDuration=(2.2+Math.random()*2.8)+'s';c.style.animationDelay=(-Math.random()*4)+'s';c.style.setProperty('--drift',(-80+Math.random()*160)+'px');layer.appendChild(c)}}
  const resultSoundKey=key;if(resultSoundKey!==gmwwResultSoundKey){gmwwResultSoundKey=resultSoundKey;playVictorySound()}
  const h=$('#resultOverlay h2'),p=$('#resultOverlay p');if(hasWinner){h.textContent=(isWinner?'CHÚC MỪNG ':'')+winner.toUpperCase()+' THẮNG!';p.textContent=isWinner?'Bạn Đã Thắng':'Bạn Đã Thua'}else{h.textContent='VÁN CHƠI ĐÃ KẾT THÚC';p.textContent='Quản Trò đã kết thúc ván chơi.'}state.ready=true;state.roleEffects={};renderRoleEffects();try{localStorage.removeItem(ACTIVE_ROLE_KEY)}catch{};$('#resultOverlay').classList.add('show');clearTimeout(gmwwResultReturnTimer);gmwwResultReturnTimer=setTimeout(()=>{closeResult().catch(()=>{})},11000);
  if(state.token)api('/api/members/me',{headers:auth()}).then(d=>{if(d?.member){state.member=d.member;localStorage.setItem('gmww_member',JSON.stringify(d.member))}}).catch(()=>{});
}
async function closeResult(){
  clearDrunkDraw();
  clearRolePrivacyTimer();rememberDismissedResult(resultMatchKey());stopVictorySound();clearTimeout(gmwwResultReturnTimer);gmwwResultReturnTimer=null;$('#resultOverlay').classList.remove('show');state.role=null;state.roles=[];state.roleOpen=false;state.artifact=null;state.artifactOpen=false;state.artifactCycle={cycleKey:'',count:0,max:3};state.artifactFocus='';clearArtifactDraft();state.dead=false;state.roleEffects={};renderRoleEffects();state.ready=true;state.roomNavigationAuthorized=true;try{localStorage.removeItem(ACTIVE_ROLE_KEY)}catch{}
  if(state.roomCode&&state.participantId){
    const code=state.roomCode,id=state.participantId;rememberActiveRoom(code,id);
    try{const d=await api('/api/rooms/'+encodeURIComponent(code)+'/ready',{method:'POST',body:JSON.stringify({participantId:id,ready:true})});if(d?.player)state.ready=!!d.player.ready}catch(_){state.ready=true}
    try{const d=await api('/api/rooms/'+encodeURIComponent(code)+'/me',{headers:auth()});if(d?.room)state.room=d.room;if(d?.player){state.participantId=d.player.participantId||id;state.ready=true}rememberActiveRoom(code,state.participantId)}catch(_){}
    try{const pub=await api('/api/rooms/'+encodeURIComponent(code));if(pub?.room)state.room=pub.room;if(Array.isArray(pub?.players))state.players=pub.players}catch(_){}
    const keep={...(state.room||{}),code:String(state.room?.code||code),roomCode:code,joinedCount:state.players.length};state.rooms=[keep,...state.rooms.filter(x=>String(x?.code||x?.roomCode||'')!==code)];
    renderRooms();go('rooms');connectWS();startRoomStateWatch();sendPresence();return
  }
  renderProfile();await enterVillage()
} window.closeResult=closeResult;

document.documentElement.dataset.gmwwMembersVersion='0.40.23-player-simplified-lobby';

async function autoResumeActiveRoom({stayInVillage=false}={}){
  const saved=savedActiveRoom(),code=String(saved?.roomCode||state.member?.currentRoomCode||'').trim().toUpperCase();if(!code||!state.token)return false;
  rememberActiveRoom(code,saved?.participantId||'');
  try{
    // Resume the EXISTING membership directly. Never pass through /join when a room is locked.
    const d=await api('/api/rooms/'+encodeURIComponent(code)+'/me',{headers:auth()}),ph=String(d?.room?.phase||'').toLowerCase();
    if(!d?.room||!d?.player||['deleted','closed','archived'].includes(ph)){clearActiveRoom();return false}
    state.roomCode=code;state.room=d.room;state.participantId=d.player.participantId;state.ready=!!d.player.ready;state.players=[d.player];
    if(d.role){state.role=d.role;rememberActiveRole(d.role)}else{state.role=null;restoreCachedRole()}state.artifact=d.artifact||null;state.artifactCycle=d.artifactCycle||{cycleKey:'',count:0,max:3};
    applyRoleCardBack();renderDrunkDraw(d?.drunkDraw);handleSeatSwapRequests(d?.swapRequests);handlePendingInteractions(d?.interactions);syncRoleEffects(d?.effects);
    rememberActiveRoom(code,state.participantId);state.roomNavigationAuthorized=true;
    try{await loadRooms(false)}catch{}
    renderRooms();gmwwChatMount();gmwwChatAnnounce(d?.audioCue);renderPlayerTimeline(d?.publicTimeline);state.onlineActions=d?.onlineActions||[];renderOnlineActionDock();connectWS();startRoomStateWatch();sendPresence();
    if(stayInVillage){await enterVillage();return true}
    if(ph==='ended'){showResult(d.room.winnerFaction||d.room.winnerLabel||'',d.room.matchId||'');return true}
    if(['role_delivery','running'].includes(ph)){
      if(d.role){renderRole();maybeOpenGame()}
      else await ensureRoleGameView(5200);
      if(ph==='running'&&state.role)maybeOpenGame();
      return true
    }
    await enterVillage();return true
  }catch(e){
    // Only forget the saved room when the server confirms membership is gone.
    if(e?.status===403||e?.status===404){clearActiveRoom();try{await api('/api/members/presence',{method:'POST',headers:auth(),body:JSON.stringify({roomCode:null,ready:false})})}catch{}}
    return false
  }
}
function ensureWebUpdateBanner(){
  let el=document.getElementById('gmwwWebUpdateBanner');if(el)return el;
  el=document.createElement('div');el.id='gmwwWebUpdateBanner';el.style.cssText='position:fixed;left:12px;right:12px;top:max(12px,env(safe-area-inset-top));z-index:99999;display:none;align-items:center;gap:10px;padding:12px 14px;border-radius:16px;background:rgba(15,23,42,.96);color:#fff;border:1px solid rgba(255,255,255,.18);box-shadow:0 12px 32px #0008;font:700 13px/1.35 -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif';
  const msg=document.createElement('span');msg.style.flex='1';msg.textContent='Có cập nhật mới trên Player Web. Vui lòng tải lại trang.';
  const btn=document.createElement('button');btn.type='button';btn.textContent='TẢI LẠI';btn.style.cssText='min-height:42px;padding:0 14px;border:0;border-radius:12px;background:#f4c15d;color:#161616;font-weight:900';btn.onclick=()=>location.reload();
  el.append(msg,btn);document.body.appendChild(el);return el;
}
async function checkWebUpdate(){
  try{
    const stamp=Date.now(),[healthRes,syncRes]=await Promise.all([fetch('/api/health?webUpdate='+stamp,{cache:'no-store'}),fetch('/api/web-sync?webUpdate='+stamp,{cache:'no-store'})]);
    if(!healthRes.ok)return;const d=await healthRes.json(),latest=String(d.webVersion||d.version||'').trim();let generation=0,known=0;
    try{known=Math.max(0,Number(localStorage.getItem(GMWW_WEB_SYNC_KEY)||0))}catch{}
    if(syncRes.ok){try{const sync=await syncRes.json();generation=Math.max(0,Number(sync?.generation||0))}catch{}}
    const syncChanged=generation>0&&known>0&&generation!==known;if(generation>0)try{localStorage.setItem(GMWW_WEB_SYNC_KEY,String(generation))}catch{}
    if((latest&&latest!==GMWW_WEB_VERSION)||syncChanged){gmwwWebUpdateVersion=latest||GMWW_WEB_VERSION;ensureWebUpdateBanner().style.display='flex'}
  }catch{}
}
function startWebUpdateWatch(){if(gmwwWebUpdateTimer)return;checkWebUpdate();gmwwWebUpdateTimer=setInterval(()=>{if(!document.hidden)checkWebUpdate()},60000)}
async function init(){
  ensureOnline2DStyle();ensureDesktopResponsiveStyle();ensureInteractionUi();applyRoleCardBack();ensureVillageGameView();const cleanStyle=document.createElement('style');cleanStyle.id='gmww-clean-role-card';cleanStyle.textContent="#game .role-stage{\n  width:min(98vw,430px)!important;\n  max-width:none!important;\n  margin:0 0 0 50%!important;\n  transform:translateX(-50%)!important;\n  padding:4px!important;\n  background:transparent!important;\n  border:0!important;\n  box-shadow:none!important;\n  backdrop-filter:none!important;\n  -webkit-backdrop-filter:none!important\n}\n#game .role-hint,#game .game-status{display:none!important}\n#game .role-card-shell{\n  width:min(96vw,416px)!important;\n  max-width:none!important;\n  height:auto!important;\n  aspect-ratio:.72!important;\n  margin:0 auto!important;\n  perspective:none!important\n}\n#game .role-card{\n  width:100%!important;\n  height:100%!important;\n  margin:0 auto!important;\n  border-radius:25px!important;\n  background:transparent!important\n}\n#game .role-face{\n  position:absolute!important;\n  inset:0!important;\n  width:100%!important;\n  height:100%!important;\n  box-sizing:border-box!important;\n  border-radius:25px!important;\n  border:1px solid rgba(229,179,97,.92)!important;\n  overflow:hidden!important;\n  background:\n    radial-gradient(circle at 50% -5%,rgba(213,153,77,.14),transparent 31%),\n    linear-gradient(180deg,#180f16 0%,#0b0b10 48%,#05070b 100%)!important;\n  box-shadow:\n    0 22px 50px rgba(0,0,0,.82),\n    inset 0 0 0 1px rgba(255,225,171,.10),\n    0 0 25px rgba(165,98,39,.20)!important\n}\n#game .role-front{\n  display:flex!important;\n  flex-direction:column!important;\n  gap:0!important;\n  padding:9px!important;\n  background:\n    radial-gradient(circle at 50% -8%,rgba(126,56,68,.22),transparent 34%),\n    linear-gradient(180deg,#120d13 0%,#090b10 57%,#06080c 100%)!important\n}\n#game .role-front:before{\n  content:\"\"!important;\n  position:absolute!important;\n  inset: