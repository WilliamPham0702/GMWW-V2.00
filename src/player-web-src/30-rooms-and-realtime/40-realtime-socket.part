// A generic room_state WebSocket snapshot does not contain confirmed public
// statusTags. Fetch the authoritative REST projection after a status/cycle update.
// Debounce to avoid repeated DO reads and preserve gameplay responsiveness.
let gmwwPublicStatusRefreshTimer=null;
function schedulePublicRoomSnapshot(){
 if(gmwwPublicStatusRefreshTimer)return;
 gmwwPublicStatusRefreshTimer=setTimeout(async()=>{
  gmwwPublicStatusRefreshTimer=null;
  const code=state.roomCode,match=String(state.room?.matchId||'');
  if(!code||!state.participantId)return;
  try{
   const fresh=await api('/api/rooms/'+encodeURIComponent(code));
   if(code!==state.roomCode||match!==String(state.room?.matchId||'')||
      match!==String(fresh?.room?.matchId||'')||!Array.isArray(fresh?.players))return;
   const verified=new Map(fresh.players.map(p=>[String(p.participantId),p]));
   state.players=state.players.map(p=>{
    const row=verified.get(String(p.participantId));
    return row?{...p,statusTags:Array.isArray(row.statusTags)?row.statusTags:[]}:p;
   });
   syncGallowsVoteTags();
   syncVillageFrame(true);
   void gmwwChatRefresh();
  }catch(e){console.warn('[GMWW public status refresh]',e)}
 },280);
}
function connectWS(){
  if(!state.roomCode||!state.participantId)return;try{state.ws?.close();const proto=location.protocol==='https:'?'wss:':'ws:';const socket=new WebSocket(proto+'//'+location.host+'/ws/'+state.roomCode+'?participantId='+encodeURIComponent(state.participantId));state.ws=socket;
  socket.onopen=()=>{if(state.ws!==socket)return;if(state.wsPingTimer)clearInterval(state.wsPingTimer);sendRoomHeartbeat();try{state.ws.send(JSON.stringify({type:'ping',at:Date.now()}))}catch{};state.wsPingTimer=setInterval(()=>{try{if(state.ws?.readyState===WebSocket.OPEN)state.ws.send(JSON.stringify({type:'ping',at:Date.now()}))}catch{}},10000);startRoomStateWatch()};socket.onmessage=e=>{if(state.ws!==socket)return;let d;try{d=JSON.parse(e.data)}catch{return};const movementEvent=d.type==='player_move'||d.type==='player_move_complete';if(d.type==='chat_tick'){void gmwwChatRefresh();return}if(d.type==='announcement_ready'){if(Number.isFinite(Number(d.serverTime)))state.serverClockOffsetMs=Number(d.serverTime)-Date.now();if(d.audioCue?.key)gmwwChatAnnounce(d.audioCue);return}if(Number.isFinite(Number(d.serverTime)))state.serverClockOffsetMs=Number(d.serverTime)-Date.now();if(d.type==='gallows_updated'){state.gallows=d.gallows||null;renderGallowsWidget();syncVillageFrame(true);return}if(d.type==='room_disbanded'){handleRoomMembershipLost('GM đã giải tán Phòng. Bạn đã trở về Sảnh chờ.');return}if(d.type==='room_state'||movementEvent){if(d.room?.enabled===false){handleRoomMembershipLost('Phòng đã Tắt. Bạn đã được đưa về Phòng chờ.');return}const beforeMatch=String(state.room?.matchId||''),previous=new Map((state.players||[]).map(p=>[p.participantId,p.statusTags]));
    state.room=d.room||state.room;
    const config=state.room?.statusDisplay||{},sameMatch=beforeMatch===String(state.room?.matchId||''),
      daylight=['morning','day'].includes(String(state.room?.cyclePhase||''));
    state.players=(d.players||state.players||[]).map(p=>({...p,
      // Generic WebSocket room_state omits confirmed statuses; keep only tags
      // supplied earlier by the server for this same match, never another match.
      statusTags:(Array.isArray(p?.statusTags)?p.statusTags:(sameMatch?previous.get(p?.participantId)||[]:[]))
        .filter(t=>config[String(t?.statusId||'')]===true||
          (daylight&&['dead','expelled','marked'].includes(String(t?.statusId||''))))}));syncGallowsVoteTags();const me=state.players.find(x=>x.participantId===state.participantId);if(!me&&state.participantId){handleRoomMembershipLost();return}if(me){state.ready=!!me.ready;if(me.gameCharacterId)state.selectedGameCharacterId=String(me.gameCharacterId);state.selectedSeatId=Number(me.seatId||me.moveTargetSeatId||0)||null;scheduleMovementCompletion(me)}if(!movementEvent){renderRooms();refreshPrivateRole(true)}if(hasCompletedRoomResult(d.room)){showResult(d.room?.winnerFaction||d.room?.winnerLabel||'',d.room?.matchId||'')}else{if(!movementEvent){maybeOpenGame();syncPlayerSetupState();ensureVillageReadyDock()}syncVillageFrame();if(!movementEvent&&state.room?.phase==='running')schedulePublicRoomSnapshot()}}else if(d.type==='room_cycle'){gmwwChatClear();void gmwwChatRefresh();state.wolfWakeEpoch=Number(state.wolfWakeEpoch||0)+1;setPrivateWolfRecognition(null);state.gallows=null;schedulePublicRoomSnapshot();renderGallowsWidget();state.room=d.room||state.room;state.villageCycle={phase:d.phase||state.room?.cyclePhase||'',night:Number(d.night||state.room?.cycleNight||0),day:Number(d.day||0)};syncVillageFrame();clearTemporaryRoleEffects(d.phase,d.night);refreshPrivateRole(true)}else if(d.type==='night_turn'||d.type==='auto_gm'){gmwwChatClear();void gmwwChatRefresh();state.wolfWakeEpoch=Number(state.wolfWakeEpoch||0)+1;setPrivateWolfRecognition(null);state.room=d.room||state.room;if(state.room)state.villageCycle={phase:state.room.cyclePhase||'',night:Number(state.room.cycleNight||0),day:0};syncVillageFrame();void refreshPrivateRole(true)}else if(['battle_action_confirmed','battle_action_undone','battle_action_reverted','day_action_confirmed'].includes(d.type)){void refreshPrivateRole(true)}
    else if(d.type==='role_ready'||d.type==='role_progress'||d.type==='artifact_progress'||d.type==='artifact_activation'){refreshPrivateRole(true)}else if(d.type==='player_status_changed'||d.type==='player_revived'||d.type==='player_state_cleared'||d.type==='player_interaction_response'){schedulePublicRoomSnapshot();void gmwwChatRefresh();pollRoomState().catch(()=>{})}else if(d.type==='player_interaction'){showPlayerInteraction(d.interaction)}else if(d.type==='room_disabled'){handleRoomMembershipLost('Phòng đã được Quản Trò Tắt. Bạn đã được đưa về Phòng chờ.')}else if(d.type==='room_hard_reset'){handleRoomMembershipLost(d.forcedEnd?'Quản Trò đã kết thúc cưỡng ép ván chơi. Bạn đã trở về sảnh chờ.':'Quản Trò đã RESET Phòng. Hãy chọn Phòng để tham gia lại.')}else if(d.type==='room_reset'){state.room=d.room||state.room;state.players=d.players||state.players;const me=state.players.find(x=>x.participantId===state.participantId);state.ready=me?!!me.ready:true;state.role=null;state.artifact=null;state.artifactOpen=false;state.artifactCycle={cycleKey:'',count:0,max:3};state.artifactFocus='';clearArtifactDraft();state.roleEffects={};renderRoleEffects();try{localStorage.removeItem(ACTIVE_ROLE_KEY)}catch{};renderRooms();if(!$('#resultOverlay')?.classList.contains('show'))enterVillage()}else if(d.type==='player_status'&&d.participantId===state.participantId){setDead(d.status==='dead')}else if(d.type==='player_kicked'&&d.participantId===state.participantId){handleRoomMembershipLost('GM đã Kick bạn khỏi Phòng.')}else if(d.type==='game_result'){showResult(d.winnerFaction||d.winnerLabel||'',d.matchId||d.room?.matchId||'',d.history?.summary)}};
  socket.onclose=e=>{if(state.ws!==socket)return;if(state.wsPingTimer){clearInterval(state.wsPingTimer);state.wsPingTimer=null}if(e?.reason==='ROOM_DISABLED'){handleRoomMembershipLost('Phòng đã được Quản Trò Tắt. Bạn đã được đưa về Phòng chờ.');return}if(e?.reason==='PLAYER_KICKED'){handleRoomMembershipLost('GM đã Kick bạn khỏi Phòng.');return}if(e?.reason==='ROOM_CLOSED'){handleRoomMembershipLost('Chủ phòng đã xoá phòng. Bạn đã được đưa về sảnh.');return}if(e?.reason==='ROOM_EXPIRED'){handleRoomMembershipLost('Phòng đã hết hạn và được xoá.');return}if(e?.reason==='PLAYER_OFFLINE_KICKED'){handleRoomMembershipLost('Bạn đã rời Phòng vì mất kết nối quá lâu.');return}if(e?.reason==='ROOM_HARD_RESET'){handleRoomMembershipLost('Quản Trò đã RESET Phòng. Hãy chọn Phòng để tham gia lại.');return}if(state.participantId&&state.roomCode)setTimeout(connectWS,1800)};}catch{}
}
async function refreshPrivateRole(force=false){
  if(!state.roomCode||!state.token||!state.participantId)return false;
  const wolfWakeEpoch=Number(state.wolfWakeEpoch||0);
  try{const d=await api('/api/rooms/'+state.roomCode+'/me',{headers:auth()});
    if(wolfWakeEpoch===Number(state.wolfWakeEpoch||0))setPrivateWolfRecognition(d?.wolfRecognition,d?.room||state.room);handleSeatSwapRequests(d?.swapRequests);handlePendingInteractions(d?.interactions);syncRoleEffects(d?.effects);renderDrunkDraw(d?.drunkDraw);(typeof renderThiefDraw==='function')&&renderThiefDraw(d?.thiefDraw);(typeof renderCardPrompts==='function')&&renderCardPrompts(d);gmwwChatAnnounce(d?.audioCue);renderPlayerTimeline(d?.publicTimeline);state.onlineActions=d?.onlineActions||[];gmwwOnlineWitchBite=d?.witchBite||null;renderOnlineActionDock();if(d?.cardBackImage)state.cardBackImage=d.cardBackImage;const oldArtifactId=String(state.artifact?.artifactId||'');state.artifact=d?.artifact||null;state.artifactCycle=d?.artifactCycle||{cycleKey:'',count:0,max:3};if(oldArtifactId&&state.artifact&&oldArtifactId!==String(state.artifact.artifactId||'')){state.artifactOpen=false;state.artifactFocus='';clearArtifactDraft()}const incoming=Array.isArray(d?.roles)&&d.roles.length?d.roles:(d?.role?[d.role]:[]),previous=state.role,prevKey=previous?String(previous.assignmentIndex??previous.roleId??''):'';state.roles=incoming;if(incoming.length){let ix=incoming.findIndex(x=>String(x?.assignmentIndex??x?.roleId??'')===prevKey);if(ix<0)ix=Math.min(Math.max(0,Number(state.roleIndex||0)),incoming.length-1);state.roleIndex=ix;state.role=incoming[ix]||incoming[0]}else{state.roleIndex=0;state.role=null}state.room=d.room||state.room;state.demoActions=d?.demoActions||[];renderDemoActions();if(String(d.room?.phase||'').toLowerCase()==='ended'){showResult(d.room?.winnerFaction||d.room?.winnerLabel||'',d.room?.matchId||'');return false}if(state.role){rememberActiveRole(state.role);if(state.rolePoll){clearInterval(state.rolePoll);state.rolePoll=null}renderRole();maybeOpenGame();return true}else if(['role_delivery','running'].includes(d.room?.phase)&&!state.rolePoll){restoreCachedRole();state.rolePoll=setInterval(()=>refreshPrivateRole(true),1800)}return !!state.role}catch(e){if(e?.status===403){await handleRoomMembershipLost();return false}if(e?.status===404){restoreCachedRole();return !!state.role}if(force)console.warn('[GMWW role]',e);restoreCachedRole();return !!state.role}
}
