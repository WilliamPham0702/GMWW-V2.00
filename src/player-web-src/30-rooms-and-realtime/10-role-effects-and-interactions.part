function roleEffectPriority(type){return type==='dead'?4:type==='expelled'?3:type==='frozen'?2:type==='assassin_mark'?1:0}
function ensureRoleEffectUi(){
  const back=$('#roleCard .role-back');if(!back)return null;let el=$('#gmwwRoleEffect');
  if(el&&el.parentElement!==back)el.remove();
  if(!el){el=document.createElement('div');el.id='gmwwRoleEffect';el.innerHTML='<div class="fx-icon"></div><div class="fx-title"></div><div class="fx-msg"></div><div class="fx-actions"></div>';back.appendChild(el)}
  return el
}
function renderRoleEffects(){
  const shell=$('#game .role-card-shell'),el=ensureRoleEffectUi();if(!shell||!el)return;
  const rows=Object.values(state.roleEffects||{}).filter(Boolean).sort((a,b)=>roleEffectPriority(b.type)-roleEffectPriority(a.type));
  const fx=rows[0],actions=el.querySelector('.fx-actions');if(!fx){el.className='';el.classList.remove('show');if(actions)actions.innerHTML='';shell.classList.remove('gmww-effect-locked');return}
  const meta=interactionMeta(fx.type);el.className='show fx-'+meta[2];el.querySelector('.fx-icon').textContent=meta[0];el.querySelector('.fx-title').textContent=meta[1];el.querySelector('.fx-msg').textContent=fx.message||'Hiệu Ứng đang áp dụng.';
  if(actions){actions.innerHTML='';if(fx.type==='assassin_mark'){const opts=Array.isArray(fx.options)&&fx.options.length?fx.options:['👍','👎'];for(const x of opts){const b=document.createElement('button');b.textContent=x;b.className=x==='👍'?'gold':'';b.onclick=e=>{e.stopPropagation();respondInteraction(fx.id,x)};actions.appendChild(b)}}}
  shell.classList.add('gmww-effect-locked');
  if(state.roleOpen){clearRolePrivacyTimer();state.roleOpen=false;$('#roleCard')?.classList.remove('revealed')}
}
function setRoleEffect(ix){
  if(!ix||!['frozen','expelled','dead','assassin_mark'].includes(ix.type))return;
  state.roleEffects=state.roleEffects||{};state.roleEffects[ix.type]={type:ix.type,id:ix.id||'',message:ix.message||'',matchId:ix.matchId||'',cycleKey:ix.cycleKey||ix.roundKey||ix.nightKey||'',expiresAt:ix.expiresAt||null,options:Array.isArray(ix.options)?ix.options.slice(0,4):[]};
  renderRoleEffects()
}
function syncRoleEffects(rows){
  const arr=Array.isArray(rows)?rows:[];const next={};
  for(const ix of arr){if(!ix||!['frozen','expelled','dead','assassin_mark'].includes(ix.type))continue;if(ix.expiresAt&&Date.parse(ix.expiresAt)<=Date.now())continue;next[ix.type]=ix}
  state.roleEffects=next;renderRoleEffects()
}
function clearTemporaryRoleEffects(phase='',night=0){phase=String(phase||'').toLowerCase()==='day'?'morning':String(phase||'').toLowerCase();night=Number(night||0);if(!state.roleEffects){renderRoleEffects();return}if(phase==='morning'){const fx=state.roleEffects.frozen;if(!fx||!Number(fx.night||0)||!night||night>=Number(fx.night||0))delete state.roleEffects.frozen}else if(phase==='night'){const fr=state.roleEffects.frozen;if(fr&&(!Number(fr.night||0)||!night||night>Number(fr.night||0)))delete state.roleEffects.frozen;const ex=state.roleEffects.expelled;if(ex&&Number(ex.night||0)>0&&night>Number(ex.night||0))delete state.roleEffects.expelled}renderRoleEffects()}
function roleIsEffectLocked(){return Object.keys(state.roleEffects||{}).some(k=>['frozen','expelled','dead','assassin_mark'].includes(k))}
function ensureInteractionUi(){
  if($('#gmwwPlayerInteraction'))return;
  const st=document.createElement('style');st.id='gmwwPlayerInteractionStyle';st.textContent='#gmwwPlayerInteraction{position:fixed;inset:0;z-index:99999;background:#02050be8;display:none;align-items:center;justify-content:center;padding:20px}#gmwwPlayerInteraction.show{display:flex}#gmwwPlayerInteraction .ix-card{width:min(100%,520px);border:2px solid #d59a43;border-radius:26px;background:linear-gradient(180deg,#14101c,#070b12);box-shadow:0 24px 70px #000;padding:26px 20px;text-align:center;color:#fff;position:relative;overflow:hidden}#gmwwPlayerInteraction .ix-card:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.45;background:radial-gradient(circle at 50% 0,#d7a64b22,transparent 55%)}#gmwwPlayerInteraction .ix-card.ix-frozen{border-color:#75cfff;background:linear-gradient(180deg,#092945,#06111f)}#gmwwPlayerInteraction .ix-card.ix-dead{border-color:#d94d5c;background:linear-gradient(180deg,#2b0c12,#08070b)}#gmwwPlayerInteraction .ix-card.ix-expelled{border-color:#e8a94e;background:linear-gradient(180deg,#3a2510,#0d0b0a)}#gmwwPlayerInteraction .ix-card.ix-vote{border-color:#ae77ff;background:linear-gradient(180deg,#23143b,#090914)}#gmwwPlayerInteraction .ix-card.ix-notice{border-color:#69b7ef;background:linear-gradient(180deg,#102b42,#07111c)}#gmwwPlayerInteraction .ix-icon{font-size:62px;line-height:1;margin-bottom:10px}#gmwwPlayerInteraction h2{margin:0;color:#ffd477;font-size:30px}#gmwwPlayerInteraction p{font-size:18px;line-height:1.45;color:#d6dce5;margin:14px 0 20px}#gmwwPlayerInteraction .ix-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}#gmwwPlayerInteraction .ix-actions.one{grid-template-columns:1fr}#gmwwPlayerInteraction button{min-height:62px;border-radius:16px;border:1px solid #d59a43;background:#14283c;color:#fff;font-size:22px;font-weight:900}#gmwwPlayerInteraction button.gold{background:linear-gradient(#d89235,#9b5619);color:#fff6dd}';
  document.head.appendChild(st);
  const el=document.createElement('div');el.id='gmwwPlayerInteraction';el.innerHTML='<div class="ix-card"><div class="ix-icon"></div><h2></h2><p></p><div class="ix-actions"></div></div>';document.body.appendChild(el)
}
function interactionMeta(type){return type==='frozen'?['❄️','BỊ ĐÓNG BĂNG','frozen']:type==='expelled'?['🚪','BỊ ĐUỔI KHỎI LÀNG','expelled']:type==='dead'?['💀','BẠN ĐÃ CHẾT','dead']:type==='assassin_mark'?['🎯','BỊ ĐÁNH DẤU','marked']:type==='thumb_vote'?['⚖️','HÃY CHỌN DẤU','vote']:['✨','HIỆU ỨNG','notice']}
function showPlayerInteraction(ix){
  if(!ix||!ix.id||ix.status&&ix.status!=='pending')return;if(String(ix.loginId||'').toLowerCase()!==String(state.member?.loginId||'').toLowerCase())return;
  // Visual-only receipts are audit events, not player prompts. Old pending
  // receipts from previous Runtime versions are acknowledged silently once.
  // Explicit acknowledgements / gameplay choices still require interaction.
  if(ix.type==='effect_notice'&&ix.requireAck!==true&&ix.requireResponse!==true){
    void respondInteraction(ix.id,'ĐÃ HIỂU',true);return;
  }
  // GM's secret choice is never provided by the server. This is the public morning answer prompt.
  if(ix.type==='assassin_mark')setRoleEffect(ix);
  if(['frozen','expelled','dead'].includes(ix.type)){setRoleEffect(ix);respondInteraction(ix.id,'ĐÃ HIỂU',true);return}
  ensureInteractionUi();if(state.activeInteractionId===ix.id&&$('#gmwwPlayerInteraction')?.classList.contains('show'))return;state.activeInteractionId=ix.id;state.activeInteraction=ix;
  const el=$('#gmwwPlayerInteraction'),meta=interactionMeta(ix.type),card=el.querySelector('.ix-card');card.className='ix-card ix-'+meta[2];el.querySelector('.ix-icon').textContent=meta[0];el.querySelector('h2').textContent=meta[1];el.querySelector('p').textContent=ix.message||'Thông báo từ Quản Trò.';
  const actions=el.querySelector('.ix-actions'),opts=Array.isArray(ix.options)&&ix.options.length?ix.options:(ix.type==='thumb_vote'?['👍','👎']:['ĐÃ HIỂU']);actions.className='ix-actions '+(opts.length===1?'one':'');actions.innerHTML='';
  for(const x of opts){const b=document.createElement('button');b.textContent=x;b.className=x==='👍'||x==='ĐÃ HIỂU'?'gold':'';b.onclick=()=>respondInteraction(ix.id,x);actions.appendChild(b)}
  if(ix.type==='dead')setDead(true);el.classList.add('show')
}
function handlePendingInteractions(rows){
  for(const ix of (Array.isArray(rows)?rows:[])){
    if(ix?.status!=='pending')continue;
    showPlayerInteraction(ix);
    // Old, visual-only receipts are cleaned up silently and must not block
    // the next meaningful action prompt in the same authenticated snapshot.
    if(ix.type==='effect_notice'&&ix.requireAck!==true&&ix.requireResponse!==true)continue;
    break;
  }
}
async function respondInteraction(id,response,silent=false){
  if(!state.roomCode||!state.token)return;
  try{const ack=await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/interaction/respond',{method:'POST',headers:auth(),body:JSON.stringify({interactionId:id,response})});if(state.roleEffects?.assassin_mark?.id===id){delete state.roleEffects.assassin_mark;renderRoleEffects()}if(!silent||state.activeInteractionId===id){const el=$('#gmwwPlayerInteraction');if(el)el.classList.remove('show');state.activeInteractionId='';state.activeInteraction=null}if(!silent)toast(ack?.assassinOutcome==='dead'?'Sát Thủ: Bạn đã chết.':ack?.assassinOutcome==='survived'?'Sát Thủ: Bạn đã sống sót.':response==='👍'||response==='👎'?'Đã gửi '+response+' cho Quản Trò.':'Đã xác nhận.');setTimeout(()=>pollRoomState(),120)}catch(e){if(!silent)toast(e.message||'Không gửi được phản hồi.')}
}
window.GMWWPlayerInteraction={show:showPlayerInteraction,respond:respondInteraction};
