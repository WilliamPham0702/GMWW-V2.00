  const TIMING=[['villageDiscussionSec','Thảo luận làng',300],['gallowsNominationSec','Đề cử Lên Giàn',60],['gallowsVoteSec','Bỏ phiếu Lên Giàn',60],['wolfDiscussionSec','Sói nhận diện nhau',30],['earlyArtifactSec','Artifact ưu tiên đầu ván',30],['defaultActionSec','Hành động mặc định',30],['artifactActionSec','Hành động Artifact',30]];
  const freshTiming=()=>Object.fromEntries(TIMING.map(([k,,d])=>[k,d]));
  // Ván Mẫu uses the same complete role, Artifact, order and timing configuration as the GM Server.
  function viewGame(box,st,room,players,locked){
    if(pr.gameView==='design')deckBuilder(box,players.length);
    else pickTemplates(box,st,players);
  }
  function pickTemplates(box,st,players){
    const cfg=st?.config,need=deckSize(cfg);
    box.append(el('div','gmww-pr-sub','CHỌN VÁN MẪU'));
    if(pr.catalogStatus==='loading'||pr.catalogStatus==='idle')box.append(el('p','gmww-pr-help','Đang tải Ván Mẫu và thư viện Vai Trò…'));
    if(pr.catalogStatus==='error')box.append(el('p','gmww-pr-note','Không tải được Ván Mẫu: '+pr.catalogError,btn('TẢI LẠI',async()=>loadTemplates(),'gmww-pr-main')));
    const row=el('div','gmww-pr-game-actions'),suggest=el('label','gmww-pr-suggest');suggest.append(el('small',null,'VÁN GỢI Ý'));
    const select=el('select');select.setAttribute('aria-label','Chọn Ván Mẫu');select.append(new Option('Chọn Ván Mẫu',''));
    for(const t of pr.templates){const tc=t.compiledConfig||t.gameConfig||{},opt=new Option((t.name||'Ván Mẫu')+' • '+(t.playerCount||'?')+' người',String(t.id));opt.selected=String(t.id)==String(pr.selectedTemplateId||cfg?.id||'');select.append(opt)}
    select.addEventListener('change',()=>{pr.selectedTemplateId=select.value;pr.matchTiming=null;pr.matchRoleSeconds=null;pr.matchArtifactEnabled=null;render()});suggest.append(select);
    row.append(suggest,btn('✨ AUTO VÁN',async()=>{const deck=composeAutoDeck(pr.roles,players.length,pr.autoHistory||[]);pr.autoHistory=[...(pr.autoHistory||[]),deck.signature].slice(-100);await callOwner('template','POST',{custom:{name:'AUTO '+players.length+' người',roles:deck.roles.map((r,i)=>({roleId:r.roleId,count:r.count,order:i+1}))}});pr.selectedTemplateId='';say('Đã tạo AUTO VÁN cân bằng theo số người.');await refresh();goStep('roles')},'gmww-pr-main',players.length<3||!pr.roles.length),btn('+ THÊM MỚI',async()=>newTemplate(),'gmww-pr-main'));
    box.append(row);
    if(pr.catalogStatus==='ready'&&!pr.templates.length)box.append(el('p','gmww-pr-help','Chưa có Ván Mẫu đã lưu. Chạm + THÊM MỚI để thiết kế mẫu đầu tiên.'));
    const active=pr.templates.find(t=>String(t.id)===String(pr.selectedTemplateId||cfg?.id||''));
    if(active){const c=active.compiledConfig||active.gameConfig||{},count=deckSize(c),chosenArts=Array.isArray(c.artifacts)?c.artifacts:[];
      const summary=el('div','gmww-pr-note');summary.textContent=count+' lá cho '+players.length+' người • '+(count===players.length?'Đủ số lượng':'Không khớp số người');box.append(summary);
      const artifact=el('label','gmww-pr-deckrow gmww-pr-match-toggle'),check=el('input');check.type='checkbox';check.checked=pr.matchArtifactEnabled??(c.artifactsEnabled===true);check.addEventListener('change',()=>{pr.matchArtifactEnabled=check.checked});artifact.append(check,el('span',null,'CÓ SỬ DỤNG ARTIFACT'),el('small',null,'Chỉ áp dụng cho trận này'));box.append(artifact);
      box.append(el('p','gmww-pr-help','Artifact: '+(check.checked?'CÓ sử dụng trong trận này':'KHÔNG sử dụng trong trận này')));
      const timing=el('details','gmww-pr-timing');timing.append(el('summary',null,'THỜI GIAN THỰC HIỆN • Chạm để tùy chỉnh (giây)'));
      const timeValues={...(c.timing||{}),...(pr.matchTiming||{})};for(const [key,label,def] of TIMING){const line=el('label','gmww-pr-deckrow');line.append(el('span',null,label),numberInput(timeValues[key]??def,0,3600,v=>{pr.matchTiming={...(pr.matchTiming||{}),[key]:v}}));timing.append(line)}
      const roleTime=el('details','gmww-pr-timing');roleTime.append(el('summary',null,'THỜI GIAN RIÊNG TỪNG VAI • Chạm để tùy chỉnh (giây)'));
      for(const r of c.roles||[]){const line=el('label','gmww-pr-deckrow');line.append(el('span',null,r.roleName||r.roleId),numberInput(pr.matchRoleSeconds?.[r.roleId]??r.actionDurationSec??timeValues.defaultActionSec??30,0,3600,v=>{pr.matchRoleSeconds={...(pr.matchRoleSeconds||{}),[r.roleId]:v}}));roleTime.append(line)}
      box.append(timing,roleTime);
    }else if(cfg){box.append(el('p','gmww-pr-help','Ván đang áp dụng: '+(cfg.name||'Ván Mẫu')))}
    const footer=el('div','gmww-pr-game-footer');footer.append(btn('HỦY',async()=>{pr.selectedTemplateId=cfg?.id||'';pr.matchTiming=null;pr.matchRoleSeconds=null;pr.matchArtifactEnabled=null;render()}),btn('CHỌN VÁN',async()=>{const id=pr.selectedTemplateId||active?.id||cfg?.id;if(!id)throw new Error('Hãy chọn một Ván Mẫu hoặc tạo AUTO VÁN.');const base=active?.compiledConfig||cfg||{},overrides={artifactsEnabled:pr.matchArtifactEnabled??base.artifactsEnabled,timing:pr.matchTiming||{},roleDurations:pr.matchRoleSeconds||{}};await callOwner('template','POST',{templateId:id,matchOverrides:overrides});pr.selectedTemplateId=id;say('Đã áp dụng Ván Mẫu cho trận này.');await refresh();goStep('roles')},'gmww-pr-main',!active&&!cfg||!players.length));box.append(footer);
    if(active?.canEdit)box.append(btn('CHỈNH SỬA VÁN MẪU',async()=>editTemplate(active)));
  }
  const numberInput=(value,min,max,onChange)=>{const i=el('input');i.type='number';i.inputMode='numeric';i.min=String(min);i.max=String(max);i.value=String(value);i.className='gmww-pr-sec-in';i.addEventListener('change',()=>onChange(Math.max(min,Math.min(max,Math.trunc(Number(i.value)||0)))));return i};
  function newTemplate(){pr.editTemplateId='';pr.deckName='';pr.deck=new Map();pr.roleOrder=new Map();pr.secs=new Map();pr.timing=freshTiming();pr.artifactIds=new Set();pr.artifactsEnabled=false;pr.artifactLimitPerCycle=3;pr.gameView='design';render()}
  function factionFor(role){const f=String(role?.faction||'').toLocaleLowerCase('vi');return f.includes('sói')||f==='wolf'?'Phe Sói':f.includes('ba')||f==='third'?'Phe Ba':'Phe Dân'}
  function roleIsStarred(role){try{return typeof prefs!=='undefined'&&!!prefs.cards?.[role.roleId]?.starred}catch(_){return false}}
  function composeAutoDeck(roles,players,history){
    const n=Math.trunc(Number(players)||0);if(n<3||n>30)throw new Error('AUTO VÁN hỗ trợ 3–30 người.');
    const all=new Map((roles||[]).map(r=>[String(r.roleId),{...r,id:String(r.roleId),name:String(r.roleName||r.roleId),factionId:factionFor(r)==='Phe Sói'?'wolf':factionFor(r)==='Phe Ba'?'third':'village'}]));
    const get=(id,team)=>{const r=all.get(id);return r&&r.factionId===team?r:null},wolf=get('role_wolf','wolf'),villager=get('role_villager','village'),seer=get('role_seer','village');
    if(!wolf||!villager||!seer)throw new Error('Thư viện chưa có đủ Sói Thường, Dân Làng và Tiên Tri.');
    const neutrals=['role_destroyer','role_assassin'].map(id=>get(id,'third')).filter(Boolean);if(n>=10&&!neutrals.length)throw new Error('Thư viện chưa có vai Phe Ba cho AUTO VÁN.');
    const wolves=n<=6?1:Math.max(2,Math.round((n-1)/4.5)),third=n>=10?1:0,special=n<=4?1:n<=8?2:n<=11?3:n<=15?4:n<=20?5:Math.min(8,Math.floor(n/3)),seen=new Set((history||[]).slice(-1));
    const pick=(arr,salt)=>arr.length?arr[Math.floor(((Math.random()+salt*.61803398875)%1)*arr.length)]:null;
    for(let attempt=0;attempt<160;attempt++){
      const counts=new Map(),add=(r,num=1)=>{if(r)counts.set(r.id,(counts.get(r.id)||0)+num)};add(wolf);
      const variants=(n>=12?['role_wolf_seer','role_wolf_cub']:[]).concat(n>=15?['role_alpha_wolf']:[],n>=17?['role_snow_wolf','role_wolf_hunter']:[]).map(id=>get(id,'wolf')).filter(Boolean);
      for(let i=1;i<wolves;i++)add(variants.length&&i<=Math.min(2,Math.floor(n/8))?pick(variants,attempt+i*5):wolf);if(third)add(pick(neutrals,attempt+2));
      const slots=n-wolves-third,ids=n<=4?['role_seer','role_guard','role_aura_seer']:n===5?['role_seer','role_guard','role_aura_seer','role_witch','role_hunter']:['role_seer','role_guard','role_witch','role_hunter','role_spiritualist','role_fox','role_aura_seer','role_piper','role_maiden','role_fairy','role_knight','role_bear_god'];
      const available=ids.map(id=>get(id,'village')).filter(Boolean),required=n>=6?[seer]:[];if(n>=5){const defense=pick(['role_guard','role_witch'].map(id=>get(id,'village')).filter(Boolean),attempt+3);if(defense&&!required.some(r=>r.id===defense.id))required.push(defense)}for(const r of required)add(r);
      const pool=[...all.values()].filter(r=>r.factionId==='village'&&r.id!=='role_villager'&&!available.some(a=>a.id===r.id)),others=available.filter(r=>!counts.has(r.id)).concat(pool.filter(r=>!counts.has(r.id)));let extra=Math.min(Math.max(0,slots-required.length),others.length);
      for(let i=0;i<extra;i++){const curated=others.filter(r=>available.some(a=>a.id===r.id)),candidate=pick(i<special-required.length&&curated.length?curated:others,attempt+i+7);add(candidate);others.splice(others.indexOf(candidate),1)}
      const rows=[...counts].map(([id,count])=>({roleId:id,count})),village=rows.filter(r=>all.get(r.roleId)?.factionId==='village').reduce((sum,r)=>sum+r.count,0),signature=rows.map(r=>r.roleId+':'+r.count).sort().join('|');
      if(village!==slots||rows.reduce((sum,r)=>sum+r.count,0)!==n||village<=wolves||seen.has(signature))continue;return{roles:rows,signature};
    }throw new Error('Đã hết đội hình khác nhau với thư viện hiện tại.');
  }
  function editTemplate(t){
    const cfg=t?.compiledConfig;if(!cfg)return;
    pr.editTemplateId=t.canEdit===true?String(t.id||''):'';pr.deckName=String(t.name||cfg.name||'Ván của tôi');pr.deck=new Map((cfg.roles||[]).map(r=>[String(r.roleId),Math.max(0,Number(r.count)||0)]).filter(([id,n])=>id&&n));
    pr.roleOrder=new Map((cfg.roles||[]).map(r=>[String(r.roleId),Number(r.order)||0]));pr.secs=new Map((cfg.roles||[]).map(r=>[String(r.roleId),Number(r.actionDurationSec)]).filter(([,n])=>Number.isFinite(n)));
    pr.artifactsEnabled=cfg.artifactsEnabled===true;pr.timing={...freshTiming(),...(cfg.timing||{})};pr.artifactIds=new Set(cfg.artifactsEnabled===true?(cfg.artifacts||[]).map(a=>String(a.artifactId||'')).filter(Boolean):[]);pr.artifactLimitPerCycle=Math.max(0,Number(cfg.artifactLimitPerCycle??3)||0);pr.gameView='design';render();
  }
  // Full Ván Mẫu editor: roles and order, per-role action time, Artifact pool/quota, game timing.
  function deckBuilder(box,people){
    const title=el('div','gmww-pr-sub','THIẾT KẾ VÁN MẪU');box.append(title,el('p','gmww-pr-help','Thư Viện • lưu trước khi vào Phòng'));
    if(pr.catalogStatus==='loading'||pr.catalogStatus==='idle'){box.append(el('p','gmww-pr-help','Đang tải danh sách vai từ Ván Mẫu Server…'));return}
    if(pr.catalogStatus==='error'){box.append(el('p','gmww-pr-note','Không tải được danh sách Ván Mẫu Server: '+pr.catalogError),btn('TẢI LẠI DANH SÁCH',async()=>{await loadTemplates()},'gmww-pr-main'));return}
    if(!pr.roles.length){box.append(el('p','gmww-pr-help','Chưa có danh sách Vai Trò từ Ván Mẫu Server. Hãy tải lại danh sách hoặc chọn một mẫu đã lưu.'));return}
    if(pr.catalogError)box.append(el('p','gmww-pr-note','Danh sách Vai Trò đã tải từ Ván Mẫu Server; danh sách Artifact chưa tải được: '+pr.catalogError));
    if(!pr.timing)pr.timing=freshTiming();if(!pr.secs)pr.secs=new Map();
    const templateRow=el('div','gmww-pr-game-actions'),templateSelect=el('select');templateSelect.setAttribute('aria-label','Chọn mẫu để chỉnh sửa');templateSelect.append(new Option('Tạo Ván Mẫu mới',''));
    for(const t of pr.templates){const opt=new Option(t.name||'Ván Mẫu',String(t.id));if(String(t.id)===String(pr.editTemplateId||''))opt.selected=true;templateSelect.append(opt)}
    templateSelect.addEventListener('change',()=>{const t=pr.templates.find(x=>String(x.id)===templateSelect.value);if(t)editTemplate(t);else newTemplate()});
    templateRow.append(templateSelect,btn('+ THÊM MỚI',async()=>newTemplate(),'gmww-pr-main'));const editing=pr.templates.find(t=>String(t.id)===String(pr.editTemplateId||''));if(editing?.canEdit===true)templateRow.append(btn('XÓA MẪU',async()=>{if(!confirm('Xóa Ván Mẫu “'+(editing.name||'')+'”?'))return;await callOwner('template-delete','POST',{templateId:editing.id});pr.editTemplateId='';await loadTemplates();pr.gameView='pick';say('Đã xóa Ván Mẫu.');render()},'gmww-pr-danger'));box.append(templateRow);
    box.append(btn('← QUAY LẠI CHỌN VÁN',async()=>{pr.gameView='pick';render()}));
    const name=el('input');name.id='gmwwPrDeckName';name.maxLength=48;name.placeholder='Tên Ván Mẫu';name.value=pr.deckName;name.addEventListener('input',()=>{pr.deckName=name.value});box.append(name);
    box.append(el('div','gmww-pr-sub','CHỌN VAI TRÒ'));
    const filters=el('div','gmww-pr-role-filters'),search=el('input');search.placeholder='Tìm Lá Bài theo tên hoặc Phe…';search.value=pr.roleSearch||'';search.addEventListener('input',()=>{pr.roleSearch=search.value;renderRoleGallery()});
    const faction=el('select');faction.append(new Option('Tất cả phe','all'),new Option('Phe Dân','Phe Dân'),new Option('Phe Sói','Phe Sói'),new Option('Phe Ba','Phe Ba'));faction.value=pr.roleFaction||'all';faction.addEventListener('change',()=>{pr.roleFaction=faction.value;renderRoleGallery()});
    const onlyFav=el('label','gmww-pr-favorite'),fav=el('input');fav.type='checkbox';fav.checked=!!pr.roleStarredOnly;fav.addEventListener('change',()=>{pr.roleStarredOnly=fav.checked;renderRoleGallery()});onlyFav.append(fav,el('span',null,'★ Thường dùng'));filters.append(search,faction,onlyFav);box.append(filters);
    const gallery=el('div','gmww-pr-role-gallery');gallery.id='gmwwPrRoleGallery';box.append(gallery);
    const sum=el('div','gmww-pr-note');sum.id='gmwwPrDeckSum';box.append(el('div','gmww-pr-sub','VAI TRÒ ĐÃ CHỌN'),sum);
    const selected=el('div','gmww-pr-list');selected.id='gmwwPrSelectedRoles';box.append(selected);
    const total=()=>[...pr.deck.values()].reduce((a,b)=>a+b,0);
    const refreshSum=()=>{const t=total(),ok=t>0&&t<=30;sum.textContent=t+' lá • '+new Set([...pr.deck.keys()]).size+' vai • '+(t===people?'Đủ số người':t>people?'Thừa '+(t-people):'Thiếu '+(people-t));const a=document.getElementById('gmwwPrDeckApply');if(a)a.disabled=pr.busy||!ok;renderSelectedRoles()};
    const renderRoleGallery=()=>{gallery.replaceChildren();const q=String(pr.roleSearch||'').trim().toLocaleLowerCase('vi'),rows=pr.roles.filter(r=>(!q||(String(r.roleName||r.roleId)+' '+factionFor(r)).toLocaleLowerCase('vi').includes(q))&&(pr.roleFaction==='all'||!pr.roleFaction||factionFor(r)===pr.roleFaction)&&(!pr.roleStarredOnly||roleIsStarred(r)));
      for(const r of rows){const picked=!!pr.deck.get(r.roleId),card=el('button','gmww-pr-role-card'+(picked?' is-picked':''));card.type='button';card.setAttribute('aria-pressed',String(picked));
        const art=el('span','gmww-pr-role-art'),img=el('img');img.alt='';img.loading='lazy';art.append(img,el('i',null,picked?'✓':'+'));card.append(art,el('b',null,r.roleName||r.roleId));
        img.src='/api/gm/template-role-artwork/'+encodeURIComponent(r.roleId);img.onerror=()=>{img.onerror=null;img.src='default-artwork.webp'};
        card.addEventListener('click',()=>{const n=pr.deck.get(r.roleId)||0;if(n)pr.deck.delete(r.roleId);else pr.deck.set(r.roleId,1);render();});gallery.append(card)}
      if(!rows.length)gallery.append(el('p','gmww-pr-help','Không tìm thấy Lá Bài. Hãy điều chỉnh bộ lọc.'))};
    const renderSelectedRoles=()=>{selected.replaceChildren();const roles=pr.roles.filter(r=>pr.deck.has(r.roleId)).sort((a,b)=>(pr.roleOrder?.get(a.roleId)||a.order||999)-(pr.roleOrder?.get(b.roleId)||b.order||999));const counts={'Phe Dân':0,'Phe Sói':0,'Phe Ba':0};for(const r of roles)counts[factionFor(r)]+=Number(pr.deck.get(r.roleId))||0;
      const totals=el('div','gmww-pr-faction-totals');for(const [k,v] of [['Tổng vai',total()],['Dân',counts['Phe Dân']],['Sói',counts['Phe Sói']],['Phe Ba',counts['Phe Ba']]])totals.append(stat(k,v));selected.append(totals);
      for(const [i,r] of roles.entries()){const line=el('div','gmww-pr-selected-role'),image=el('img');image.loading='lazy';image.alt='';line.append(image);image.src='/api/gm/template-role-artwork/'+encodeURIComponent(r.roleId);
        const title=el('span','gmww-pr-selected-title');title.append(el('b',null,r.roleName||r.roleId),el('small',null,factionFor(r)));const ctl=el('div','gmww-pr-ctl'),less=el('button','gmww-pr-step','−'),count=el('b',null,String(pr.deck.get(r.roleId)||0)),more=el('button','gmww-pr-step','+');less.type=more.type='button';
        const set=n=>{n=Math.max(0,Math.min(30,n));if(n)pr.deck.set(r.roleId,n);else pr.deck.delete(r.roleId);render();};less.onclick=()=>set((pr.deck.get(r.roleId)||0)-1);more.onclick=()=>set((pr.deck.get(r.roleId)||0)+1);ctl.append(less,count,more);
        const time=numberInput(pr.secs.has(r.roleId)?pr.secs.get(r.roleId):pr.timing.defaultActionSec,0,3600,v=>{pr.secs.set(r.roleId,v)});time.title='Thời gian riêng của vai (giây)';
        const order=numberInput(pr.roleOrder?.get(r.roleId)||i+1,1,99,v=>{pr.roleOrder.set(r.roleId,v)});order.title='Thứ tự';line.append(title,order,time,ctl);selected.append(line)}
      if(!roles.length)selected.append(el('p','gmww-pr-help','Chưa chọn Vai Trò. Chạm vào ảnh phía trên để thêm vào ván.'))};
    renderRoleGallery();
    const artifacts=el('label','gmww-pr-deckrow gmww-pr-match-toggle'),useArtifacts=el('input');useArtifacts.type='checkbox';useArtifacts.checked=pr.artifactsEnabled===true;useArtifacts.id='gmwwPrUseArtifacts';
    useArtifacts.addEventListener('change',()=>{pr.artifactsEnabled=useArtifacts.checked});
    artifacts.append(useArtifacts,el('span',null,'CÓ SỬ DỤNG ARTIFACT'),el('small',null,'Tự lấy từ kho Artifact chung của Server khi chọn ván.'));box.append(artifacts);
    const tl=el('div','gmww-pr-deck');tl.append(el('small',null,'TIMELINE (giây)'));
    for(const [k,label] of TIMING){const line=el('div','gmww-pr-deckrow');line.append(el('span',null,label),numberInput(pr.timing[k],0,3600,v=>{pr.timing[k]=v}));tl.append(line)}
    const auto=el('label','gmww-pr-deckrow'),autoCheck=el('input');autoCheck.type='checkbox';autoCheck.checked=pr.timing.autoAdvance!==false;auto.append(autoCheck,el('span',null,'Tự động chuyển vai khi hết giờ'));autoCheck.addEventListener('change',()=>{pr.timing.autoAdvance=autoCheck.checked});tl.append(auto);
    const details=el('details','gmww-pr-designer-advanced');details.append(el('summary',null,'THỜI GIAN VÁN (giây)'));details.append(tl);box.append(details);
    const row=el('div','gmww-pr-game-footer');
    const save=btn('LƯU VÁN',async()=>{
      const roles=[...pr.deck].map(([roleId,count],i)=>({roleId,count,order:pr.roleOrder?.get(roleId)||i+1,actionDurationSec:pr.secs.has(roleId)?pr.secs.get(roleId):pr.timing.defaultActionSec}));
      const artifactsEnabled=pr.artifactsEnabled===true;
      await callOwner('template-save','POST',{templateId:pr.editTemplateId||'',name:pr.deckName.trim()||'Ván của tôi',roles,timing:pr.timing,artifactsEnabled,artifactPool:'shared',artifactLimitPerCycle:pr.artifactLimitPerCycle??3});
      say(pr.editTemplateId?'Đã cập nhật Ván Mẫu trên Server.':'Đã lưu Ván Mẫu trên Server.');pr.editTemplateId='';pr.deckName='';pr.deck=new Map();pr.secs=new Map();pr.roleOrder=new Map();pr.artifactIds=new Set();pr.artifactLimitPerCycle=3;pr.timing=freshTiming();pr.gameView='pick';await loadTemplates()},'gmww-pr-main');save.id='gmwwPrDeckApply';
    save.textContent='LƯU';
    const cancel=btn('HỦY',async()=>{pr.gameView='pick';render()});row.append(cancel,save);box.append(row);
    refreshSum();
  }
  function viewRoles(box,st,room,players){
    const cfg=st?.config,need=deckSize(cfg),ok=!!cfg&&need===players.length,rounds=Number(st?.dealRound)||0;
    const g=el('div','gmww-pr-grid');g.append(stat('Lá bài',need||'—'),stat('Đã phân',rounds+' lần'));box.append(g);
    if(!cfg){box.append(el('p','gmww-pr-note','Chưa chọn Ván Mẫu.'),btn('← VÁN MẪU',async()=>goStep('game')));return}
    box.append(el('p','gmww-pr-help','Bấm PHÂN VAI NGẪU NHIÊN để máy chủ xáo bài kín. Có thể phân nhiều lần. Để giữ bí mật, không ai (kể cả bạn) thấy ai giữ vai hay Artifact nào.'));
    if(!ok)box.append(el('p','gmww-pr-note','Số lá bài ('+need+') chưa bằng số người ('+players.length+'). Hãy đổi Ván Mẫu hoặc điều chỉnh số người.'));
    if(cfg.artifactsEnabled)box.append(el('p','gmww-pr-note','Artifact được trộn và phát ngẫu nhiên cùng với Vai Trò. Người chủ phòng không thấy ai nhận lá nào.'));
    box.append(btn('🎲 PHÂN VAI NGẪU NHIÊN',async()=>{await callOwner('roles-shuffle','POST',{});say('Đã trộn Vai Trò và Artifact kín trên Server.');await refresh()},'gmww-pr-main',!ok));
    const row=el('div','gmww-pr-tools');row.append(btn('← VÁN MẪU',async()=>goStep('game')),btn('TIẾP: PHÁT VAI →',async()=>goStep('deal'),'gmww-pr-main',!ok));box.append(row);
  }
  function viewDeal(box,st,room,players,locked){
    const cfg=st?.config,need=deckSize(cfg),why=!cfg?'Chưa chọn Ván Mẫu.':!locked?'Hãy chốt chỗ ngồi ở bước Tập hợp.':need!==players.length?'Số lá bài ('+need+') chưa bằng số người ('+players.length+').':'';
    const g=el('div','gmww-pr-grid');g.append(stat('Người chơi',players.length),stat('Lá bài',need||'—'));box.append(g);
    box.append(el('p','gmww-pr-help','Bấm PHÁT VAI: máy chủ xáo bài ngẫu nhiên, mỗi người tự xem vai của mình, rồi vào Đêm 1. Bạn không biết ai nhận vai nào.'));
    if(why)box.append(el('p','gmww-pr-note',why));
    box.append(btn('🎴 PHÁT VAI & VÀO TRẬN',async()=>{await callOwner('start','POST',{});say('Đã phát vai. Ván bắt đầu.');pr.view='battle';await refresh()},'gmww-pr-main',!!why));
    box.append(btn('← PHÂN VAI',async()=>goStep('roles')));
  }
  function viewBattle(box,st,room,players,running){
    const g=el('div','gmww-pr-grid');g.append(stat('Trạng thái',running?'Đang chơi':'Chưa bắt đầu'),stat('Người chơi',players.length));box.append(g);
    if(running){box.append(el('p','gmww-pr-help','Quản Trò Tự Động đang điều hành. Ván tự kết thúc khi có phe thắng.'));
      box.append(btn('KẾT THÚC SỚM',async()=>{if(!confirm('Kết thúc ván ngay?'))return;await callOwner('end','POST',{});say('Đã kết thúc ván.');pr.view='lobby';await refresh()},'gmww-pr-danger'))}
    else box.append(el('p','gmww-pr-help','Ván chưa bắt đầu. Quay lại bước Phát Vai.'),btn('← PHÁT VAI',async()=>goStep('deal')));
  }
