  const stepNow=()=>{const room=pr.state?.room||{};return String(room.phase||'lobby').toLowerCase()==='running'?'battle':serverStep(room)};
  const inOwnRoom=()=>!!(pr.own&&state?.roomCode&&String(state.roomCode).toUpperCase()===String(pr.own.code).toUpperCase());
  // The four-stage flow is the DEFAULT Player Web setup, even before a room exists.
  // The seven-stage GM strip remains available only inside a separately created advanced room.
  const quickMode=()=>!state?.roomCode||state?.room?.phase==='deleted'||(!state?.room&&!pr.own)||(pr.own&&inOwnRoom()?(pr.state?.room?.quickPlay===true||pr.own.quick===true||state?.room?.quickPlay===true):state?.room?.quickPlay===true);
  const QUICK_ORDER=[['lobby','Sảnh Chờ'],['room','Tạo Phòng'],['game','Ván Mẫu'],['deal','Bắt Đầu']];
  // Chỉ chủ phòng (đã tạo phòng và đang ở trong phòng đó) mới thấy Ván Mẫu / Bắt Đầu.
  // Chưa có phòng hoặc vào phòng người khác: chỉ Sảnh Chờ · Tạo Phòng.
  const quickSteps=()=>pr.own&&inOwnRoom()?QUICK_ORDER:QUICK_ORDER.slice(0,2);
  function openSheet(){closeChat();pr.open=true;pr.touched=false;render();loadTemplates().then(render).catch(()=>render());refresh()}
  function closeSheet(){pr.open=false;render()}
  window.gmwwOpenCreateRoom=()=>{if(pr.own&&!inOwnRoom()){/* own room exists but the player is elsewhere */}openSheet()};
  // ---- Trang rời (Phòng, Chat): kéo được bằng thanh nắm/tiêu đề, hít vào menu trên/dưới (như màn Server), bấm ngoài để đóng.
  const DOCK_KEY='gmww_pr_dock_v1',SNAP_PX=32;
  const readDock=()=>{try{const v=JSON.parse(localStorage.getItem(DOCK_KEY)||'{}');return v&&typeof v==='object'&&!Array.isArray(v)?v:{}}catch(_){return{}}};
  function saveDock(id,edge){const v=readDock();if(edge==='top'||edge==='bottom')v[id]=edge;else delete v[id];try{localStorage.setItem(DOCK_KEY,JSON.stringify(v))}catch(_){}}
  // Visible menu bars (the bars live in shadow roots); null when a bar is not on screen.
  function barRects(){
    const rect=(hostId,innerId)=>{const h=document.getElementById(hostId);if(!h||h.hidden||!h.getClientRects().length)return null;
      const r=(h.shadowRoot?.getElementById(innerId)||h).getBoundingClientRect();return r.width>40&&r.height>10?r:null};
    return{top:rect('gmwwQuickStageStrip','quickSetupStrip')||rect('gmwwStageStrip','playSetupStrip'),bottom:rect('gmwwOwnerDock','gmTopMenu')};
  }
  function placeGeometry(panel,edge,bars){
    const gap=5,vw=innerWidth,vh=innerHeight,top=bars.top?bars.top.bottom+gap:8,bot=bars.bottom?bars.bottom.top-gap:vh-8;
    const ref=(edge==='top'?bars.top:bars.bottom)||bars.bottom||bars.top,width=Math.min(ref?ref.width:vw,vw-16),left=ref?ref.left+(ref.width-width)/2:(vw-width)/2;
    const vv=window.visualViewport,vl=Number(vv?.offsetLeft)||0,vwv=Math.min(vw,Number(vv?.width)||vw),w2=Math.min(width,vwv-16);
    return{top,bot,width:w2,left:Math.max(vl+8,Math.min(vl+vwv-w2-8,left+(width-w2)/2)),maxH:Math.max(180,Math.min(bot-top,vh-290))};
  }
  // iOS Safari/WebKit's keyboard shrinks visualViewport, not innerHeight.
  // Keep the entire chat composer within the visible area and above the keyboard.
  function placeChat(page){
    if(!page||page.hidden||!pr.chatOpen)return;
    const vp=window.visualViewport,visibleTop=Math.max(0,Number(vp?.offsetTop)||0);
    const bottom=visibleTop+(Number(vp?.height)||innerHeight),bars=barRects();
    const menuBottom=bars.top?.bottom||visibleTop;
    const minTop=Math.max(visibleTop+8,menuBottom+8),available=Math.max(96,bottom-minTop-8);
    const height=Math.min(350,available),top=Math.max(minTop,bottom-height-8);
    const width=Math.max(0,Math.min(innerWidth-16,bars.top?.width||innerWidth-16));
    const st=page.style;
    st.left=Math.max(8,(innerWidth-width)/2)+'px';st.right='auto';st.width=width+'px';
    st.top=top+'px';st.bottom='auto';st.height=height+'px';st.maxHeight=height+'px';
    st.transform='none';page.classList.remove('gmww-dock-snapped','gmww-dock-near');
  }
  function place(panel){
    if(!panel||panel.hidden||panel.dataset.prDragging==='1')return;
    if(panel.id==='gmwwPrChat'){placeChat(panel);return}
    const bars=barRects(),saved=readDock()[panel.id],edge=pr.pos&&pr.pos[panel.id]?'free':(saved==='top'?'top':'bottom'),g=placeGeometry(panel,edge,bars),st=panel.style;
    st.right='auto';st.transform='none';panel.classList.remove('gmww-dock-near');
    if(edge==='free'){
      const q=pr.pos[panel.id],w=Math.min(q.width||g.width,innerWidth-12),h=panel.offsetHeight||200;
      st.width=w+'px';st.left=Math.max(6,Math.min(innerWidth-w-6,q.left))+'px';st.top=Math.max(6,Math.min(innerHeight-h-6,q.top))+'px';st.bottom='auto';st.maxHeight=Math.max(180,innerHeight-parseFloat(st.top)-8)+'px';panel.classList.remove('gmww-dock-snapped');return;
    }
    st.width=g.width+'px';st.left=g.left+'px';st.maxHeight=g.maxH+'px';panel.classList.add('gmww-dock-snapped');
    if(edge==='top'){st.top=g.top+'px';st.bottom='auto'}else{st.top='auto';st.bottom=(innerHeight-g.bot)+'px'}
  }
  // Which menu edge a released page would stick to (or null when it is farther than 32px from both).
  function snapFor(rect){
    const bars=barRects();let best=null;
    if(bars.top){const d=Math.abs(rect.top-(bars.top.bottom+5));if(d<=SNAP_PX)best={edge:'top',d}}
    if(bars.bottom){const d=Math.abs(rect.bottom-(bars.bottom.top-5));if(d<=SNAP_PX&&(!best||d<best.d))best={edge:'bottom',d}}
    return best;
  }
  function floatPage(panel){
    if(!panel||panel.dataset.prFloat==='1')return;panel.dataset.prFloat='1';let drag=null;
    panel.addEventListener('pointerdown',e=>{
      if(panel.hidden||(e.button!==0&&e.pointerType!=='touch'))return;
      if(!e.target.closest('.gmww-pr-grip,.gmww-pr-head')||e.target.closest('button,input,select,textarea,a'))return;
      const r=panel.getBoundingClientRect();drag={id:e.pointerId,x:e.clientX,y:e.clientY,left:r.left,top:r.top,w:r.width,h:r.height};
      panel.dataset.prDragging='1';try{panel.setPointerCapture(e.pointerId)}catch(_){}e.preventDefault();
    });
    panel.addEventListener('pointermove',e=>{
      if(!drag||e.pointerId!==drag.id)return;const st=panel.style;
      const left=Math.max(6,Math.min(innerWidth-drag.w-6,drag.left+e.clientX-drag.x)),top=Math.max(6,Math.min(innerHeight-drag.h-6,drag.top+e.clientY-drag.y));
      st.width=drag.w+'px';st.left=left+'px';st.top=top+'px';st.right='auto';st.bottom='auto';st.transform='none';st.maxHeight=Math.max(180,innerHeight-top-8)+'px';
      panel.classList.remove('gmww-dock-snapped');panel.classList.toggle('gmww-dock-near',!!snapFor({top,bottom:top+drag.h}));e.preventDefault();
    });
    const stop=e=>{
      if(!drag||e.pointerId!==drag.id)return;const r=panel.getBoundingClientRect(),snap=e.type==='pointerup'?snapFor(r):null;
      drag=null;panel.dataset.prDragging='0';panel.classList.remove('gmww-dock-near');try{panel.releasePointerCapture(e.pointerId)}catch(_){}
      pr.pos=pr.pos||{};
      if(snap){delete pr.pos[panel.id];saveDock(panel.id,snap.edge)}else{pr.pos[panel.id]={left:r.left,top:r.top,width:r.width};saveDock(panel.id,null)}
      place(panel);
    };
    panel.addEventListener('pointerup',stop);panel.addEventListener('pointercancel',stop);
  }
  // Chat là một trang rời riêng (nút Box Chat ở thanh dưới), không nằm trong trang Phòng.
  function closeChat(){
    const page=document.getElementById('gmwwPrChat'),chat=document.getElementById('gmwwChatPanel');
    const was=pr.chatOpen;pr.chatOpen=false;if(page)page.hidden=true;
    if(chat&&page&&page.contains(chat)){chat.classList.remove('open');document.body.appendChild(chat)}
    if(document.activeElement?.id==='gmwwChatText')document.activeElement.blur();
    if(was)render();
  }
  function openChat(){
    const page=document.getElementById('gmwwPrChat'),host=page?.querySelector('.gmww-pr-chatbody'),chat=document.getElementById('gmwwChatPanel');
    if(!page||!host)return;
    if(!state?.roomCode||!chat){try{toast('Box Chat mở được khi bạn đã ở trong phòng.')}catch(_){}return}
    pr.open=false;render();host.appendChild(chat);chat.classList.add('open');pr.chatOpen=true;page.hidden=false;render();placeChat(page);
    // Do not auto-open the iPhone keyboard. Let people read chat before tapping the input.
  }
  // Bấm ra ngoài trang thì đóng trang trên cùng (như Server); thanh menu trên/dưới vẫn bấm được.
  function dismissOutside(e){
    const t=e.target;if(!t?.closest||(e.pointerType==='mouse'&&e.button!==0))return;
    if(t.closest('#gmwwStageStrip,#gmwwQuickStageStrip,#gmwwOwnerDock,#gmwwToast'))return;
    const chatPage=document.getElementById('gmwwPrChat'),panel=document.getElementById('gmwwPrPanel');
    const chatUp=pr.chatOpen&&chatPage&&!chatPage.hidden&&!chatPage.contains(t),sheetUp=pr.open&&panel&&!panel.hidden&&!panel.contains(t);
    if(!chatUp&&!sheetUp)return;
    if(sheetUp&&!chatUp&&seatDragOn()&&t.id==='gmwwPrBack')return;
    e.preventDefault();e.stopImmediatePropagation();
    // keep an invisible catcher for a moment so the finger-up click does not land on the village underneath
    pr.holdBack=true;setTimeout(()=>{pr.holdBack=false;render()},450);
    if(chatUp)closeChat();else closeSheet();
  }
  function render(options={}){
    const panel=document.getElementById('gmwwPrPanel'),back=document.getElementById('gmwwPrBack');if(!panel||!back)return;
    // Chơi nhanh đang vào trận: game tự vận hành, chủ phòng chơi như mọi người (chỉ thêm nút Kết thúc ván ở thanh dưới).
    if(pr.open&&quickMode()&&String((pr.own&&inOwnRoom()?pr.state?.room:state?.room)?.phase||'').toLowerCase()==='running')pr.open=false;
    panel.hidden=!pr.open;back.hidden=!(pr.open||pr.chatOpen||pr.holdBack||seatDragOn());back.classList.toggle('seatdrag',seatDragOn());renderChrome();if(!pr.open)return;
    const viewKey=[pr.own?.code||'',pr.view,pr.gameView||'pick',pr.editTemplateId||''].join(':');
    const oldBody=panel.querySelector('.gmww-pr-body'),sameView=panel.dataset.viewKey===viewKey;
    // iPhone keyboard: never tear down an active Quick Play selector/number field during polling.
    if(options?.background&&sameView&&pr.view==='game'&&(pr.state?.room?.quickPlay||state.room?.quickPlay)&&
       oldBody&&oldBody.contains(document.activeElement)&&/^(INPUT|SELECT|TEXTAREA)$/.test(document.activeElement.tagName))return;
    // Poll room authority without replacing the editor DOM under a touch/keyboard gesture.
    if(options?.background&&sameView&&oldBody&&pr.view==='game'&&pr.gameView==='design'&&pr.own&&inOwnRoom()&&String(pr.state?.room?.phase||'lobby').toLowerCase()==='lobby'){
      const sum=document.getElementById('gmwwPrDeckSum'),people=pr.state?.players?.length||0,t=[...pr.deck.values()].reduce((a,b)=>a+b,0);
      if(sum)sum.textContent=t+' lá • '+pr.deck.size+' vai • '+(t===people?'Đủ số người':t>people?'Thừa '+(t-people):'Thiếu '+(people-t));
      return;
    }
    const keep=sameView&&pr.view==='game'&&oldBody?{top:oldBody.scrollTop,left:oldBody.querySelector('.gmww-pr-role-gallery')?.scrollLeft||0,details:[...oldBody.querySelectorAll('details')].map(n=>n.open)}:null;
    panel.dataset.viewKey=viewKey;
    panel.textContent='';
    const head=el('header','gmww-pr-head'),close=el('button','gmww-pr-close','×');close.type='button';close.setAttribute('aria-label','Đóng');close.addEventListener('click',closeSheet);
    const isQuick=quickMode();
    const panelTitle=isQuick?(pr.view==='game'?'Ván Mẫu':pr.view==='deal'?'Bắt Đầu':pr.view==='lobby'?'Sảnh Chờ':'Tạo Phòng'):(pr.view==='game'?(pr.gameView==='design'?'Thiết kế Ván Mẫu':'Chọn Ván Mẫu'):pr.view==='room'||!pr.own?'Phòng':(pr.state?.room?.roomName||LABEL[pr.view]||'Phòng'));
    // Chơi nhanh: bỏ dòng tiêu đề + nút × (menu trên đã ghi tên bước; chạm ra ngoài để đóng, kéo bằng thanh nắm).
    head.append(el('b',null,panelTitle),close);panel.append(el('i','gmww-pr-grip'));void head;// Mọi trang rời: không tên trang, không nút × (chạm ra ngoài để đóng).
    const body=el('div','gmww-pr-body');
    if(isQuick){
      const host=!!(pr.own&&inOwnRoom()&&pr.state?.room?.quickPlay),st=host?pr.state:null;
      const room=st?.room||(state?.room?.quickPlay?state.room:{}),players=st?.players||state.players||[],hasRoom=room.quickPlay===true;
      if(hasRoom&&pr.catalogStatus==='idle')loadTemplates().then(()=>render()).catch(()=>render());
      if(!quickSteps().some(x=>x[0]===pr.view))pr.view=hasRoom?'room':'lobby';
      const sec=el('section','gmww-pr-sec'),running=String(room.phase||'lobby').toLowerCase()==='running';
      if(running){
        sec.append(el('p','gmww-pr-note','Ván đang diễn ra.'));
      }else if(pr.view==='lobby'){
        sec.append(el('p','gmww-pr-help',hasRoom?
          'Sảnh chờ • '+players.length+' người đã vào phòng '+(room.code||state.roomCode||'')+'. Mọi người cùng chơi, kể cả chủ phòng.':
          'Sảnh chờ • Đăng nhập để mở phòng hoặc tham gia bằng mã/link.'));
        sec.append(btn('TIẾP: TẠO PHÒNG →',()=>onTab('room'),'gmww-pr-main'));
      }else if(pr.view==='room'){
        if(!hasRoom)viewQuickEntry(sec);
        else if(host)viewQuickRoom(sec,st,room,players);
        else {
          sec.append(el('p','gmww-pr-note','Mã phòng: '+(room.code||state.roomCode||'')+' • '+players.length+' người'+(room.quickPlayJoinLocked?' • Đã khóa':' • Đang mở')));
          const list=el('div','gmww-pr-list');
          for(const p of players)list.append(el('div','gmww-pr-player',p.displayName||p.loginId||'Người chơi'));
          sec.append(list);
        }
      }else if(!hasRoom){
        sec.append(el('p','gmww-pr-note','Bạn cần tạo hoặc tham gia phòng trước khi chọn Ván Mẫu và bắt đầu.'));
        sec.append(btn('ĐẾN TẠO PHÒNG →',()=>onTab('room'),'gmww-pr-main'));
      }else if(pr.view==='game')renderQuickPlay(sec,players,st);
      else if(pr.view==='deal')viewQuickStart(sec,st,room,players);
      body.append(sec);
    }else if(!pr.own||pr.view==='room'&&!inOwnRoom()){
      viewRoomHub(body,pr.state,pr.state?.room||{},Array.isArray(pr.state?.players)?pr.state.players:[]);
    }else{
      const st=pr.state,room=st?.room||{},players=Array.isArray(st?.players)?st.players:[],running=String(room.phase||'lobby').toLowerCase()==='running';
      const locked=room.seatsLocked===true;if(!pr.view||!ORDER.includes(pr.view))pr.view=stepNow();
      if(!inOwnRoom())body.append(el('p','gmww-pr-note','Bạn đang ở ngoài phòng '+pr.own.code+'. Vào lại phòng để dùng thanh điều khiển.'),btn('VÀO LẠI PHÒNG '+pr.own.code,async()=>{if(!await window.joinRoom(pr.own.code))throw new Error('Không vào lại được phòng.');pr.open=false;try{await enterVillage()}catch(_){}}));
      const sec=el('section','gmww-pr-sec');
      ({lobby:viewLobby,room:viewRoomHub,seats:viewSeats,game:viewGame,roles:viewRoles,deal:viewDeal,battle:viewBattle})[pr.view](sec,st,room,players,pr.view==='battle'?running:locked);
      if(running&&pr.view!=='battle')sec.prepend(el('p','gmww-pr-note','Ván đang chạy: các bước chuẩn bị chỉ để xem.'));
      body.append(sec);
    }
    const status=el('div','gmww-pr-status');status.id='gmwwPrStatus';status.textContent=pr.msg;body.append(status);
    panel.append(body);place(panel);
    if(keep){body.querySelectorAll('details').forEach((n,i)=>{n.open=!!keep.details[i]});body.scrollTop=keep.top;const gallery=body.querySelector('.gmww-pr-role-gallery');if(gallery)gallery.scrollLeft=keep.left;}
  }
  // Top strip + bottom dock are the GM Server's own markup and CSS (GMWW_SERVER_MENU), shown to every logged-in player.
  const LABEL={lobby:'SẢNH CHỜ',room:'PHÒNG',seats:'TẬP HỢP',game:'VÁN MẪU',roles:'PHÂN VAI',deal:'PHÁT VAI',battle:'VÀO TRẬN'};
  const ORDER=['lobby','room','seats','game','roles','deal','battle'];
  const barScreen=()=>!!(state?.token&&state?.member&&!['','login','register'].includes(state.activeScreenId||''));
  // The step every player sees: the owner's own view, otherwise the stage the server publishes for the room.
  function stripNow(){
    if(!state?.roomCode)return 'lobby';
    const r=(pr.own&&inOwnRoom()?pr.state?.room:state?.room)||{};
    if(String(r.phase||'').toLowerCase()==='running')return 'battle';
    const g=String(r.gmStage||'room');return ORDER.includes(g)&&g!=='lobby'?g:'room';
  }
  const SHADOW_BASE=':host{display:block}#start #playShell #gmTopMenu #playAudioTop{display:none!important}';
  function ensureStrip(){
    let host=document.getElementById('gmwwStageStrip');if(host)return host;
    host=el('div');host.id='gmwwStageStrip';host.hidden=true;
    const root=host.attachShadow({mode:'open'}),strip=(GMWW_SERVER_MENU.markup.match(/<section\b[^>]*id="playSetupStrip"[\s\S]*?<\/section>/)||[''])[0];
    root.innerHTML='<style>'+GMWW_SERVER_MENU.css+SHADOW_BASE+'#start #playShell #playSetupStrip.play-setup-strip.gm-stage-timeline-v330{position:relative!important;top:auto!important;bottom:auto!important;left:auto!important;right:auto!important;width:100%!important;max-width:none!important;margin:0!important;transform:none!important;min-height:58px!important;border:0!important;outline:0!important;border-radius:0 0 22px 22px!important;box-shadow:none!important;padding:7px 8px!important;-webkit-mask-image:linear-gradient(180deg,#000 0,#000 72%,transparent 100%);mask-image:linear-gradient(180deg,#000 0,#000 72%,transparent 100%)}</style><div id="start"><div id="playShell" class="play-shell" data-phase="lobby" style="position:relative;height:auto;min-height:0;padding:0;background:none;overflow:visible">'+strip+'</div></div>';
    root.querySelectorAll('#playSetupStrip button').forEach(b=>b.addEventListener('click',()=>onTab(b.dataset.playStep||'room')));
    document.body.appendChild(host);return host;
  }
  // This is the TOP navigation replacing the seven-circle legacy menu, not a
  // second navigation row inside the floating setup sheet.
  function ensureQuickStrip(){
    let host=document.getElementById('gmwwQuickStageStrip');if(host)return host;
    host=el('div');host.id='gmwwQuickStageStrip';host.hidden=true;
    const root=host.attachShadow({mode:'open'});
    root.innerHTML='<style>'+
      // Menu trên gọn bằng menu dưới (cao 62px, tối đa 520px, canh giữa), không nền.
      ':host{display:block;box-sizing:border-box;background:transparent;border:0;box-shadow:none}#quickSetupStrip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2px;width:100%;max-width:520px;height:62px;margin:0 auto;padding:4px 6px;box-sizing:border-box;background:transparent;font-family:system-ui,-apple-system,sans-serif}'+
      '#quickSetupStrip button{appearance:none;background:transparent;border:0;color:#eef8ff;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:3px;min-width:0;height:54px;padding:0 1px;cursor:pointer;font-family:inherit}'+
      '#quickSetupStrip button[hidden]{display:none}'+
      '#quickSetupStrip .number{display:grid;place-items:center;width:28px;height:28px;flex:none;box-sizing:border-box;border:1.5px solid #9fd2f0;border-radius:50%;font-weight:700;font-size:13px;background:rgba(6,44,66,.55);box-shadow:0 1px 4px rgba(0,0,0,.35)}'+
      '#quickSetupStrip .label{font-weight:700;font-size:10.5px;white-space:nowrap;max-width:100%;letter-spacing:-.1px;text-shadow:0 1px 3px rgba(0,0,0,.85),0 0 2px rgba(0,0,0,.6)}'+
      '#quickSetupStrip button.active .number{background:#f4d16d;color:#544400;border-color:#ffe39b;box-shadow:0 0 9px #ffe39099}'+
      '#quickSetupStrip button.active .label{color:#fff1bd}'+
      '#quickSetupStrip button.done .number{background:#148178;border-color:#55d5c7;color:white}'+
      '#quickSetupStrip button:focus-visible{outline:2px solid #fff;border-radius:8px}'+
      '</style><nav id="quickSetupStrip" aria-label="Chơi nhanh V2"></nav>';
    const nav=root.getElementById('quickSetupStrip');
    for(const [index,[key,label]] of QUICK_ORDER.entries()){
      const button=el('button');button.type='button';button.dataset.quickStep=key;
      button.append(el('span','number',String(index+1)),el('span','label',label));
      button.addEventListener('click',()=>onTab(key));nav.append(button);
    }
    document.body.appendChild(host);return host;
  }
  // Only the owner of the room they are in drives the steps; everyone can open the Phòng page (create / join / manage).
  async function rejoinOwn(){
    if(await window.joinRoom(pr.own.code)===false)throw new Error('Không vào lại được phòng.');
    try{await enterVillage()}catch(_){}
    await refresh();
  }
  function onTab(k){
    if(quickMode()){
      pr.view=quickSteps().some(s=>s[0]===k)?k:'room';pr.touched=true;
      if(pr.open)render();else openSheet();
      return;
    }
    if(k==='room'||k==='lobby'&&!pr.own){pr.view='room';pr.touched=true;openSheet();return}
    if(pr.own&&!inOwnRoom()){run(async()=>{await rejoinOwn();pr.view=k;pr.touched=true;syncStage(k);openSheet()});return}
    if(!(pr.own&&inOwnRoom())){try{toast('Chỉ chủ phòng điều hành các bước này.')}catch(_){}return}
    pr.view=k;pr.touched=true;syncStage(k);if(pr.open)render();else openSheet();
  }
  function ensureDock(){
    let host=document.getElementById('gmwwOwnerDock');if(host)return host;
    host=el('div');host.id='gmwwOwnerDock';host.hidden=true;
    const root=host.attachShadow({mode:'open'});
    root.innerHTML='<style>'+GMWW_SERVER_MENU.css+SHADOW_BASE+'#start #playShell #gmTopMenu.gm-top-menu-v293{position:relative!important;inset:auto!important;left:auto!important;right:auto!important;bottom:auto!important;top:auto!important;width:100%!important;max-width:520px;margin:0 auto!important;transform:none!important;height:62px!important;min-height:62px!important;border:0!important;outline:0!important;background:transparent!important;grid-template-columns:48px 48px minmax(0,1fr) 48px!important}#start #playShell #gmTopMenu .gm-top-info-copy-v293 b{white-space:normal!important;overflow:visible!important;text-overflow:clip!important;font-size:11.5px!important;line-height:13px!important;letter-spacing:0!important;word-break:keep-all}#start #playShell #gmTopMenu .gm-top-info-copy-v293 small{white-space:normal!important;letter-spacing:.02em!important;line-height:9px!important}#start #playShell #gmTopMenu.gm-top-menu-v293>*{-webkit-backdrop-filter:blur(12px) saturate(130%)!important;backdrop-filter:blur(12px) saturate(130%)!important}</style><div id="start"><div id="playShell" class="play-shell" data-phase="lobby" style="position:relative;height:auto;min-height:0;padding:0;background:none;overflow:visible">'+GMWW_SERVER_MENU.dock+'</div></div>';
    const q=id=>root.getElementById(id),owner=()=>!!(pr.own&&inOwnRoom());
    q('playPhasePill').addEventListener('click',()=>{
      if(quickMode()){const qs=quickSteps(),cur=qs.findIndex(s=>s[0]===pr.view),nxt=qs[Math.min(qs.length-1,cur+1)];onTab(!state?.roomCode?'room':(cur>=0?nxt[0]:'room'));return}
      if(!state?.roomCode){onTab('room');return}
      if(pr.own&&!owner()){run(async()=>{await rejoinOwn();pr.view='room';pr.touched=true;openSheet()});return}
      if(state.room?.quickPlay&&state.room.phase==='lobby'){onTab('room');return}
      if(!owner()){try{toast('Chủ phòng điều hành ván; bạn chỉ cần chờ.')}catch(_){}return}
      const i=ORDER.indexOf(pr.open?pr.view:stepNow()),nxt=ORDER[Math.min(ORDER.length-1,i+1)];
      pr.view=nxt;pr.touched=true;syncStage(nxt);if(pr.open)render();else openSheet();
    });
    q('playExitVillage').addEventListener('click',()=>{
      if(!state?.roomCode){try{go('profile')}catch(_){}return}
      if(confirm(owner()?'Rời phòng của bạn? Phòng trống 30 phút sẽ tự xoá.':'Rời phòng này?'))run(async()=>{closeSheet();await window.leaveRoom()});
    });
    q('playChatTop').addEventListener('click',()=>{
      if(!state?.roomCode){try{toast('Box Chat mở được khi bạn đã ở trong phòng.')}catch(_){}return}
      if(pr.chatOpen){closeChat();return}
      openChat();
    });
    q('playEndGame').addEventListener('click',()=>{if(owner()&&stepNow()==='battle'&&confirm('Kết thúc ván ngay?'))run(async()=>{await callOwner('end','POST',{});say('Đã kết thúc ván.');await refresh()})});
    document.body.appendChild(host);return host;
  }

  // Player-created matches reuse existing room state, private actions, voice,
  // gallows and result handlers. This is only the phase-aware bottom controller.
  // Màn trận Player Web = bố cục trận của Server, phần dành cho người chơi:
  // dưới cùng chỉ có [đồng hồ] [ô chat]; ô hành động chỉ hiện khi bạn có việc phải làm.
  // Không có menu GM (Khôi phục, Điều hành, Audio, icon Cứu/Giết/Câm…).
  function quickActionStage(room){
    if(room.cyclePhase==='night'){
      const offers=state.onlineActions||[];
      return offers.length&&!offers.every(a=>a.blocked)?'night':'';
    }
    const stage=typeof gallowsCurrentStage==='function'?gallowsCurrentStage():'ready';
    return stage==='nominating'||stage==='voting'?stage:'';
  }
  function ensureQuickBattleDock(){
    let host=document.getElementById('gmwwQuickBattleDock');if(host)return host;
    host=el('nav');host.id='gmwwQuickBattleDock';host.hidden=true;host.setAttribute('aria-label','Menu dưới trong trận');
    const style=el('style');style.textContent='#gmwwQuickBattleDock{position:fixed;box-sizing:border-box;z-index:9650;left:calc(var(--gmww-player-visible-left,0px) + 8px);top:calc(var(--gmww-player-visible-top,0px) + var(--gmww-player-visible-height,100dvh) - max(8px,env(safe-area-inset-bottom,0px)));transform:translateY(-100%);width:calc(var(--gmww-player-visible-width,100vw) - 16px);max-width:760px;display:grid;grid-template-columns:74px minmax(0,1fr);gap:8px;padding:0;background:transparent;border:0}'+
      '#gmwwQuickBattleDock.has-action{grid-template-columns:74px minmax(0,1fr) 74px}'+
      '#gmwwQuickBattleDock.has-end{grid-template-columns:74px minmax(0,1fr) 64px}#gmwwQuickBattleDock.has-action.has-end{grid-template-columns:74px minmax(0,1fr) 74px 64px}'+
      '#gmwwQuickBattleDock [data-battle-control="chat"].is-icon{text-align:center;padding:0;font-size:22px}#gmwwQuickBattleDock [data-battle-control="tray"].is-empty{opacity:.55;justify-content:center}#gmwwQuickBattleDock [data-battle-control="tray"].is-empty::before{content:"—";color:#d7ecfc;font:700 14px system-ui}'+
      '#gmwwQuickBattleDock [data-battle-control="restore"]{font-size:12px;line-height:1.2}#gmwwQuickBattleDock [data-battle-control="restore"].gmww-restore-ready{background:#7a5a12e6;border-color:#f4d16d;color:#fff4cf}'+
      '#gmwwQuickBattleDock [data-battle-control="tray"]{min-width:0;min-height:58px;display:flex;align-items:center;border:1.5px solid #f4d16daa;border-radius:16px;background:rgba(18,59,82,.42);box-shadow:0 4px 14px #00182b66;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);padding:3px 6px;overflow:hidden}#gmwwQuickBattleDock [data-battle-control="tray"][hidden]{display:none}'+
      '#gmwwOnlineDock.in-tray{position:static!important;transform:none!important;left:auto!important;top:auto!important;display:flex;flex-wrap:nowrap;justify-content:flex-start;gap:6px;max-width:none;width:100%;overflow-x:auto;overflow-y:hidden}'+
      '#gmwwOnlineDock.in-tray button{width:auto!important;height:auto!important;min-width:52px;display:flex;flex-direction:column;align-items:center;gap:1px;background:transparent!important;border:0!important;box-shadow:none!important;padding:0 2px!important;min-height:0!important}'+
      '#gmwwOnlineDock.in-tray img{width:34px!important;height:34px!important}#gmwwOnlineDock .gmww-act-name{display:none}#gmwwOnlineDock.in-tray .gmww-act-name{display:block;font:700 10px/1.15 system-ui,-apple-system,sans-serif;color:#fff1bd;white-space:nowrap;max-width:84px;overflow:hidden;text-overflow:ellipsis;pointer-events:none}'+
      '#gmwwQuickBattleDock [data-battle-control="end"]{background:#6b2430e6;border-color:#e59aa5;font-size:12px;line-height:1.2}#gmwwQuickBattleDock [data-battle-control="end"][hidden]{display:none}'+
      '#gmwwQuickBattleDock[hidden]{display:none!important}#gmwwQuickBattleDock button{font:800 15px/1.15 system-ui,-apple-system,sans-serif;color:#eefaff;background:rgba(18,59,82,.42);border:1.5px solid #6fa9bdaa;border-radius:16px;min-width:0;min-height:58px;padding:4px 6px;box-shadow:0 4px 14px #00182b66;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}'+
      '#gmwwQuickBattleDock [data-battle-control="clock"]{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:19px;font-variant-numeric:tabular-nums}#gmwwQuickBattleDock [data-battle-control="clock"] i{font-style:normal;font-size:16px;line-height:1}'+
      '#gmwwQuickBattleDock [data-battle-control="chat"]{text-align:left;padding:0 18px;font-weight:600;font-size:16px;color:#d9eef5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}'+
      '#gmwwQuickBattleDock [data-battle-control="action"]{background:#1c6a4ae6;border-color:#8ee0b0;font-size:12px}#gmwwQuickBattleDock [data-battle-control="action"][hidden]{display:none}';
    document.head.appendChild(style);
    for(const key of ['clock','chat','tray','action','restore','end']){
      if(key==='tray'){const tray=el('div');tray.dataset.battleControl='tray';tray.hidden=true;tray.setAttribute('aria-label','Hành động của lượt');host.append(tray);continue}
      const button=el('button');button.type='button';button.dataset.battleControl=key;
      if(key==='clock')button.setAttribute('aria-label','Thời gian lượt');
      if(key==='chat')button.textContent='Nhắn cho phòng…';
      if(key==='restore'){button.textContent='Khôi phục';button.id='gmwwQuickRestore';button.setAttribute('aria-label','Khôi phục hành động')}
      if(key==='end'){button.textContent='⏹ Kết thúc';button.hidden=true;button.setAttribute('aria-label','Kết thúc ván (chủ phòng)')}
      button.addEventListener('click',()=>{
        try{unlockGmwwAudio()}catch(_){}
        const room=(pr.own&&inOwnRoom()?pr.state?.room:state?.room)||{};
        if(key==='clock'){revealPlayerTopMenu(true);return}
        if(key==='chat'){pr.chatOpen?closeChat():openChat();return}
        if(key==='restore'){gmwwPlayerRestoreClick();return}
        if(key==='end'){if(pr.own&&inOwnRoom()&&confirm('Kết thúc ván ngay?'))run(async()=>{await callOwner('end','POST',{});say('Đã kết thúc ván.');await refresh()});return}
        const stage=quickActionStage(room);
        if(stage==='night'){renderOnlineActionDock();toast('Chạm hoặc kéo icon hành động vào người chơi.');return}
        if(stage==='nominating'){state.gallowsNominationOpen=true;renderGallowsWidget();return}
        if(stage==='voting'){renderGallowsWidget();return}
        toast('Chưa đến lượt hành động của bạn.');
      });
      host.append(button);
    }
    document.body.appendChild(host);return host;
  }
  function quickBattleClock(room){
    const night=room.cyclePhase==='night';let remain=NaN,paused=false;
    if(night){
      const clock=gmwwSharedTimeline?.clock;
      if(clock&&gmwwSharedTimelineKey===[state.roomCode,room.matchId,room.cycleKey].join(':')){
        remain=Number(clock.remainingMs);paused=clock.paused===true;
        if(!paused)remain-=Math.max(0,performance.now()-gmwwSharedTimelineReceivedAt);
      }
    }else if(room.dayPausedRemainingMs!=null){remain=Number(room.dayPausedRemainingMs);paused=true}
    else if(room.dayDeadlineAt)remain=Date.parse(room.dayDeadlineAt)-Date.now()-(Number(state.serverClockOffsetMs)||0);
    if(!Number.isFinite(remain))return '--:--';
    const secs=Math.max(0,Math.ceil(remain/1000));
    return (paused?'⏸ ':'')+String(Math.floor(secs/60)).padStart(2,'0')+':'+String(secs%60).padStart(2,'0');
  }
  function renderQuickBattleDock(host,room){
    const clock=host.querySelector('[data-battle-control="clock"]'),action=host.querySelector('[data-battle-control="action"]');
    // Đồng hồ chỉ còn 00:00 (không icon).
    const t=quickBattleClock(room).replace('--:--','00:00');
    if(clock.dataset.t!==t){clock.dataset.t=t;clock.textContent=t}
    // Hộp hành động như Server: icon + tên hành động, kéo lên người chơi.
    // Bố cục CỐ ĐỊNH theo pha (không co giãn khi hành động xong → menu dưới không giật).
    const night=room.cyclePhase==='night',tray=host.querySelector('[data-battle-control="tray"]'),hasTray=!!tray?.querySelector('#gmwwOnlineDock button');
    const stage=quickActionStage(room),gallows=stage==='nominating'||stage==='voting',label=stage==='nominating'?'🗳 Đề cử':stage==='voting'?'🗳 Bỏ phiếu':'';
    if(tray){tray.hidden=gallows&&!hasTray;tray.classList.toggle('is-empty',!hasTray)}
    action.hidden=!gallows||hasTray;host.classList.toggle('has-action',true);if(action.textContent!==label)action.textContent=label;
    // Ban đêm: Chat thu thành icon 💬 để hộp hành động rộng hơn.
    const chat=host.querySelector('[data-battle-control="chat"]'),chatLabel=night?'💬':'Nhắn cho phòng…';
    if(chat&&chat.textContent!==chatLabel){chat.textContent=chatLabel;chat.classList.toggle('is-icon',night)}
    const end=host.querySelector('[data-battle-control="end"]'),isOwner=!!(pr.own&&inOwnRoom());
    if(end){end.hidden=!isOwner;host.classList.toggle('has-end',isOwner)}
    const cols=night?['58px','52px','minmax(0,1fr)','66px']:['58px','minmax(0,1fr)','minmax(0,1fr)','66px'];if(isOwner)cols.push('60px');
    const grid=cols.join(' ');if(host.style.gridTemplateColumns!==grid)host.style.gridTemplateColumns=grid;
    if(typeof gmwwOnlineRestoreHint==='function')gmwwOnlineRestoreHint();
  }
  function renderChrome(){
    const show=barScreen(),quick=quickMode(),strip=ensureStrip(),quickStrip=ensureQuickStrip(),dock=ensureDock(),battleDock=ensureQuickBattleDock();
    // The iOS keyboard is more important than the setup bar while composing a chat.
    const chatTyping=pr.chatOpen&&document.activeElement?.id==='gmwwChatText';
    const gameRunning=String((pr.own&&inOwnRoom()?pr.state?.room:state?.room)?.phase||'').toLowerCase()==='running';
    // Khi vào trận, ẩn menu thiết lập để engine Đêm/Ngày/Lên Giàn hiển thị.
    strip.hidden=!show||quick||chatTyping;quickStrip.hidden=!show||!quick||chatTyping||gameRunning;
    dock.hidden=!show||pr.chatOpen;
    battleDock.hidden=!show||!quick||!gameRunning||pr.chatOpen;
    if(quick&&gameRunning&&show){
      document.getElementById('gmwwPlayerTopMenu')?.classList.remove('is-idle-hidden');
      renderQuickBattleDock(battleDock,(pr.own&&inOwnRoom()?pr.state?.room:state?.room)||{});
      dock.hidden=true;
    }
    if(!show)return;
    const now=stripNow(),idx=ORDER.indexOf(now),sroot=strip.shadowRoot;
    if(!quick)sroot.querySelectorAll('#playSetupStrip button').forEach(b=>{
      const k=b.dataset.playStep||'room',i=ORDER.indexOf(k);
      b.classList.toggle('active',i===idx);b.classList.toggle('done',i<idx);
      if(i===idx)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current');
    });
    const room=(pr.own&&inOwnRoom()?pr.state?.room:state?.room)||{};
    const qkey=quickSteps().some(s=>s[0]===pr.view)?pr.view:(!state?.roomCode?'lobby':'room');
    const qsteps=quickSteps();
    if(quick){const qnav=quickStrip.shadowRoot.getElementById('quickSetupStrip'),cols='repeat('+qsteps.length+',minmax(0,1fr))';if(qnav.style.gridTemplateColumns!==cols)qnav.style.gridTemplateColumns=cols}
    if(quick)quickStrip.shadowRoot.querySelectorAll('#quickSetupStrip button').forEach(b=>{
      b.hidden=!qsteps.some(s=>s[0]===b.dataset.quickStep);
      const i=QUICK_ORDER.findIndex(s=>s[0]===b.dataset.quickStep),active=b.dataset.quickStep===qkey;
      b.classList.toggle('active',active);b.classList.toggle('done',i<QUICK_ORDER.findIndex(s=>s[0]===qkey));
      if(active)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current');
    });
    const root=dock.shadowRoot,title=root.getElementById('playPhaseTitle'),hint=root.getElementById('playPhaseHint'),
      owner=!!(pr.own&&inOwnRoom()),nxt=ORDER[idx+1],label=(owner||!state?.roomCode)&&nxt?LABEL[nxt]:(LABEL[now]||'SẢNH CHỜ'),
      h=!state?.roomCode?'CHẠM ĐỂ VÀO PHÒNG':!owner?'CHỦ PHÒNG ĐIỀU HÀNH':now==='battle'?'ĐANG CHƠI':'CHẠM ĐỂ TIẾP';
    const qi=qsteps.findIndex(s=>s[0]===qkey),qlast=qi===qsteps.length-1&&qsteps.length<QUICK_ORDER.length&&!!state?.roomCode,qnext=qsteps[Math.min(qsteps.length-1,qi+1)];
    // Nút giữa luôn ghi tên BƯỚC TIẾP THEO (Sảnh Chờ → Tạo Phòng → Ván Mẫu → Bắt Đầu).
    const shownLabel=quick?(String(room.phase||'').toLowerCase()==='running'?'ĐANG CHƠI':(qlast?'CHỜ CHỦ PHÒNG':(qnext?.[1]||'Tạo Phòng').toUpperCase())):label;
    const shownHint=quick?(!state?.roomCode?'CHẠM ĐỂ TẠO/VÀO PHÒNG':qlast?'CHỦ PHÒNG ĐIỀU HÀNH':'CHẠM ĐỂ TIẾP'):h;
    if(title.textContent!==shownLabel)title.textContent=shownLabel;if(hint.textContent!==shownHint)hint.textContent=shownHint;
    root.getElementById('playEndGame').style.opacity=owner&&now==='battle'?'1':'.35';
  }
  const renderDock=renderChrome,renderBar=renderChrome;
  async function joinByCode(code){
    code=String(code||'').trim().toUpperCase();
    if(!/^[A-Z0-9]{4,8}$/.test(code)){say('Hãy nhập mã phòng (4–8 ký tự).');return}
    state.lastJoinError=null;
    const ok=await window.joinRoom(code);
    if(ok===false){
      const err=state.lastJoinError||{},c=String(err.code||'');
      say(c==='ROOM_NOT_FOUND'||err.status===404?'Không tìm thấy phòng '+code+'. Hãy kiểm tra lại mã.':(c==='ROOM_IN_PROGRESS'?'Ván đang chơi, không vào giữa trận được.':(err.message&&err.message!==c?err.message:'Không vào được phòng '+code+'.')));return}
    pr.joinCode='';pr.open=false;try{await enterVillage()}catch(_){}render();
  }
  function injectCreateButtons(){renderChrome()}
  function mount(){
    if(!state?.token||!state?.member?.loginId)return;
    injectCreateButtons();
    if(pr.mounted)return;pr.mounted=true;
    document.head.appendChild(el('style',null,'#gmwwSetupTop3{display:none!important}'
      +'#gmwwOwnerDock{position:fixed;left:calc(var(--gmww-player-visible-left,0px) + 8px);right:auto;width:calc(var(--gmww-player-visible-width,100vw) - 16px);top:calc(var(--gmww-player-visible-top,0px) + var(--gmww-player-visible-height,100dvh) - max(8px,env(safe-area-inset-bottom,0px)));bottom:auto;transform:translateY(-100%);box-sizing:border-box;z-index:9650}#gmwwOwnerDock[hidden]{display:none}'
      +'#gmwwStageStrip{position:fixed;left:var(--gmww-player-visible-left,0px);right:auto;top:var(--gmww-player-visible-top,0px);width:var(--gmww-player-visible-width,100vw);max-width:100vw;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);z-index:9650}#gmwwStageStrip[hidden]{display:none}' 
      +'#gmwwQuickStageStrip{position:fixed;left:calc(var(--gmww-player-visible-left,0px) + 8px);right:auto;top:calc(var(--gmww-player-visible-top,0px) + 6px);width:calc(var(--gmww-player-visible-width,100vw) - 16px);max-width:100vw;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);z-index:9650;background:transparent}#gmwwQuickStageStrip[hidden]{display:none}'
      +'body>#gmwwChatPanel{display:none!important}.gmww-pr-chatbody{display:flex;flex:1 1 auto;min-height:0;flex-direction:column;overflow:hidden;padding:8px 10px 10px!important}.gmww-pr-chatbody #gmwwChatPanel{position:relative!important;inset:auto!important;transform:none!important;width:100%!important;max-width:none!important;height:100%!important;max-height:100%!important;min-height:0!important;margin:0!important;display:flex!important;flex-direction:column!important}'
      +'.gmww-pr-chatpage{min-height:0!important;overflow:hidden!important}.gmww-pr-chatpage #gmwwChatLines{display:block!important;flex:1 1 auto!important;height:auto!important;max-height:none!important;min-height:0!important;overflow-y:auto!important}.gmww-pr-chatpage #gmwwChatForm{display:flex!important;flex:0 0 auto!important;min-height:48px!important}.gmww-pr-chatpage #gmwwChatPanel header,.gmww-pr-chatpage #gmwwVillageTicker{flex:0 0 auto!important}'
      +'#gmwwOnlineFooter{display:none!important}#gmwwGameViewTabs{bottom:calc(86px + env(safe-area-inset-bottom))!important}'
      +'.gmww-pr-ctl{display:flex;align-items:center;gap:6px;flex-shrink:0}.gmww-pr-ctl b{min-width:20px;text-align:center}.gmww-pr-order{min-width:18px;text-align:center;opacity:.75}.gmww-pr-panel button.gmww-pr-step{padding:0;width:32px;height:32px;border-radius:50%;font-size:18px;line-height:1}.gmww-pr-tpldetail{display:block;max-width:62vw;white-space:normal!important;line-height:1.35;opacity:.78}'
      +'.gmww-pr-roomrow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px;border-radius:12px;border:1px solid #4fc3f7!important;background:#0b3a5e!important;color:#e8f6ff;text-align:left}.gmww-pr-roomrow div{display:flex;flex-direction:column;gap:2px;min-width:0}.gmww-pr-roomrow small{opacity:.75;font-weight:500}.gmww-pr-roomrow span{font-size:24px}'
