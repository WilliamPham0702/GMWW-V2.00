(()=>{
'use strict';
const GMWW_SERVER_MENU={"markup":"<section class=\"play-setup-strip gm-stage-timeline-v330\" id=\"playSetupStrip\" aria-label=\"Luồng vào trận\">\n          <button class=\"active\" data-play-step=\"lobby\" type=\"button\"><span>1</span><b>Sảnh chờ</b></button>\n          <button data-play-step=\"seats\" type=\"button\"><span>2</span><b>Tập hợp</b></button>\n          <button data-play-step=\"game\" type=\"button\"><span>3</span><b>Ván Mẫu</b></button>\n          <button data-play-step=\"roles\" type=\"button\"><span>4</span><b>Phân Vai</b></button>\n          <button data-play-step=\"deal\" type=\"button\"><span>5</span><b>Phát Vai</b></button>\n          <button data-play-step=\"battle\" type=\"button\"><span>6</span><b>Vào Trận</b></button>\n        </section><section id=\"playBattleTop\" class=\"play-battle-top\" aria-label=\"Điều khiển trong trận\" hidden>\n          <button id=\"battleBack\" type=\"button\" aria-label=\"Lượt trước\" title=\"Lượt trước\"><b>&lt;Đêm 1</b></button>\n          <div id=\"battleTimeline\" class=\"play-battle-timeline\" aria-label=\"Thứ tự gọi vai trò\" role=\"list\"></div>\n          <button id=\"battleAdvance\" type=\"button\" aria-label=\"Tiếp tục\" title=\"Tiếp tục\"><b>Ngày 1&gt;</b></button>\n        </section>","css":":host{--gmww-stage-glass-v330:linear-gradient(155deg,rgba(5,39,58,.61),rgba(7,69,87,.51));--gmww-stage-glass-border-v330:rgba(188,240,248,.43);--gmww-stage-glass-shadow-v330:0 9px 25px rgba(0,22,34,.24),inset 0 1px rgba(255,255,255,.14);}.play-setup-strip{display:grid;grid-template-columns:repeat(6,1fr);gap:3px;padding:3px 1px}\n.play-setup-strip button{border:0;background:transparent;color:rgba(227,253,255,.7);padding:2px 0;min-width:0;text-align:center}\n.play-setup-strip span{width:22px;height:22px;margin:auto;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.34);background:rgba(4,108,139,.33);font-size:8px;font-weight:1000}\n.play-setup-strip b{display:block;margin-top:2px;font-size:6.6px;line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.play-setup-strip button.active span{background:linear-gradient(145deg,#fff6b0,#f4ca65);color:#745d13;border-color:#fff8ce;box-shadow:0 0 13px rgba(255,240,143,.45)}\n.play-setup-strip button.active b{color:#fff7c9}\n.play-setup-strip button.done span{background:#57ddc6;color:#fff}\n.play-shell[data-phase=\"night\"] .play-setup-strip button{color:#b7d9e6}\n:host .play-setup-strip{display:none!important}\n.play-setup-strip{display:none!important}\n:host #start .play-shell[data-step=\"lobby\"] .play-setup-strip,\n:host #start .play-shell[data-step=\"room\"] .play-setup-strip{\n  display:grid!important;position:absolute!important;z-index:44!important;\n  top:calc(env(safe-area-inset-top) + 76px)!important;left:8px!important;right:8px!important;\n  grid-template-columns:repeat(6,minmax(0,1fr))!important;column-gap:2px!important;\n  padding:5px 3px!important;border:1px solid rgba(216,255,255,.3)!important;\n  border-radius:14px!important;background:rgba(2,40,57,.75)!important;\n  box-shadow:0 4px 18px rgba(0,23,34,.23)!important;\n}\n:host #start .play-shell[data-step=\"lobby\"] .play-setup-strip button,\n:host #start .play-shell[data-step=\"room\"] .play-setup-strip button{\n  min-width:0!important;min-height:37px!important;padding:2px 0!important;\n}\n:host #start .play-setup-strip span{width:20px;height:20px;font-size:9px}\n:host #start .play-setup-strip b{font-size:7px;line-height:1.1;white-space:normal}\n:host #start #playSetupStrip.play-setup-strip,\n:host #start .play-shell[data-step=\"lobby\"] #playSetupStrip,\n:host #start .play-shell[data-step=\"room\"] #playSetupStrip{\n display:grid!important;position:absolute!important;z-index:96!important;\n top:calc(env(safe-area-inset-top) + 10px)!important;bottom:auto!important;\n left:9px!important;right:9px!important;width:auto!important;max-width:900px!important;margin:0 auto!important;\n grid-template-columns:repeat(6,minmax(0,1fr))!important;gap:2px!important;align-items:center!important;\n min-height:62px!important;padding:7px 5px!important;border-radius:17px!important;\n border:1px solid rgba(186,240,250,.39)!important;\n background:linear-gradient(155deg,rgba(5,39,58,.64),rgba(7,69,87,.54))!important;\n box-shadow:0 7px 23px rgba(0,22,34,.18),inset 0 1px 0 rgba(255,255,255,.13)!important;\n backdrop-filter:blur(13px) saturate(145%)!important;-webkit-backdrop-filter:blur(13px) saturate(145%)!important;\n transition:opacity .25s ease,transform .3s ease!important;\n}\n:host #start #playSetupStrip.play-setup-strip.is-auto-hidden{\n opacity:0!important;pointer-events:none!important;\n transform:translateY(calc(-100% - env(safe-area-inset-top) - 18px))!important;\n}\n:host #start #playSetupStrip.play-setup-strip>button{\n display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;\n min-width:0!important;min-height:44px!important;padding:3px 1px!important;touch-action:manipulation!important;\n border:0!important;border-radius:11px!important;background:transparent!important;color:#d5edf5!important;\n}\n:host #start #playSetupStrip.play-setup-strip button.active{\n color:#fff2bc!important;background:rgba(255,233,159,.09)!important;\n}\n:host #start #playSetupStrip.play-setup-strip span{\n width:24px!important;height:24px!important;font-size:11px!important;border:1px solid rgba(200,243,248,.5)!important;\n}\n:host #start #playSetupStrip.play-setup-strip button.active span{\n color:#6b531c!important;background:linear-gradient(145deg,#fff8ba,#e9bd62)!important;\n box-shadow:0 0 13px rgba(255,234,150,.48)!important;\n}\n:host #start #playSetupStrip.play-setup-strip button.done span{\n background:rgba(74,188,174,.75)!important;color:#fff!important;\n}\n:host #start #playSetupStrip.play-setup-strip b{\n display:block!important;max-width:100%!important;margin-top:4px!important;\n font-size:9px!important;line-height:1.13!important;font-weight