tant;\n}\n:host #start #playSetupStrip.gm-stage-timeline-v330{\n top:calc(env(safe-area-inset-top) + 9px)!important;\n min-height:64px!important;max-width:760px!important;\n border-radius:17px!important;\n}\n:host #start #gmTopMenu.gm-stage-dock-v330>.gm-top-box-v293:focus-visible,\n:host #start #playSetupStrip.gm-stage-timeline-v330>button:focus-visible{\n outline:2px solid #ffedb0!important;outline-offset:2px!important;\n}\n@media(max-width:380px){:host #start #playSetupStrip.gm-stage-timeline-v330{left:7px!important;right:7px!important;gap:1px!important}\n}\n#playBattleTop[hidden],#playBattleDock[hidden],#battleRoster[hidden],#battlePending[hidden]{display:none!important}\n:host #start #playShell[data-step=\"battle\"] #playSetupStrip,\n:host #start #playShell[data-step=\"battle\"] #gmTopMenu,\n:host #start #playShell[data-step=\"battle\"] #playCardFan,\n:host #start #playShell[data-step=\"battle\"] .play-hud,\n:host #start #playShell[data-step=\"battle\"] .play-exit-village{display:none!important}\n#start #playBattleTop{position:absolute;top:calc(env(safe-area-inset-top) + 5px);left:7px;right:7px;z-index:95;display:grid;grid-template-columns:auto minmax(0,1fr) 42px;align-items:center;gap:5px;padding:7px 6px;border:1px solid #99ddea8c;border-radius:17px;background:#062f4aee;box-shadow:0 8px 22px #0014216b;color:#fff;pointer-events:auto}\n#start #playBattleTop>button{height:44px;min-width:42px;border:1px solid #bce9f477;border-radius:11px;background:#0b4d62;color:#fff;font-size:14px;font-weight:850;padding:0 7px}\n#start #playBattleTop #battleForceEnd{color:#ffd3c3;background:#653832}\n#start .play-battle-timeline{display:flex;align-items:center;gap:6px;overflow-x:auto;min-width:0;scrollbar-width:none;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;touch-action:pan-x}\n#start .play-battle-timeline::-webkit-scrollbar{display:none}\n#start .play-battle-step{display:flex;flex:none;align-items:center;gap:5px;max-width:190px;min-height:40px;border:1px soli