    #gmwwVillageShell{position:fixed!important;inset:0!important;z-index:0!important;width:100vw!important;height:100svh!important;min-height:100svh!important;border:0!important;border-radius:0!important;margin:0!important;box-shadow:none!important;background:#071426!important}
    #gmwwVillageFrame{width:100%!important;height:100%!important}
    #game .role-stage{position:fixed!important;z-index:66!important;left:50%!important;top:50%!important;transform:translate(-50%,-50%)!important;width:min(90vw,430px)!important;max-height:82svh!important;overflow:auto!important;margin:0!important;padding:8px!important;border-radius:20px;background:rgba(2,17,28,.80);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 22px 70px rgba(0,0,0,.5)}
    #game .role-stage[hidden]{display:none!important}
    #gmwwRoomSetup{position:fixed;inset:0;z-index:82;display:none;pointer-events:none}
    #gmwwRoomSetup.open{display:block}
    #gmwwRoomSetup .setup-top{position:absolute;left:50%;top:calc(max(58px,env(safe-area-inset-top) + 52px));transform:translateX(-50%);width:min(94vw,520px);padding:9px 12px;border:1px solid rgba(255,238,172,.55);border-radius:14px;background:rgba(3,34,50,.76);backdrop-filter:blur(12px);color:#fff;text-align:center;pointer-events:auto}
    #gmwwRoomSetup .setup-top b{display:block;color:#fff0a7;font-size:13px}.setup-top small{font-size:9px;color:#c9edf5}
    #gmwwRoomSetup .character-tray{position:absolute;left:8px;right:8px;bottom:calc(max(8px,env(safe-area-inset-bottom)) + 68px);z-index:2;display:grid;grid-auto-flow:column;grid-template-rows:repeat(2,minmax(82px,1fr));grid-auto-columns:72px;gap:7px;max-height:190px;overflow-x:auto;overflow-y:hidden;padding:9px;border:1px solid rgba(225,241,255,.34);border-radius:18px;background:rgba(2,25,40,.78);backdrop-filter:blur(10px);pointer-events:auto;scroll-snap-type:x proximity}
    #gmwwRoomSetup.choose-seat .character-tray{display:none}
    #gmwwSelectedCharacterChip{display:none;position:absolute;left:10px;bottom:calc(max(8px,env(safe-area-inset-bottom)) + 70px);z-index:3;width:76px;padding:5px;border:1px solid rgba(255,232,145,.6);border-radius:14px;background:rgba(2,30,45,.78);backdrop-filter:blur(8px);pointer-events:auto;color:#fff;text-align:center}
    #gmwwRoomSetup.choose-seat #gmwwSelectedCharacterChip{display:block}
    #gmwwSelectedCharacterChip img{display:block;width:64px;height:82px;object-fit:contain;margin:auto;filter:drop-shadow(0 5px 5px rgba(0,0,0,.45))}
    #gmwwSelectedCharacterChip small{display:block;font-size:8px;font-weight:900;color:#ffe99d}
    .gmww-character-choice{position:relative;aspect-ratio:.76;border:1px solid rgba(183,226,239,.25);border-radius:13px;overflow:hidden;background:rgba(6,44,62,.86);padding:0;scroll-snap-align:start}
    .gmww-character-choice img{width:100%;height:100%;object-fit:contain;display:block}.gmww-character-choice span{position:absolute;left:3px;right:3px;bottom:3px;padding:2px;border-radius:7px;background:rgba(1,19,29,.72);color:#fff;font-size:7px;font-weight:900;text-align:center}
    .gmww-character-choice.selected{border:2px solid #ffe48d;box-shadow:0 0 0 2px rgba(255,228,141,.24),0 0 22px rgba(255,220,95,.35)}
    .gmww-character-choice.taken{opacity:.32;filter:grayscale(.8)}
    #avatarSuggestions [data-gmww-avatar^="character-"] img,#avatarLibraryGrid [data-gmww-avatar^="character-"] img{filter:drop-shadow(0 6px 5px rgba(0,0,0,.24))}
    #gmwwRoomSetup .setup-actions{position:absolute;left:8px;right:8px;bottom:max(8px,env(safe-area-inset-bottom));display:grid;grid-template-columns:1fr 1.5fr;gap:7px;pointer-events:auto}
    #gmwwRoomSetup .setup-actions button,#gmwwVillageReadyDock button{min-height:52px;border-radius:14px;border:1px solid rgba(255,255,255,.26);font-weight:1000;color:white}
    #gmwwSetupCancel{background:rgba(4,42,59,.82)}#gmwwSetupConfirm{background:linear-gradient(135deg,#0caec9,#3ad2b6)}#gmwwSetupConfirm:disabled{opacity:.45;filter:grayscale(.6)}
    #gmwwVillageReadyDock{position:fixed;z-index:76;left:8px;right:8px;bottom:max(8px,env(safe-area-inset-bottom));display:none;grid-template-columns:minmax(0,1fr) auto auto;gap:7px;align-items:center;padding:7px;border-radius:17px;border:1px solid rgba(255,255,255,.28);background:rgba(2,29,44,.76);backdrop-filter:blur(14px);color:#fff}
    #gmwwVillageReadyDock.show{display:grid}#gmwwVillageReadyDock .who{min-width:0;padding-left:5px}#gmwwVillageReadyDock .who b{display:block;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#fff2ad}#gmwwVillageReadyDock .who small{display:block;font-size:8px;color:#b8e4ec}
    #gmwwVillageReadyDock button{padding:0 12px;background:#0a5169;font-size:9px}#gmwwVillageReadyDock .seat{background:#135c72;color:#e8fbff}#gmwwVillageReadyDock .ready{background:linear-gradient(135deg,#11b8d0,#3bd1b5)}#gmwwVillageReadyDock .ready.on{background:linear-gradient(135deg,#2eb875,#56d698)}
    @media(max-width:390px){#gmwwRoomSetup .character-tray{grid-auto-columns:66px;grid-template-rows:repeat(2,minmax(76px,1fr));max-height:176px}#gmwwVillageReadyDock{grid-template-columns:minmax(0,1fr) auto auto;gap:4px}#gmwwVillageReadyDock button{padding:0 6px;font-size:8px}#gmwwVillageReadyDock .leave{display:block}}
  `;document.head.appendChild(st)
}
async function loadGameCharacters(){
  if(state.gameCharacters.length)return state.gameCharacters;
  try{const d=await api('/api/game-characters');state.gameCharacters=Array.isArray(d?.characters)?d.characters.map(c=>({...c,imageUrl:c.imageUrl||gameCharacterImageUrl(c.id)})):[]}catch(e){state.gameCharacters=[];console.warn('[GMWW characters]',e)}
  return state.gameCharacters
}
function gameCharacterFrameUrl(id,frame=1){const f=Math.max(1,Math.min(6,Number(frame)||1));return '/api/game-characters/'+encodeURIComponent(id)+'/image?rev=c40-4'}
function gameCharacterImageUrl(id){return gameCharacterFrameUrl(id,1)}
function ensureCharacterPreviewTicker(){if(state.characterPreviewTimer)return;state.characterPreviewTimer=setInterval(()=>{const frame=(Math.floor(performance.now()/115)%6)+1;$$('img[data-gmww-walk-character]').forEach(img=>{const id=img.dataset.gmwwWalkCharacter;if(!id)return;const key=id+':c40-1';if(img.dataset.gmwwWalkFrame===key)return;img.dataset.gmwwWalkFrame=key;img.src=gameCharacterFrameUrl(id,frame)})},1200)}
const LOBBY_MOTION_HOLD_MS=1400;
function lobbyMotionEnabled(){return state.member?.lobbyMotionEnabled!==false}
function currentVillageLobbyPlayer(){const id='member:'+String(state.member?.loginId||'');return state.lobbyPlayers.find(p=>String(p?.participantId||'')===id)||null}
function currentLobbyMotionPlayer(){return state.roomCode?currentRoomPlayer():currentVillageLobbyPlayer()}
function lobbyMotionEligible(){
  if(!state.member||!lobbyMotionEnabled()||document.hidden||state.lobbyMotionPaused||Date.now()<Number(state.lobbyManualUntil||0))return false;
  const p=currentLobbyMotionPlayer();if(!p||p.movementStatus==='moving'&&p.moveTargetSeatId)return false;
  if(state.roomCode){const phase=String(state.room?.phase||'lobby').toLowerCase();return ['lobby','waiting','role_delivery'].includes(phase)&&!state.room?.seatsLocked&&!Number(p?.seatId||0)}
  return true
}
function lobbyMotionHash(v){let h=2166136261;for(const ch of String(v||'')){h^=ch.charCodeAt(0);h=Math.imul(h,16777619)}return h>>>0}
function lobbyRandomPoint(){
  const base=[[29,39],[49,35.5],[70,39],[81,53],[74,69],[62,82],[42,85],[27,76],[17,58]],p=base[Math.floor(Math.random()*base.length)],jx=(Math.random()-.5)*8,jy=(Math.random()-.5)*6;
  return{x:p[0]+jx,y:p[1]+jy}
}
function buildLobbyMotionRoute(){return[lobbyRandomPoint()]}
function clearLobbyMotionTimer(){if(state.lobbyMotionTimer){clearTimeout(state.lobbyMotionTimer);state.lobbyMotionTimer=null}}
function resetLobbyMotionPlan(){state.lobbyMotionWaypoints=[];state.lobbyMotionIndex=0;state.lobbyMotionPhase='roam';state.lobbyMotionHoldUntil=0}
function scheduleLobbyMotion(delay=500){clearLobbyMotionTimer();if(!state.member||!lobbyMotionEnabled())return;state.lobbyMotionTimer=setTimeout(runLobbyMotionStep,Math.max(120,Number(delay)||500))}
function holdLobbyMotionForManualWalk(){
  state.lobbyManualUntil=Date.now()+30000;clearLobbyMotionTimer();resetLobbyMotionPlan();scheduleLobbyMotion(30000);
}
function pauseLobbyMotionForSeat(){state.lobbyMotionPaused=true;clearLobbyMotionTimer();resetLobbyMotionPlan()}
function resumeLobbyMotion(){state.lobbyMotionPaused=false;resetLobbyMotionPlan();scheduleLobbyMotion(350)}
async function performLobbyAutoMove(point){
  if(!point||!lobbyMotionEligible())return false;
  try{
    if(state.roomCode){
      const p=currentRoomPlayer();if(!p||p.movementStatus==='moving'||p.seatId)return false;
      const origin=movementViewerPosition(),d=await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/move',{method:'POST',headers:auth(),body:JSON.stringify({x:Number(point.x),y:Number(point.y),fromX:origin.x,fromY:origin.y,autoMotionPhase:'roam'})});
      if(d?.room)state.room=d.room;if(Array.isArray(d?.players))state.players=d.players;syncVillageFrame();scheduleMovementCompletion(currentRoomPlayer());return true
    }
    const d=await api('/api/village/move',{method:'POST',headers:auth(),body:JSON.stringify({x:Number(point.x),y:Number(point.y),autoMotionPhase:'roam'})});state.lobbyPlayers=d.players||state.lobbyPlayers;syncVillageFrame();return true
  }catch(e){console.warn('[GMWW lobby motion]',e);return false}
}
async function runLobbyMotionStep(){
  state.lobbyMotionTimer=null;
  if(!state.member||!lobbyMotionEnabled())return;
  const p=currentLobbyMotionPlayer();
  if(!lobbyMotionEligible()){if(p?.seatId)resetLobbyMotionPlan();scheduleLobbyMotion(document.hidden?5000:2200);return}
  if(p?.movementStatus==='moving'){if(state.roomCode)scheduleMovementCompletion(p);scheduleLobbyMotion(700);return}
  if(state.lobbyMotionPhase==='gather'){
    state.lobbyMotionPhase='hold';state.lobbyMotionHoldUntil=Date.now()+LOBBY_MOTION_HOLD_MS;scheduleLobbyMotion(LOBBY_MOTION_HOLD_MS);return
  }
  if(state.lobbyMotionPhase==='hold'){
    const remain=state.lobbyMotionHoldUntil-Date.now();if(remain>0){scheduleLobbyMotion(remain);return}
    resetLobbyMotionPlan()
  }
  if(!state.lobbyMotionWaypoints.length){state.lobbyMotionWaypoints=buildLobbyMotionRoute();state.lobbyMotionIndex=0}
  const target=state.lobbyMotionWaypoints[0];state.lobbyMotionPhase='gather';const ok=await performLobbyAutoMove(target);scheduleLobbyMotion(ok?650:1600)
}
function ensureLobbyMotionToggle(){
  const profile=$('#profile');if(!profile||!state.member)return null;let row=$('#profileLobbyMotionRow');
  if(!row){row=document.createElement('div');row.id='profileLobbyMotionRow';row.innerHTML='<div class="motion-copy"><b>Di chuyển trong sảnh</b><small>Tự đi ngẫu nhiên trong Làng, dừng một lát rồi tiếp tục di chuyển. Không ngồi.</small></div><button id="profileLobbyMotionToggle" type="button" role="switch" aria-label="Di chuyển trong sảnh"></button>';const anchor=profile.querySelector('.section-title')||profile.querySelector('.history-fold');if(anchor)anchor.parentNode.insertBefore(row,anchor);else profile.appendChild(row);row.querySelector('button').onclick=()=>setLobbyMotionEnabled(!lobbyMotionEnabled())}
  const toggle=row.querySelector('button'),enabled=lobbyMotionEnabled();if(toggle){toggle.setAttribute('aria-checked',enabled?'true':'false');toggle.title=enabled?'Đang bật':'Đang tắt'}return row
}
async function setLobbyMotionEnabled(enabled){
  if(!state.member)return;enabled=!!enabled;const previous=state.member.lobbyMotionEnabled!==false;state.member.lobbyMotionEnabled=enabled;ensureLobbyMotionToggle();localStorage.setItem('gmww_member',JSON.stringify(state.member));
  if(enabled)resumeLobbyMotion();else{state.lobbyMotionPaused=false;clearLobbyMotionTimer();resetLobbyMotionPlan()}
  try{const d=await api('/api/members/profile',{method:'POST',headers:auth(),body:JSON.stringify({lobbyMotionEnabled:enabled})});if(d?.member){state.member=d.member;localStorage.setItem('gmww_member',JSON.stringify(state.member))}ensureLobbyMotionToggle();toast(enabled?'Đã bật di chuyển trong sảnh.':'Đã tắt di chuyển trong sảnh.')}
  catch(e){state.member.lobbyMotionEnabled=previous;localStorage.setItem('gmww_member',JSON.stringify(state.member));ensureLobbyMotionToggle();if(previous)resumeLobbyMotion();toast(e.message||'Không lưu được cài đặt di chuyển.')}
}
window.setLobbyMotionEnabled=setLobbyMotionEnabled;
function currentRoomPlayer(){return state.players.find(p=>String(p.participantId||'')===String(state.participantId||''))||null}
function roomSetupComplete(){const me=currentRoomPlayer();return !!(me?.setupComplete&&me?.gameCharacterId&&Number(me?.seatId||0)>0)}
function ensureRoomSetupUi(){
  ensureOnline2DStyle();let el=$('#gmwwRoomSetup');if(el)return el;
  el=document.createElement('div');el.id='gmwwRoomSetup';el.innerHTML='<div class="setup-top"><b>NHÂN VẬT CỐ ĐỊNH & VỊ TRÍ NGỒI</b><small id="gmwwSetupHint">Đang tải vị trí trong Làng…</small></div><div class="character-tray" id="gmwwCharacterTray"></div><button type="button" id="gmwwSelectedCharacterChip"><img alt=""><small>NHÂN VẬT CỦA BẠN</small></button><div class="setup-actions"><button type="button" id="gmwwSetupCancel">RỜI PHÒNG</button><button type="button" id="gmwwSetupConfirm" disabled>XÁC NHẬN VỊ TRÍ</button></div>';document.body.appendChild(el);
  $('#gmwwSetupCancel').onclick=()=>leaveRoom();$('#gmwwSetupConfirm').onclick=saveRoomSetup;return el
}
function renderRoomSetup(){
  const el=ensureRoomSetupUi(),tray=$('#gmwwCharacterTray'),me=currentRoomPlayer(),fixedCharacter=String(me?.gameCharacterId||state.member?.gameCharacterId||'');
  state.selectedGameCharacterId=fixedCharacter||state.selectedGameCharacterId;tray.innerHTML='';
  if(fixedCharacter){const ch=state.gameCharacters.find(x=>x.id===fixedCharacter),b=document.createElement('div');b.className='gmww-character-choice selected';b.innerHTML='<img alt=""><span></span>';b.querySelector('img').src=ch?.imageUrl||gameCharacterImageUrl(fixedCharacter);b.querySelector('span').textContent=ch?.name||fixedCharacter;tray.appendChild(b)}
  const hasCharacter=!!state.selectedGameCharacterId,walk=String(state.room?.seatMoveMode||'instant')==='walk',hint=$('#gmwwSetupHint'),chip=$('#gmwwSelectedCharacterChip'),moving=me?.movementStatus==='moving';
  el.classList.add('choose-seat');el.classList.remove('choose-character');
  if(chip){const img=chip.querySelector('img');if(img)img.src=hasCharacter?gameCharacterImageUrl(state.selectedGameCharacterId):''}
  if(hint){
    if(!hasCharacter)hint.textContent='Tài khoản chưa có Nhân Vật game cố định.';
    else if(moving&&me?.moveTargetSeatId)hint.textContent='Chibi đang đi tới vị trí '+me.moveTargetSeatId+'…';
    else if(moving)hint.textContent='Chibi đang đi trong Làng…';
    else if(walk)hint.textContent=(me?.seatId?'Đang ở vị trí '+me.seatId+' • Chạm dấu + khác để chibi đi đổi vị trí.':'Chạm trong Làng để đi lại • Chạm dấu + để chibi đi tới vị trí.');
    else hint.textContent='Chạm dấu + để chọn vị trí trực tiếp.'+(state.selectedSeatId?' • Đã chọn vị trí '+state.selectedSeatId:'');
  }
  const confirm=$('#gmwwSetupConfirm');if(confirm){confirm.hidden=walk;confirm.disabled=!hasCharacter||!state.selectedSeatId;confirm.textContent=state.selectedSeatId?'XÁC NHẬN VỊ TRÍ '+state.selectedSeatId:'CHỌN VỊ TRÍ TRÊN LÀNG'}
  el.classList.toggle('open',!!state.roomSetupOpen)
}
async function openRoomSetup(){
  state.roomSetupOpen=true;await loadGameCharacters();const me=currentRoomPlayer();state.selectedGameCharacterId=String(me?.gameCharacterId||state.member?.gameCharacterId||'');state.selectedSeatId=Number(me?.seatId||0)||Number(me?.moveTargetSeatId||0)||null;renderRoomSetup();syncVillageFrame();scheduleMovementCompletion(me)
}
function closeRoomSetup(){state.roomSetupOpen=false;$('#gmwwRoomSetup')?.classList.remove('open');syncVillageFrame()}
async function saveRoomSetup(){
  if(!state.roomCode||!state.selectedGameCharacterId||!state.selectedSeatId)return;
  if(String(state.room?.seatMoveMode||'instant')==='walk'){await startSeatWalk(state.selectedSeatId);return}
  const btn=$('#gmwwSetupConfirm');if(btn)btn.disabled=true;
  try{const d=await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/setup',{method:'POST',headers:auth(),body:JSON.stringify({seatId:state.selectedSeatId})});if(d?.room)state.room=d.room;if(Array.isArray(d?.players))state.players=d.players;else if(d?.player){const i=state.players.findIndex(p=>p.participantId===d.player.participantId);if(i>=0)state.players[i]=d.player;else state.players.push(d.player)}state.ready=false;closeRoomSetup();ensureVillageReadyDock();syncVillageFrame();toast('Đã chọn vị trí '+state.selectedSeatId)}
  catch(e){const code=String(e?.data?.error||'');if(code==='SEAT_TAKEN')state.selectedSeatId=null;toast(e.message);renderRoomSetup()}
  finally{if(btn)btn.disabled=!state.selectedGameCharacterId||!state.selectedSeatId}
}
function movementViewerPosition(){
  const me=currentRoomPlayer();return{x:Number(me?.positionX??me?.moveToX??50)||50,y:Number(me?.positionY??me?.moveToY??78)||78}
}
async function startVillageMove({x,y,seatId=null,fromX=null,fromY=null}={}){
  if(!state.roomCode||state.room?.seatsLocked)return;
  const me=currentRoomPlayer();if(!me)return;
  const origin=movementViewerPosition(),validCoord=v=>v!==null&&v!==undefined&&v!==''&&Number.isFinite(Number(v)),payload={x:Number(x),y:Number(y),fromX:validCoord(fromX)?Number(fromX):origin.x,fromY:validCoord(fromY)?Number(fromY):origin.y};if(seatId)payload.seatId=Number(seatId);
  try{const d=await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/move',{method:'POST',headers:auth(),body:JSON.stringify(payload)});if(d?.room)state.room=d.room;if(Array.isArray(d?.players))state.players=d.players;state.selectedSeatId=seatId?Number(seatId):null;renderRoomSetup();syncVillageFrame();scheduleMovementCompletion(currentRoomPlayer())}
  catch(e){if(String(e?.data?.error||'')==='SEAT_TAKEN')state.selectedSeatId=null;toast(e.message);renderRoomSetup();syncVillageFrame()}
}
async function startSeatWalk(seatId,x=null,y=null){
  const n=Number(seatId||0);if(!n)return;state.selectedSeatId=n;renderRoomSetup();syncVillageFrame();
  if(x===null||x===undefined||x===''||y===null||y===undefined||y===''||!Number.isFinite(Number(x))||!Number.isFinite(Number(y))){try{$('#gmwwVillageFrame')?.contentWindow?.postMessage({type:'gmww:seat-position-request',seatId:n},location.origin)}catch{};return}
  pauseLobbyMotionForSeat();const me=currentRoomPlayer();if(me?.movementStatus==='moving'){state.lobbySeatWalkPending={seatId:n,x:Number(x),y:Number(y)};return}
  state.lobbySeatWalkPending=null;await startVillageMove({x,y,seatId:n})
}
async function startFreeWalk(x,y){const me=currentRoomPlayer();if(me?.seatId||state.room?.seatsLocked)return;holdLobbyMotionForManualWalk();await startVillageMove({x,y})}
function clearMovementCompletionTimer(){if(state.movementCompleteTimer){clearTimeout(state.movementCompleteTimer);state.movementCompleteTimer=null}}
function scheduleMovementCompletion(player=currentRoomPlayer()){
  clearMovementCompletionTimer();if(!player||player.movementStatus!=='moving'||!player.moveId)return;
  const due=Number(player.moveStartedAt||0)+Math.max(1,Number(player.moveDurationMs||1)),wait=Math.max(40,due-Date.now()+60),moveId=String(player.moveId);state.movementCompleteTimer=setTimeout(()=>completeVillageMove(moveId),wait)
}
async function completeVillageMove(moveId){
  const me=currentRoomPlayer();if(!state.roomCode||!moveId||String(me?.moveId||'')!==String(moveId))return;
  try{const d=await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/move/complete',{method:'POST',headers:auth(),body:JSON.stringify({moveId})});if(d?.room)state.room=d.room;if(Array.isArray(d?.players))state.players=d.players;const next=currentRoomPlayer();state.selectedSeatId=Number(next?.seatId||next?.moveTargetSeatId||0)||null;state.ready=!!next?.ready;if(next?.setupComplete){state.lobbySeatWalkPending=null;closeRoomSetup();ensureVillageReadyDock()}else renderRoomSetup();syncVillageFrame();if(!next?.seatId&&state.lobbySeatWalkPending){const q=state.lobbySeatWalkPending;state.lobbySeatWalkPending=null;setTimeout(()=>startSeatWalk(q.seatId,q.x,q.y),120)}else if(!next?.seatId&&!state.lobbyMotionPaused)scheduleLobbyMotion(420)}
  catch(e){if(String(e?.data?.error||'')==='MOVE_NOT_ARRIVED'){state.movementCompleteTimer=setTimeout(()=>completeVillageMove(moveId),Math.max(80,Number(e?.data?.remainingMs||180)));return}toast(e.message);renderRoomSetup()}
}
function ensureVillageReadyDock(){
  // The player seat/ready state belongs in the existing top information box.
  const d=$('#gmwwVillageReadyDock');if(d)d.remove();
  const me=currentRoomPlayer();if(state.participantId&&me)state.ready=!!me.ready;
  updatePlayerTopMenu();
  return null;
}
function syncPlayerSetupState(){
  const me=currentRoomPlayer();if(!state.participantId||!me)return;
  if(state.roomSetupOpen)closeRoomSetup();ensureVillageReadyDock();syncVillageFrame()
}
function ensureVillageGameView(){
  ensureOnline2DStyle();const game=$('#game'),roleStage=game?.querySelector('.role-stage');if(!game||!roleStage)return null;
  if(!$('#gmwwVillageHostStyle')){
    const st=document.createElement('style');st.id='gmwwVillageHostStyle';st.textContent=
      '#gmwwGameViewTabs button{border:1px solid #52779b;background:#0b2033;color:#d9ecff;font-weight:900}'+
      '#gmwwGameViewTabs button.active{border-color:#e2ad52;background:linear-gradient(#b87626,#74400f);color:#fff7dc;box-shadow:0 0 0 1px #f4ce7a55 inset}'+
      '#gmwwVillageShell{overflow:hidden;background:#071426}'+
      '#gmwwVillageFrame{display:block;border:0;background:#071426}'+
      '#gmwwVillagePerfBadge{position:absolute;right:8px;bottom:8px;z-index:3;padding:5px 7px;border-radius:8px;background:#02111ddb;color:#ccecff;border:1px solid #5d8faa88;font:700 10px/1.2 monospace;pointer-events:none}';
    document.head.appendChild(st);
  }
  // Cards open directly; no redundant village / role navigation panel.
  $('#gmwwGameViewTabs')?.remove();
  let shell=$('#gmwwVillageShell');
  if(!shell){
    shell=document.createElement('div');shell.id='gmwwVillageShell';shell.className='gmww-game-pane';
    const iframe=document.createElement('iframe');iframe.id='gmwwVillageFrame';iframe.title='Ngôi làng GMWW';iframe.loading='eager';iframe.referrerPolicy='same-origin';iframe.src='/village/?embed=1&v=3201';
    shell.appendChild(iframe);roleStage.parentNode.insertBefore(shell,roleStage);
    iframe.addEventListener('load',()=>syncVillageFrame(true),{passive:true});
  }
  if(!shell.dataset.initialized){shell.dataset.initialized='1';setGameViewPane('village',{persist:false})}
  if(!state.role||!playerScenePolicy(state.room).rolesReleased)setGameViewPane('village',{persist:false});
  syncVillageFrame();return shell;
}
function setGameViewPane(pane,{persist=true}={}){
  pane=pane==='role'&&state.role&&playerScenePolicy(state.room).rolesReleased?'role':'village';
  const shell=$('#gmwwVillageShell'),role=$('#game .role-stage');if(!shell||!role)return;
  shell.hidden=false;role.hidden=pane!=='role';$('#game')?.classList.toggle('gmww-card-expanded',pane==='role');
  const mini=$('#gmwwPlayerMiniCards');if(mini)mini.hidden=pane==='role';
  const roleBackdrop=$('#gmwwPlayerRoleBackdrop'),roleReturn=$('#gmwwPlayerRoleReturn');
  const roleExpanded=pane==='role';
  if(roleBackdrop)roleBackdrop.hidden=!roleExpanded;
  if(roleReturn)roleReturn.hidden=!roleExpanded;
  if(persist)try{sessionStorage.setItem('gmww_game_pane_v1',pane)}catch{}
  if(pane==='village')syncVillageFrame();
}
// Sói GM retired in V3.143; online/offline presence is preserved.
async function refreshGmPresence(){try{const d=await api('/api/gm-presence');state.gmPresence=d?.gm||null;syncVillageFrame()}catch{}}
function startGmPresencePoll(){if(state.gmPresencePoll)return;state.gmPresencePoll=setInterval(()=>{if(state.member&&!document.hidden)refreshGmPresence()},2500)}
let gmwwVillageLastFrame=null,gmwwVillageLastSignature='';
function villageSceneSignature(payload){
  // The server clock offset can drift slightly every heartbeat without changing the scene.
  const setup=payload?.setup||{};
  return JSON.stringify([payload?.room||{},payload?.cycle||{},{...setup,clockOffsetMs:0},payload?.players||[]]);
}
function syncVillageFrame(force=false){
  const iframe=$('#gmwwVillageFrame');if(!iframe?.contentWindow||!state.member)return;
  const room=state.room||{},cycle=state.villageCycle||{},cyclePhase=String(cycle.phase||room.cyclePhase||'').toLowerCase(),cycleNight=Number(cycle.night||room.cycleNight||0);
  const portal=null;
  const publicPlayers=villagePublicPlayers(state.roomCode?state.players:state.lobbyPlayers);
  const playerView=playerScenePolicy(room);
  const payload={type:'gmww:village-state',portal,room:{playerSceneMode:playerView.mode,code:String(room.code||state.roomCode||'').slice(0,16),roomName:String(room.roomName||'').slice(0,100),phase:String(room.phase||'').slice(0,32),gmStage:String(room.gmStage||'').slice(0,20),gmStageRevision:Number(room.gmStageRevision||0),status:String(room.status||'').slice(0,32),roomMode:String(room.roomMode||'online'),enabled:room.enabled!==false,seatsLocked:!!room.seatsLocked,seatCount:Number(room.seatCount||room.playerCount||12),seatLayout:String(room.seatLayout||''),seatOffset:{x:Number(room.seatOffset?.x||0),y:Number(room.seatOffset?.y||0)},seatSpacing:Number(room.seatSpacing||100),startedAt:String(room.startedAt||'').slice(0,64),playerCount:Number(room.playerCount||0)},cycle:{phase:playerView.mode==='battle'?cyclePhase.slice(0,20):'lobby',night:playerView.mode==='battle'?cycleNight:0,day:playerView.mode==='battle'?Number(cycle.day||0):0},setup:{showSeats:!!state.roomCode&&room.enabled!==false&&!publicPlayers.some(p=>Number(p.seatId||0)>0),enabled:!!state.roomCode&&!room.seatsLocked,walkEnabled:!state.roomCode||(!room.seatsLocked&&['lobby','waiting'].includes(room.phase||'lobby')),previewCharacterId:String(state.selectedGameCharacterId||''),selectedSeatId:Number(state.selectedSeatId||0)||null,viewerParticipantId:String(state.participantId||('member:'+state.member.loginId)),gallowsHanging:playerView.mode==='battle'?(state.gallows?.hanging||null):null,gallowsNominationTotals:playerView.mode==='battle'?(state.gallows?.nominationTotals||[]).map(row=>({loginId:String(row.loginId||''),votes:Math.max(0,Number(row.votes)||0)})):[],gallowsCanNominate:!!(state.gallows&&state.gallows.mode!=='gm'&&(state.gallows.eligible||[]).includes(state.member.loginId)&&gallowsCurrentStage()==='nominating'&&!(state.gallows.blockedNomination||[]).includes(state.member.loginId)&&!state.gallows.nominations?.[state.member.loginId]),gallowsEligibleTargets:(state.gallows?.eligible||[]).filter(id=>id!==state.member.loginId&&(state.players||[]).some(p=>String(p.loginId||p.participantId||'').replace(/^member:/,'')===id&&!(p.statusTags||[]).some(tag=>tag.statusId==='dead'))),gallowsSelectedId:String(state.gallowsSelectedId||''),clockOffsetMs:Number(state.serverClockOffsetMs||0),characterScale:Number(state.characterScale||100)},players:publicPlayers};
  updateVillageHud();
  const signature=villageSceneSignature(payload);
  if(!force&&gmwwVillageLastFrame===iframe.contentWindow&&gmwwVillageLastSignature===signature)return;
  try{
    iframe.contentWindow.postMessage(payload,location.origin);
    gmwwVillageLastFrame=iframe.contentWindow;
    gmwwVillageLastSignature=signature;
  }catch{gmwwVillageLastFrame=null;gmwwVillageLastSignature=''}

}
window.addEventListener('message',event=>{
  const iframe=$('#gmwwVillageFrame');if(event.origin!==location.origin||!iframe||event.source!==iframe.contentWindow)return;
  const d=event.data||{};
  if(d.type==='gmww:user-activity'){revealPlayerTopMenu();gmwwChatClosePanel();return}
  if(d.type==='gmww:village-ready')syncVillageFrame(true);
  else if(d.type==='gmww:gallows-open-nominations'){
    const me=String(state.member?.loginId||''),g=state.gallows;
    if(g&&g.mode==='auto'&&gallowsCurrentStage()==='nominating'&&(g.eligible||[]).includes(me)&&
      !(g.blockedNomination||[]).includes(me)&&!g.nominations?.[me]){
      state.gallowsNominationOpen=true;renderGallowsWidget();
    }
  }
  else if(['gmww:gallows-preview-nominate','gmww:gallows-drag-nominate','gmww:gallows-confirm-nominate','gmww:gallows-reset-nominate'].includes(d.type)){
    // Only the authenticated Player Web page sends votes; the iframe sends
    // preview/reset intents, never authenticated requests to the Server.
    const g=state.gallows,me=String(state.member?.loginId||'');
    const validActor=g?.mode==='auto'&&gallowsCurrentStage()==='nominating'&&
      (g.eligible||[]).includes(me)&&!(g.blockedNomination||[]).includes(me)&&
      !g.nominations?.[me];
    if(!validActor)return;
    if(d.type==='gmww:gallows-reset-nominate'){
      state.gallowsSelectedId='';
      renderGallowsWidget();syncVillageFrame(true);return;
    }
    const id=String(d.participantId||'').replace(/^member:/,'');
    const validTarget=id&&id!==me&&(g.eligible||[]).includes(id)&&
      (state.players||[]).some(p=>String(p.loginId||p.participantId||'').replace(/^member:/,'')===id&&
      !(p.statusTags||[]).some(tag=>tag.statusId==='dead'));
    if(!validTarget)return;
    if(d.type==='gmww:gallows-confirm-nominate'){
      // A stale/altered iframe intent cannot confirm a different nominee.
      if(id===String(state.gallowsSelectedId||''))void sendGallowsChoice('nominate',id);
      return;
    }
    state.gallowsSelectedId=id;
    state.gallowsSelectionRound=String(g.id||state.room?.matchId||'')+'|'+gallowsCurrentStage()+'|'+me;
    state.gallowsNominationOpen=false;
    renderGallowsWidget();syncVillageFrame(true);
  }
  else if(d.type==='gmww:seat-click')toast(Number(currentRoomPlayer()?.seatId||0)?'Ghế do GM quản lý. Dùng RỜI GHẾ nếu cần rời vị trí.':'Vị trí do GM xếp. Vui lòng chờ Quản Trò.');
  else if(d.type==='gmww:fire-click'){state.roomNavigationAuthorized=true;loadRooms(false).then(()=>go('rooms'))}
  else if(d.type==='gmww:ground-click'){if(state.roomCode)startFreeWalk(Number(d.x),Number(d.y));else walkInVillage(Number(d.x),Number(d.y))}
  else if(d.type==='gmww:move-arrived'&&state.roomCode&&String(d.participantId||'')===String(state.participantId||''))completeVillageMove(String(d.moveId||''));
  else if(d.type==='gmww:village-perf'){
    state.villagePerf={fps:Number(d.fps||0),longTasks:Number(d.longTasks||0),worstLongTask:Number(d.worstLongTask||0),nodes:Number(d.nodes||0),sceneRenders:Number(d.sceneRenders||0),sceneNodesCreated:Number(d.sceneNodesCreated||0),sceneNodesReused:Number(d.sceneNodesReused||0),movementFrames:Number(d.movementFrames||0),mountedCharacters:Number(d.mountedCharacters||0),width:Number(d.width||0),height:Number(d.height||0),dpr:Number(d.dpr||1),heapMB:d.heapMB==null?null:Number(d.heapMB),at:Number(d.at||Date.now())};
    window.GMWWVillagePerf=state.villagePerf;
    if(new URLSearchParams(location.search).get('gmwwPerf')==='1'){let badge=$('#gmwwVillagePerfBadge');if(!badge){badge=document.createElement('div');badge.id='gmwwVillagePerfBadge';$('#gmwwVillageShell')?.appendChild(badge)}if(badge)badge.textContent=state.villagePerf.fps+' FPS · '+state.villagePerf.nodes+' nodes · '+state.villagePerf.mountedCharacters+' chars · '+state.villagePerf.sceneNodesReused+' reused · '+state.villagePerf.longTasks+' LT'}
  }
});
window.GMWWVillage={ensure:ensureVillageGameView,sync:syncVillageFrame,setPane:setGameViewPane,getPerf:()=>state.villagePerf||null};

async function api(path,opts={}){
  const headers={...(opts.headers||{})};
  if(opts.body!==undefined&&!headers['content-type'])headers['content-type']='application/json';
  const r=await fetch(path,{...opts,headers,cache:'no-store'});
  let d={};try{d=await r.json()}catch{}
  if(!r.ok)throw Object.assign(new Error(d.message||d.error||'Có lỗi xảy ra.'),{status:r.status,data:d});
  return d;
}
function auth(){return state.token?{Authorization:'Bearer '+state.token}:{}}
function avatarUrl(id){return '/api/avatars/'+encodeURIComponent(id)+'/image'}
async function loadUiSettings(force=false){
  if(!force&&Date.now()-Number(state.uiSettingsLoadedAt||0)<10000)return state.characterScale;
  try{const d=await api('/api/ui-settings');state.characterScale=normalizeCharacterScale(d?.characterScale,100);state.actionIconScale=[25,50,75,100,125,150].includes(Number(d?.actionIconScale))?Number(d.actionIconScale):100;state.uiSettingsLoadedAt=Date.now();syncVillageFrame();renderOnlineActionDock();return state.characterScale}catch{return state.characterScale}
}

function saveSession(d){
  state.token=d.token;state.member=d.member;
  localStorage.setItem('gmww_token',d.token);localStorage.setItem('gmww_member',JSON.stringify(d.member));
  startPresence();
}
async function restore(){
  if(!state.token)return false;
  try{const d=await api('/api/members/me',{headers:auth()});state.member=d.member;localStorage.setItem('gmww_member',JSON.stringify(d.member));startPresence();return true}
  catch(e){
    if(e?.status===401||e?.status===403){state.token='';state.member=null;localStorage.removeItem('gmww_token');localStorage.removeItem('gmww_member');return false}
    try{const cached=JSON.parse(localStorage.getItem('gmww_member')||'null');if(cached){state.member=cached;startPresence();setTimeout(()=>restore(),2500);return true}}catch{}
    return false
  }
}

function setLoginPasswordVisible(show){
  const block=$('#loginPasswordBlock'),pass=$('#loginPass');if(block)block.classList.toggle('open',!!show);if(!show&&pass)pass.value='';
}
function setLoginRegisterGuide(show){const g=$('#loginRegisterGuide');if(g)g.classList.toggle('show',!!show)}
function openCreateFromLogin(){
  const user=$('#loginUser')?.value.trim()||'',reg=$('#regUser');if(reg&&user)reg.value=user;setLoginRegisterGuide(false);go('create');
  setTimeout(()=>{const target=user?$('#regDisplay'):$('#regUser');target?.focus()},40);
}
window.openCreateFromLogin=openCreateFromLogin;
function toggleRegistrationPassword(){
  const fields=$('#registrationPasswordFields'),toggle=$('#registrationPasswordToggle');if(!fields)return;const open=!fields.classList.contains('open');fields.classList.toggle('open',open);
  if(toggle)toggle.textContent=open?'− Không đặt mật khẩu':'＋ Đặt mật khẩu cho tài khoản nếu muốn';
  if(open)$('#regPass')?.focus();else{const p=$('#regPass'),p2=$('#regPass2');if(p)p.value='';if(p2)p2.value=''}
}
window.toggleRegistrationPassword=toggleRegistrationPassword;

async function login(){
  const user=$('#loginUser')?.value.trim()||'';
  if(!user){toast('Vui lòng nhập tên đăng nhập.');return}
  setLoginRegisterGuide(false);setLoginPasswordVisible(false);
  const btn=$('#login .primary');btn?.classList.add('loading');
  try{const d=await api('/api/members/login',{method:'POST',body:JSON.stringify({loginId:user})});saveSession(d);state.roomNavigationAuthorized=false;await enterVillage()}
  catch(e){if(String(e?.data?.error||'')==='MEMBER_NOT_FOUND'){setLoginRegisterGuide(true);toast('Tên đăng nhập này chưa có tài khoản.')}else toast(e.message)}
  finally{btn?.classList.remove('loading')}
}

window.login=login;
$('#loginUser')?.addEventListener('input',()=>{setLoginPasswordVisible(false);setLoginRegisterGuide(false)});

function openReset(){
  const u=$('#resetUser'),from=$('#loginUser')?.value.trim()||'';if(u)u.value=from;
  const f=$('#resetForm'),s=$('#resetSuccess');if(f)f.style.display='block';if(s)s.style.display='none';go('reset');
}
window.openReset=openReset;
async function requestPasswordReset(){
  const loginId=$('#resetUser')?.value.trim()||'';if(!loginId){toast('Vui lòng nhập tên tài khoản.');return}
  const btn=$('#resetSubmit');btn?.classList.add('loading');
  try{await api('/api/members/reset-request',{method:'POST',body:JSON.stringify({loginId})});const f=$('#resetForm'),s=$('#resetSuccess');if(f)f.style.display='none';if(s)s.style.display='block'}
  catch(e){toast(e.message)}
  finally{btn?.classList.remove('loading')}
}
window.requestPasswordReset=requestPasswordReset;

async function createAccount(){
  const loginId=$('#regUser')?.value.trim()||'',displayName=$('#regDisplay')?.value.trim()||'';
  if(!loginId){toast('Vui lòng nhập tên đăng nhập.');$('#regUser')?.focus();return}
  if(!displayName){toast('Vui lòng nhập Tên Hiển Thị.');$('#regDisplay')?.focus();return}
  if(!state.selectedAvatarId){toast('Vui lòng chọn Nhân Vật GMWW.');return}
  const btn=$('#create .primary.violet');btn?.classList.add('loading');
  try{const d=await api('/api/members/register',{method:'POST',body:JSON.stringify({loginId,displayName,gameCharacterId:state.selectedAvatarId})});saveSession(d);state.roomNavigationAuthorized=false;await enterVillage();return}
  catch(e){toast(e.message)}finally{btn?.classList.remove('loading')}
}

window.createAccount=createAccount;

async function logout(){
  try{if(state.token)await api('/api/members/logout',{method:'POST',headers:auth(),body:'{}'})}catch{}
  clearActiveRoom();disconnectRoom();clearInterval(state.presenceTimer);state.presenceTimer=null;if(state.gmPresencePoll){clearInterval(state.gmPresencePoll);state.gmPresencePoll=null}state.gmPresence=null;clearLobbyMotionTimer();state.token='';state.member=null;
  localStorage.removeItem('gmww_token');localStorage.removeItem('gmww_member');
  go('login');
}

async function changePassword(){
  const inputs=$$('.change-pass .pass-grid .input');if(inputs.length<3)return;
  const [cur,nw,cf]=inputs.map(x=>x.value);
  if(nw!==cf){toast('Mật khẩu mới nhập lại chưa khớp.');return}
  try{await api('/api/members/password',{method:'POST',headers:auth(),body:JSON.stringify({currentPassword:cur,newPassword:nw})});inputs.forEach(x=>x.value='');toast('Đã thay đổi mật khẩu.')}
  catch(e){toast(e.message)}
}

function renderProfile(){
  const m=state.member;if(!m)return;ensureLobbyMotionToggle();
  const editing=!!$('#profileEditPanel')?.open,currentCharacter=String(m.gameCharacterId||state.gameCharacters[0]?.id||''),draftCharacter=String(state.profileDraftGameCharacterId||currentCharacter);
  if(!state.profileDraftGameCharacterId)state.profileDraftGameCharacterId=currentCharacter;
  const main=$('#profileAvatar'),edit=$('#profileEditAvatar');if(main){main.src=gameCharacterImageUrl(editing?draftCharacter:currentCharacter);main.dataset.gmwwWalkCharacter=editing?draftCharacter:currentCharacter}if(edit){edit.src=gameCharacterImageUrl(draftCharacter);edit.dataset.gmwwWalkCharacter=draftCharacter}
  const pd=$('#profileDisplay'),pi=$('#profileId');if(pd)pd.textContent=m.displayName||m.loginId;if(pi)pi.textContent=m.loginId;const pdi=$('#profileDisplayInput');if(pdi&&!editing)pdi.value=m.displayName||m.loginId;
  const wins=Math.max(0,Number(m?.stats?.wins||0)),losses=Math.max(0,Number(m?.stats?.losses||0)),total=wins+losses,rate=total?Math.round(wins*100/total):0,statValues=[String(wins),String(losses),rate+'%'];$$('#profile .stats .stat strong').forEach((el,i)=>{if(statValues[i]!=null)el.textContent=statValues[i]});
  const historyBox=$('#profile .history');if(historyBox){historyBox.innerHTML='';const rows=Array.isArray(m.history)?m.history.slice(0,10):[];if(!rows.length){const empty=document.createElement('div');empty.className='history-item';empty.textContent='Chưa có lịch sử ván chơi.';historyBox.appendChild(empty)}else rows.forEach(row=>{const item=document.createElement('div');item.className='history-item';const info=document.createElement('div'),title=document.createElement('b'),small=document.createElement('small'),badge=document.createElement('span');title.textContent=String(row.gameName||row.roomName||'Ván GMWW');small.textContent=[row.roleName,row.playedAt?new Date(row.playedAt).toLocaleDateString('vi-VN'):''].filter(Boolean).join(' • ');info.append(title,small);badge.className='badge '+(row.result==='win'?'win':'lose');badge.textContent=row.result==='win'?'THẮNG':'THUA';item.append(info,badge);historyBox.appendChild(item)})}
  const summary=$('#profileEditPanel>summary');if(summary)summary.textContent='✎ THAY ĐỔI AVATAR';const saveBtn=$('#profileSaveButton');if(saveBtn&&!saveBtn.disabled)saveBtn.textContent='LƯU AVATAR';updateVillageHud();ensureCharacterPreviewTicker();
}

function avatarAssetSrc(a){const id=String(a?.id||'');return id.startsWith('character-')?gameCharacterImageUrl(id):String(a?.imageData||a?.imageUrl||avatarUrl(id))}
function avatarButton(a){
  const b=document.createElement('button');b.type='button';b.dataset.gmwwAvatar=a.id;
  const i=document.createElement('img');i.alt=a.name||'Nhân vật GMWW';i.loading='eager';i.decoding='async';i.src=gameCharacterImageUrl(a.id);i.dataset.gmwwWalkCharacter=a.id;b.appendChild(i);ensureCharacterPreviewTicker();
  const modalOpen=$('#avatarLibraryModal')?.classList.contains('open');
  const selectedId=modalOpen&&state.avatarPickerDraftId?state.avatarPickerDraftId:(state.avatarPickerMode==='profile'?(state.profileDraftGameCharacterId||state.member?.gameCharacterId):state.selectedAvatarId);b.classList.toggle('selected',a.id===selectedId);
  return b;
}
function selectAvatarChoice(id){
  const a=state.gameCharacters.find(x=>x.id===id);if(!a)return;
  const modalOpen=$('#avatarLibraryModal')?.classList.contains('open');
  if(modalOpen){
    state.avatarPickerDraftId=id;renderAvatarLibrary();const btn=$('#avatarConfirmButton');if(btn)btn.disabled=false;return;
  }
  if(state.avatarPickerMode==='profile'){
    state.profileDraftGameCharacterId=id;
    const src=gameCharacterImageUrl(id),pea=$('#profileEditAvatar'),main=$('#profileAvatar');
    if(pea){pea.src=src;pea.dataset.gmwwWalkCharacter=id}if(main){main.src=src;main.dataset.gmwwWalkCharacter=id}ensureCharacterPreviewTicker();
  }else{state.selectedAvatarId=id;renderAvatarSuggestions(false)}
}
window.selectAvatarChoice=selectAvatarChoice;
let suggestionIds=[];
function renderAvatarSuggestions(newSet=true){
  const box=$('#avatarSuggestions');if(!box)return;if(newSet||!suggestionIds.length){const a=[...state.gameCharacters];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}suggestionIds=a.slice(0,5).map(x=>x.id)}
  box.innerHTML='';suggestionIds.forEach(id=>{const a=state.gameCharacters.find(x=>x.id===id);if(a)box.appendChild(avatarButton(a))});
}
function renderAvatarLibrary(){const box=$('#avatarLibraryGrid');if(!box)return;box.innerHTML='';const catalog=state.gameCharacters;catalog.forEach(a=>box.appendChild(avatarButton(a)));$('#avatarLibraryCount').textContent=catalog.length+' Nhân vật GMWW'}
async function loadAvatars(){
  ensureOnline2DStyle();
  let avatarError=null;
  try{const d=await api('/api/avatars?v=0413');state.avatars=(d.avatars||[]).map(a=>({...a,imageUrl:a.imageUrl||avatarUrl(a.id)}))}catch(e){state.avatars=[];avatarError=e}
  await loadGameCharacters();
  if(!state.selectedAvatarId&&state.gameCharacters[0])state.selectedAvatarId=state.gameCharacters[0].id;
  const source=$('#avatarSourceState');if(source)source.textContent=state.gameCharacters.length+' Nhân vật động GMWW';
  const err=$('#avatarLoadError');if(err){if(state.gameCharacters.length){err.style.display='none';err.textContent=''}else{err.textContent=avatarError?.message||'Không tải được danh sách Nhân Vật động.';err.style.display='block'}}
  const sourceLabel=$('.avatar-source span');if(sourceLabel)sourceLabel.textContent=state.gameCharacters.length+' Nhân Vật Động';
  const libraryBtn=$('.avatar-source .secondary');if(libraryBtn)libraryBtn.textContent='XEM ĐỦ '+state.gameCharacters.length+' NHÂN VẬT';
  renderAvatarSuggestions(true);renderAvatarLibrary();ensureCharacterPreviewTicker();
}

function shuffleAvatarSuggestions(){renderAvatarSuggestions(true)} window.shuffleAvatarSuggestions=shuffleAvatarSuggestions;
async function openAvatarLibrary(){state.avatarPickerMode='register';if(!state.gameCharacters.length)await loadAvatars();state.avatarPickerDraftId=state.selectedAvatarId||state.gameCharacters[0]?.id||null;$('#avatarLibraryModal').classList.add('open');renderAvatarLibrary()} window.openAvatarLibrary=openAvatarLibrary;
function closeAvatarLibrary(){state.avatarPickerDraftId=null;$('#avatarLibraryModal').classList.remove('open')} window.closeAvatarLibrary=closeAvatarLibrary;
async function confirmAvatarSelection(){
  const id=state.avatarPickerDraftId;if(!id){toast('Vui lòng chọn Avatar.');return}
  if(state.avatarPickerMode==='profile'){
    state.profileDraftGameCharacterId=id;
    const src=gameCharacterImageUrl(id),pea=$('#profileEditAvatar'),main=$('#profileAvatar');if(pea){pea.src=src;pea.dataset.gmwwWalkCharacter=id}if(main){main.src=src;main.dataset.gmwwWalkCharacter=id}ensureCharacterPreviewTicker();
    closeAvatarLibrary();await saveProfile();return;
  }
  state.selectedAvatarId=id;suggestionIds=[id,...suggestionIds.filter(x=>x!==id)].slice(0,5);renderAvatarSuggestions(false);
  closeAvatarLibrary();toast('Đã chọn Avatar.');
}
window.confirmAvatarSelection=confirmAvatarSelection;
function avatarModalBackdrop(e){if(e.target?.id==='avatarLibraryModal')closeAvatarLibrary()} window.avatarModalBackdrop=avatarModalBackdrop;

async function saveProfile(){
  const input=$('#profileDisplayInput'),btn=$('#profileSaveButton');if(btn?.disabled)return;
  const displayName=input?.value.trim()||'',gameCharacterId=String(state.profileDraftGameCharacterId||state.member?.gameCharacterId||''),previous={...state.member};
  if(!displayName){toast('Vui lòng nhập Tên hiển thị.');return}if(!gameCharacterId){toast('Vui lòng chọn Nhân Vật.');return}
  const oldLabel=btn?.textContent||'LƯU THÔNG TIN';if(btn){btn.disabled=true;btn.textContent='ĐANG LƯU…'}
  try{await api('/api/members/profile',{method:'POST',headers:auth(),body:JSON.stringify({displayName,gameCharacterId})});const verified=await api('/api/members/me',{headers:auth()}),vm=verified?.member;if(!vm)throw new Error('Không xác minh được hồ sơ sau khi lưu.');if(String(vm.displayName||'').trim()!==displayName||String(vm.gameCharacterId||'')!==gameCharacterId)throw new Error('Máy chủ chưa lưu đúng Tên hiển thị hoặc Nhân Vật.');state.member=vm;state.profileDraftGameCharacterId=vm.gameCharacterId;localStorage.setItem('gmww_member',JSON.stringify(vm));renderProfile();try{await sendPresence();if(state.roomCode)await refreshPrivateRole(true)}catch{}$('#profileEditPanel')?.removeAttribute('open');renderProfile();go('profile');toast('Đã cập nhật thông tin.')}catch(e){state.member=previous;state.profileDraftGameCharacterId=previous?.gameCharacterId||'';renderProfile();toast(e.message||'Không cập nhật được thông tin.')}finally{if(btn){btn.disabled=false;btn.textContent=oldLabel}}
}
window.saveProfile=saveProfile;
async function openProfileAvatarLibrary(){state.avatarPickerMode='profile';if(!state.gameCharacters.length)await loadGameCharacters();if(!state.gameCharacters.length){toast('Không tải được danh sách Avatar. Vui lòng thử lại.');return}state.profileDraftGameCharacterId=state.profileDraftGameCharacterId||state.member?.gameCharacterId||state.gameCharacters[0]?.id||'';state.avatarPickerDraftId=state.profileDraftGameCharacterId;const modal=$('#avatarLibraryModal');if(!modal)return;modal.classList.add('open');renderAvatarLibrary();ensureCharacterPreviewTicker()}
window.openProfileAvatarLibrary=openProfileAvatarLibrary;

async function openRooms(){
  if(!state.token){go('login');return}
  state.roomNavigationAuthorized=true;
  go('rooms');
  await loadRooms(false);
  if(targetRoom){
    const card=$('[data-room-code="'+targetRoom+'"]');
    if(card){
      card.scrollIntoView({block:'center'});
      card.style.boxShadow='0 0 0 2px #ffd27b,0 14px 34px #0008';
      setTimeout(()=>card.style.boxShadow='',1800);
    }
    sessionStorage.removeItem('gmww_pending_room');
  }
}
window.openRooms=openRooms;

async function loadRooms(show=false){
  ensureOnline2DStyle();if(!state.token){go('login');return}
  if(show&&!state.roomNavigationAuthorized)return;if(roomListRefreshBusy)return;roomListRefreshBusy=true;
  const list=$('#rooms .room-list');if(list)list.innerHTML='<div class="room-card"><div class="wait-note">Đang tải phòng Online…</div></div>';
  try{let d=await api('/api/rooms');state.rooms=d.rooms||[];if(!state.rooms.length){await new Promise(ok=>setTimeout(ok,320));d=await api('/api/rooms');state.rooms=d.rooms||[]}if(targetRoom&&!state.rooms.some(r=>String(r?.code||r?.roomCode||'').toUpperCase()===targetRoom)){try{const direct=await api('/api/rooms/'+encodeURIComponent(targetRoom)),rr=direct?.room;if(rr){state.rooms=[{...rr,code:String(rr.code||targetRoom),joinedCount:Array.isArray(direct.players)?direct.players.length:0},...state.rooms]}}catch{}}renderRooms()}
  catch(e){if(list)list.innerHTML='<div class="room-card"><div class="wait-note">'+escapeHtml(e.message)+'</div></div>'}
  finally{roomListRefreshBusy=false}
}
function escapeHtml(v){return String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}
