function openVillageProfile(){try{renderProfile();const h=$('#profile .history-fold');if(h)h.open=false;const edit=$('#profileEditPanel');if(edit)edit.open=false}catch(e){console.warn('[GMWW profile render]',e)}go('profile')}
let gmwwPlayerTopMenuTimer=null,gmwwPlayerTopMenuLastActivity=0;
function playerScenePolicy(room={}){
  const phase=String(room?.phase||'lobby').toLowerCase();
  const playing=['running','started','playing','game'].includes(phase);
  return {phase,mode:playing?'battle':'lobby',rolesReleased:playing||phase==='role_delivery'};
}
function playerTopMenuStatus(){
  const room=state.room||{},cycle=state.villageCycle||{},phase=String(room.phase||'').toLowerCase(),cyclePhase=String(cycle.phase||room.cyclePhase||'').toLowerCase(),night=Math.max(0,Number(cycle.night||room.cycleNight||0)),day=Math.max(0,Number(cycle.day||room.cycleDay||0));
  if(!state.roomCode)return'SẢNH CHỜ';
  if(phase==='ended')return'KẾT THÚC VÁN';
  if(playerScenePolicy(room).mode==='battle'){
    if(cyclePhase==='night'||phase==='night')return'ĐÊM '+Math.max(1,night||1);
    if(cyclePhase==='day'||cyclePhase==='morning'||phase==='day')return'BAN NGÀY'+(day||night?' '+Math.max(1,day||night):'');
    return'ĐANG TRONG VÁN';
  }
  if(phase==='role_delivery')return'PHÒNG CHỜ · ĐÃ PHÁT VAI';
  if(phase==='lobby'||phase==='waiting')return Number(currentRoomPlayer()?.seatId||0)>0?'PHÒNG CHỜ · ĐÃ XẾP VỊ TRÍ':'PHÒNG CHỜ · CHỜ GM';
  return String(room.roomName||'PHÒNG CHỜ').trim()||'PHÒNG CHỜ';
}
function updatePlayerTopMenu(){
  const menu=$('#gmwwPlayerTopMenu');if(!menu)return;
  const info=menu.querySelector('.gmww-player-menu-info b');if(info)info.textContent=playerTopMenuStatus();const hint=menu.querySelector('.gmww-player-menu-info small');if(hint)hint.textContent=state.participantId?(Number(currentRoomPlayer()?.seatId||0)>0?'Vị trí '+currentRoomPlayer().seatId+' · Đã sẵn sàng':'Chờ Quản Trò xếp vị trí'):'Chờ Quản Trò gọi vào phòng';
  const turn=menu.querySelector('.gmww-player-menu-turn');if(turn)turn.textContent=playerScenePolicy(state.room).mode==='battle'?String(state.audioCue?.label||'Đang theo dõi lượt GM').slice(0,120):'';
  const account=menu.querySelector('.gmww-player-menu-account');
  const avatar=account?.querySelector('img'),characterId=String(state.member?.gameCharacterId||currentRoomPlayer()?.gameCharacterId||'').trim();
  if(avatar){
    const key=characterId?characterId+':top-menu':'';
    if(avatar.dataset.gmwwMenuCharacter!==key){
      avatar.dataset.gmwwMenuCharacter=key;
      avatar.hidden=true;
      account.classList.remove('has-avatar');
      avatar.removeAttribute('data-gmww-walk-character');
      if(!characterId){avatar.removeAttribute('src');}
      else{
        avatar.onload=()=>{if(avatar.dataset.gmwwMenuCharacter!==key)return;avatar.hidden=false;account.classList.add('has-avatar');};
        avatar.onerror=()=>{if(avatar.dataset.gmwwMenuCharacter!==key)return;avatar.hidden=true;account.classList.remove('has-avatar');avatar.removeAttribute('src');};
        avatar.alt='Avatar nhân vật của bạn';
        avatar.src=gameCharacterImageUrl(characterId);
      }
    }
  }
  menu.hidden=!state.member;
}

/* One private dock only: role and artifact are quarter-size shortcuts to the same full-size cards.
 * Position is a UI preference, never a second copy of the role or an authoritative card state. */
const GMWW_MINI_POSITIONS_KEY='gmww_online_mini_positions_v2';
function gmwwMiniPositions(){try{return JSON.parse(localStorage.getItem(GMWW_MINI_POSITIONS_KEY)||'{}')||{}}catch{return{}}}
function gmwwMiniPosition(button,type){
  const stored=gmwwMiniPositions()[type],w=Math.min(78,Math.max(56,window.innerWidth*.19)),h=w/0.72;
  const x=Math.max(4,Math.min(window.innerWidth-w-4,Number(stored?.x??(window.innerWidth-w-8)))),
    y=Math.max(56,Math.min(window.innerHeight-h-74,Number(stored?.y??(type==='role'?118:118+h+7))));
  button.style.left=x+'px';button.style.top=y+'px';
}
function gmwwMiniDrag(button,type){
  if(button.dataset.gmwwMiniBound)return;button.dataset.gmwwMiniBound='1';
  button.addEventListener('pointerdown',event=>{
    if(event.button!==undefined&&event.button!==0)return;
    const startX=event.clientX,startY=event.clientY,rect=button.getBoundingClientRect();let moved=false;
    const move=e=>{if(Math.hypot(e.clientX-startX,e.clientY-startY)<7&&!moved)return;moved=true;
      button.style.left=Math.max(4,Math.min(window.innerWidth-rect.width-4,rect.left+e.clientX-startX))+'px';
      button.style.top=Math.max(55,Math.min(window.innerHeight-rect.height-70,rect.top+e.clientY-startY))+'px'};
    const end=e=>{button.removeEventListener('pointermove',move);button.removeEventListener('pointerup',end);button.removeEventListener('pointercancel',end);
      if(moved){button.dataset.gmwwMiniMoved='1';try{const positions=gmwwMiniPositions();positions[type]={x:parseFloat(button.style.left),y:parseFloat(button.style.top)};localStorage.setItem(GMWW_MINI_POSITIONS_KEY,JSON.stringify(positions))}catch{}
        setTimeout(()=>{delete button.dataset.gmwwMiniMoved},250)}};
    button.setPointerCapture?.(event.pointerId);button.addEventListener('pointermove',move);button.addEventListener('pointerup',end);button.addEventListener('pointercancel',end);
  });
}
function syncPlayerMiniCards(){
  let host=document.getElementById('gmwwPlayerMiniCards');
  const allowed=!!(state.member&&state.roomCode&&state.participantId&&state.role&&
    String(state.room?.roomMode||'online').toLowerCase()==='online'&&playerScenePolicy(state.room).mode==='battle');
  if(!allowed){host?.remove();return}
  if(!document.getElementById('gmwwPlayerMiniCardStyle')){
    const st=document.createElement('style');st.id='gmwwPlayerMiniCardStyle';
    st.textContent='#gmwwPlayerMiniCards{position:fixed;inset:0;z-index:234;pointer-events:none}'+
      '#game:not(.active) #gmwwPlayerMiniCards,#game.gmww-card-expanded #gmwwPlayerMiniCards{display:none!important}'+
      '#game .role-stage[hidden]{display:none!important}'+
      '#gmwwPlayerMiniCards button{position:fixed;display:block;width:clamp(56px,19vw,78px);aspect-ratio:.72;padding:0;overflow:hidden;pointer-events:auto;touch-action:none;border:1px solid #d5af68;border-radius:9px;background:#07111b;box-shadow:0 4px 14px #000a;color:white}'+
      '#gmwwPlayerMiniCards button[hidden]{display:none!important}#gmwwPlayerMiniCards img{display:block;width:100%;height:100%;object-fit:cover}'+
      '#gmwwPlayerMiniCards .mini-label{position:absolute;inset:auto 0 0;background:#07131dc9;color:#f7e1a1;font:700 9px/1.3 system-ui;padding:2px 1px;text-align:center}';
    document.head.appendChild(st)
  }
  if(!host){
    host=document.createElement('div');host.id='gmwwPlayerMiniCards';
    host.innerHTML='<button type="button" data-mini="role" title="Xem Vai Trò của bạn"><img alt=""><span class="mini-label">Vai Trò</span></button><button type="button" data-mini="artifact" title="Xem Artifact của bạn"><img alt=""><span class="mini-label">Artifact</span></button>';
    document.getElementById('game')?.appendChild(host);
    for(const type of ['role','artifact']){
      const button=host.querySelector('[data-mini="'+type+'"]');gmwwMiniPosition(button,type);gmwwMiniDrag(button,type);
      button.onclick=()=>{if(button.dataset.gmwwMiniMoved)return;
        if(type==='artifact'&&!state.artifact)return;
        ensurePlayerPrivateDock();openPrivateCardViewer(type);
      }
    }
  }
  host.hidden=$('#game')?.classList.contains('gmww-card-expanded')===true;
  const role=state.role||{},pc=role.roleCard||{},artifact=state.artifact||{},ac=artifact.artifactCard||{};
  const base='/api/rooms/'+encodeURIComponent(state.roomCode)+'/role-assets/';
  const roleAsset=String(role.artworkAssetId||role.artworkId||pc.artworkAssetId||pc.artworkId||role.roleId||'');
  const artAsset=String(artifact.artworkAssetId||artifact.artworkId||ac.artworkAssetId||ac.artworkId||'');
  const setImage=(selector,url)=>{const img=host?.querySelector(selector);if(img&&url&&img.getAttribute('src')!==url)img.src=url};
  setImage('[data-mini="role"] img',String(role.roleImage||(roleAsset?base+encodeURIComponent(roleAsset)+'/image':'')||''));
  const artButton=host.querySelector('[data-mini="artifact"]');artButton.hidden=!state.artifact;
  if(state.artifact)setImage('[data-mini="artifact"] img',String(artifact.artifactImage||(artAsset?base+encodeURIComponent(artAsset)+'/image':'')||''));
}

function renderPlayerTimeline(timeline){
 const menu=document.getElementById('gmwwPlayerTopMenu');if(!menu)return;
 let strip=document.getElementById('gmwwPlayerTimeline');
 if(!timeline?.steps?.length){strip?.remove();return}
 if(!document.getElementById('gmwwPlayerTimelineCss')){
   const style=document.createElement('style');style.id='gmwwPlayerTimelineCss';
   style.textContent='#gmwwPlayerTimeline{position:absolute;top:calc(100% + 2px);left:52px;right:52px;max-width:calc(100% - 104px);display:flex;justify-content:flex-start;gap:4px;overflow-x:auto;scrollbar-width:none;pointer-events:auto;padding:2px 0 4px}'+
     '#gmwwPlayerTimeline span{flex:0 0 auto;white-space:nowrap;max-width:150px;overflow:hidden;text-overflow:ellipsis;padding:4px 6px;border:1px solid #ffffff44;border-radius:7px;background:#06273bc9;color:#b7e0e4;font:700 9px/1.2 system-ui}'+
     '#gmwwPlayerTimeline span.active{border-color:#ffdd91;background:#9d6220e6;color:white}'+
     '#gmwwPlayerTimeline span.done{opacity:.65}';
   document.head.appendChild(style);
 }
 if(!strip){strip=document.createElement('div');strip.id='gmwwPlayerTimeline';strip.setAttribute('aria-label','Timeline đồng bộ Quản Trò');menu.appendChild(strip)}
 const steps=timeline.steps.slice(0,150),key=[state.roomCode,state.room?.matchId,timeline.phase,timeline.activeIndex,...steps.map(x=>x.label+':'+x.status)].join('|');
 if(strip.dataset.sig===key)return;strip.dataset.sig=key;strip.replaceChildren();
 for(const step of steps){
   const node=document.createElement('span');node.className=['done','active'].includes(step.status)?step.status:'';
   node.textContent=String(step.label||'Lượt').slice(0,110);strip.appendChild(node);
 }
 strip.querySelector('.active')?.scrollIntoView({behavior:'instant',inline:'center',block:'nearest'});
}

function hidePlayerTopMenu(){
  const menu=$('#gmwwPlayerTopMenu');if(menu&&state.member)menu.classList.add('is-idle-hidden');
  document.getElementById('gmwwChatLaunch')?.classList.add('is-idle-hidden');
  document.getElementById('gmwwOnlineDock')?.classList.add('is-idle-hidden');
}
function revealPlayerTopMenu(force=false){
  const menu=$('#gmwwPlayerTopMenu');if(!menu||!state.member)return;
  const now=Date.now();if(!force&&now-gmwwPlayerTopMenuLastActivity<450)return;gmwwPlayerTopMenuLastActivity=now;
  menu.classList.remove('is-idle-hidden');document.getElementById('gmwwChatLaunch')?.classList.remove('is-idle-hidden');document.getElementById('gmwwOnlineDock')?.classList.remove('is-idle-hidden');clearTimeout(gmwwPlayerTopMenuTimer);gmwwPlayerTopMenuTimer=setTimeout(hidePlayerTopMenu,30000);
}
function ensurePlayerTopMenu(){
  let menu=$('#gmwwPlayerTopMenu');
  if(!menu){
    menu=document.createElement('nav');menu.id='gmwwPlayerTopMenu';menu.setAttribute('aria-label','Menu Player Web');
    menu.innerHTML='<div class="gmww-player-menu-info"><b>SẢNH CHỜ</b><small>Chờ Quản Trò gọi vào phòng</small><em class="gmww-player-menu-turn" aria-live="polite"></em></div><button class="gmww-player-menu-account" type="button" aria-label="Tài khoản" title="Tài khoản"><svg class="gmww-player-account-fallback" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4.2 21c.7-4 3.4-6 7.8-6s7.1 2 7.8 6"/></svg><img alt="Avatar nhân vật của bạn" hidden></button>';
    $('#game')?.appendChild(menu);
    menu.querySelector('.gmww-player-menu-account').onclick=openVillageProfile;
  }
  $('#gmwwVillageProfileButton')?.remove();
  if(!$('#gmwwPlayerTopMenuStyle')){
    const st=document.createElement('style');st.id='gmwwPlayerTopMenuStyle';st.textContent=`
      #gmwwVillageProfileButton{display:none!important}
      #gmwwVillageHud .status{display:none!important}
      #gmwwPlayerTopMenu{position:fixed;z-index:235;left:10px;right:10px;top:max(7px,env(safe-area-inset-top));display:grid;grid-template-columns:minmax(0,1fr) 50px;gap:6px;align-items:stretch;pointer-events:auto;opacity:1;transform:translateY(0);transition:opacity .28s ease,transform .28s ease;filter:drop-shadow(0 6px 14px rgba(0,18,30,.24))}
      #gmwwPlayerTopMenu.is-idle-hidden{opacity:0;transform:translateY(calc(-100% - 18px));pointer-events:none}
      #gmwwPlayerTopMenu button,#gmwwPlayerTopMenu .gmww-player-menu-info{height:44px;min-height:44px;color:#fff}
      #gmwwPlayerTopMenu button{display:flex;align-items:center;justify-content:center;padding:0;font:900 10px/1 system-ui;cursor:pointer}
      #gmwwPlayerTopMenu button span{font-size:20px;line-height:1}
      #gmwwPlayerTopMenu .gmww-player-menu-exit{border:1px solid rgba(211,246,255,.18)!important;border-radius:14px!important;background:radial-gradient(circle at 48% 35%,rgba(196,246,255,.20),rgba(71,180,210,.08) 48%,rgba(5,42,57,.18) 76%)!important;box-shadow:inset 0 0 0 1px rgba(255,255,255,.035),0 4px 12px rgba(0,18,30,.12)!important;backdrop-filter:blur(9px) saturate(1.08);-webkit-backdrop-filter:blur(9px) saturate(1.08);overflow:visible!important}
      #gmwwPlayerTopMenu .gmww-player-menu-exit span{font-size:24px;transform:translateX(-1px);color:rgba(239,253,255,.96);text-shadow:0 1px 7px rgba(99,222,255,.38)}
      #gmwwPlayerTopMenu .gmww-player-menu-info{border:1px solid rgba(226,249,255,.10);border-radius:13px;background:rgba(5,39,53,.18);box-shadow:inset 0 0 0 1px rgba(255,255,255,.025),0 3px 9px rgba(0,15,25,.08);backdrop-filter:blur(10px) saturate(1.05);-webkit-backdrop-filter:blur(10px) saturate(1.05)}
      #gmwwPlayerTopMenu .gmww-player-menu-account{border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important}
      #gmwwPlayerTopMenu .gmww-player-menu-account img{display:block;width:100%;height:100%;object-fit:contain;object-position:center bottom;background:transparent!important;border:0!important;border-radius:0!important;filter:drop-shadow(0 3px 4px rgba(0,18,30,.32))}
      #gmwwPlayerTopMenu .gmww-player-menu-account img[hidden]{display:none!important}
      #gmwwPlayerTopMenu .gmww-player-account-fallback{display:block;width:28px;height:28px;color:#e5f7ff;filter:drop-shadow(0 2px 5px rgba(0,20,34,.6))}
      #gmwwPlayerTopMenu .gmww-player-menu-account.has-avatar .gmww-player-account-fallback{display:none!important}
      #gmwwPlayerTopMenu .gmww-player-menu-info{display:flex;min-width:0;align-items:center;justify-content:center;padding:4px 10px;text-align:center}
      #gmwwPlayerTopMenu .gmww-player-menu-info small{display:none!important}
       #gmwwPlayerTopMenu .gmww-player-menu-info{flex-direction:column}
       #gmwwPlayerTopMenu .gmww-player-menu-turn{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:600 9px/1.3 system-ui;color:#e4dba7;font-style:normal}
      #gmwwPlayerTopMenu .gmww-player-menu-info b{display:block;max-width:100%;margin:0;font-size:13px;line-height:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:rgba(246,252,247,.92);text-shadow:0 1px 3px rgba(0,20,30,.22)}
      @media(max-width:420px){
        #gmwwPlayerTopMenu{left:7px;right:7px;gap:5px;grid-template-columns:minmax(0,1fr) 46px}
        #gmwwPlayerTopMenu button,#gmwwPlayerTopMenu .gmww-player-menu-info{height:42px;min-height:42px;border-radius:12px}
        #gmwwPlayerTopMenu button{padding:0;font-size:8px;gap:0;flex-direction:column}
        #gmwwPlayerTopMenu button span{font-size:18px}
        #gmwwPlayerTopMenu .gmww-player-menu-info b{font-size:11px}
      }
      @media(min-width:900px){
        html,body{width:100%!important;max-width:none!important;height:100%!important;min-height:100%!important;margin:0!important;padding:0!important;overflow:hidden!important}
        #game.screen.active{position:fixed!important;inset:0!important;width:100vw!important;max-width:none!important;height:100vh!important;min-height:100vh!important;max-height:none!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;transform:none!important}
        #gmwwVillageShell{position:fixed!important;inset:0!important;width:100vw!important;max-width:none!important;height:100vh!important;min-height:100vh!important;max-height:none!important;margin:0!important;border-radius:0!important}
        #gmwwVillageFrame{display:block!important;width:100vw!important;max-width:none!important;height:100vh!important;min-height:100vh!important;border:0!important}
        #gmwwPlayerTopMenu{left:50%!important;right:auto!important;top:14px!important;width:min(88vw,860px)!important;grid-template-columns:minmax(0,1fr) 58px!important;gap:8px!important;transform:translateX(-50%)!important}
        #gmwwPlayerTopMenu.is-idle-hidden{transform:translate(-50%,calc(-100% - 26px))!important}
        #gmwwPlayerTopMenu button,#gmwwPlayerTopMenu .gmww-player-menu-info{height:50px!important;min-height:50px!important;border-radius:14px!important}
        #gmwwPlayerTopMenu button{font-size:11px!important}
        #gmwwPlayerTopMenu button span{font-size:22px!important}
        #gmwwPlayerTopMenu .gmww-player-menu-info small{font-size:8px!important}
        #gmwwPlayerTopMenu .gmww-player-menu-info b{font-size:16px!important}
        #game .role-stage{width:min(72vw,920px)!important;max-width:none!important;max-height:84vh!important}
        #gmwwVillageReadyDock{left:50%!important;right:auto!important;width:min(92vw,1000px)!important;transform:translateX(-50%)!important}
        #gmwwGameViewTabs{width:260px!important}
      }
    `;document.head.appendChild(st)
  }
  if(!document.documentElement.dataset.gmwwPlayerTopMenuActivity){
    document.documentElement.dataset.gmwwPlayerTopMenuActivity='1';
    const activity=()=>revealPlayerTopMenu();
    ['pointerdown','mousemove','touchstart','keydown','wheel'].forEach(type=>document.addEventListener(type,activity,{passive:true,capture:true}));
    window.addEventListener('focus',()=>revealPlayerTopMenu(true));
  }
  menu.querySelector('.gmww-player-menu-exit')?.remove();updatePlayerTopMenu();revealPlayerTopMenu(true);return menu
}
function ensureVillageHud(){
  ensureVillageGameView();let hud=$('#gmwwVillageHud');if(!hud){hud=document.createElement('div');hud.id='gmwwVillageHud';hud.innerHTML='<div class="status"><b></b><small></small></div><button id="gmwwVillageProfileButton" type="button" aria-label="Thông tin"><img id="gmwwVillageProfileAvatar" alt="Avatar của bạn"></button>';$('#game').appendChild(hud)}
  if(!$('#gmwwVillageV260Style')){const st=document.createElement('style');st.id='gmwwVillageV260Style';st.textContent=`
    #gmwwVillageHud{position:fixed;inset:0;z-index:73;pointer-events:none;color:#fff4da}
    #gmwwVillageHud .status{display:none;position:absolute;left:8px;top:max(6px,env(safe-area-inset-top));padding:5px 8px;border:1px solid #d7b775;border-radius:11px;background:#05283ad9;max-width:48vw}
    #gmwwVillageHud.has-room .status{display:block}#gmwwVillageHud .status b,#gmwwVillageHud .status small{display:block}#gmwwVillageHud .status b{font-size:10px}#gmwwVillageHud .status small{font-size:8px;color:#c3e6e4}
    #gmwwVillageProfileButton{pointer-events:auto;position:absolute;right:10px;top:max(8px,env(safe-area-inset-top));width:44px;height:44px;padding:0;overflow:hidden;border:1px solid #e4c982;border-radius:50%;background:#0b3144;color:#fff4da;display:grid;place-items:center;box-shadow:0 4px 14px #00131f66}
    #gmwwVillageProfileAvatar{width:100%;height:100%;display:block;object-fit:contain;object-position:center;background:linear-gradient(180deg,#174f65,#0b293a)}
    #game:after,#game:before{display:none!important}
    #game.screen.active>.page-head,#game.screen.active>.page-title{display:none!important}
    #gmwwGameViewTabs{top:auto!important;bottom:calc(12px + env(safe-area-inset-bottom))!important;right:10px!important;width:190px!important;background:#05283aeb!important;backdrop-filter:none!important}
    #gmwwRoomSetup,#gmwwVillagePerfBadge{display:none!important}
    #gmwwVillageReadyDock{bottom:calc(4px + env(safe-area-inset-bottom));background:#05283aeb;backdrop-filter:none!important}
    #profile.screen.active{position:fixed!important;left:50%!important;right:auto!important;bottom:auto!important;top:50%!important;transform:translate(-50%,-50%)!important;width:min(88vw,360px)!important;max-height:72svh!important;padding:12px!important;z-index:240!important;border:1px solid #d7b775;border-radius:18px;background:#05283af5!important;backdrop-filter:none!important}
    #rooms.screen.active{position:fixed!important;inset:auto 8px 8px!important;top:54px!important;z-index:240!important;border:1px solid #d7b775;border-radius:18px;max-height:calc(100svh - 66px);background:#05283af5!important;backdrop-filter:none!important}
    #profile.screen.active:before,#rooms.screen.active:before{display:none!important}
    #rooms .room-card{backdrop-filter:none!important}
    #gmwwVillageChoice{position:fixed;inset:0;z-index:120;background:#00172760;display:grid;align-items:end;padding:12px 12px calc(12px + env(safe-area-inset-bottom))}
    #gmwwVillageChoice>div{padding:18px;border:1px solid #e3c786;border-radius:20px;background:#05283af5;color:#fff4da}
    #gmwwVillageChoice p{font-size:16px;margin:0 0 14px}#gmwwVillageChoice .choices{display:flex;gap:8px;flex-wrap:wrap}
    #gmwwVillageChoice button{flex:1;min-height:48px;padding:10px;border:1px solid #d7b775;border-radius:12px;background:#0a5c70;color:#fff4da;font-size:15px}
    #gmwwProfileVillageBack,#gmwwRoomsVillageBack{position:absolute;right:8px;top:8px;z-index:5;width:34px;height:34px;min-height:34px;margin:0;border:1px solid #d7b775;border-radius:50%;background:#0a5c70;color:#fff4da;padding:0;font-size:22px;line-height:1}
    #loginPasswordBlock,#registrationPasswordToggle,#registrationPasswordFields,#reset{display:none!important}
    #profile.screen.active{width:min(92vw,382px)!important;height:auto!important;min-height:0!important;max-height:min(76svh,560px)!important;padding:44px 10px 10px!important;overflow:auto!important;top:50%!important}
    #profile .profile-main{width:100%!important;margin:0!important;padding:10px!important;grid-template-columns:72px minmax(0,1fr)!important;gap:10px!important;border-radius:14px!important}
    #profile .profile-main .meta,#profile>.kicker,#profile>.page-title,#profile>.page-sub,#profile .change-pass,#profile .profile-enter-room{display:none!important}
    #profile #profileEditPanel{width:100%!important;margin:8px 0 0!important;border-radius:12px!important}
    #profile #profileEditPanel>summary{min-height:40px!important;padding:8px 10px!important;font-size:12px!important}
    #profile #profileEditPanel label:has(#profileDisplayInput){display:none!important}
    #profile #profileEditPanel .avatar-edit-row{margin-top:4px!important}
    #profile #profileSaveButton{min-height:44px!important;margin-top:8px!important}
    #profile .section-title{width:100%!important;margin:9px 0 5px!important;font-size:11px!important}
    #profile .stats{width:100%!important;margin:0!important;gap:6px!important}
    #profile .stat{min-height:58px!important;padding:7px 4px!important;border-radius:11px!important}
    #profile .stat strong{font-size:20px!important}#profile .stat span{font-size:8px!important}
    #profile .profile-actions-row{display:flex!important;width:100%!important;margin:9px 0 0!important;gap:7px!important}
    #profile .profile-exit-btn{display:block!important;flex:1!important;min-height:44px!important;border-radius:12px!important}
    #profile .history-fold{display:block!important;width:100%!important;margin:8px 0 0!important;padding:0!important;border:1px solid #d7b775!important;border-radius:11px!important;background:#073146!important;overflow:hidden!important}
    #profile .history-fold>summary{display:flex!important;align-items:center!important;justify-content:space-between!important;min-height:38px!important;margin:0!important;padding:8px 10px!important;cursor:pointer!important;color:#fff4da!important;font-size:11px!important;font-weight:900!important;list-style:none!important;border:0!important;border-radius:0!important;outline:0!important;box-shadow:none!important;background:transparent!important}
    #profile .history-fold>summary::-webkit-details-marker{display:none!important}
    #profile .history-fold>summary:after{content:'⌄';font-size:16px!important;transition:transform .18s ease}
    #profile .history-fold[open]>summary:after{transform:rotate(180deg)}
    #profile .history-fold .history{display:grid!important;gap:5px!important;max-height:170px!important;overflow:auto!important;padding:0 7px 7px!important}
    #profile .history-item{padding:7px!important;border-radius:8px!important;font-size:10px!important}
    #profileLobbyMotionRow{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;width:100%!important;margin:8px 0 0!important;padding:9px 10px!important;border:1px solid #547f92!important;border-radius:11px!important;background:#073146!important;color:#fff4da!important}
    #profileLobbyMotionRow .motion-copy{min-width:0!important}#profileLobbyMotionRow b{display:block!important;font-size:11px!important;line-height:1.2!important}#profileLobbyMotionRow small{display:block!important;margin-top:2px!important;color:#a8d4df!important;font-size:8px!important;line-height:1.3!important}
    #profileLobbyMotionToggle{flex:0 0 48px!important;width:48px!important;height:28px!important;min-height:28px!important;padding:2px!important;border:1px solid #6f91a0!important;border-radius:999px!important;background:#183848!important;position:relative!important;box-shadow:none!important}
    #profileLobbyMotionToggle:after{content:''!important;display:block!important;width:22px!important;height:22px!important;border-radius:50%!important;background:#d8e7ec!important;transform:translateX(0)!important;transition:transform .18s ease,background .18s ease!important}
    #profileLobbyMotionToggle[aria-checked='true']{background:#11745e!important;border-color:#54d8b2!important}#profileLobbyMotionToggle[aria-checked='true']:after{transform:translateX(20px)!important;background:#ecfff8!important}
  `;document.head.appendChild(st)}
  if(!$('#gmwwProfileVillageBack')){const b=document.createElement('button');b.id='gmwwProfileVillageBack';b.setAttribute('aria-label','Đóng');b.textContent='×';b.onclick=enterVillage;$('#profile')?.prepend(b)}if(!$('#gmwwRoomsVillageBack')){const b=document.createElement('button');b.id='gmwwRoomsVillageBack';b.setAttribute('aria-label','Đóng');b.textContent='×';b.onclick=enterVillage;$('#rooms')?.prepend(b)}
  const profileButton=$('#gmwwVillageProfileButton');if(profileButton&&!profileButton.dataset.bound){profileButton.dataset.bound='1';profileButton.onclick=openVillageProfile}
  ensurePlayerTopMenu();
  ensureDesktopResponsiveStyle();
  return hud;
}
function updateVillageHud(){const hud=$('#gmwwVillageHud');if(!hud)return;updatePlayerTopMenu();const me=currentRoomPlayer();hud.classList.toggle('has-room',!!state.roomCode);const b=hud.querySelector('.status b'),sm=hud.querySelector('.status small');if(b)b.textContent=state.roomCode?('Phòng '+state.roomCode):'';if(sm)sm.textContent=state.roomCode?(state.room?.seatsLocked?'Vị trí đã khóa':me?.seatId?'Vị trí '+me.seatId:'Chọn vị trí'):' ';const img=hud.querySelector('#gmwwVillageProfileAvatar'),id=String(state.member?.gameCharacterId||state.gameCharacters[0]?.id||'character-01');if(img&&id){const key=id+':hud';if(img.dataset.gmwwHud!==key){img.dataset.gmwwHud=key;img.dataset.gmwwWalkCharacter=id;img.src=gameCharacterImageUrl(id)}ensureCharacterPreviewTicker()}}

let gmRoomCallWatchBusy=false,gmRoomCallLastCheckAt=0;
async function followGmRoomCall(){
  // Only the confirmed GM-reserved player may transition automatically into a room.
  if(!state.member||!state.token||state.roomCode||state.participantId||document.hidden||gmRoomCallWatchBusy)return false;
  const now=Date.now();if(now-gmRoomCallLastCheckAt<2500)return false;
  gmRoomCallLastCheckAt=now;gmRoomCallWatchBusy=true;
  try{
    const me=await api('/api/members/me',{headers:auth()});
    if(state.roomCode||state.participantId)return false;
    const code=String(me?.member?.currentRoomCode||'').trim().toUpperCase();
    if(!/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/.test(code)){
      // Single active DEMO may be joined while the GM is already running it.
      // Only an authenticated member is admitted; no private role is granted.
      const list=await api('/api/rooms');
      const demos=(list?.rooms||[]).filter(r=>r?.demo===true&&r?.enabled!==false&&String(r?.phase||'').toLowerCase()==='running');
      if(demos.length!==1)return false;
      return await joinRoom(demos[0].code);
    }
    const roster=await api('/api/rooms/'+encodeURIComponent(code));
    if(!roster?.room||roster.room.enabled===false||!Array.isArray(roster.players))return false;
    const loginId=String(state.member.loginId||'').trim().toLowerCase();
    const called=roster.players.some(p=>String(p?.loginId||'').trim().toLowerCase()===loginId&&p?.reservedByGM===true);
    if(!called||state.roomCode||state.participantId){
      if(roster.room.demo===true&&roster.room.phase==='running'&&!state.roomCode&&!state.participantId)return await joinRoom(code);
      return false;
    }
    return await joinRoom(code);
  }catch{return false}
  finally{gmRoomCallWatchBusy=false}
}

async function enterVillage(){if(!state.member)return go('login');ensureVillageHud();go('game');setGameViewPane('village',{persist:false});syncPlayerPresentation();ensureVillageReadyDock();await loadUiSettings();await refreshGmPresence();startGmPresencePoll();if(!state.roomCode)await loadVillageLobby();syncVillageFrame();scheduleLobbyMotion(400);if(!state.lobbyPoll)state.lobbyPoll=setInterval(()=>{if(state.member&&!state.roomCode&&!document.hidden)loadVillageLobby()},1600);void followGmRoomCall()}
async function loadVillageLobby(){try{await loadUiSettings();const data=await api('/api/village');if(Number.isFinite(Number(data?.serverTime)))state.serverClockOffsetMs=Number(data.serverTime)-Date.now();state.lobbyPlayers=data.players||[];syncVillageFrame();if(!state.lobbyMotionTimer)scheduleLobbyMotion(450)}catch{}finally{void followGmRoomCall()}}
async function walkInVillage(x,y){holdLobbyMotionForManualWalk();try{const d=await api('/api/village/move',{method:'POST',headers:auth(),body:JSON.stringify({x,y})});state.lobbyPlayers=d.players||state.lobbyPlayers;syncVillageFrame();return d}catch(e){toast(e.message);return null}}
function villageChoice(message,actions){$('#gmwwVillageChoice')?.remove();const shell=document.createElement('div');shell.id='gmwwVillageChoice';const card=document.createElement('div'),text=document.createElement('p'),buttons=document.createElement('div');text.textContent=message;buttons.className='choices';card.append(text,buttons);shell.appendChild(card);for(const [label,action]of actions){const b=document.createElement('button');b.textContent=label;b.onclick=async()=>{shell.remove();await action?.()};buttons.appendChild(b)}shell.addEventListener('click',e=>{if(e.target===shell)shell.remove()});document.body.appendChild(shell)}
function showSeatChoice(){toast('Vị trí do GM xếp. Vui lòng chờ Quản Trò.')}
async function releaseMySeat(){
  if(!state.roomCode||!state.participantId)return;const me=currentRoomPlayer();if(!Number(me?.seatId||0))return;
  try{const d=await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/setup',{method:'POST',headers:auth(),body:JSON.stringify({seatId:null})});state.players=d.players||state.players;state.ready=false;state.selectedSeatId=null;await sendPresence();ensureVillageReadyDock();syncVillageFrame();toast('Đã rời ghế. Chờ GM xếp lại vị trí.')}catch(e){toast(e.message)}
}
let roomListRefreshBusy=false;

function go(id,opts={}){
  if(id==='rooms'&&!state.roomNavigationAuthorized&&!opts.fromHistory)return false;
  if(id==='profile'&&!opts.fromHistory)state.roomNavigationAuthorized=false;
  $$('.screen').forEach(x=>x.classList.remove('active'));if(state.member&&['profile','rooms'].includes(id))$('#game')?.classList.add('active');
  const el=$('#'+id);if(!el)return false;
  el.classList.add('active');state.activeScreenId=id;
  // Reveal the selected real screen only after navigation has chosen its destination.
  document.documentElement.dataset.gmwwBoot='ready';
  window.scrollTo({top:0,behavior:'instant'});
  try{
    if(!state.historyReady){history.replaceState({gmwwScreen:id},'',location.href);state.historyReady=true}
    else if(!opts.fromHistory&&history.state?.gmwwScreen!==id)history.pushState({gmwwScreen:id},'',location.href)
  }catch{}
  return true;
}
function gmwwBack(){
  try{history.back()}catch{}
}
window.go=go;window.gmwwBack=gmwwBack;
window.addEventListener('popstate',e=>{const id=e.state?.gmwwScreen;if(id){if(id==='rooms')state.roomNavigationAuthorized=true;go(id,{fromHistory:true})}});

let toastTimer;
function toast(text){
  let t=$('#gmwwToast');
  if(!t){t=document.createElement('div');t.id='gmwwToast';t.style.cssText='position:fixed;z-index:300;left:50%;bottom:24px;transform:translateX(-50%);max-width:360px;padding:10px 14px;border:1px solid #c7893e;border-radius:12px;background:#080b12ee;color:#ffe0a1;font-size:11px;font-weight:800;box-shadow:0 10px 30px #000b;text-align:center';document.body.appendChild(t)}
  t.textContent=text||'';t.style.display='block';clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.style.display='none',2400);
}
window.toast=toast;

const villageFrozenState=new Map();
let wolfRecognitionExpiryTimer=null;
function setPrivateWolfRecognition(value,room=state.room){
  if(wolfRecognitionExpiryTimer){clearTimeout(wolfRecognitionExpiryTimer);wolfRecognitionExpiryTimer=null}
  const battle=playerScenePolicy(room).mode==='battle'&&String(room?.cyclePhase||'')==='night';
  const isCurrent=battle&&value&&String(value.matchId||'')===String(room?.matchId||'')&&
    Number(value.night)===Number(room?.cycleNight)&&Array.isArray(value.labels);
  const expiration=Date.parse(value?.deadlineAt||'');
  const valid=!!isCurrent&&(!Number.isFinite(expiration)||expiration>Date.now()+Number(state.serverClockOffsetMs||0));
  state.wolfRecognition=valid?value:null;
  if(valid&&Number.isFinite(expiration)){
    const remaining=Math.max(0,expiration-(Date.now()+Number(state.serverClockOffsetMs||0)));
    wolfRecognitionExpiryTimer=setTimeout(()=>{state.wolfRecognition=null;wolfRecognitionExpiryTimer=null;syncVillageFrame(true)},remaining);
  }
  syncVillageFrame(true);
}
function villagePublicPlayers(rows){
  const seen=new Set(),out=[];
  for(const p of (Array.isArray(rows)?rows:[])){
    const id=String(p?.participantId||p?.id||'').slice(0,100);
    if(!id||seen.has(id))continue;seen.add(id);
    const selfId=String(state.participantId||('member:'+state.member?.loginId)),isSelf=id===selfId,characterId=isSelf?String(state.member?.gameCharacterId||p?.gameCharacterId||''):String(p?.gameCharacterId||''),ownEffects=isSelf?Object.values(state.roleEffects||{}).filter(Boolean):[],ownType=ownEffects.some(x=>x?.type==='dead')?'dead':ownEffects.some(x=>x?.type==='expelled')?'expelled':ownEffects.some(x=>x?.type==='frozen')?'frozen':'',statusKey=String(state.roomCode||'lobby')+':'+id;if(Object.prototype.hasOwnProperty.call(p||{},'frozen'))villageFrozenState.set(statusKey,p.frozen===true);const viewStatus=state.room?.statusDisplay||{},showLegacy=id=>viewStatus[id]===true,visibleOwnType=ownType&&showLegacy(ownType)?ownType:'',frozen=showLegacy('frozen')&&((villageFrozenState.get(statusKey)===true)||ownType==='frozen'),statusLabel=visibleOwnType==='dead'?'ĐÃ CHẾT':visibleOwnType==='expelled'?'BỊ ĐUỔI':visibleOwnType==='frozen'?'ĐÓNG BĂNG':p?.online===false?'':p?.ready?'READY':'ONLINE',
      wolfView=state.wolfRecognition&&String(state.wolfRecognition.matchId||'')===String(state.room?.matchId||'')&&Number(state.wolfRecognition.night)===Number(state.room?.cycleNight)&&String(state.room?.cyclePhase||'')==='night',
      wolfLabel=wolfView?(state.wolfRecognition.labels||[]).find(x=>x.loginId===String(p?.loginId||id).replace(/^member:/,'').toLowerCase()):null,
      roleName=isSelf?String(state.role?.roleCard?.name||state.role?.roleName||'').slice(0,80):wolfLabel?String(wolfLabel.roleName||'').slice(0,80)+(wolfLabel.converted?' · Phe Sói':''):'';out.push({id,participantId:id,displayName:String(p?.displayName||'Người chơi').slice(0,80),avatarId:String(p?.avatarId||'').slice(0,100),gameCharacterId:characterId.slice(0,100),statusLabel,roleName:playerScenePolicy(state.room).mode==='battle'?roleName:'',frozen,seatId:Number(p?.seatId||0)||null,positionX:p?.positionX==null?null:Number(p.positionX),positionY:p?.positionY==null?null:Number(p.positionY),movementStatus:p?.movementStatus==='moving'?'moving':'idle',villageActivity:String(p?.villageActivity||'idle').slice(0,40),sitStartedAt:Number(p?.sitStartedAt||0)||null,sitUntil:Number(p?.sitUntil||0)||null,moveId:String(p?.moveId||''),moveFromX:p?.moveFromX==null?null:Number(p.moveFromX),moveFromY:p?.moveFromY==null?null:Number(p.moveFromY),moveToX:p?.moveToX==null?null:Number(p.moveToX),moveToY:p?.moveToY==null?null:Number(p.moveToY),moveStartedAt:Number(p?.moveStartedAt||0)||null,moveDurationMs:Number(p?.moveDurationMs||0)||null,moveTargetSeatId:Number(p?.moveTargetSeatId||0)||null,statusTags:Array.isArray(p?.statusTags)?p.statusTags.filter(x=>viewStatus[String(x?.statusId||'')]===true).slice(0,8).map(x=>({statusId:String(x?.statusId||'').slice(0,50),icon:String(x?.icon||'').slice(0,16),label:String(x?.label||'').slice(0,80)})):[],online:p?.online!==false,ready:!!p?.ready,setupComplete:!!p?.setupComplete});
    if(out.length>=30)break;
  }
  return out;
}
