
/* Player-created online rooms: owner console modelled on the GM Server "Chơi" screen (six steps:
   Sảnh chờ, Tập hợp, Ván Mẫu, Phân Vai, Phát Vai, Vào Trận). The owner sees seats and the deck
   (role names and counts) but never who holds which role: the server deals blind at Phát Vai.
   Routes: POST /api/player-rooms, GET /api/player-rooms/templates, /api/player-rooms/:code/owner/*. */
(function gmwwPlayerRooms(){
  const KEY='gmwwOwnedRoom',STEPS=[['lobby','Sảnh chờ'],['room','Phòng Game'],['seats','Tập hợp'],['game','Ván Mẫu'],['roles','Phân Vai'],['deal','Phát Vai'],['battle','Vào Trận']];
  const pr={open:false,mounted:false,busy:false,timer:0,own:null,templates:[],roles:[],artifacts:[],catalogStatus:'idle',catalogError:'',deck:new Map(),deckName:'',state:null,msg:'',view:'',touched:false,joinCode:'',known:null,pos:null,chatOpen:false};
  const el=(tag,cls,text)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(text!=null)n.textContent=text;return n};
  const load=()=>{try{const v=JSON.parse(localStorage.getItem(KEY)||'null');return v&&v.code&&v.token?v:null}catch(_){return null}};
  const save=v=>{try{if(v)localStorage.setItem(KEY,JSON.stringify(v));else localStorage.removeItem(KEY)}catch(_){}};
  const base=()=>'/api/player-rooms/'+encodeURIComponent(pr.own.code)+'/owner/';
  const oh=()=>({Authorization:'Bearer '+pr.own.token});
  const callOwner=(op,method,body)=>api(base()+op,{method,headers:oh(),body:body===undefined?undefined:JSON.stringify(body)});
  const ERR={OWNER_ALREADY_HAS_ROOM:'Bạn đang có một phòng rồi.',PLAYER_ROOM_LIMIT:'Đã đủ số phòng người chơi cùng lúc. Hãy thử lại sau.',ROOM_NOT_IN_LOBBY:'Ván đã bắt đầu.',ROOM_NOT_FOUND:'Phòng không còn tồn tại.',UNAUTHORIZED:'Không có quyền chủ phòng.',TEMPLATE_NOT_FOUND:'Không tìm thấy Ván Mẫu.',ROLE_COUNT_MISMATCH:'Số lá bài không khớp số người ngồi.',SEATS_NOT_LOCKED:'Hãy chốt ghế trước khi phát vai.',MOVE_NOT_ACTIVE:'Chưa mở chuyển ghế.',NO_GAME_CONFIG:'Hãy chọn Ván Mẫu trước.',ROOM_NOT_RUNNING:'Ván chưa chạy.',CANNOT_KICK_OWNER:'Không thể đuổi chủ phòng.'};
  const errText=e=>ERR[String(e?.data?.error||'')]||e?.message||'Có lỗi xảy ra.';
  function say(t){pr.msg=t||'';const s=document.getElementById('gmwwPrStatus');if(s)s.textContent=pr.msg}
  async function run(fn){if(pr.busy)return;pr.busy=true;render();try{await fn()}catch(e){
    if(e?.status===404||e?.data?.error==='ROOM_NOT_FOUND'){if(pr.own){pr.own=null;save(null);pr.state=null}}
    say(errText(e))}finally{pr.busy=false;render()}}
  // The owner hears about each new arrival (first look only records who is already inside).
  function noteJoins(st){
    const ps=Array.isArray(st?.players)?st.players:[],ids=new Set(ps.map(p=>String(p.loginId||'')));
    if(pr.known){const fresh=ps.filter(p=>p.loginId&&!pr.known.has(String(p.loginId))&&String(p.loginId)!==String(st?.ownerLoginId||''));
      if(fresh.length){const t=fresh.map(p=>p.displayName||p.loginId).join(', ')+' đã vào phòng.';say(t);try{toast(t)}catch(_){}}}
    pr.known=ids;
  }
  async function refresh(){
    if(!pr.own)return;
    try{pr.state=await api(base()+'state',{headers:oh()});noteJoins(pr.state)}
    catch(e){if(e?.status===404||e?.status===401){pr.own=null;pr.state=null;pr.known=null;save(null);say('Phòng đã đóng.')}}
    render();autoSeat();
  }
  async function create(){
        const d=await api('/api/player-rooms',{method:'POST',headers:auth(),body:JSON.stringify({})});
    pr.own={code:d.roomCode,token:d.ownerToken,joinUrl:d.joinUrl};save(pr.own);pr.view='room';pr.touched=true;
    try{await window.joinRoom(d.roomCode)}catch(_){}
    say('Đã tạo phòng '+d.roomCode+'.');await refresh();
    try{await enterVillage()}catch(_){}
    pr.open=true;pr.view='room';pr.touched=true;render();
  }
  // Keeps the strip every player sees in step with the owner's tab (ignored when the server refuses).
  const STAGE={lobby:'room',room:'room',seats:'seats',game:'game',roles:'roles',deal:'deal'};
  function syncStage(k){if(!pr.own||!STAGE[k]||String(pr.state?.room?.phase||'lobby').toLowerCase()==='running')return;callOwner('stage','POST',{step:STAGE[k]}).then(refresh).catch(()=>{})}
  function goStep(k){pr.view=k;pr.touched=true;syncStage(k);render()}
  async function loadTemplates(){
    pr.catalogStatus='loading';pr.catalogError='';
    try{
      const d=await api('/api/player-rooms/templates',{headers:auth()});pr.templates=Array.isArray(d.templates)?d.templates:[];
      const available=new Map();for(const t of pr.templates){const cfg=t?.compiledConfig||t?.gameConfig||{};for(const r of Array.isArray(cfg.roles)?cfg.roles:[]){const id=String(r?.roleId||'');if(id&&!available.has(id))available.set(id,{roleId:id,roleName:String(r.roleName||r.name||id),faction:String(r.faction||''),order:Number(r.order)||0})}}
      pr.roles=[...available.values()];
      try{const r=await api('/api/player-rooms/roles',{headers:auth()});if(Array.isArray(r.roles)&&r.roles.length)pr.roles=r.roles;pr.artifacts=Array.isArray(r.artifacts)?r.artifacts:[]}
      catch(e){pr.catalogError=errText(e)}
      pr.catalogStatus='ready';
    }catch(e){pr.catalogStatus='error';pr.catalogError=errText(e);throw e}
  }
  const btn=(label,fn,cls,disabled)=>{const b=el('button',cls||null,label);b.type='button';if(disabled||pr.busy)b.disabled=true;b.addEventListener('click',()=>run(fn));return b};
  const stat=(k,v)=>{const d=el('div','gmww-pr-stat');d.append(el('small',null,k),el('b',null,String(v)));return d};
  // Step the server is on, mapped to the six tabs; the owner can still browse the other tabs.
  function serverStep(room){const g=String(room.gmStage==='room'?'lobby':room.gmStage||'lobby');return STEPS.some(s=>s[0]===g)?g:'lobby'}
  function seatedCount(players){return players.length}
  function deckSize(cfg){return(cfg?.roles||[]).reduce((n,r)=>n+Math.max(1,Number(r.count)||1),0)}

  function viewLobby(box,st,room,players){
    const g=el('div','gmww-pr-grid');g.append(stat('Mã phòng',pr.own.code),stat('Người trong phòng',players.length+' / '+(room.seatCount||30)));box.append(g);
    box.append(el('p','gmww-pr-help','Bạn chơi cùng mọi người, Quản Trò Tự Động điều hành ván. Bước đầu: gửi phòng cho bạn bè ở trang Phòng.'));
    box.append(btn('TIẾP: PHÒNG →',async()=>goStep('room'),'gmww-pr-main'));
  }
  // v3.322 menu Phòng gọn (deploy lại sau khi CI main xanh).
  // Quản lý phòng: mã phòng + Gửi phòng + Sao chép mã trên 1 dòng, rồi danh sách người đã vào (Xoá).
  async function deleteRoom(){
    const code=pr.own.code;
    if(!confirm('Xoá phòng '+code+'? Mọi người trong phòng sẽ bị đưa ra ngoài.'))return;
    await callOwner('close','POST',{});
    pr.own=null;pr.state=null;pr.known=null;pr.view='room';pr.touched=true;save(null);
    try{await handleRoomMembershipLost('Đã xoá phòng '+code+'.')}catch(_){}
    say('Đã xoá phòng '+code+'.');
  }
  function roomDetails(box,st,room,players,locked){
    const link=pr.own.joinUrl||(location.origin+'/?room='+pr.own.code),code=pr.own.code,total=Number(room.seatCount)||30;
    const line1=el('div','gmww-pr-line');line1.append(el('b','gmww-pr-linecode',code),
      btn('Sao chép mã',async()=>{try{await navigator.clipboard.writeText(code);say('Đã sao chép mã '+code+'.')}catch(_){say('Mã phòng: '+code)}}),
      btn('Gửi phòng',async()=>{const text='Vào phòng Ma Sói của mình nhé! Mã phòng: '+code+'\n'+link;
        if(navigator.share){try{await navigator.share({title:'Phòng Ma Sói '+code,text,url:link});return}catch(e){if(e&&e.name==='AbortError')return}}
        try{await navigator.clipboard.writeText(text);say('Đã sao chép lời mời.')}catch(_){say(text)}},'gmww-pr-main'));box.append(line1);
    box.append(el('div','gmww-pr-sub','ĐÃ VÀO PHÒNG • '+players.length+' / '+total));
    const list=el('div','gmww-pr-list');
    for(const p of players){const line=el('div','gmww-pr-player'),isOwner=String(p.loginId||'')===String(st?.ownerLoginId||'');
      line.append(el('span',null,(p.displayName||p.loginId||'?')+(isOwner?'  ★':'')));
      if(!isOwner&&!locked)line.append(btn('Xoá',async()=>{await callOwner('kick','POST',{loginId:p.loginId});await refresh()},'gmww-pr-kick'));
      list.append(line)}
    if(!players.length)list.append(el('p','gmww-pr-help','Chưa có ai trong phòng.'));
    box.append(list);
    const line2=el('div','gmww-pr-line');line2.append(btn('Xoá phòng',deleteRoom,'gmww-pr-danger'),btn('Tập hợp →',async()=>goStep('seats'),'gmww-pr-main'));box.append(line2);
  }
  // "Phòng": 1) vào phòng bằng mã  2) tạo phòng riêng  3) quản lý phòng đã tạo.
  function viewRoomHub(box,st,room,players){
    box.append(el('div','gmww-pr-sub','1. QUẢN LÝ PHÒNG'));
    if(!pr.own)box.append(el('p','gmww-pr-help','Bạn chưa tạo phòng nào.'));
    else if(!inOwnRoom())box.append(btn('Vào lại phòng '+pr.own.code,async()=>{
      if(await window.joinRoom(pr.own.code)===false)throw new Error('Không vào lại được phòng.');try{await enterVillage()}catch(_){}
      await refresh()},'gmww-pr-main'),btn('Xoá phòng',deleteRoom,'gmww-pr-danger'));
    else roomDetails(box,st,room,players,room.seatsLocked===true);
    box.append(el('div','gmww-pr-sub','2. TẠO PHÒNG'));
    box.append(btn('Tạo phòng riêng',create,'gmww-pr-main',!!pr.own));
    box.append(el('div','gmww-pr-sub','3. VÀO PHÒNG'));
    const row=el('div','gmww-pr-row'),inp=el('input');inp.id='gmwwPrJoin';inp.placeholder='Nhập mã phòng';inp.maxLength=8;inp.autocapitalize='characters';inp.style.textTransform='uppercase';
    // The panel is rebuilt on every refresh / button press, so the typed code lives in pr.joinCode, not only in the input.
    inp.value=pr.joinCode||'';inp.addEventListener('input',()=>{pr.joinCode=inp.value});
    row.append(inp,btn('Vào Game',async()=>{await joinByCode(pr.joinCode)}));box.append(row);
  }
  function viewSeats(box,st,room,players,locked){
    box.append(el('div','gmww-pr-sub','PHÂN BỐ VỊ TRÍ • '+players.length+' người • '+(locked?'ĐÃ CHỐT':'Tự xếp')));
    box.append(el('p','gmww-pr-help',locked?'Đã chốt chỗ. Bấm GIẢI TÁN nếu cần xếp lại.':'Mọi người ngồi quanh đống lửa. Kéo trên cảnh làng để dời cả khối, hai ngón để chỉnh khoảng cách.'));
    const row=el('div','gmww-pr-line');
    if(!locked)row.append(btn('Về giữa',async()=>{await callOwner('room-settings','POST',{seatOffset:{x:0,y:0},seatSpacing:100});await refresh()}));
    row.append(btn(locked?'↩ GIẢI TÁN':'✓ CHỐT CHỖ',async()=>{await callOwner('seat-lock','POST',{locked:!locked});say(locked?'Đã giải tán, mở lại chỗ ngồi.':'Đã chốt chỗ ngồi.');await refresh()},locked?null:'gmww-pr-main'));
    if(locked)row.append(btn('TIẾP: VÁN MẪU →',async()=>goStep('game'),'gmww-pr-main'));
    box.append(row);
    const det=el('details','gmww-pr-seatlist'),sum=el('summary',null,'Danh sách chỗ ngồi');det.append(sum);
    if(pr.seatListOpen)det.open=true;det.addEventListener('toggle',()=>{pr.seatListOpen=det.open});
    const list=el('div','gmww-pr-list');
    for(const p of players){const line=el('div','gmww-pr-player'),isOwner=String(p.loginId||'')===String(st?.ownerLoginId||'');
      line.append(el('span',null,(p.seatId?('#'+p.seatId+'  '):'')+(p.displayName||p.loginId||'?')+(isOwner?'  ★':'')));
      if(!isOwner&&!locked){const k=btn('Kick',async()=>{await callOwner('kick','POST',{loginId:p.loginId});await refresh()},'gmww-pr-kick');line.append(k)}
      list.append(line)}
    if(!players.length)list.append(el('p','gmww-pr-help','Chưa có ai trong phòng.'));
    det.append(list);box.append(det);
  }
  // Kéo cả khối seat trên cảnh làng (như GM Server): 1 ngón dời, 2 ngón chỉnh khoảng cách; chạm không kéo thì đóng trang.
  const seatDragOn=()=>!!(pr.open&&pr.view==='seats'&&pr.own&&inOwnRoom()&&pr.state?.room?.seatsLocked!==true&&String(pr.state?.room?.phase||'lobby').toLowerCase()!=='running');
  function installSeatDrag(back){
    const pts=new Map();let g=null,moved=false;
    const frame=()=>document.getElementById('gmwwVillageFrame')?.getBoundingClientRect()||{width:innerWidth,height:innerHeight};
    const room=()=>pr.state?.room||{},cur=()=>({x:Number(room().seatOffset?.x)||0,y:Number(room().seatOffset?.y)||0,sp:Number(room().seatSpacing)||100});
    const dist=()=>{const [a,b]=[...pts.values()];return Math.hypot(a.x-b.x,a.y-b.y)};
    const preview=v=>{window.gmwwSeatPreview=v;try{syncVillageFrame(true)}catch(_){}};
    back.addEventListener('pointerdown',e=>{
      if(!seatDragOn()||pts.size>=2)return;
      pts.set(e.pointerId,{x:e.clientX,y:e.clientY});try{back.setPointerCapture(e.pointerId)}catch(_){}
      const c=cur();g=pts.size===2?{pinch:true,d:Math.max(1,dist()),c}:{x:e.clientX,y:e.clientY,c};
    });
    back.addEventListener('pointermove',e=>{
      if(!pts.has(e.pointerId)||!g)return;pts.set(e.pointerId,{x:e.clientX,y:e.clientY});
      if(g.pinch&&pts.size===2){moved=true;preview({x:g.c.x,y:g.c.y,sp:Math.max(50,Math.min(300,Math.round(g.c.sp*dist()/g.d)))});e.preventDefault();return}
      if(g.pinch||pts.size!==1)return;
      const dx=e.clientX-g.x,dy=e.clientY-g.y;if(!moved&&Math.hypot(dx,dy)<6)return;moved=true;
      const f=frame();preview({x:g.c.x+dx/Math.max(1,f.width)*100,y:g.c.y+dy/Math.max(1,f.height)*100,sp:g.c.sp});e.preventDefault();
    },{passive:false});
    const end=async e=>{
      if(!pts.has(e.pointerId))return;pts.delete(e.pointerId);try{back.releasePointerCapture(e.pointerId)}catch(_){}
      if(pts.size)return;
      const was=moved,pv=window.gmwwSeatPreview;g=null;moved=false;
      if(!was){return}
      pr.suppressBackClick=true;setTimeout(()=>{pr.suppressBackClick=false},500);
      if(e.type==='pointercancel'||!pv){preview(null);return}
      try{await callOwner('room-settings','POST',{seatOffset:{x:pv.x,y:pv.y},seatSpacing:pv.sp});await refresh()}catch(err){say(errText(err))}
      preview(null);
    };
    back.addEventListener('pointerup',end);back.addEventListener('pointercancel',end);
  }
  // Seats are filled by the server from the sample layout; nobody moves them by hand (online play).
  function autoSeat(){
    const st=pr.state;if(!st||pr.busy||pr.autoSeating||!pr.own||!inOwnRoom())return;
    const room=st.room||{},ps=Array.isArray(st.players)?st.players:[];
    if(room.seatsLocked===true||String(room.phase||'lobby').toLowerCase()==='running'||!ps.some(p=>!p.seatId))return;
    if(!(pr.view==='seats'||stepNow()==='seats'))return;
    pr.autoSeating=true;
    (async()=>{try{
      if(ps.length>(Number(room.seatCount)||0))await callOwner('room-settings','POST',{seatCount:Math.min(30,Math.max(6,ps.length))});
      await callOwner('seats-randomize','POST',{});pr.state=await api(base()+'state',{headers:oh()});render();
    }catch(_){}finally{pr.autoSeating=false}})();
  }
  const TIMING=[['villageDiscussionSec','Thảo luận làng',300],['gallowsNominationSec','Đề cử Lên Giàn',60],['gallowsVoteSec','Bỏ phiếu Lên Giàn',60],['wolfDiscussionSec','Sói nhận diện nhau',30],['earlyArtifactSec','Artifact ưu tiên đầu ván',30],['defaultActionSec','Hành động mặc định',30],['artifactActionSec','Hành động Artifact',30]];
  const freshTiming=()=>Object.fromEntries(TIMING.map(([k,,d])=>[k,d]));
  // Ván Mẫu uses the same complete role, Artifact, order and timing configuration as the GM Server.
  function viewGame(box,st,room,players,locked){
    const tab=pr.gameTab==='make'?'make':'pick',tabs=el('div','gmww-pr-tabs');
    for(const [k,t] of [['make','Thiết kế Ván Mẫu'],['pick','Ván Mẫu Server']]){const b=el('button',k===tab?'is-on':null,t);b.type='button';b.addEventListener('click',()=>{pr.gameTab=k;render()});tabs.append(b)}
    box.append(tabs);
    if(tab==='make')deckBuilder(box,players.length);else pickTemplates(box,st,players);
    box.append(btn('TIẾP: PHÂN VAI →',async()=>goStep('roles'),'gmww-pr-main'));
  }
  function pickTemplates(box,st,players){
    const cfg=st?.config,need=deckSize(cfg);
    box.append(el('p','gmww-pr-help','Chọn cấu hình Ván Mẫu đã lưu trên Server. Vai trò, Artifact và thời gian sẽ được áp dụng nguyên cấu hình. Cần '+players.length+' lá bài cho phòng này.'));
    if(pr.catalogStatus==='loading'||pr.catalogStatus==='idle')box.append(el('p','gmww-pr-help','Đang tải Ván Mẫu Server…'));
    else if(pr.catalogStatus==='error')box.append(el('p','gmww-pr-note','Không tải được Ván Mẫu Server: '+pr.catalogError));
    else if(!pr.templates.length)box.append(el('p','gmww-pr-help','Chưa có Ván Mẫu trên Server.'));
    for(const t of pr.templates){
      const card=el('div','gmww-pr-tpl'+(cfg?.id===t.id?' is-on':'')),fit=Number(t.playerCount)===players.length;
      const head=el('div'),tc=t.compiledConfig||t.gameConfig||{},roles=Array.isArray(tc.roles)?tc.roles:[],arts=tc.artifactsEnabled===true?(tc.artifacts||[]):[];
      head.append(el('b',null,t.name||'Ván Mẫu'),el('small',null,(t.playerCount||'?')+' người'+(fit?' • vừa đủ':'')+' • '+roles.length+' loại Vai'+(arts.length?' • '+arts.length+' Artifact':' • không Artifact')));
      const detail=el('small','gmww-pr-tpldetail',roles.map(r=>(r.roleName||r.roleId)+' × '+(r.count||1)).join(' · '));head.append(detail);
      const timing=tc.timing||{};head.append(el('small','gmww-pr-tpldetail','Thảo luận '+(timing.villageDiscussionSec??300)+'s • Lên Giàn '+(timing.gallowsNominationSec??60)+'/'+(timing.gallowsVoteSec??60)+'s • Auto '+(timing.autoAdvance===false?'Tắt':'Bật')));
      const acts=el('div','gmww-pr-tplacts');
      acts.append(btn(cfg?.id===t.id?'ĐANG DÙNG':'Chọn Ván Mẫu',async()=>{await callOwner('template','POST',{templateId:t.id});say('Đã nạp đầy đủ Ván Mẫu từ Server.');await refresh()},null,cfg?.id===t.id));
      if(t.canEdit===true)acts.append(btn('Chỉnh sửa',async()=>editTemplate(t)),btn('Xoá mẫu',async()=>{if(!confirm('Xoá Ván Mẫu "'+(t.name||'')+'"?'))return;await callOwner('template-delete','POST',{templateId:t.id});await loadTemplates();say('Đã xoá Ván Mẫu.')},'gmww-pr-danger'));
      card.append(head,acts);box.append(card)}
    if(cfg){const selected=(cfg.artifacts||[]).map(a=>a.name||a.artifactId).filter(Boolean);box.append(el('p','gmww-pr-help','Đang chọn: '+(cfg.name||cfg.id)+' • '+need+' lá bài • Artifact: '+(cfg.artifactsEnabled?selected.join(', ')||'đã bật':'tắt')))}
  }
  function editTemplate(t){
    const cfg=t?.compiledConfig;if(!cfg)return;
    pr.editTemplateId=String(t.id||'');pr.deckName=String(t.name||cfg.name||'Ván của tôi');pr.deck=new Map((cfg.roles||[]).map(r=>[String(r.roleId),Math.max(0,Number(r.count)||0)]).filter(([id,n])=>id&&n));
    pr.roleOrder=new Map((cfg.roles||[]).map(r=>[String(r.roleId),Number(r.order)||0]));pr.secs=new Map((cfg.roles||[]).map(r=>[String(r.roleId),Number(r.actionDurationSec)]).filter(([,n])=>Number.isFinite(n)));
    pr.timing={...freshTiming(),...(cfg.timing||{})};pr.artifactIds=new Set(cfg.artifactsEnabled===true?(cfg.artifacts||[]).map(a=>String(a.artifactId||'')).filter(Boolean):[]);pr.artifactLimitPerCycle=Math.max(0,Number(cfg.artifactLimitPerCycle??3)||0);pr.gameTab='make';render();
  }
  // Full Ván Mẫu editor: roles and order, per-role action time, Artifact pool/quota, game timing.
  function deckBuilder(box,people){
    box.append(el('div','gmww-pr-sub','THIẾT KẾ VÁN MẪU'));
    if(pr.catalogStatus==='loading'||pr.catalogStatus==='idle'){box.append(el('p','gmww-pr-help','Đang tải danh sách vai từ Ván Mẫu Server…'));return}
    if(pr.catalogStatus==='error'){box.append(el('p','gmww-pr-note','Không tải được danh sách Ván Mẫu Server: '+pr.catalogError),btn('TẢI LẠI DANH SÁCH',async()=>{await loadTemplates()},'gmww-pr-main'));return}
    if(!pr.roles.length){box.append(el('p','gmww-pr-help','Chưa có vai trong các Ván Mẫu Server đã lưu. Chọn tab “Ván Mẫu Server” để dùng mẫu có sẵn.'));return}
    if(pr.catalogError)box.append(el('p','gmww-pr-note','Danh sách Vai Trò đã tải từ Ván Mẫu Server; danh sách Artifact chưa tải được: '+pr.catalogError));
    if(!pr.timing)pr.timing=freshTiming();if(!pr.secs)pr.secs=new Map();
    const name=el('input');name.id='gmwwPrDeckName';name.maxLength=48;name.placeholder='Tên Ván Mẫu';name.value=pr.deckName;name.addEventListener('input',()=>{pr.deckName=name.value});box.append(name);
    const sum=el('div','gmww-pr-note');sum.id='gmwwPrDeckSum';box.append(sum);
    const total=()=>[...pr.deck.values()].reduce((a,b)=>a+b,0);
    const refreshSum=()=>{const t=total(),ok=t>0&&t<=30;sum.textContent='Đã chọn '+t+' lá • Số người '+people+(t===people?' • Đủ':t>people?' • Thừa '+(t-people):' • Thiếu '+(people-t));const a=document.getElementById('gmwwPrDeckApply');if(a)a.disabled=pr.busy||!ok};
    const num=(val,onSet)=>{const i=el('input');i.type='number';i.inputMode='numeric';i.min='0';i.max='3600';i.value=String(val);i.className='gmww-pr-sec-in';i.addEventListener('input',()=>onSet(Math.max(0,Math.min(3600,Math.trunc(Number(i.value)||0)))));return i};
    const groups=new Map();for(const r of pr.roles){const f=r.faction||'Khác';if(!groups.has(f))groups.set(f,[]);groups.get(f).push(r)}
    for(const [f,rows] of groups){
      const sec=el('div','gmww-pr-deck');sec.append(el('small',null,f));
      for(const r of rows){
        const line=el('div','gmww-pr-deckrow'),cnt=el('b',null,String(pr.deck.get(r.roleId)||0)),minus=el('button','gmww-pr-step','−'),plus=el('button','gmww-pr-step','+'),secIn=num(pr.secs.has(r.roleId)?pr.secs.get(r.roleId):pr.timing.defaultActionSec,v=>pr.secs.set(r.roleId,v));
        minus.type=plus.type='button';secIn.title='Giây hành động';secIn.style.display=pr.deck.get(r.roleId)?'':'none';
        const set=n=>{n=Math.max(0,Math.min(30,n));if(n)pr.deck.set(r.roleId,n);else pr.deck.delete(r.roleId);cnt.textContent=String(n);secIn.style.display=n?'':'none';refreshSum()};
        minus.addEventListener('click',()=>set((pr.deck.get(r.roleId)||0)-1));plus.addEventListener('click',()=>set((pr.deck.get(r.roleId)||0)+1));
        const order=el('span','gmww-pr-order',String(pr.roleOrder?.get(r.roleId)||r.order||1)),up=el('button','gmww-pr-step','↑'),down=el('button','gmww-pr-step','↓');up.title='Đưa vai lên trước';down.title='Đưa vai xuống sau';
        const move=delta=>{const active=pr.roles.filter(x=>pr.deck.has(x.roleId)).sort((a,b)=>(pr.roleOrder?.get(a.roleId)||a.order||999)-(pr.roleOrder?.get(b.roleId)||b.order||999));const at=active.findIndex(x=>x.roleId===r.roleId),to=Math.max(0,Math.min(active.length-1,at+delta));if(at<0||to===at)return;[active[at],active[to]]=[active[to],active[at]];pr.roleOrder=new Map(active.map((x,i)=>[x.roleId,i+1]));render()};up.addEventListener('click',()=>move(-1));down.addEventListener('click',()=>move(1));
        const ctl=el('div','gmww-pr-ctl');ctl.append(order,up,down,secIn,minus,cnt,plus);line.append(el('span',null,r.roleName||r.roleId),ctl);sec.append(line)}
      box.append(sec)}
    const artifacts=el('div','gmww-pr-deck');artifacts.append(el('small',null,'ARTIFACT • chọn các lá có thể phát trong ván'));
    if(!pr.artifacts.length)artifacts.append(el('p','gmww-pr-help','Chưa có Artifact đã đồng bộ từ Server.'));
    for(const a of pr.artifacts){const line=el('label','gmww-pr-deckrow'),check=el('input');check.type='checkbox';check.checked=pr.artifactIds?.has(a.artifactId)||false;check.addEventListener('change',()=>{if(!pr.artifactIds)pr.artifactIds=new Set();if(check.checked)pr.artifactIds.add(a.artifactId);else pr.artifactIds.delete(a.artifactId)});line.append(check,el('span',null,a.name||a.artifactId),el('small',null,a.singleUse?'Dùng một lần':''));artifacts.append(line)}
    const quotaLine=el('div','gmww-pr-deckrow');quotaLine.append(el('span',null,'Artifact tối đa mỗi Ngày / Đêm'),num(pr.artifactLimitPerCycle??3,v=>{pr.artifactLimitPerCycle=v}));artifacts.append(quotaLine);box.append(artifacts);
    const tl=el('div','gmww-pr-deck');tl.append(el('small',null,'TIMELINE (giây)'));
    for(const [k,label] of TIMING){const line=el('div','gmww-pr-deckrow');line.append(el('span',null,label),num(pr.timing[k],v=>{pr.timing[k]=v}));tl.append(line)}
    const auto=el('label','gmww-pr-deckrow'),autoCheck=el('input');autoCheck.type='checkbox';autoCheck.checked=pr.timing.autoAdvance!==false;auto.append(autoCheck,el('span',null,'Tự động chuyển vai khi hết giờ'));autoCheck.addEventListener('change',()=>{pr.timing.autoAdvance=autoCheck.checked});tl.append(auto);box.append(tl);
    box.append(tl);
    const row=el('div','gmww-pr-line');
    const save=btn('LƯU VÁN',async()=>{
      const roles=[...pr.deck].map(([roleId,count],i)=>({roleId,count,order:pr.roleOrder?.get(roleId)||i+1,actionDurationSec:pr.secs.has(roleId)?pr.secs.get(roleId):pr.timing.defaultActionSec}));
      const artifacts=[...(pr.artifactIds||new Set())].map((artifactId,i)=>({artifactId,order:i+1}));
      await callOwner('template-save','POST',{templateId:pr.editTemplateId||'',name:pr.deckName.trim()||'Ván của tôi',roles,timing:pr.timing,artifactsEnabled:artifacts.length>0,artifacts,artifactLimitPerCycle:pr.artifactLimitPerCycle??3});
      say(pr.editTemplateId?'Đã cập nhật Ván Mẫu trên Server.':'Đã lưu đầy đủ Ván Mẫu trên Server.');pr.editTemplateId='';pr.deckName='';pr.deck=new Map();pr.secs=new Map();pr.roleOrder=new Map();pr.artifactIds=new Set();pr.artifactLimitPerCycle=3;pr.timing=freshTiming();pr.gameTab='pick';await loadTemplates()},'gmww-pr-main');save.id='gmwwPrDeckApply';
    save.textContent=pr.editTemplateId?'CẬP NHẬT VÁN MẪU':'LƯU VÁN MẪU';
    const clear=btn('MẪU MỚI',async()=>{pr.editTemplateId='';pr.deckName='';pr.deck=new Map();pr.secs=new Map();pr.roleOrder=new Map();pr.artifactIds=new Set();pr.artifactLimitPerCycle=3;pr.timing=freshTiming();render()},'gmww-pr-danger');
    row.append(save,clear);box.append(row);
    refreshSum();
  }
  function viewRoles(box,st,room,players){
    const cfg=st?.config,need=deckSize(cfg),ok=!!cfg&&need===players.length,rounds=Number(st?.dealRound)||0;
    const g=el('div','gmww-pr-grid');g.append(stat('Lá bài',need||'—'),stat('Đã phân',rounds+' lần'));box.append(g);
    if(!cfg){box.append(el('p','gmww-pr-note','Chưa chọn Ván Mẫu.'),btn('← VÁN MẪU',async()=>goStep('game')));return}
    box.append(el('p','gmww-pr-help','Bấm PHÂN VAI NGẪU NHIÊN để máy chủ xáo bài kín. Có thể phân nhiều lần. Để giữ bí mật, không ai (kể cả bạn) thấy ai giữ vai hay Artifact nào.'));
    if(!ok)box.append(el('p','gmww-pr-note','Số lá bài ('+need+') chưa bằng số người ('+players.length+'). Hãy đổi Ván Mẫu hoặc điều chỉnh số người.'));
    if(cfg.artifactsEnabled)box.append(el('p','gmww-pr-note','Artifact được trộn và phát ngẫu nhiên cùng với Vai Trò. Người chủ phòng không thấy ai nhận lá nào.'));
    box.append(btn('🎲 PHÂN VAI NGẪU NHIÊN',async()=>{await callOwner('roles-shuffle','POST',{});say('Đã trộn Vai Trò và Artifact kín trên Server.');await refresh()},'gmww-pr-main',!ok));
    const row=el('div','gmww-pr-tools');row.append(btn('← VÁN MẪU',async()=>goStep('game')),btn('TIẾP: PHÁT VAI →',async()=>goStep('deal'),'gmww-pr-main',!ok));box.append(row);
  }
  function viewDeal(box,st,room,players,locked){
    const cfg=st?.config,need=deckSize(cfg),why=!cfg?'Chưa chọn Ván Mẫu.':!locked?'Hãy chốt chỗ ngồi ở bước Tập hợp.':need!==players.length?'Số lá bài ('+need+') chưa bằng số người ('+players.length+').':'';
    const g=el('div','gmww-pr-grid');g.append(stat('Người chơi',players.length),stat('Lá bài',need||'—'));box.append(g);
    box.append(el('p','gmww-pr-help','Bấm PHÁT VAI: máy chủ xáo bài ngẫu nhiên, mỗi người tự xem vai của mình, rồi vào Đêm 1. Bạn không biết ai nhận vai nào.'));
    if(why)box.append(el('p','gmww-pr-note',why));
    box.append(btn('🎴 PHÁT VAI & VÀO TRẬN',async()=>{await callOwner('start','POST',{});say('Đã phát vai. Ván bắt đầu.');pr.view='battle';await refresh()},'gmww-pr-main',!!why));
    box.append(btn('← PHÂN VAI',async()=>goStep('roles')));
  }
  function viewBattle(box,st,room,players,running){
    const g=el('div','gmww-pr-grid');g.append(stat('Trạng thái',running?'Đang chơi':'Chưa bắt đầu'),stat('Người chơi',players.length));box.append(g);
    if(running){box.append(el('p','gmww-pr-help','Quản Trò Tự Động đang điều hành. Ván tự kết thúc khi có phe thắng.'));
      box.append(btn('KẾT THÚC SỚM',async()=>{if(!confirm('Kết thúc ván ngay?'))return;await callOwner('end','POST',{});say('Đã kết thúc ván.');pr.view='lobby';await refresh()},'gmww-pr-danger'))}
    else box.append(el('p','gmww-pr-help','Ván chưa bắt đầu. Quay lại bước Phát Vai.'),btn('← PHÁT VAI',async()=>goStep('deal')));
  }
  const stepNow=()=>{const room=pr.state?.room||{};return String(room.phase||'lobby').toLowerCase()==='running'?'battle':serverStep(room)};
  const inOwnRoom=()=>!!(pr.own&&state?.roomCode&&String(state.roomCode).toUpperCase()===String(pr.own.code).toUpperCase());
  function openSheet(){closeChat();pr.open=true;pr.touched=false;render();loadTemplates().then(render).catch(()=>render());refresh()}
  function closeSheet(){pr.open=false;render()}
  window.gmwwOpenCreateRoom=()=>{if(pr.own&&!inOwnRoom()){/* own room exists but the player is elsewhere */}openSheet()};
  // ---- Trang rời (Phòng, Chat): kéo được bằng thanh nắm/tiêu đề, hít vào menu trên/dưới (như màn Server), bấm ngoài để đóng.
  const DOCK_KEY='gmww_pr_dock_v1',SNAP_PX=32;
  const readDock=()=>{try{const v=JSON.parse(localStorage.getItem(DOCK_KEY)||'{}');return v&&typeof v==='object'&&!Array.isArray(v)?v:{}}catch(_){return{}}};
  function saveDock(id,edge){const v=readDock();if(edge==='top'||edge==='bottom')v[id]=edge;else delete v[id];try{localStorage.setItem(DOCK_KEY,JSON.stringify(v))}catch(_){}}
  // Visible menu bars (the bars live in shadow roots); null when a bar is not on screen.
  function barRects(){
    const rect=(hostId,innerId)=>{const h=document.getElementById(hostId);if(!h||h.hidden||!h.getClientRects().length)return null;
      const r=(h.shadowRoot?.getElementById(innerId)||h).getBoundingClientRect();return r.width>40&&r.height>10?r:null};
    return{top:rect('gmwwStageStrip','playSetupStrip'),bottom:rect('gmwwOwnerDock','gmTopMenu')};
  }
  function placeGeometry(panel,edge,bars){
    const gap=5,vw=innerWidth,vh=innerHeight,top=bars.top?bars.top.bottom+gap:8,bot=bars.bottom?bars.bottom.top-gap:vh-8;
    const ref=(edge==='top'?bars.top:bars.bottom)||bars.bottom||bars.top,width=Math.min(ref?ref.width:vw,vw-16),left=ref?ref.left+(ref.width-width)/2:(vw-width)/2;
    return{top,bot,width,left:Math.max(8,Math.min(vw-width-8,left)),maxH:Math.max(180,Math.min(bot-top,vh-290))};
  }
  function place(panel){
    if(!panel||panel.hidden||panel.dataset.prDragging==='1')return;
    const bars=barRects(),saved=readDock()[panel.id],edge=pr.pos&&pr.pos[panel.id]?'free':(saved==='top'?'top':'bottom'),g=placeGeometry(panel,edge,bars),st=panel.style;
    st.right='auto';st.transform='none';panel.classList.remove('gmww-dock-near');
    if(edge==='free'){
      const q=pr.pos[panel.id],w=Math.min(q.width||g.width,innerWidth-12),h=panel.offsetHeight||200;
      st.width=w+'px';st.left=Math.max(6,Math.min(innerWidth-w-6,q.left))+'px';st.top=Math.max(6,Math.min(innerHeight-h-6,q.top))+'px';st.bottom='auto';st.maxHeight=Math.max(180,innerHeight-parseFloat(st.top)-8)+'px';panel.classList.remove('gmww-dock-snapped');return;
    }
    st.width=g.width+'px';st.left=g.left+'px';st.maxHeight=g.maxH+'px';panel.classList.add('gmww-dock-snapped');
    if(edge==='top'){st.top=g.top+'px';st.bottom='auto'}else{st.top='auto';st.bottom=(innerHeight-g.bot)+'px'}
  }
  // Which menu edge a released page would stick to (or null when it is farther than 32px from both).
  function snapFor(rect){
    const bars=barRects();let best=null;
    if(bars.top){const d=Math.abs(rect.top-(bars.top.bottom+5));if(d<=SNAP_PX)best={edge:'top',d}}
    if(bars.bottom){const d=Math.abs(rect.bottom-(bars.bottom.top-5));if(d<=SNAP_PX&&(!best||d<best.d))best={edge:'bottom',d}}
    return best;
  }
  function floatPage(panel){
    if(!panel||panel.dataset.prFloat==='1')return;panel.dataset.prFloat='1';let drag=null;
    panel.addEventListener('pointerdown',e=>{
      if(panel.hidden||(e.button!==0&&e.pointerType!=='touch'))return;
      if(!e.target.closest('.gmww-pr-grip,.gmww-pr-head')||e.target.closest('button,input,select,textarea,a'))return;
      const r=panel.getBoundingClientRect();drag={id:e.pointerId,x:e.clientX,y:e.clientY,left:r.left,top:r.top,w:r.width,h:r.height};
      panel.dataset.prDragging='1';try{panel.setPointerCapture(e.pointerId)}catch(_){}e.preventDefault();
    });
    panel.addEventListener('pointermove',e=>{
      if(!drag||e.pointerId!==drag.id)return;const st=panel.style;
      const left=Math.max(6,Math.min(innerWidth-drag.w-6,drag.left+e.clientX-drag.x)),top=Math.max(6,Math.min(innerHeight-drag.h-6,drag.top+e.clientY-drag.y));
      st.width=drag.w+'px';st.left=left+'px';st.top=top+'px';st.right='auto';st.bottom='auto';st.transform='none';st.maxHeight=Math.max(180,innerHeight-top-8)+'px';
      panel.classList.remove('gmww-dock-snapped');panel.classList.toggle('gmww-dock-near',!!snapFor({top,bottom:top+drag.h}));e.preventDefault();
    });
    const stop=e=>{
      if(!drag||e.pointerId!==drag.id)return;const r=panel.getBoundingClientRect(),snap=e.type==='pointerup'?snapFor(r):null;
      drag=null;panel.dataset.prDragging='0';panel.classList.remove('gmww-dock-near');try{panel.releasePointerCapture(e.pointerId)}catch(_){}
      pr.pos=pr.pos||{};
      if(snap){delete pr.pos[panel.id];saveDock(panel.id,snap.edge)}else{pr.pos[panel.id]={left:r.left,top:r.top,width:r.width};saveDock(panel.id,null)}
      place(panel);
    };
    panel.addEventListener('pointerup',stop);panel.addEventListener('pointercancel',stop);
  }
  // Chat là một trang rời riêng (nút Box Chat ở thanh dưới), không nằm trong trang Phòng.
  function closeChat(){
    const page=document.getElementById('gmwwPrChat'),chat=document.getElementById('gmwwChatPanel');
    const was=pr.chatOpen;pr.chatOpen=false;if(page)page.hidden=true;
    if(chat&&page&&page.contains(chat)){chat.classList.remove('open');document.body.appendChild(chat)}
    if(was)render();
  }
  function openChat(){
    const page=document.getElementById('gmwwPrChat'),host=page?.querySelector('.gmww-pr-chatbody'),chat=document.getElementById('gmwwChatPanel');
    if(!page||!host)return;
    if(!state?.roomCode||!chat){try{toast('Box Chat mở được khi bạn đã ở trong phòng.')}catch(_){}return}
    pr.open=false;render();host.appendChild(chat);chat.classList.add('open');pr.chatOpen=true;page.hidden=false;render();place(page);
    try{document.getElementById('gmwwChatText')?.focus({preventScroll:true})}catch(_){}
  }
  // Bấm ra ngoài trang thì đóng trang trên cùng (như Server); thanh menu trên/dưới vẫn bấm được.
  function dismissOutside(e){
    const t=e.target;if(!t?.closest||(e.pointerType==='mouse'&&e.button!==0))return;
    if(t.closest('#gmwwStageStrip,#gmwwOwnerDock,#gmwwToast'))return;
    const chatPage=document.getElementById('gmwwPrChat'),panel=document.getElementById('gmwwPrPanel');
    const chatUp=pr.chatOpen&&chatPage&&!chatPage.hidden&&!chatPage.contains(t),sheetUp=pr.open&&panel&&!panel.hidden&&!panel.contains(t);
    if(!chatUp&&!sheetUp)return;
    if(sheetUp&&!chatUp&&seatDragOn()&&t.id==='gmwwPrBack')return;
    e.preventDefault();e.stopImmediatePropagation();
    // keep an invisible catcher for a moment so the finger-up click does not land on the village underneath
    pr.holdBack=true;setTimeout(()=>{pr.holdBack=false;render()},450);
    if(chatUp)closeChat();else closeSheet();
  }
  function render(){
    const panel=document.getElementById('gmwwPrPanel'),back=document.getElementById('gmwwPrBack');if(!panel||!back)return;
    panel.hidden=!pr.open;back.hidden=!(pr.open||pr.chatOpen||pr.holdBack);back.classList.toggle('seatdrag',seatDragOn());renderChrome();if(!pr.open)return;
    panel.textContent='';
    const head=el('header','gmww-pr-head'),close=el('button','gmww-pr-close','×');close.type='button';close.setAttribute('aria-label','Đóng');close.addEventListener('click',closeSheet);
    head.append(el('b',null,pr.view==='room'||!pr.own?'Phòng':(pr.state?.room?.roomName||LABEL[pr.view]||'Phòng')),close);panel.append(el('i','gmww-pr-grip'),head);
    const body=el('div','gmww-pr-body');
    if(!pr.own||pr.view==='room'&&!inOwnRoom()){
      viewRoomHub(body,pr.state,pr.state?.room||{},Array.isArray(pr.state?.players)?pr.state.players:[]);
    }else{
      const st=pr.state,room=st?.room||{},players=Array.isArray(st?.players)?st.players:[],running=String(room.phase||'lobby').toLowerCase()==='running';
      const locked=room.seatsLocked===true;if(!pr.view||!ORDER.includes(pr.view))pr.view=stepNow();
      if(!inOwnRoom())body.append(el('p','gmww-pr-note','Bạn đang ở ngoài phòng '+pr.own.code+'. Vào lại phòng để dùng thanh điều khiển.'),btn('VÀO LẠI PHÒNG '+pr.own.code,async()=>{if(!await window.joinRoom(pr.own.code))throw new Error('Không vào lại được phòng.');pr.open=false;try{await enterVillage()}catch(_){}}));
      const sec=el('section','gmww-pr-sec');
      ({lobby:viewLobby,room:viewRoomHub,seats:viewSeats,game:viewGame,roles:viewRoles,deal:viewDeal,battle:viewBattle})[pr.view](sec,st,room,players,pr.view==='battle'?running:locked);
      if(running&&pr.view!=='battle')sec.prepend(el('p','gmww-pr-note','Ván đang chạy: các bước chuẩn bị chỉ để xem.'));
      body.append(sec);
    }
    const status=el('div','gmww-pr-status');status.id='gmwwPrStatus';status.textContent=pr.msg;body.append(status);
    panel.append(body);place(panel);
  }
  // Top strip + bottom dock are the GM Server's own markup and CSS (GMWW_SERVER_MENU), shown to every logged-in player.
  const LABEL={lobby:'SẢNH CHỜ',room:'PHÒNG',seats:'TẬP HỢP',game:'VÁN MẪU',roles:'PHÂN VAI',deal:'PHÁT VAI',battle:'VÀO TRẬN'};
  const ORDER=['lobby','room','seats','game','roles','deal','battle'];
  const barScreen=()=>!!(state?.token&&state?.member&&!['','login','register'].includes(state.activeScreenId||''));
  // The step every player sees: the owner's own view, otherwise the stage the server publishes for the room.
  function stripNow(){
    if(!state?.roomCode)return 'lobby';
    const r=(pr.own&&inOwnRoom()?pr.state?.room:state?.room)||{};
    if(String(r.phase||'').toLowerCase()==='running')return 'battle';
    const g=String(r.gmStage||'room');return ORDER.includes(g)&&g!=='lobby'?g:'room';
  }
  const SHADOW_BASE=':host{display:block}#start #playShell #gmTopMenu #playAudioTop{display:none!important}';
  function ensureStrip(){
    let host=document.getElementById('gmwwStageStrip');if(host)return host;
    host=el('div');host.id='gmwwStageStrip';host.hidden=true;
    const root=host.attachShadow({mode:'open'}),strip=(GMWW_SERVER_MENU.markup.match(/<section\b[^>]*id="playSetupStrip"[\s\S]*?<\/section>/)||[''])[0];
    root.innerHTML='<style>'+GMWW_SERVER_MENU.css+SHADOW_BASE+'#start #playShell #playSetupStrip.play-setup-strip.gm-stage-timeline-v330{position:relative!important;top:auto!important;bottom:auto!important;left:auto!important;right:auto!important;width:100%!important;max-width:none!important;margin:0!important;transform:none!important;min-height:58px!important;border:0!important;outline:0!important;border-radius:0 0 22px 22px!important;box-shadow:none!important;padding:7px 8px!important;-webkit-mask-image:linear-gradient(180deg,#000 0,#000 72%,transparent 100%);mask-image:linear-gradient(180deg,#000 0,#000 72%,transparent 100%)}</style><div id="start"><div id="playShell" class="play-shell" data-phase="lobby" style="position:relative;height:auto;min-height:0;padding:0;background:none;overflow:visible">'+strip+'</div></div>';
    root.querySelectorAll('#playSetupStrip button').forEach(b=>b.addEventListener('click',()=>onTab(b.dataset.playStep||'room')));
    document.body.appendChild(host);return host;
  }
  // Only the owner of the room they are in drives the steps; everyone can open the Phòng page (create / join / manage).
  async function rejoinOwn(){
    if(await window.joinRoom(pr.own.code)===false)throw new Error('Không vào lại được phòng.');
    try{await enterVillage()}catch(_){}
    await refresh();
  }
  function onTab(k){
    if(k==='room'||k==='lobby'&&!pr.own){pr.view='room';pr.touched=true;openSheet();return}
    if(pr.own&&!inOwnRoom()){run(async()=>{await rejoinOwn();pr.view=k;pr.touched=true;syncStage(k);openSheet()});return}
    if(!(pr.own&&inOwnRoom())){try{toast('Chỉ chủ phòng điều hành các bước này.')}catch(_){}return}
    pr.view=k;pr.touched=true;syncStage(k);if(pr.open)render();else openSheet();
  }
  function ensureDock(){
    let host=document.getElementById('gmwwOwnerDock');if(host)return host;
    host=el('div');host.id='gmwwOwnerDock';host.hidden=true;
    const root=host.attachShadow({mode:'open'});
    root.innerHTML='<style>'+GMWW_SERVER_MENU.css+SHADOW_BASE+'#start #playShell #gmTopMenu.gm-top-menu-v293{position:relative!important;inset:auto!important;left:auto!important;right:auto!important;bottom:auto!important;top:auto!important;width:100%!important;max-width:520px;margin:0 auto!important;transform:none!important;height:62px!important;min-height:62px!important;border:0!important;outline:0!important;background:transparent!important;grid-template-columns:48px 48px minmax(0,1fr) 48px!important}</style><div id="start"><div id="playShell" class="play-shell" data-phase="lobby" style="position:relative;height:auto;min-height:0;padding:0;background:none;overflow:visible">'+GMWW_SERVER_MENU.dock+'</div></div>';
    const q=id=>root.getElementById(id),owner=()=>!!(pr.own&&inOwnRoom());
    q('playPhasePill').addEventListener('click',()=>{
      if(!state?.roomCode&&!pr.own){pr.view='room';openSheet();return}
      if(pr.own&&!owner()){run(async()=>{await rejoinOwn();pr.view='room';pr.touched=true;openSheet()});return}
      if(!owner()){try{toast('Chủ phòng điều hành ván; bạn chỉ cần chờ.')}catch(_){}return}
      const i=ORDER.indexOf(pr.open?pr.view:stepNow()),nxt=ORDER[Math.min(ORDER.length-1,i+1)];
      pr.view=nxt;pr.touched=true;syncStage(nxt);if(pr.open)render();else openSheet();
    });
    q('playExitVillage').addEventListener('click',()=>{
      if(!state?.roomCode){try{go('profile')}catch(_){}return}
      if(confirm(owner()?'Rời phòng của bạn? Phòng trống 30 phút sẽ tự xoá.':'Rời phòng này?'))run(async()=>{closeSheet();await window.leaveRoom()});
    });
    q('playChatTop').addEventListener('click',()=>{
      if(!state?.roomCode){try{toast('Box Chat mở được khi bạn đã ở trong phòng.')}catch(_){}return}
      if(pr.chatOpen){closeChat();return}
      openChat();
    });
    q('playEndGame').addEventListener('click',()=>{if(owner()&&stepNow()==='battle'&&confirm('Kết thúc ván ngay?'))run(async()=>{await callOwner('end','POST',{});say('Đã kết thúc ván.');await refresh()})});
    document.body.appendChild(host);return host;
  }
  function renderChrome(){
    const show=barScreen(),strip=ensureStrip(),dock=ensureDock();
    strip.hidden=dock.hidden=!show;if(!show)return;
    const now=stripNow(),idx=ORDER.indexOf(now),sroot=strip.shadowRoot;
    sroot.querySelectorAll('#playSetupStrip button').forEach(b=>{const k=b.dataset.playStep||'room',i=ORDER.indexOf(k);b.classList.toggle('active',i===idx);b.classList.toggle('done',i<idx);if(i===idx)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current')});
    const root=dock.shadowRoot,title=root.getElementById('playPhaseTitle'),hint=root.getElementById('playPhaseHint'),
      owner=!!(pr.own&&inOwnRoom()),nxt=ORDER[idx+1],label=(owner||!state?.roomCode)&&nxt?LABEL[nxt]:(LABEL[now]||'SẢNH CHỜ'),h=!state?.roomCode?'CHẠM ĐỂ VÀO PHÒNG':!owner?'CHỦ PHÒNG ĐIỀU HÀNH':now==='battle'?'ĐANG CHƠI':'CHẠM ĐỂ TIẾP';
    if(title.textContent!==label)title.textContent=label;if(hint.textContent!==h)hint.textContent=h;
    root.getElementById('playEndGame').style.opacity=owner&&now==='battle'?'1':'.35';
  }
  const renderDock=renderChrome,renderBar=renderChrome;
  async function joinByCode(code){
    code=String(code||'').trim().toUpperCase();
    if(!/^[A-Z0-9]{4,8}$/.test(code)){say('Hãy nhập mã phòng (4–8 ký tự).');return}
    state.lastJoinError=null;
    const ok=await window.joinRoom(code);
    if(ok===false){
      const err=state.lastJoinError||{},c=String(err.code||'');
      say(c==='ROOM_NOT_FOUND'||err.status===404?'Không tìm thấy phòng '+code+'. Hãy kiểm tra lại mã.':(c==='ROOM_IN_PROGRESS'?'Ván đang chơi, không vào giữa trận được.':(err.message&&err.message!==c?err.message:'Không vào được phòng '+code+'.')));return}
    pr.joinCode='';pr.open=false;try{await enterVillage()}catch(_){}render();
  }
  function injectCreateButtons(){renderChrome()}
  function mount(){
    if(!state?.token||!state?.member?.loginId)return;
    injectCreateButtons();
    if(pr.mounted)return;pr.mounted=true;
    document.head.appendChild(el('style',null,'#gmwwSetupTop3{display:none!important}'
      +'#gmwwOwnerDock{position:fixed;left:calc(var(--gmww-player-visible-left,0px) + 8px);right:auto;width:calc(var(--gmww-player-visible-width,100vw) - 16px);top:calc(var(--gmww-player-visible-top,0px) + var(--gmww-player-visible-height,100dvh) - max(8px,env(safe-area-inset-bottom,0px)));bottom:auto;transform:translateY(-100%);box-sizing:border-box;z-index:9650}#gmwwOwnerDock[hidden]{display:none}'
      +'#gmwwStageStrip{position:fixed;left:var(--gmww-player-visible-left,0px);right:auto;top:var(--gmww-player-visible-top,0px);width:var(--gmww-player-visible-width,100vw);max-width:100vw;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);z-index:9650}#gmwwStageStrip[hidden]{display:none}'
      +'body>#gmwwChatPanel{display:none!important}.gmww-pr-chatbody{display:flex;flex-direction:column;padding:10px 12px calc(env(safe-area-inset-bottom,0px) + 12px)}.gmww-pr-chatbody #gmwwChatPanel{position:relative!important;inset:auto!important;transform:none!important;width:100%!important;max-width:none!important;height:300px!important;max-height:300px!important;margin:0!important;display:flex!important;flex-direction:column}'
      +'#gmwwOnlineFooter{display:none!important}#gmwwGameViewTabs{bottom:calc(86px + env(safe-area-inset-bottom))!important}'
      +'.gmww-pr-ctl{display:flex;align-items:center;gap:6px;flex-shrink:0}.gmww-pr-ctl b{min-width:20px;text-align:center}.gmww-pr-order{min-width:18px;text-align:center;opacity:.75}.gmww-pr-panel button.gmww-pr-step{padding:0;width:32px;height:32px;border-radius:50%;font-size:18px;line-height:1}.gmww-pr-tpldetail{display:block;max-width:62vw;white-space:normal!important;line-height:1.35;opacity:.78}'
      +'.gmww-pr-roomrow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px;border-radius:12px;border:1px solid #4fc3f7!important;background:#0b3a5e!important;color:#e8f6ff;text-align:left}.gmww-pr-roomrow div{display:flex;flex-direction:column;gap:2px;min-width:0}.gmww-pr-roomrow small{opacity:.75;font-weight:500}.gmww-pr-roomrow span{font-size:24px}'
      +'.gmww-pr-back{position:fixed;inset:0;z-index:9490;background:rgba(0,0,0,.22)}.gmww-pr-back[hidden]{display:none}.gmww-pr-seatlist summary{padding:8px 2px;font-weight:700;cursor:pointer}.gmww-pr-tabs{display:flex;gap:6px}.gmww-pr-tabs button{flex:1;padding:10px;border-radius:12px;border:1px solid #4fc3f7;background:#0b3a5e;color:#e8f6ff;font-weight:700}.gmww-pr-tabs button.is-on{background:#27c4b3;color:#032}.gmww-pr-tplacts{display:flex;gap:8px;margin-top:6px}.gmww-pr-tplacts button{flex:1}input.gmww-pr-sec-in{width:64px;padding:6px;border-radius:8px;text-align:center}.gmww-pr-back.seatdrag{background:transparent;touch-action:none}'
      +'.gmww-pr-panel{position:fixed;left:0;right:0;bottom:calc(env(safe-area-inset-bottom,0px) + 78px);z-index:9500;max-height:calc(100vh - 290px - env(safe-area-inset-bottom,0px));background:linear-gradient(180deg,#0f4c75,#0a2f4f);color:#e8f6ff;display:flex;flex-direction:column;font-size:15px;border-radius:18px 18px 0 0;border-top:1px solid #4fc3f7;box-shadow:0 -10px 40px #000a}.gmww-pr-panel[hidden]{display:none}'
      +'.gmww-pr-grip{display:block;height:22px;position:relative;touch-action:none;cursor:grab}.gmww-pr-grip::after{content:"";position:absolute;left:50%;top:9px;width:44px;height:4px;margin-left:-22px;border-radius:4px;background:#4fc3f7}.gmww-pr-head{touch-action:none;cursor:grab;user-select:none;-webkit-user-select:none}'
      +'.gmww-pr-panel.gmww-dock-near{outline:2px solid rgba(118,239,224,.68);outline-offset:2px;box-shadow:0 0 0 4px rgba(39,196,179,.11),0 12px 30px rgba(0,15,31,.38)}.gmww-pr-panel.gmww-dock-snapped{border-radius:14px;border:1px solid rgba(120,255,221,.76)}'
      +'.gmww-pr-head{display:flex;justify-content:space-between;align-items:center;padding:8px 16px 10px;font-size:17px;border-bottom:1px solid #1d6fa5}.gmww-pr-close{width:38px;height:38px;border-radius:50%;border:1px solid #4fc3f7;background:#0b3a5e;color:#e8f6ff;font-size:22px}'
      +'.gmww-pr-body{overflow:auto;padding:12px 16px calc(env(safe-area-inset-bottom,0px) + 20px);display:flex;flex-direction:column;gap:10px}'
      +'.gmww-pr-steps{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}.gmww-pr-panel .gmww-pr-steps button{font-size:9px;font-weight:600;min-width:0;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 2px;border-radius:10px;border:1px solid #1d6fa5;background:#0b3a5e;color:#9fd6f5}.gmww-pr-steps span{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#14598a;font-weight:700;font-size:12px}.gmww-pr-steps b{font-weight:600;white-space:nowrap;font-size:8.5px}'
      +'.gmww-pr-panel .gmww-pr-steps .is-now span{background:#4fc3f7;color:#032033}.gmww-pr-panel .gmww-pr-steps .is-view{border-color:#4fc3f7;color:#fff}'
      +'.gmww-pr-sec{display:flex;flex-direction:column;gap:10px}.gmww-pr-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.gmww-pr-stat{background:#0b3a5e;border:1px solid #1d6fa5;border-radius:12px;padding:10px;display:flex;flex-direction:column;gap:2px}.gmww-pr-stat small{opacity:.7;font-size:11px}.gmww-pr-stat b{font-size:18px}'
      +'.gmww-pr-help{margin:0;font-size:13px;opacity:.85;line-height:1.45}.gmww-pr-note{margin:0;padding:10px;border-radius:10px;background:#0b3a5e;border:1px solid #4fc3f7;font-size:13px;line-height:1.45}'
      +'.gmww-pr-panel input,.gmww-pr-panel select{padding:11px;border-radius:10px;border:1px solid #1d6fa5;background:#eaf6ff;color:#06263d;width:100%;box-sizing:border-box;font-size:15px}'
      +'.gmww-pr-panel button{padding:12px;border-radius:12px;border:1px solid #4fc3f7;background:#14598a;color:#fff;font-weight:700;font-size:14px}.gmww-pr-panel button:disabled{opacity:.45}.gmww-pr-panel button.gmww-pr-main{background:#2f8f4e;border-color:#3fb868;color:#fff}.gmww-pr-panel button.gmww-pr-danger{background:#8c2b2b;border-color:#c24646;color:#fff}'
      +'.gmww-pr-row{display:grid;grid-template-columns:1fr auto;gap:8px}.gmww-pr-tools{display:grid;grid-template-columns:1fr 1fr;gap:8px}.gmww-pr-line{display:flex;flex-wrap:nowrap;align-items:center;gap:8px}.gmww-pr-line button{white-space:nowrap;padding:8px 10px}.gmww-pr-linecode{flex:1;text-align:center;font-size:22px;letter-spacing:4px;min-width:0}'
      +'.gmww-pr-list{display:flex;flex-direction:column;gap:6px}.gmww-pr-player{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 10px;border-radius:10px;background:#0b3a5e;border:1px solid #1d6fa5}.gmww-pr-player button.gmww-pr-kick{padding:6px 12px;background:#7f1d1d;font-size:12px}'
      +'.gmww-pr-tpl{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px;border-radius:12px;background:#0b3a5e;border:1px solid #1d6fa5}.gmww-pr-tpl.is-on{border-color:#4fc3f7}.gmww-pr-tpl div{display:flex;flex-direction:column;gap:2px}.gmww-pr-tpl small{opacity:.75}.gmww-pr-tpl button{padding:8px 14px}'
      +'.gmww-pr-deck{background:#0b3a5e;border:1px solid #1d6fa5;border-radius:12px;padding:8px 10px}.gmww-pr-deck small{opacity:.7}.gmww-pr-deckrow{display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #1f2944}.gmww-pr-deckrow:first-of-type{border-top:0}'
      +'.gmww-pr-code{display:flex;flex-direction:column;align-items:center;padding:12px;border-radius:14px;background:#0b3a5e;border:1px solid #4fc3f7}.gmww-pr-code small{opacity:.7;font-size:11px;letter-spacing:.1em}.gmww-pr-code b{font-size:34px;letter-spacing:.18em}.gmww-pr-sub{font-size:11px;font-weight:700;letter-spacing:.05em;opacity:.8}.gmww-pr-who{display:flex;align-items:center;gap:8px;min-width:0}.gmww-pr-dot{width:9px;height:9px;border-radius:50%;background:#3fb868;flex:none}.gmww-pr-dot.is-off{background:#6b7280}.gmww-pr-status{font-size:12px;opacity:.9;min-height:16px}'));
    const back=el('div','gmww-pr-back');back.id='gmwwPrBack';back.hidden=true;back.addEventListener('click',()=>{if(pr.suppressBackClick)return;if(pr.chatOpen)closeChat();if(pr.open)closeSheet()});installSeatDrag(back);
    const panel=el('div','gmww-pr-panel');panel.id='gmwwPrPanel';panel.hidden=true;document.body.append(back,panel);
    const chatPage=el('div','gmww-pr-panel gmww-pr-chatpage');chatPage.id='gmwwPrChat';chatPage.hidden=true;
    const chatHead=el('header','gmww-pr-head'),chatClose=el('button','gmww-pr-close','×');chatClose.type='button';chatClose.setAttribute('aria-label','Đóng');chatClose.addEventListener('click',closeChat);
