      +'.gmww-pr-tpl{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px;border-radius:12px;background:#0b3a5e;border:1px solid #1d6fa5}.gmww-pr-tpl.is-on{border-color:#4fc3f7}.gmww-pr-tpl div{display:flex;flex-direction:column;gap:2px}.gmww-pr-tpl small{opacity:.75}.gmww-pr-tpl button{padding:8px 14px}'
      +'.gmww-pr-deck{background:#0b3a5e;border:1px solid #1d6fa5;border-radius:12px;padding:8px 10px}.gmww-pr-deck small{opacity:.7}.gmww-pr-deckrow{display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #1f2944}.gmww-pr-deckrow:first-of-type{border-top:0}'
      +'.gmww-pr-code{display:flex;flex-direction:column;align-items:center;padding:12px;border-radius:14px;background:#0b3a5e;border:1px solid #4fc3f7}.gmww-pr-code small{opacity:.7;font-size:11px;letter-spacing:.1em}.gmww-pr-code b{font-size:34px;letter-spacing:.18em}.gmww-pr-sub{font-size:11px;font-weight:700;letter-spacing:.05em;opacity:.8}.gmww-pr-who{display:flex;align-items:center;gap:8px;min-width:0}.gmww-pr-dot{width:9px;height:9px;border-radius:50%;background:#3fb868;flex:none}.gmww-pr-dot.is-off{background:#6b7280}.gmww-pr-status{font-size:12px;opacity:.9;min-height:16px}'));
    const back=el('div','gmww-pr-back');back.id='gmwwPrBack';back.hidden=true;back.addEventListener('click',()=>{if(pr.chatOpen)closeChat();if(pr.open)closeSheet()});
    const panel=el('div','gmww-pr-panel');panel.id='gmwwPrPanel';panel.hidden=true;document.body.append(back,panel);
    const chatPage=el('div','gmww-pr-panel gmww-pr-chatpage');chatPage.id='gmwwPrChat';chatPage.hidden=true;
    const chatHead=el('header','gmww-pr-head'),chatClose=el('button','gmww-pr-close','×');chatClose.type='button';chatClose.setAttribute('aria-label','Đóng');chatClose.addEventListener('click',closeChat);
    chatHead.append(el('b',null,'Chat phòng'),chatClose);chatPage.append(el('i','gmww-pr-grip'),chatHead,el('div','gmww-pr-chatbody'));document.body.append(chatPage);
    floatPage(panel);floatPage(chatPage);
    document.addEventListener('pointerdown',dismissOutside,true);
    const replace=()=>{place(panel);place(chatPage)};addEventListener('resize',replace,{passive:true});try{visualViewport?.addEventListener('resize',replace,{passive:true})}catch(_){}
    pr.own=load();
    clearInterval(pr.timer);pr.timer=setInterval(()=>{if(pr.own&&inOwnRoom()&&!document.hidden&&!pr.busy)refresh();else renderDock()},4000);
    setInterval(renderDock,1000);
  }
  setInterval(mount,1500);
})();
