
/* Player-created online rooms: owner console modelled on the GM Server "Chơi" screen (six steps:
   Sảnh chờ, Tập hợp, Ván Mẫu, Phân Vai, Phát Vai, Vào Trận). The owner sees seats and the deck
   (role names and counts) but never who holds which role: the server deals blind at Phát Vai.
   Routes: POST /api/player-rooms, GET /api/player-rooms/templates, /api/player-rooms/:code/owner/*. */
(function gmwwPlayerRooms(){
  const KEY='gmwwOwnedRoom',STEPS=[['lobby','Sảnh chờ'],['room','Phòng Game'],['seats','Tập hợp'],['game','Ván Mẫu'],['roles','Phân Vai'],['deal','Phát Vai'],['battle','Vào Trận']];
  const pr={open:false,mounted:false,busy:false,timer:0,own:null,templates:[],state:null,msg:'',view:'',touched:false};
  const el=(tag,cls,text)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(text!=null)n.textContent=text;return n};
  const load=()=>{try{const v=JSON.parse(localStorage.getItem(KEY)||'null');return v&&v.code&&v.token?v:null}catch(_){return null}};
  const save=v=>{try{if(v)localStorage.setItem(KEY,JSON.stringify(v));else localStorage.removeItem(KEY)}catch(_){}};
  const base=()=>'/api/player-rooms/'+encodeURIComponent(pr.own.code)+'/owner/';
  const oh=()=>({Authorization:'Bearer '+pr.own.token});
  const callOwner=(op,method,body)=>api(base()+op,{method,headers:oh(),body:body===undefined?undefined:JSON.stringify(body)});
  const ERR={OWNER_ALREADY_HAS_ROOM:'Bạn đang có một phòng rồi.',PLAYER_ROOM_LIMIT:'Đã đủ số phòng người chơi cùng lúc. Hãy thử lại sau.',ROOM_NOT_IN_LOBBY:'Ván đã bắt đầu.',ROOM_NOT_FOUND:'Phòng không còn tồn tại.',UNAUTHORIZED:'Không có quyền chủ phòng.',TEMPLATE_NOT_FOUND:'Không tìm thấy Ván Mẫu.',ROLE_COUNT_MISMATCH:'Số lá bài không khớp số người ngồi.',SEATS_NOT_LOCKED:'Hãy chốt ghế trước khi phát vai.',MOVE_NOT_ACTIVE:'Chưa mở chuyển ghế.',NO_GAME_CONFIG:'Hãy chọn Ván Mẫu trước.',ROOM_NOT_RUNNING:'Ván chưa chạy.',CANNOT_KICK_OWNER:'Không thể đuổi chủ phòng.'};
  const errText=e=>ERR[String(e?.data?.error||'')]||e?.message||'Có lỗi xảy ra.';
  function say(t){pr.msg=t||'';const s=document.getElementById('gmwwPrStatus');if(s)s.textContent=pr.msg}
  async function run(fn){if(pr.busy)return;pr.busy=true;render();try{await fn()}catch(e){
    if(e?.status===404||e?.data?.error==='ROOM_NOT_FOUND'){if(pr.own){pr.own=null;save(null);pr.state=null}}
    say(errText(e))}finally{pr.busy=false;render()}}
  async function refresh(){
    if(!pr.own)return;
    try{pr.state=await api(base()+'state',{headers:oh()})}
    catch(e){if(e?.status===404||e?.status===401){pr.own=null;pr.state=null;save(null);say('Phòng đã đóng.')}}
    render();
  }
  async function create(){
    const nameInput=document.getElementById('gmwwPrName');
    const d=await api('/api/player-rooms',{method:'POST',headers:auth(),body:JSON.stringify({roomName:(nameInput?.value||'').trim()||undefined})});
    pr.own={code:d.roomCode,token:d.ownerToken,joinUrl:d.joinUrl};save(pr.own);pr.view='';pr.touched=false;
    try{await window.joinRoom(d.roomCode)}catch(_){}
    say('Đã tạo phòng '+d.roomCode+'.');await refresh();
    pr.open=false;try{await enterVillage()}catch(_){}
  }
  // Keeps the strip every player sees in step with the owner's tab (ignored when the server refuses).
  const STAGE={lobby:'room',room:'room',seats:'seats',game:'game',roles:'roles',deal:'deal'};
  function syncStage(k){if(!pr.own||!STAGE[k]||String(pr.state?.room?.phase||'lobby').toLowerCase()==='running')return;callOwner('stage','POST',{step:STAGE[k]}).then(refresh).catch(()=>{})}
  function goStep(k){pr.view=k;pr.touched=true;syncStage(k);render()}
  async function loadTemplates(){const d=await api('/api/player-rooms/templates',{headers:auth()});pr.templates=Array.isArray(d.templates)?d.templates:[]}
  const btn=(label,fn,cls,disabled)=>{const b=el('button',cls||null,label);b.type='button';if(disabled||pr.busy)b.disabled=true;b.addEventListener('click',()=>run(fn));return b};
  const stat=(k,v)=>{const d=el('div','gmww-pr-stat');d.append(el('small',null,k),el('b',null,String(v)));return d};
  // Step the server is on, mapped to the six tabs; the owner can still browse the other tabs.
  function serverStep(room){const g=String(room.gmStage==='room'?'lobby':room.gmStage||'lobby');return STEPS.some(s=>s[0]===g)?g:'lobby'}
  function seatedCount(players){return players.length}
  function deckSize(cfg){return(cfg?.roles||[]).reduce((n,r)=>n+Math.max(1,Number(r.count)||1),0)}

  function viewLobby(box,st,room,players){
    const g=el('div','gmww-pr-grid');g.append(stat('Mã phòng',pr.own.code),stat('Người trong phòng',players.length+' / '+(room.seatCount||30)));box.append(g);
    box.append(el('p','gmww-pr-help','Bạn chơi cùng mọi người, Quản Trò Tự Động điều hành ván. Bước đầu: gửi phòng cho bạn bè ở trang Phòng Game.'));
    box.append(btn('TIẾP: PHÒNG GAME →',async()=>goStep('room'),'gmww-pr-main'));
  }
  // "Phòng Game": send the room to friends and see who has joined it.
  function viewRoomPage(box,st,room,players){
    const link=pr.own.joinUrl||(location.origin+'/?room='+pr.own.code),code=pr.own.code,total=Number(room.seatCount)||30;
    const big=el('div','gmww-pr-code');big.append(el('small',null,'MÃ PHÒNG'),el('b',null,code));box.append(big);
    const tools=el('div','gmww-pr-tools');
    tools.append(btn('GỬI PHÒNG',async()=>{const text='Vào phòng Ma Sói của mình nhé! Mã phòng: '+code+'\n'+link;
      if(navigator.share){try{await navigator.share({title:'Phòng Ma Sói '+code,text,url:link});return}catch(e){if(e&&e.name==='AbortError')return}}
      try{await navigator.clipboard.writeText(text);say('Đã sao chép lời mời.')}catch(_){say(text)}},'gmww-pr-main'),
      btn('SAO CHÉP MÃ',async()=>{try{await navigator.clipboard.writeText(code);say('Đã sao chép mã '+code+'.')}catch(_){say('Mã phòng: '+code)}}));box.append(tools);
    const row=el('div','gmww-pr-row'),name=el('input');name.id='gmwwPrRename';name.maxLength=60;name.placeholder='Tên phòng';name.value=room.roomName||'';
    row.append(name,btn('LƯU',async()=>{const v=(document.getElementById('gmwwPrRename')?.value||'').trim();if(!v)return;await callOwner('room-settings','POST',{roomName:v});say('Đã đổi tên.');await refresh()}));box.append(row);
    box.append(el('div','gmww-pr-sub','ĐÃ VÀO PHÒNG • '+players.length+' / '+total));
    const list=el('div','gmww-pr-list');
    for(const p of players){const line=el('div','gmww-pr-player'),isOwner=String(p.loginId||'')===String(st?.ownerLoginId||'');
      const dot=el('i','gmww-pr-dot'+(p.online===false?' is-off':''));const nm=el('span',null,(p.displayName||p.loginId||'?')+(isOwner?'  ★ chủ phòng':''));
      const left=el('div','gmww-pr-who');left.append(dot,nm);line.append(left,el('small',null,p.seatId?('Ghế '+p.seatId):'Chưa có ghế'));list.append(line)}
    if(!players.length)list.append(el('p','gmww-pr-help','Chưa có ai trong phòng.'));
    box.append(list,btn('TIẾP: TẬP HỢP →',async()=>goStep('seats'),'gmww-pr-main'));
  }
  function viewSeats(box,st,room,players,locked){
    const g=el('div','gmww-pr-grid');g.append(stat('Đã tập hợp',players.length+' người'),stat('Chỗ ngồi',locked?'ĐÃ CHỐT':'Đang mở'));box.append(g);
    const seatSel=el('select');seatSel.id='gmwwPrSeatCount';
    for(let n=6;n<=30;n++)seatSel.append(new Option(n+' chỗ ngồi',String(n)));seatSel.value=String(Math.min(30,Math.max(6,Number(room.seatCount)||players.length||6)));
    if(locked)seatSel.disabled=true;
    const row=el('div','gmww-pr-row');row.append(seatSel,btn('ĐỔI SỐ CHỖ',async()=>{await callOwner('room-settings','POST',{seatCount:Number(document.getElementById('gmwwPrSeatCount').value)});say('Đã đổi số chỗ.');await refresh()},null,locked));box.append(row);
    const tools=el('div','gmww-pr-tools');
    tools.append(btn('⚄ PHÂN BỐ',async()=>{await callOwner('seats-randomize','POST',{});say('Đã phân bố chỗ ngồi ngẫu nhiên.');await refresh()},null,locked),
      btn(locked?'↩ GIẢI TÁN':'✓ CHỐT',async()=>{await callOwner('seat-lock','POST',{locked:!locked});say(locked?'Đã mở lại chỗ ngồi.':'Đã chốt chỗ ngồi.');await refresh()},locked?null:'gmww-pr-main'));box.append(tools);
    const list=el('div','gmww-pr-list');
    for(const p of players){const line=el('div','gmww-pr-player');line.append(el('span',null,(p.seatId?('#'+p.seatId+'  '):'')+(p.displayName||p.loginId||'?')+(String(p.loginId||'')===String(st?.ownerLoginId||'')?'  ★':'')));
      if(String(p.loginId||'')!==String(st?.ownerLoginId||'')){const k=btn('Kick',async()=>{await callOwner('kick','POST',{loginId:p.loginId});await refresh()},'gmww-pr-kick');line.append(k)}
      list.append(line)}
    box.append(list);
  }
  function viewGame(box,st,room,players,locked){
    const cfg=st?.config,need=deckSize(cfg);
    box.append(el('p','gmww-pr-help','Chọn Ván Mẫu do Quản Trò đã đăng. Số lá bài phải bằng số người ngồi ('+players.length+').'));
    if(!pr.templates.length)box.append(el('p','gmww-pr-help','Chưa có Ván Mẫu nào được đăng.'));
    for(const t of pr.templates){
      const card=el('div','gmww-pr-tpl'+(cfg?.id===t.id?' is-on':'')),fit=Number(t.playerCount)===players.length;
      const head=el('div');head.append(el('b',null,t.name||'Ván Mẫu'),el('small',null,(t.playerCount||'?')+' người'+(fit?' • vừa đủ':'')));
      card.append(head,btn(cfg?.id===t.id?'ĐANG DÙNG':'CHỌN',async()=>{await callOwner('template','POST',{templateId:t.id});say('Đã áp dụng Ván Mẫu.');await refresh()},null,cfg?.id===t.id));box.append(card)}
    if(cfg)box.append(el('p','gmww-pr-help','Đang chọn: '+(cfg.name||cfg.id)+' • '+need+' lá bài'));
    box.append(btn('TIẾP: PHÂN VAI →',async()=>goStep('roles'),'gmww-pr-main'));
  }
  function viewRoles(box,st,room,players){
    const cfg=st?.config,need=deckSize(cfg),ok=cfg&&need===players.length;
    const g=el('div','gmww-pr-grid');g.append(stat('Lá bài',need||'—'),stat('Người ngồi',players.length));box.append(g);
    if(!cfg){box.append(el('p','gmww-pr-help','Chưa chọn Ván Mẫu.'));box.append(btn('← VÁN MẪU',async()=>goStep('game')));return}
    const fac={};for(const r of cfg.roles){const f=r.faction||'Khác';(fac[f]=fac[f]||[]).push(r)}
    for(const [f,rows] of Object.entries(fac)){const sec=el('div','gmww-pr-deck');sec.append(el('small',null,f));for(const r of rows){const line=el('div','gmww-pr-deckrow');line.append(el('span',null,r.roleName||r.roleId),el('b',null,'× '+r.count));sec.append(line)}box.append(sec)}
    box.append(el('p','gmww-pr-note',ok?'Bộ bài khớp số người. Việc chia vai do máy chủ làm kín, không ai biết ai giữ vai nào, kể cả bạn.':'Số lá bài ('+need+') chưa bằng số người ngồi ('+players.length+'). Hãy đổi Ván Mẫu hoặc điều chỉnh số người.'));
    const row=el('div','gmww-pr-tools');row.append(btn('← VÁN MẪU',async()=>goStep('game')),btn('TIẾP: PHÁT VAI →',async()=>goStep('deal'),'gmww-pr-main',!ok));box.append(row);
  }
  function viewDeal(box,st,room,players,locked){
    const cfg=st?.config,need=deckSize(cfg),why=!cfg?'Chưa chọn Ván Mẫu.':!locked?'Hãy chốt chỗ ngồi ở bước Tập hợp.':need!==players.length?'Số lá bài ('+need+') chưa bằng số người ('+players.length+').':'';
    const g=el('div','gmww-pr-grid');g.append(stat('Người chơi',players.length),stat('Lá bài',need||'—'));box.append(g);
    box.append(el('p','gmww-pr-help','Bấm PHÁT VAI: máy chủ xáo bài ngẫu nhiên, mỗi người tự xem vai của mình, rồi vào Đêm 1. Bạn không biết ai nhận vai nào.'));
    if(why)box.append(el('p','gmww-pr-note',why));
    box.append(btn('🎴 PHÁT VAI & VÀO TRẬN',async()=>{await callOwner('start','POST',{});say('Đã phát vai. Ván bắt đầu.');pr.view='battle';await refresh()},'gmww-pr-main',!!why));
    box.append(btn('← PHÂN VAI',async()=>goStep('roles')));
  }
  function viewBattle(box,st,room,players,running){
    const g=el('div','gmww-pr-grid');g.append(stat('Trạng thái',running?'Đang chơi':'Chưa bắt đầu'),stat('Người chơi',players.length));box.append(g);
    if(running){box.append(el('p','gmww-pr-help','Quản Trò Tự Động đang điều hành. Ván tự kết thúc khi có phe thắng.'));
      box.append(btn('KẾT THÚC SỚM',async()=>{if(!confirm('Kết thúc ván ngay?'))return;await callOwner('end','POST',{});say('Đã kết thúc ván.');pr.view='lobby';await refresh()},'gmww-pr-danger'))}
    else box.append(el('p','gmww-pr-help','Ván chưa bắt đầu. Quay lại bước Phát Vai.'),btn('← PHÁT VAI',async()=>goStep('deal')));
  }
  const stepNow=()=>{const room=pr.state?.room||{};return String(room.phase||'lobby').toLowerCase()==='running'?'battle':serverStep(room)};
  const inOwnRoom=()=>!!(pr.own&&state?.roomCode&&String(state.roomCode).toUpperCase()===String(pr.own.code).toUpperCase());
  function openSheet(){pr.open=true;pr.touched=false;render();loadTemplates().then(render).catch(()=>{});refresh()}
  function closeSheet(){pr.open=false;render()}
  window.gmwwOpenCreateRoom=()=>{if(pr.own&&!inOwnRoom()){/* own room exists but the player is elsewhere */}openSheet()};
  function render(){
    const panel=document.getElementById('gmwwPrPanel'),back=document.getElementById('gmwwPrBack');if(!panel||!back)return;
    panel.hidden=back.hidden=!pr.open;renderDock();if(!pr.open)return;
    panel.textContent='';
    const head=el('header','gmww-pr-head'),close=el('button','gmww-pr-close','×');close.type='button';close.setAttribute('aria-label','Đóng');close.addEventListener('click',closeSheet);
    head.append(el('b',null,pr.own?(pr.state?.room?.roomName||'Phòng Game'):'Phòng Game'),close);panel.append(el('i','gmww-pr-grip'),head);
    const body=el('div','gmww-pr-body');
    if(!pr.own){
      body.append(el('p','gmww-pr-help','Bạn chơi cùng mọi người, Quản Trò Tự Động điều hành. Tối đa 30 người. Mỗi người một phòng.'));
      const name=el('input');name.id='gmwwPrName';name.placeholder='Tên phòng (không bắt buộc)';name.maxLength=60;body.append(name,btn('TẠO PHÒNG',create,'gmww-pr-main'));
    }else{
      const st=pr.state,room=st?.room||{},players=Array.isArray(st?.players)?st.players:[],running=String(room.phase||'lobby').toLowerCase()==='running';
      const locked=room.seatsLocked===true,cur=stepNow();if(!pr.touched||!pr.view)pr.view=cur;
      if(!inOwnRoom())body.append(el('p','gmww-pr-note','Bạn đang ở ngoài phòng '+pr.own.code+'. Vào lại phòng để dùng thanh điều khiển.'),btn('VÀO LẠI PHÒNG '+pr.own.code,async()=>{if(!await window.joinRoom(pr.own.code))throw new Error('Không vào lại được phòng.');pr.open=false;try{await enterVillage()}catch(_){}}));
      const tabs=el('nav','gmww-pr-steps');
      STEPS.forEach(([k,label],i)=>{const t=el('button',(pr.view===k?'is-view ':'')+(cur===k?'is-now':''));t.type='button';t.append(el('span',null,String(i+1)),el('b',null,label));t.addEventListener('click',()=>goStep(k));tabs.append(t)});
      body.append(tabs);
      const sec=el('section','gmww-pr-sec');
      ({lobby:viewLobby,room:viewRoomPage,seats:viewSeats,game:viewGame,roles:viewRoles,deal:viewDeal,battle:viewBattle})[pr.view](sec,st,room,players,pr.view==='battle'?running:locked);
      if(running&&pr.view!=='battle')sec.prepend(el('p','gmww-pr-note','Ván đang chạy: các bước chuẩn bị chỉ để xem.'));
      body.append(sec);
    }
    const status=el('div','gmww-pr-status');status.id='gmwwPrStatus';status.textContent=pr.msg;body.append(status);panel.append(body);
  }
  // Bottom bar copied from the GM Server (GMWW_SERVER_MENU.dock): visible only to the owner inside the room they created.
  const LABEL={lobby:'SẢNH CHỜ',seats:'TẬP HỢP',game:'VÁN MẪU',roles:'PHÂN VAI',deal:'PHÁT VAI',battle:'VÀO TRẬN'};
  function ensureDock(){
    let host=document.getElementById('gmwwOwnerDock');if(host)return host;
    host=el('div');host.id='gmwwOwnerDock';host.hidden=true;
    const root=host.attachShadow({mode:'open'});
    root.innerHTML='<style>'+GMWW_SERVER_MENU.css+' :host{display:block}#start #playShell #gmTopMenu.gm-top-menu-v293{position:relative!important;inset:auto!important;left:auto!important;right:auto!important;bottom:auto!important;top:auto!important;width:100%!important;max-width:520px;margin:0 auto!important;transform:none!important;height:62px!important;min-height:62px!important}#start #playShell #gmTopMenu #playAudioTop{display:none!important}#start #playShell #gmTopMenu.gm-top-menu-v293{border:0!important;outline:0!important;background:transparent!important;grid-template-columns:48px 48px minmax(0,1fr) 48px!important}</style><div id="start"><div id="playShell" class="play-shell" style="position:relative;height:auto;min-height:0;padding:0;background:none;overflow:visible">'+GMWW_SERVER_MENU.dock+'</div></div>';
    const q=id=>root.getElementById(id);
    q('playPhasePill').addEventListener('click',()=>{pr.view=stepNow();openSheet()});
    q('playExitVillage').addEventListener('click',()=>{if(confirm('Rời phòng của bạn? Phòng trống 30 phút sẽ tự xoá.'))run(async()=>{closeSheet();await window.leaveRoom()})});
    q('playAutoGM').addEventListener('click',()=>{try{toast('Quản Trò Tự Động luôn bật trong phòng người chơi.')}catch(_){}});
    q('playEndGame').addEventListener('click',()=>{if(stepNow()==='battle'&&confirm('Kết thúc ván ngay?'))run(async()=>{await callOwner('end','POST',{});say('Đã kết thúc ván.');await refresh()})});
    document.body.appendChild(host);return host;
  }
  function renderDock(){
    const host=ensureDock(),show=inOwnRoom()&&!pr.open&&['game'].includes(state.activeScreenId||'game');
    host.hidden=!show;if(!show)return;
    const root=host.shadowRoot,k=stepNow(),title=root.getElementById('playPhaseTitle'),hint=root.getElementById('playPhaseHint');
    if(title.textContent!==LABEL[k])title.textContent=LABEL[k];
    const h=k==='battle'?'ĐANG CHƠI':'CHẠM ĐỂ TIẾP';if(hint.textContent!==h)hint.textContent=h;
    root.getElementById('playEndGame').style.opacity=k==='battle'?'1':'.35';
  }
  // Player Web V2 has no room picker, so players enter a player-created room by its code from the profile page.
  async function joinByCode(code){
    code=String(code||'').trim().toUpperCase();
    if(!/^[A-Z0-9]{4,8}$/.test(code)){try{toast('Hãy nhập mã phòng.')}catch(_){}return}
    const ok=await window.joinRoom(code);
    if(ok===false){try{toast('Không vào được phòng '+code+'.')}catch(_){}return}
    try{await enterVillage()}catch(_){}
  }
  function injectCreateButtons(){
    if(!state?.token||!state?.member)return;
    for(const row of document.querySelectorAll('.profile-actions-row')){
      if(row.parentNode.querySelector('.gmww-pr-join'))continue;
      const wrap=el('div','gmww-pr-join');wrap.style.cssText='display:grid;grid-template-columns:1fr auto;gap:8px;margin:0 0 10px';
      const inp=el('input');inp.placeholder='Mã phòng';inp.maxLength=8;inp.autocapitalize='characters';inp.setAttribute('aria-label','Mã phòng');inp.style.cssText='padding:12px;border-radius:12px;border:1px solid #6b5a2e;text-transform:uppercase;font-size:16px;min-width:0';
      const go=el('button','primary gold','VÀO BẰNG MÃ');go.type='button';go.addEventListener('click',()=>joinByCode(inp.value));
      inp.addEventListener('keydown',e=>{if(e.key==='Enter')joinByCode(inp.value)});wrap.append(inp,go);
      const mk=el('button','primary gold gmww-pr-create',pr.own?'PHÒNG CỦA TÔI':'TẠO PHÒNG +');mk.type='button';mk.style.cssText='width:100%;margin:0 0 10px';mk.addEventListener('click',()=>window.gmwwOpenCreateRoom());
      row.parentNode.insertBefore(wrap,row);row.parentNode.insertBefore(mk,row);
    }
  }
  function mount(){
    if(!state?.token||!state?.member?.loginId)return;
    injectCreateButtons();
    if(pr.mounted)return;pr.mounted=true;
    document.head.appendChild(el('style',null,'#gmwwSetupTop3{display:none!important}'
      +'#gmwwOwnerDock{position:fixed;left:8px;right:8px;bottom:calc(env(safe-area-inset-bottom,0px) + 70px);z-index:9400}#gmwwOwnerDock[hidden]{display:none}'
      +'.gmww-pr-back{position:fixed;inset:0;z-index:9490;background:rgba(0,0,0,.45)}.gmww-pr-back[hidden]{display:none}'
