function applyRoleCardBack(){
  const back=$('#roleCard .role-back');if(!back)return;
  const src='data:image/webp;base64,';
  let img=back.querySelector('.gmww-card-back-img');
  if(!img){back.innerHTML='';img=document.createElement('img');img.className='gmww-card-back-img';img.alt='Mặt lưng Lá Vai Trò';img.draggable=false;img.decoding='async';back.appendChild(img)}
  if(img.src!==src)img.src=src;
  back.style.setProperty('background','#05070c','important');
  renderRoleEffects();
}

