
/* Online-first Chat: all reads are authenticated; the WebSocket carries only a generic tick.
 * DO NOT use public room_state to transport chat messages or secret group membership. */
let gmwwChatOpen=false,gmwwChatSeq=0,gmwwPlayerCueKey='',gmwwChatIdleTimer=null,gmwwOnlineFooterTimer=null,gmwwChatTarget='room';
const gmwwChatLatestByChannel=new Map();
function gmwwChatUnread(unread){
 const panel=document.getElementById('gmwwChatPanel'),footer=document.getElementById('gmwwOnlineFooter');
 panel?.classList.toggle('gmww-chat-unread',!!unread);footer?.classList.toggle('gmww-chat-unread',!!unread);
 panel?.setAttribute('aria-label',unread?'Chat Làng • Có tin mới':'Chat Làng');
}
function gmwwChatClosePanel(){
 gmwwChatOpen=false;clearTimeout(gmwwChatIdleTimer);
 document.getElementById('gmwwChatPanel')?.classList.remove('open');
 if(document.activeElement?.id==='gmwwChatText')document.activeElement.blur();
 syncPlayerMiniCards();
}
function gmwwChatTouch(){
 revealPlayerTopMenu(true);
 document.getElementById('gmwwOnlineFooter')?.classList.remove('is-idle-hidden');
 clearTimeout(gmwwChatIdleTimer);gmwwChatIdleTimer=setTimeout(()=>{
  if(gmwwChatVoiceRecorder?.state==='recording'||gmwwChatVoiceProcessing||gmwwChatVoiceDraft){gmwwChatTouch();return}
  gmwwChatClosePanel();document.getElementById('gmwwOnlineFooter')?.classList.add('is-idle-hidden');
 },30000);
}
function gmwwChatExpand(){
 gmwwChatOpen=true;document.getElementById('gmwwChatPanel')?.classList.add('open');
 gmwwChatUnread(false);
 if(typeof closePrivateCardViewer==='function')closePrivateCardViewer();
 gmwwChatTouch();syncPlayerMiniCards();
}
function gmwwChatColor(id){
 const ids=[...new Set((state.players||[]).map(p=>String(p.loginId||p.participantId||'').replace(/^member:/,'')))].sort();
 const normalized=String(id||'').replace(/^member:/,'').toLowerCase();const index=ids.indexOf(normalized);let hash=0;for(const c of normalized)hash=(hash*31+c.charCodeAt(0))>>>0;
 // Reserve red exclusively for GM and public announcements.
 return 'hsl('+(38+((index>=0?index*137.508:hash)%278))+' 85% 78%)';
}
const gmwwChatAudioOff=()=>{try{return localStorage.getItem('gmww_player_announcement_audio_off')==='1'}catch{return false}};
let gmwwAnnouncementAudio=null,gmwwAnnouncementUrl='',gmwwAnnouncementRequest=null,gmwwAnnouncementPending=null,gmwwAnnouncementGeneration=0,gmwwAnnouncementSources=[];
// V3.303: clips are content-addressed by the Server, so a role's clip is fetched once and
// reused every night; decoded buffers are cached per Blob.
const gmwwAnnouncementClips=new Map(),gmwwAnnouncementDecoded=new WeakMap();
function gmwwStopAnnouncementSources(){for(const src of gmwwAnnouncementSources){try{src.stop(0)}catch{}}gmwwAnnouncementSources=[]}
function gmwwStopAnnouncement(){
  gmwwAnnouncementGeneration++;gmwwAnnouncementRequest?.abort();gmwwAnnouncementRequest=null;
  gmwwStopAnnouncementSources();
  if(gmwwAnnouncementAudio){gmwwAnnouncementAudio.onended=null;gmwwAnnouncementAudio.pause();gmwwAnnouncementAudio.removeAttribute('src');gmwwAnnouncementAudio.load();gmwwAnnouncementAudio=null}
  if(gmwwAnnouncementUrl)URL.revokeObjectURL(gmwwAnnouncementUrl);gmwwAnnouncementUrl='';
}
function gmwwAnnouncementUrls(pending){
  const base='/api/rooms/'+encodeURIComponent(pending?.room||'')+'/announcement-audio?a=',cue=pending?.cue||{};
  const list=Array.isArray(cue.audio)?cue.audio:(cue.audioUrl?[cue.audioUrl]:[]);
  return list.filter(u=>typeof u==='string'&&u.startsWith(base)&&/^[a-f0-9]{32}$/.test(u.slice(base.length))).slice(0,12);
}
// Seconds since the Server started this turn: every device joins the clip at the same point.
function gmwwAnnouncementOffset(cue){
  const at=Number(cue?.startedAt)||0;if(!at)return 0;
  const lag=(Date.now()+(Number(state.serverClockOffsetMs)||0)-at)/1000;
  return lag<0.3?0:lag;
}
function gmwwChatAnnounce(cue){
  state.audioCue=cue?.key&&cue?.label?{key:String(cue.key),label:String(cue.label).slice(0,120)}:null;
  updatePlayerTopMenu();
  const key=cue?.key&&state.roomCode&&state.participantId?state.roomCode+':'+cue.key:'';
  if(gmwwAnnouncementPending?.key!==key){gmwwStopAnnouncement();gmwwAnnouncementPending=key?{key,cue,room:state.roomCode}:null}
  else if(gmwwAnnouncementPending)gmwwAnnouncementPending.cue={...gmwwAnnouncementPending.cue,...cue};
  if(!key||key===gmwwPlayerCueKey||gmwwChatAudioOff())return;
  // A missing clip is retryable: the Server pushes the cue again once the GM uploads it.
  if(gmwwAnnouncementRequest||!gmwwAnnouncementUrls(gmwwAnnouncementPending).length)return;
  void gmwwPlayAnnouncement();
}
async function gmwwPlayAnnouncement(){
  const pending=gmwwAnnouncementPending;if(!pending||gmwwChatAudioOff()||pending.key===gmwwPlayerCueKey)return;
  const urls=gmwwAnnouncementUrls(pending);if(!urls.length)return;
  const generation=gmwwAnnouncementGeneration,controller=new AbortController();gmwwAnnouncementRequest=controller;
  try{
    const blobs=[];
    for(const url of urls){
      let blob=gmwwAnnouncementClips.get(url);
      if(!blob){
        const response=await fetch(url,{headers:auth(),signal:controller.signal});
        if(!response.ok)return;
        blob=await response.blob();
        if(!/^audio\//i.test(blob.type)||blob.size>2*1024*1024)return;
        gmwwAnnouncementClips.set(url,blob);
        if(gmwwAnnouncementClips.size>40)gmwwAnnouncementClips.delete(gmwwAnnouncementClips.keys().next().value);
      }
      blobs.push(blob);
    }
    if(generation!==gmwwAnnouncementGeneration||gmwwChatAudioOff()||state.roomCode!==pending.room)return;
    // Shared WebAudio context (unlocked by any earlier tap) avoids iOS autoplay blocks.
    if(await gmwwPlayAnnouncementBuffers(blobs,generation,pending))return;
    await gmwwPlayAnnouncementHtml(blobs,generation,pending);
  }catch{}finally{if(gmwwAnnouncementRequest===controller)gmwwAnnouncementRequest=null}
}
function gmwwDecodeAnnouncement(c,blob){
  const cached=gmwwAnnouncementDecoded.get(blob);if(cached)return Promise.resolve(cached);
  return blob.arrayBuffer().then(data=>new Promise((resolve,reject)=>{let done=false;const ok=x=>{if(!done){done=true;gmwwAnnouncementDecoded.set(blob,x);resolve(x)}},bad=e=>{if(!done){done=true;reject(e)}};
    try{const p=c.decodeAudioData(data,ok,bad);if(p&&typeof p.then==='function')p.then(ok,bad)}catch(e){bad(e)}}));
}
async function gmwwPlayAnnouncementBuffers(blobs,generation,pending){
  try{
    const c=gmwwAudio();if(!c||!gmwwAudioMaster)return false;
    if(c.state!=='running'){try{await c.resume()}catch{}}
    if(c.state!=='running')return false;
    const buffers=[];for(const blob of blobs)buffers.push(await gmwwDecodeAnnouncement(c,blob));
    if(generation!==gmwwAnnouncementGeneration||gmwwChatAudioOff()||state.roomCode!==pending.room)return true;
    let skip=gmwwAnnouncementOffset(pending.cue),at=c.currentTime+0.02;
    const total=buffers.reduce((n,b)=>n+b.duration,0);
    gmwwStopAnnouncementSources();gmwwPlayerCueKey=pending.key;
    if(skip>=total-0.15)return true; // already finished on every other device
    for(const buf of buffers){
      if(skip>=buf.duration){skip-=buf.duration;continue}
      const src=c.createBufferSource(),g=c.createGain();src.buffer=buf;g.gain.value=.85;src.connect(g);g.connect(gmwwAudioMaster);
      src.onended=()=>{gmwwAnnouncementSources=gmwwAnnouncementSources.filter(x=>x!==src)};
      src.start(at,skip);at+=buf.duration-skip;skip=0;gmwwAnnouncementSources.push(src);
    }
    return true;
  }catch{return false}
}
async function gmwwPlayAnnouncementHtml(blobs,generation,pending){
  const audio=gmwwAnnouncementAudio||(gmwwAnnouncementAudio=new Audio());let index=0;
  const load=i=>{if(gmwwAnnouncementUrl)URL.revokeObjectURL(gmwwAnnouncementUrl);gmwwAnnouncementUrl=URL.createObjectURL(blobs[i]);audio.src=gmwwAnnouncementUrl;audio.volume=.85};
  const seek=()=>{const skip=gmwwAnnouncementOffset(pending.cue);if(skip>0&&Number.isFinite(audio.duration))try{audio.currentTime=Math.min(skip,Math.max(0,audio.duration-0.05))}catch{}};
  audio.onended=()=>{if(generation!==gmwwAnnouncementGeneration||++index>=blobs.length)return;load(index);audio.play().catch(()=>{})};
  load(0);
  try{audio.addEventListener?.('loadedmetadata',seek,{once:true})}catch{}
  await audio.play();
  if(generation===gmwwAnnouncementGeneration)gmwwPlayerCueKey=pending.key;
}
// Retry a blocked autoplay on a real tap; playback still joins at the Server's position.
document.addEventListener('pointerdown',()=>{
  if(gmwwChatAudioOff()||!gmwwAnnouncementPending||gmwwAnnouncementPending.key===gmwwPlayerCueKey||gmwwAnnouncementRequest)return;
  void gmwwPlayAnnouncement();
},{passive:true});
function gmwwChatAudioButton(){const b=document.getElementById('gmwwChatAudio');if(b){b.textContent=gmwwChatAudioOff()?'🔇':'🔊';b.title=gmwwChatAudioOff()?'Bật audio thông báo':'Tắt audio thông báo'}}

const gmwwChatMicSvg='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="2" width="6" height="13" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4m-4 0h8"/></svg>';
const gmwwChatSendSvg='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg>';
const gmwwChatStopSvg='<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2"/></svg>';
let gmwwChatVoiceMeterContext=null,gmwwChatVoiceMeterSource=null,gmwwChatVoiceMeterAnalyser=null,gmwwChatVoiceMeterFrame=null;
function gmwwChatVoiceMeterStop(){
 if(gmwwChatVoiceMeterFrame!==null)cancelAnimationFrame(gmwwChatVoiceMeterFrame);
 gmwwChatVoiceMeterFrame=null;
 try{gmwwChatVoiceMeterSource?.disconnect()}catch{}
 try{gmwwChatVoiceMeterAnalyser?.disconnect()}catch{}
 try{const closed=gmwwChatVoiceMeterContext?.close();closed?.catch?.(()=>{})}catch{}
 gmwwChatVoiceMeterContext=null;gmwwChatVoiceMeterSource=null;gmwwChatVoiceMeterAnalyser=null;
}
function gmwwChatVoiceMeterStart(stream){
 gmwwChatVoiceMeterStop();
 const meter=document.querySelector('#gmwwChatRecording .gmww-live-meter');
 const bars=[...(meter?.querySelectorAll('i')||[])];
 const Audio=window.AudioContext||window.webkitAudioContext;
 if(!Audio||!bars.length)return;
 try{
  const ctx=new Audio(),source=ctx.createMediaStreamSource(stream),analyser=ctx.createAnalyser();
  analyser.fftSize=256;analyser.smoothingTimeConstant=.65;
  source.connect(analyser); // Observe the mic only; never play it through speakers.
  gmwwChatVoiceMeterContext=ctx;gmwwChatVoiceMeterSource=source;gmwwChatVoiceMeterAnalyser=analyser;
  const signal=new Uint8Array(analyser.fftSize);
  let lastFrame=0;
  const animate=time=>{
   if(gmwwChatVoiceRecorder?.state!=='recording'||document.visibilityState==='hidden')return;
   if(time-lastFrame>=75){
    lastFrame=time;analyser.getByteTimeDomainData(signal);
    for(let i=0;i<bars.length;i++){
     const offset=Math.floor((i+0.5)*signal.length/bars.length);
     let energy=0;
     for(let j=0;j<10;j++){const x=(signal[(offset+j)%signal.length]-128)/128;energy+=x*x}
     const level=Math.min(1,Math.sqrt(energy/10)*3);
     bars[i].style.height=Math.round(3+19*level)+'px';
    }
   }
   gmwwChatVoiceMeterFrame=requestAnimationFrame(animate);
  };
  void ctx.resume().catch(()=>{});
  gmwwChatVoiceMeterFrame=requestAnimationFrame(animate);
 }catch(error){gmwwChatVoiceMeterStop();console.warn('GMWW_LIVE_VOICE_METER',error)}
}
let gmwwChatVoiceClock=null;
function gmwwChatRecordDisplay(on,start){
 const form=document.getElementById('gmwwChatForm'),state=document.getElementById('gmwwChatRecording');
 form?.classList.toggle('is-recording',on);if(state)state.hidden=!on;
 clearInterval(gmwwChatVoiceClock);gmwwChatVoiceClock=null;
 if(on){const tick=()=>{const time=state?.querySelector('time');if(time)time.textContent='0:'+String(Math.min(30,Math.floor((Date.now()-start)/1000))).padStart(2,'0')};tick();gmwwChatVoiceClock=setInterval(tick,500)}
}
function gmwwChatVoiceCard(msg){
 const card=document.createElement('button');card.type='button';card.className='gmww-voice-card';card.setAttribute('aria-label','Phát tin nhắn thoại');
 const play=document.createElement('span');play.className='gmww-voice-play';play.textContent='▶';
 const wave=document.createElement('span');wave.className='gmww-voice-wave';wave.setAttribute('aria-hidden','true');
 for(const h of [32,70,45,90,55,35,77,48,95,42,61,82,38,73]){const bar=document.createElement('i');bar.style.height=h+'%';wave.appendChild(bar)}
 const time=document.createElement('span');time.textContent='0:'+String(Math.ceil(Number(msg.durationMs||0)/1000)).padStart(2,'0');time.className='gmww-voice-duration';
 card.append(play,wave,time);card.onclick=()=>void gmwwChatVoicePlay(msg.voiceId,card);return card;
}

let gmwwChatVoiceRecorder=null,gmwwChatVoiceTimeout=null,gmwwChatVoiceDiscard=false;
let gmwwChatVoiceGeneration=0;
let gmwwChatVoiceDraft=null,gmwwChatVoicePendingSend=false,gmwwChatVoiceProcessing=false,gmwwChatVoiceStarting=false,gmwwChatVoiceBusy=false;
let gmwwChatMicStream=null,gmwwChatMicIdleTimer=null;
function gmwwChatMicRelease(){
 gmwwChatVoiceMeterStop();
 clearTimeout(gmwwChatMicIdleTimer);gmwwChatMicIdleTimer=null;
 gmwwChatMicStream?.getTracks().forEach(track=>track.stop());gmwwChatMicStream=null;
}
async function gmwwChatMicAcquire(){
 clearTimeout(gmwwChatMicIdleTimer);gmwwChatMicIdleTimer=null;
 if(!gmwwChatMicStream?.getAudioTracks().some(track=>track.readyState==='live')){
  gmwwChatMicRelease();
  gmwwChatMicStream=await navigator.mediaDevices.getUserMedia({audio:true});
 }
 gmwwChatMicStream.getAudioTracks().forEach(track=>{track.enabled=true});
 return gmwwChatMicStream;
}
function gmwwChatMicPark(){
 gmwwChatMicStream?.getAudioTracks().forEach(track=>{track.enabled=false});
 clearTimeout(gmwwChatMicIdleTimer);
 gmwwChatMicIdleTimer=setTimeout(gmwwChatMicRelease,120000);
 if(document.visibilityState==='hidden')gmwwChatMicRelease();
}
function gmwwChatVoiceReset(){
 const button=document.getElementById('gmwwChatVoice');
 if(button){button.innerHTML=gmwwChatMicSvg;button.title='Ghi âm tối đa 30 giây';button.setAttribute('aria-pressed','false')}
}
function gmwwChatVoicePreview(){
 const form=document.getElementById('gmwwChatForm'),display=document.getElementById('gmwwChatRecording');
 if(!display||!form)return;
 const ready=!!gmwwChatVoiceDraft;
 form.classList.toggle('is-recording',ready);
 display.hidden=!ready;
 if(ready){
  const label=document.getElementById('gmwwChatRecordingStatus');if(label)label.textContent='Đã ghi • nhấn ↑ để gửi';
  const time=display.querySelector('time');if(time)time.textContent='0:'+String(Math.min(30,Math.ceil(gmwwChatVoiceDraft.voice.durationMs/1000))).padStart(2,'0');
 }
}
async function gmwwChatVoiceSend(){
 if(gmwwChatVoiceRecorder?.state==='recording'){
  const label=document.getElementById('gmwwChatRecordingStatus');if(label)label.textContent='Đang xử lý thoại…';
  gmwwChatVoicePendingSend=true;gmwwChatVoiceRecorder.stop();return;
 }
 if(gmwwChatVoiceStarting||gmwwChatVoiceProcessing||gmwwChatVoiceBusy)return;
 const draft=gmwwChatVoiceDraft;if(!draft)return;
 if(String(state.roomCode)!==draft.room||gmwwChatTarget!==draft.target){toast('Phòng hoặc người nhận đã thay đổi. Hãy chọn lại đúng nơi nhận trước khi gửi.');return}
 gmwwChatVoiceBusy=true;
 const feedback=document.getElementById('gmwwChatRecordingStatus');if(feedback)feedback.textContent='Đang gửi thoại…';
 const send=document.getElementById('gmwwChatSubmit');if(send)send.disabled=true;
 const discardButton=document.getElementById('gmwwChatDiscard');if(discardButton)discardButton.disabled=true;
 try{
  await api('/api/rooms/'+encodeURIComponent(draft.room)+'/chat',{method:'POST',headers:auth(),body:JSON.stringify({channel:draft.target,voice:draft.voice})});
  if(feedback)feedback.textContent='Đã gửi';
  gmwwChatVoiceDraft=null;await gmwwChatRefresh();gmwwChatRecordDisplay(false);gmwwChatVoiceReset();
 }catch(e){toast('Không gửi được thoại: '+String(e?.message||e));gmwwChatVoicePreview()}
 finally{gmwwChatVoiceBusy=false;if(send)send.disabled=false;if(discardButton)discardButton.disabled=false}
}
function gmwwChatVoiceCancel(){
 if(gmwwChatVoiceBusy)return; // A request already uploading cannot be retracted locally.
 gmwwChatVoiceGeneration++;
 gmwwChatVoiceDiscard=true;gmwwChatVoicePendingSend=false;gmwwChatVoiceDraft=null;
 if(gmwwChatVoiceRecorder?.state==='recording'){
  gmwwChatVoiceProcessing=true;gmwwChatVoiceRecorder.stop();return;
 }
 gmwwChatRecordDisplay(false);gmwwChatVoiceReset();
}
async function gmwwChatVoiceToggle(){
 if(gmwwChatVoiceRecorder?.state==='recording'){gmwwChatVoiceRecorder.stop();return}
 const button=document.getElementById('gmwwChatVoice');
 if(!button||button.disabled||!state.roomCode||gmwwChatVoiceStarting||gmwwChatVoiceProcessing||gmwwChatVoiceBusy)return;
 if(!window.MediaRecorder||!navigator.mediaDevices?.getUserMedia){toast('Trình duyệt không hỗ trợ ghi âm.');return}
 const target=gmwwChatTarget,room=String(state.roomCode);
 const recordingGeneration=++gmwwChatVoiceGeneration;
 gmwwChatVoiceStarting=true;gmwwChatVoiceDraft=null;gmwwChatVoicePreview();
 try{
  const stream=await gmwwChatMicAcquire();
  if(room!==String(state.roomCode)){gmwwChatMicPark();return}
  const mime=['audio/mp4','audio/webm;codecs=opus','audio/webm'].find(t=>MediaRecorder.isTypeSupported(t));
  let recorder;try{recorder=new MediaRecorder(stream,{...(mime?{mimeType:mime}:{}),audioBitsPerSecond:40000})}
  catch{recorder=new MediaRecorder(stream,mime?{mimeType:mime}:undefined)}
  const chunks=[],start=Date.now();
  gmwwChatVoiceDiscard=false;gmwwChatVoiceRecorder=recorder;gmwwChatVoicePendingSend=false;
  recorder.ondataavailable=event=>{if(event.data?.size)chunks.push(event.data)};
  recorder.onerror=()=>{gmwwChatVoiceDiscard=true;toast('Ghi âm bị gián đoạn.')};
  recorder.onstop=async()=>{
   const sendRequested=gmwwChatVoicePendingSend;gmwwChatVoicePendingSend=false;
   gmwwChatVoiceProcessing=true;
   clearTimeout(gmwwChatVoiceTimeout);gmwwChatVoiceMeterStop();gmwwChatVoiceRecorder=null;gmwwChatRecordDisplay(false);gmwwChatVoiceReset();gmwwChatMicPark();
   try{
    if(gmwwChatVoiceDiscard||recordingGeneration!==gmwwChatVoiceGeneration||String(state.roomCode)!==room||!chunks.length)return;
    const blob=new Blob(chunks,{type:recorder.mimeType||chunks[0]?.type||'audio/mp4'});
    const bytes=new Uint8Array(await blob.arrayBuffer());let binary='';
    for(let i=0;i<bytes.length;i+=16384)binary+=String.fromCharCode(...bytes.subarray(i,i+16384));
    if(gmwwChatVoiceDiscard||recordingGeneration!==gmwwChatVoiceGeneration)return;
    gmwwChatVoiceDraft={room,target,voice:{mime:blob.type.split(';')[0],durationMs:Math.min(30000,Math.max(1,Date.now()-start)),base64:btoa(binary)}};
    gmwwChatVoicePreview();
   }catch(e){toast('Không lưu được bản ghi âm: '+String(e?.message||e))}
   finally{gmwwChatVoiceProcessing=false;if(sendRequested&&gmwwChatVoiceDraft)void gmwwChatVoiceSend()}
  };
  recorder.start(500);gmwwChatRecordDisplay(true,start);gmwwChatVoiceMeterStart(stream);
  const label=document.getElementById('gmwwChatRecordingStatus');if(label)label.textContent='Đang ghi âm';
  button.innerHTML=gmwwChatStopSvg;button.title='Dừng ghi âm (chưa gửi)';button.setAttribute('aria-pressed','true');
  gmwwChatVoiceTimeout=setTimeout(()=>{if(recorder.state==='recording')recorder.stop()},30000);
 }catch(e){gmwwChatMicRelease();gmwwChatRecordDisplay(false);gmwwChatVoiceReset();toast('Không truy cập được microphone: '+String(e?.message||e))}
 finally{gmwwChatVoiceStarting=false}
}
document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')gmwwChatMicRelease()});
window.addEventListener('pagehide',gmwwChatMicRelease);
async function gmwwChatVoicePlay(id,button){
 try{
  button.disabled=true;
  const file=await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/chat/audio/'+encodeURIComponent(id),{headers:auth()});
  const data=atob(file.base64),bytes=new Uint8Array(data.length);
  for(let i=0;i<data.length;i++)bytes[i]=data.charCodeAt(i);
  const uri=URL.createObjectURL(new Blob([bytes],{type:file.mime})),audio=new Audio(uri);
  const done=()=>{button.disabled=false;button.classList.remove('is-playing');URL.revokeObjectURL(uri)};
  audio.onended=done;audio.onerror=done;await audio.play();button.classList.add('is-playing');
 }catch(e){button.disabled=false;button.classList.remove('is-playing');toast('Không phát được tin thoại: '+String(e?.message||e))}
}
function gmwwChatMount(){
 if(!state.roomCode||!state.participantId)return;
 document.getElementById('gmwwChatLaunch')?.remove();
 if(!document.getElementById('gmwwChatStyle')){
  const style=document.createElement('style');style.id='gmwwChatStyle';
  style.textContent=`
#gmwwOnlineFooter{position:fixed;z-index:100003;left:8px;right:8px;bottom:max(6px,env(safe-area-inset-bottom));--gmww-foot-h:44px;display:grid;grid-template-columns:54px minmax(0,1fr) 54px;gap:6px;align-items:end;color:#fff;transition:opacity .2s;max-height:40dvh}
html body #gmwwOnlineFooter{top:calc(var(--gmww-player-visible-top,0px) + var(--gmww-player-visible-height,100dvh) - max(6px,env(safe-area-inset-bottom)))!important;bottom:auto!important;transform:translateY(-100%)!important;max-height:calc(var(--gmww-player-visible-height,100dvh) - 16px)!important}
html body #gmwwOnlineFooter #gmwwChatPanel{position:relative!important;inset:auto!important;top:auto!important;bottom:auto!important;transform:none!important;width:100%!important;max-width:none!important;height:auto!important;max-height:min(38dvh,320px)!important;min-height:0!important;margin:0!important}
#gmwwOnlineFooter[hidden]{display:none!important}#gmwwOnlineFooter.is-idle-hidden{opacity:0;pointer-events:none}
#gmwwOnlineFooter.gmww-chat-unread.is-idle-hidden{opacity:1;pointer-events:auto}
#gmwwChatPanel.gmww-chat-unread{border-color:#ffe08b!important;box-shadow:0 0 0 2px #ffd46a90,0 0 14px #ffcb49b3;animation:gmww-chat-new-message 1s ease-in-out infinite}
@keyframes gmww-chat-new-message{0%,100%{box-shadow:0 0 0 1px #ffe08b88}50%{box-shadow:0 0 0 3px #ffe08bcc,0 0 16px #ffe08b}}
@media(prefers-reduced-motion:reduce){#gmwwChatPanel.gmww-chat-unread{animation:none}}
#gmwwOnlineFooter .gmww-foot-button{box-sizing:border-box;height:var(--gmww-foot-h);min-height:var(--gmww-foot-h);padding:3px;border:1px solid #ffffff3d;border-radius:10px;background:#062e4340;color:white;font:800 11px system-ui;backdrop-filter:blur(8px)}
#gmwwOnlineFooter #gmwwPlayerRestore{display:grid;place-items:center;align-content:center;gap:0;line-height:1;border:1.5px solid #ffd77a;background:#4a3307cc;color:#ffe9b0;box-shadow:0 0 8px #ffd77a55}
#gmwwOnlineFooter #gmwwPlayerRestore{font:800 11px/1.15 system-ui;letter-spacing:.1px;text-align:center;white-space:normal}
/* V3.301: clock, collapsed chat bar and Khôi phục share one equal-height row. */
html body #gmwwOnlineFooter #gmwwChatPanel:not(.open){box-sizing:border-box;height:var(--gmww-foot-h)!important;min-height:var(--gmww-foot-h)!important;max-height:var(--gmww-foot-h)!important;display:flex;align-items:center}
#gmwwOnlineFooter #gmwwChatPanel:not(.open) form{box-sizing:border-box;flex:1;min-width:0;height:100%;padding:4px 6px}
#gmwwOnlineFooter #gmwwChatPanel:not(.open) #gmwwChatText{box-sizing:border-box;height:100%;max-height:36px;min-height:0}
#gmwwOnlineFooter #gmwwPlayerRestore.gmww-restore-ready{background:#c88a12;color:#fff;border-color:#fff3c4;animation:gmwwRestorePulse 1.1s ease-in-out infinite alternate}
@keyframes gmwwRestorePulse{from{box-shadow:0 0 0 0 #ffd77a99,0 0 6px #ffd77a}to{box-shadow:0 0 0 5px #ffd77a00,0 0 18px #ffd77a}}
@media(prefers-reduced-motion:reduce){#gmwwOnlineFooter #gmwwPlayerRestore.gmww-restore-ready{animation:none}}
#gmwwChatPanel{min-width:0;background:rgba(5,35,49,.25);border:1px solid #b5e6e843;border-radius:12px;color:#fff;overflow:hidden;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:0 4px 15px #0002}
#gmwwChatPanel header,#gmwwChatLines,#gmwwChatHelp{display:none}
#gmwwChatPanel.open header{display:flex;align-items:center;gap:6px;padding:3px 7px}#gmwwChatPanel header b{flex:1;font-size:10px}
#gmwwChatPanel header button{padding:2px 4px;min-width:25px;min-height:25px;border:0;background:transparent;color:#fff;font-size:12px}
#gmwwChatPanel.open #gmwwChatLines{display:block;height:90px;max-height:22dvh;overflow-y:auto;overscroll-behavior:contain;padding:3px 7px;touch-action:pan-y}
html body #gmwwOnlineFooter.gmww-chat-day{height:auto!important;max-height:min(74dvh,calc(var(--gmww-player-visible-height,100dvh) - 96px))!important}
html body #gmwwOnlineFooter.gmww-chat-day #gmwwChatPanel.open{max-height:min(68dvh,calc(var(--gmww-player-visible-height,100dvh) - 76px))!important}
#gmwwOnlineFooter.gmww-chat-day #gmwwChatPanel.open #gmwwChatLines{height:min(270px,calc(var(--gmww-player-visible-height,100dvh) - 155px))!important;max-height:54dvh!important}
#gmwwChatLines .msg{display:block;margin:0;padding:1px 0;font:600 12px/17px system-ui;white-space:pre-wrap;overflow-wrap:anywhere;text-shadow:0 1px 3px #000}
#gmwwChatLines .msg b{display:inline;font:inherit}#gmwwChatLines .msg.gm,#gmwwChatLines .msg.system{color:#ff5353!important;font-weight:800}
#gmwwChatPanel.open #gmwwChatForm{border-top:1px solid rgba(255,255,255,.48)}
#gmwwChatPanel form{display:flex;gap:4px;padding:3px}#gmwwChatText{flex:1;min-width:0;width:100%;height:30px;border:0;background:transparent;color:white;font:12px system-ui;outline:none;padding:4px}#gmwwChatText::placeholder{color:#f2f9ffb3}
#gmwwChatVoice{display:none;min-width:29px;height:30px;border:0;background:transparent;color:white;font-size:18px}#gmwwChatPanel.open #gmwwChatVoice{display:block}#gmwwChatSubmit{display:none;height:30px;min-height:30px;border:0;border-radius:7px;background:#0d59757a;color:#fff;padding:3px 7px}#gmwwChatPanel.open #gmwwChatSubmit{display:block}#gmwwChatHelp{font-size:10px;padding:3px 7px}#gmwwChatHelp.gmww-chat-dead-notice{display:block!important;color:#69d8ff!important;font-weight:800;text-shadow:0 1px 2px #001a2b}
#gmwwChatPanel.open #gmwwChatHelp:not(:empty){display:block}#gmwwChatText:disabled,#gmwwChatSubmit:disabled{opacity:.55}
`;
  style.textContent+=`
/* GMWW Chat V2 glass parity with GM, reduced-motion-safe waveform */
#gmwwChatPanel{background:rgba(17,24,44,.43)!important;border:1px solid #ddcaff65!important;border-radius:18px!important;backdrop-filter:blur(13px);-webkit-backdrop-filter:blur(13px);box-shadow:0 12px 38px #0006}
html body #gmwwOnlineFooter #gmwwChatPanel{max-height:min(52dvh,440px)!important}
#gmwwChatPanel.open header{padding:8px 11px;background:rgba(39,43,70,.38);border-bottom:1px solid #ffffff25}
/* Votes take priority over the floating chat footer; never mask actionable ballots. */
#gmwwGallowsDock:not([hidden]){z-index:100006!important}
#gmwwChatPanel.open #gmwwChatLines{height:130px;max-height:27dvh;padding:7px 9px}
#gmwwChatLines .msg{margin:5px 0;padding:6px 9px;border:1px solid #e1dcff26;border-radius:13px;background:rgba(132,143,188,.20);max-width:90%;width:fit-content;line-height:1.5}
#gmwwChatLines .msg.is-self{margin-left:auto;background:rgba(124,98,188,.40)}
#gmwwChatPanel.open #gmwwChatForm{border-top:1px solid #ffffff40;background:rgba(26,30,51,.24)}
#gmwwChatPanel form{align-items:center;gap:6px;padding:7px}
#gmwwChatText{border-radius:999px;background:rgba(180,184,213,.14);border:1px solid #ffffff42;padding:8px 12px;height:38px}
#gmwwChatVoice,#gmwwChatSubmit{width:38px;height:38px;min-width:38px;flex:0 0 38px;border:1px solid #ffffff35!important;border-radius:50%!important;display:grid!important;place-items:center;background:rgba(172,174,214,.16)!important;color:#fff!important;padding:0!important}
#gmwwChatPanel:not(.open) #gmwwChatVoice,#gmwwChatPanel:not(.open) #gmwwChatSubmit{display:none!important}
#gmwwChatSubmit{background:linear-gradient(135deg,#8871dc,#5f54ae)!important}
#gmwwChatDiscard{display:none;width:34px;height:34px;min-width:34px;flex:0 0 34px;border:1px solid #ff9cac88;border-radius:50%;background:rgba(170,55,80,.28);color:#ffe3e8;font-size:18px;padding:0;place-items:center}
#gmwwChatForm.is-recording #gmwwChatDiscard{display:grid}
#gmwwChatDiscard:disabled{opacity:.4}
#gmwwChatForm button svg{width:21px;height:21px}
#gmwwChatVoice[aria-pressed="true"]{background:rgba(241,91,116,.26)!important}
#gmwwChatForm.is-recording #gmwwChatText{display:none}
#gmwwChatRecording .gmww-live-meter{display:flex;align-items:center;justify-content:center;gap:2px;flex:1;min-width:34px;height:24px;overflow:hidden}
#gmwwChatRecording .gmww-live-meter i{width:3px;min-width:2px;height:3px;border-radius:4px;background:#ffb1c7;transition:height 75ms linear}
@media(prefers-reduced-motion:reduce){#gmwwChatRecording .gmww-live-meter i{transition:none}}
#gmwwChatRecording[hidden]{display:none!important}
#gmwwChatRecording{display:flex;flex:1;min-width:0;align-items:center;gap:6px;border-radius:999px;padding:8px;background:rgba(215,69,89,.17);border:1px solid #ff7d8e99;font-size:10px;color:#ffe8ec}
#gmwwChatRecording .gmww-record-dot{width:8px;height:8px;border-radius:50%;background:#ff627d;animation:gmww-chat-record-pulse 1s ease-in-out infinite}
#gmwwChatRecording time{font-variant-numeric:tabular-nums;margin-left:auto}
.gmww-voice-wave{display:flex;align-items:center;justify-content:center;gap:2px;height:23px;flex:1;min-width:42px}
.gmww-voice-wave i{display:block;width:2px;min-width:2px;border-radius:3px;background:currentColor}
.gmww-voice-card{display:inline-flex;gap:9px;align-items:center;min-width:146px;max-width:100%;border-radius:15px!important;border:1px solid #ddd0ff40!important;padding:6px 9px!important;background:rgba(124,98,188,.34)!important;color:#fff!important}
.gmww-voice-play{border-radius:50%;width:29px;height:29px;min-width:29px;display:grid;place-items:center;background:rgba(233,224,255,.25)}
.gmww-voice-duration{font-variant-numeric:tabular-nums;font-size:11px}
.gmww-voice-card.is-playing .gmww-voice-wave i{animation:gmww-chat-wave 640ms ease-in-out infinite alternate}
@keyframes gmww-chat-record-pulse{50%{opacity:.35;transform:scale(.78)}}
@keyframes gmww-chat-wave{to{transform:scaleY(.45)}}
@media(prefers-reduced-motion:reduce){#gmwwChatRecording .gmww-record-dot,.gmww-voice-card.is-playing .gmww-voice-wave i{animation:none}}
`;
  style.textContent+=`
/* Full public bulletin in one slowly looping line. */
#gmwwVillageTicker{display:none;align-items:center;gap:7px;min-height:27px;max-height:27px;padding:2px 10px;background:rgba(31,30,44,.30);border-bottom:1px solid #ffffff1c;overflow:hidden}
#gmwwChatPanel.open #gmwwVillageTicker{display:flex}
#gmwwVillageTicker .gmww-ticker-symbol{flex:0 0 auto;color:#ffd18b;font:800 13px/22px system-ui}
#gmwwVillageTicker .gmww-ticker-clip{flex:1;min-width:0;overflow:hidden;white-space:nowrap}
#gmwwVillageTicker .gmww-ticker-track{display:inline-block;width:max-content;white-space:nowrap;color:#ffb1b1;font:700 12px/22px system-ui;will-change:transform;animation:gmww-village-marquee var(--gmww-ticker-duration,48s) linear infinite}
#gmwwVillageTicker:not(.has-notices) .gmww-ticker-track{animation:none;transform:none;color:#f6f0e9b0}
@keyframes gmww-village-marquee{from{transform:translateX(var(--gmww-ticker-start,320px))}to{transform:translateX(-100%)}}
@media(prefers-reduced-motion:reduce){#gmwwVillageTicker .gmww-ticker-track{animation:none!important;transform:none!important;will-change:auto}#gmwwVillageTicker .gmww-ticker-clip{overflow-x:auto;touch-action:pan-x}}
/* Messages and voice are natural colored conversation lines, not separate glass bubbles. */
#gmwwChatLines .msg{max-width:100%!important;width:auto!important;margin:4px 0!important;padding:2px 0!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;line-height:1.55!important}
#gmwwChatLines .msg.is-self{margin-left:0!important;background:transparent!important}
#gmwwChatLines .msg b{font-weight:800!important}
.gmww-voice-card{border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;padding:1px 3px!important;gap:6px!important;color:inherit!important;vertical-align:middle}
.gmww-voice-play{width:27px;height:27px;min-width:27px;background:rgba(245,239,255,.18)}
`;
  document.head.appendChild(style);
 }
 if(document.getElementById('gmwwChatPanel')){gmwwChatDockSync();return}
 const panel=document.createElement('section');panel.id='gmwwChatPanel';panel.setAttribute('aria-label','Chat Làng');
 panel.innerHTML='<header><b id="gmwwChatHeading">Chat Làng</b><button type="button" id="gmwwChatToGM" title="Chat riêng GM">GM</button><button type="button" id="gmwwChatAudio" aria-label="Audio thông báo"></button></header><div id="gmwwVillageTicker" role="status" aria-live="off" title="Thông cáo Làng"><span class="gmww-ticker-symbol" aria-hidden="true">🎬:</span><div class="gmww-ticker-clip" id="gmwwVillageTickerClip"><span class="gmww-ticker-track" id="gmwwVillageTickerTrack">Chưa có thông cáo công khai.</span></div></div><div id="gmwwChatLines" role="log"></div><div id="gmwwChatHelp"></div><form id="gmwwChatForm"><input id="gmwwChatText" maxlength="280" autocomplete="off" aria-label="Tin nhắn" placeholder="Gửi tin nhắn…"><span id="gmwwChatRecording" hidden><span class="gmww-record-dot"></span><span class="gmww-live-meter" aria-label="Mức âm thanh từ micro"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i></span><span id="gmwwChatRecordingStatus">Đang ghi âm</span><time>0:00</time></span><button type="button" id="gmwwChatDiscard" aria-label="Hủy bản ghi thoại" title="Hủy bản ghi thoại chưa gửi">🗑️</button><button type="button" id="gmwwChatVoice" aria-label="Ghi âm" title="Ghi âm tối đa 30 giây"></button><button type="submit" id="gmwwChatSubmit" aria-label="Gửi tin nhắn">'+gmwwChatSendSvg+'</button></form>';
 document.body.appendChild(panel);gmwwChatDockSync();gmwwChatTouch();
 panel.addEventListener('pointerdown',()=>{if(!gmwwChatOpen)gmwwChatExpand();else gmwwChatTouch()});
 document.getElementById('gmwwChatText').addEventListener('focus',gmwwChatExpand);
 document.getElementById('gmwwChatText').addEventListener('input',gmwwChatTouch);
 const gmButton=document.getElementById('gmwwChatToGM');
 gmButton.onclick=()=>{gmwwChatTarget=gmwwChatTarget==='gm'?'room':'gm';gmButton.textContent=gmwwChatTarget==='gm'?'Làng':'GM';gmwwChatClear();void gmwwChatRefresh()};
 if(!document.documentElement.dataset.gmwwChatDismiss){
  document.documentElement.dataset.gmwwChatDismiss='1';
  document.addEventListener('pointerdown',event=>{
   const panel=document.getElementById('gmwwChatPanel');if(panel?.contains(event.target))return;
   gmwwChatClosePanel();gmwwChatTouch();
  },{capture:true,passive:true});
 }
 document.getElementById('gmwwChatAudio').onclick=()=>{
  try{localStorage.setItem('gmww_player_announcement_audio_off',gmwwChatAudioOff()?'0':'1')}catch{}
  gmwwChatAudioButton();if(gmwwChatAudioOff())gmwwStopAnnouncement();else if(gmwwAnnouncementPending){gmwwPlayerCueKey='';void gmwwPlayAnnouncement()}
 };
 document.getElementById('gmwwChatVoice').onclick=()=>void gmwwChatVoiceToggle();
 document.getElementById('gmwwChatDiscard').onclick=gmwwChatVoiceCancel;
 gmwwChatAudioButton();gmwwChatVoiceReset();document.getElementById('gmwwChatForm').onsubmit=e=>{e.preventDefault();gmwwChatTouch();if(gmwwChatVoiceRecorder?.state==='recording'||gmwwChatVoiceDraft||gmwwChatVoiceProcessing){void gmwwChatVoiceSend();return}void gmwwChatSend()};
 void gmwwChatRefresh();
}
function gmwwChatDockSync(){
  const inGame=!!(state.roomCode&&state.participantId&&['lobby','waiting','role_delivery','running'].includes(state.room?.phase)&&
    String(state.room?.roomMode||'online').toLowerCase()==='online');
  let footer=document.getElementById('gmwwOnlineFooter'),panel=document.getElementById('gmwwChatPanel');
  if(!inGame){if(footer){if(panel)document.body.appendChild(panel);footer.remove()}if(gmwwOnlineFooterTimer){clearInterval(gmwwOnlineFooterTimer);gmwwOnlineFooterTimer=null}return}
  if(!panel)return;
  if(!footer){
    footer=document.createElement('div');footer.id='gmwwOnlineFooter';footer.setAttribute('aria-label','Menu dưới Player Web');
    const clock=document.createElement('button');clock.type='button';clock.className='gmww-foot-button';clock.id='gmwwPlayerClock';clock.title='Đồng hồ đồng bộ GM';clock.disabled=true;clock.textContent='--:--';
    const undo=document.createElement('button');undo.type='button';undo.className='gmww-foot-button';undo.id='gmwwPlayerRestore';undo.textContent='Khôi phục';undo.title='Khôi phục lựa chọn hoặc hành động gần nhất của bạn';undo.setAttribute('aria-label','Khôi phục hành động');
    undo.onclick=()=>{const pending=!!gmwwOnlinePick;gmwwOnlineStop();gmwwOnlineClearPositions();state.gallowsSelectedId='';setGameViewPane('village',{persist:false});renderGallowsWidget();if(pending){toast('Đã khôi phục lựa chọn chưa gửi.');return}void gmwwOnlineRestore()};
    footer.append(clock,panel,undo);document.body.appendChild(footer);
  }
  gmwwOnlineRestoreHint();
  footer.hidden=!document.getElementById('game')?.classList.contains('active');
  footer.classList.toggle('gmww-chat-day',state.room?.phase==='running'&&
    ['morning','day'].includes(String(state.room?.cyclePhase||'')));
  panel.classList.toggle('open',gmwwChatOpen);
  const tick=()=>{const el=document.getElementById('gmwwPlayerClock');if(!el)return;
    const night=String(state.room?.cyclePhase||'')==='night';
    const turnClock=night&&gmwwSharedTimeline?.phase==='night'?gmwwSharedTimeline?.clock:null;
    const hasNightClock=Number.isFinite(turnClock?.remainingMs)&&gmwwSharedTimelineReceivedAt>0;
    const deadline=(typeof state.room?.dayDeadlineAt==='number'?state.room.dayDeadlineAt:Date.parse(state.room?.dayDeadlineAt||''));
    const pausedDay=state.room?.autoGM===false&&Number.isFinite(Number(state.room?.dayPausedRemainingMs))&&state.room?.dayPausedRemainingMs!=null;
    const hasDayClock=!night&&(pausedDay||(Number.isFinite(deadline)&&deadline>0));
    let ms=hasNightClock?Math.max(0,turnClock.remainingMs-(turnClock.paused?0:performance.now()-gmwwSharedTimelineReceivedAt)):
      pausedDay?Math.max(0,Number(state.room.dayPausedRemainingMs)):
      hasDayClock?Math.max(0,deadline-(Date.now()+Number(state.serverClockOffsetMs||0))):null;
    const sec=ms==null?null:Math.ceil(ms/1000);
    el.textContent=sec===null?'--:--':String(Math.floor(sec/60)).padStart(2,'0')+':'+String(sec%60).padStart(2,'0');
  };
  tick();if(!gmwwOnlineFooterTimer)gmwwOnlineFooterTimer=setInterval(tick,1000);
}
// V3.305: the same running Village bulletin also sits on the top menu, right after "Làng ơi dậy đi".
let gmwwTopTicker={sig:'',content:''};
function gmwwTopTickerRender(){
 const root=document.getElementById('gmwwPlayerTimeline')?.shadowRoot,list=root?.querySelector('#battleTimeline');if(!list)return;
 if(!root.getElementById('gmwwTopTickerCss')){const css=document.createElement('style');css.id='gmwwTopTickerCss';
  css.textContent='.gmww-top-ticker{flex:1 1 220px;min-width:160px;max-width:100%;align-self:stretch;display:flex;align-items:center;gap:6px;overflow:hidden;padding:0 10px;border-radius:14px;background:rgba(31,30,44,.62);border:1px solid #ffd18b55;box-sizing:border-box}'+
   '.gmww-top-ticker i{flex:0 0 auto;font-style:normal;color:#ffd18b;font:800 13px/1 system-ui}.gmww-top-ticker span{flex:1;min-width:0;overflow:hidden;white-space:nowrap}'+
   '.gmww-top-ticker b{display:inline-block;width:max-content;white-space:nowrap;color:#ffb1b1;font:700 13px/1.6 system-ui;will-change:transform;animation:gmww-top-marquee var(--gmww-top-duration,24s) linear infinite}'+
   '@keyframes gmww-top-marquee{from{transform:translateX(var(--gmww-top-start,240px))}to{transform:translateX(-100%)}}'+
   '@media(prefers-reduced-motion:reduce){.gmww-top-ticker b{animation:none!important;transform:none!important}}';
  root.appendChild(css)}
 let node=list.querySelector('.gmww-top-ticker');
 const day=state.room?.phase==='running'&&String(state.room?.cyclePhase||'')!=='night'&&!!gmwwTopTicker.content;
 if(!day){node?.remove();return}
 if(!node){node=document.createElement('div');node.className='gmww-top-ticker';node.setAttribute('role','marquee');node.innerHTML='<i>📢</i><span><b></b></span>'}
 if(node.parentNode!==list||list.lastElementChild!==node)list.appendChild(node);
 if(node.dataset.sig===gmwwTopTicker.sig)return;node.dataset.sig=gmwwTopTicker.sig;
 const clip=node.querySelector('span'),track=node.querySelector('b');track.textContent=gmwwTopTicker.content;
 node.title=gmwwTopTicker.content;node.setAttribute('aria-label','Thông cáo Làng: '+gmwwTopTicker.content);
 const width=Math.max(1,clip.clientWidth||200),distance=width+Math.max(1,track.scrollWidth);
 track.style.setProperty('--gmww-top-start',width+'px');track.style.setProperty('--gmww-top-duration',Math.max(18,Math.ceil(distance/30))+'s');
}
function gmwwVillageTickerUpdate(notices,cycleNight){
 const ticker=document.getElementById('gmwwVillageTicker'),track=document.getElementById('gmwwVillageTickerTrack'),clip=document.getElementById('gmwwVillageTickerClip');
 if(!ticker||!track||!clip)return;
 const safe=(Array.isArray(notices)?notices:[]).filter(n=>n?.system===true&&typeof n.text==='string'&&n.text.trim().length>0);
 const sig=JSON.stringify([state.roomCode,state.room?.matchId,cycleNight,safe.map(n=>[n.id,n.text])]);
 if(ticker.dataset.sig===sig)return;
 ticker.dataset.sig=sig;
 const content=safe.length?safe.map(n=>n.text).join('     •     '):'Chưa có thông cáo công khai.';
 track.textContent=content;ticker.classList.toggle('has-notices',safe.length>0);
 gmwwTopTicker={sig,content:safe.length?content:''};gmwwTopTickerRender();
 ticker.title=content;ticker.setAttribute('aria-label','Thông cáo Làng: '+content);
 if(!safe.length)return;
 const width=Math.max(1,clip.clientWidth),distance=width+Math.max(1,track.scrollWidth);
 track.style.setProperty('--gmww-ticker-start',width+'px');
 track.style.setProperty('--gmww-ticker-duration',Math.max(20,Math.ceil(distance/28))+'s');
}
function gmwwChatClear(){
  gmwwChatSeq++;const lines=document.getElementById('gmwwChatLines');lines?.replaceChildren();if(lines)delete lines.dataset.sig;
  const note=document.getElementById('gmwwChatHelp');if(note)note.textContent='Đang kiểm tra quyền Chat cho lượt mới…';
}
function gmwwChatUnmount(){
  gmwwChatVoiceDiscard=true;gmwwChatVoiceDraft=null;gmwwChatVoicePendingSend=false;gmwwChatRecordDisplay(false);
  if(gmwwChatVoiceRecorder?.state==='recording')gmwwChatVoiceRecorder.stop();gmwwChatMicRelease();
  gmwwStopAnnouncement();gmwwAnnouncementPending=null;
  gmwwChatClear();gmwwChatLatestByChannel.clear();gmwwChatUnread(false);document.getElementById('gmwwOnlineFooter')?.remove();if(gmwwOnlineFooterTimer)clearInterval(gmwwOnlineFooterTimer);gmwwOnlineFooterTimer=null;gmwwChatOpen=false;gmwwChatTarget='room';gmwwPlayerCueKey='';state.audioCue=null;document.getElementById('gmwwPlayerMiniCards')?.remove();
  document.getElementById('gmwwChatLaunch')?.remove();document.getElementById('gmwwChatPanel')?.remove();
  document.getElementById('gmwwOnlineWitchIntel')?.remove();document.getElementById('gmwwOnlineRevelation')?.remove();gmwwOnlineWitchBite=null;gmwwOnlineConfirmedTargets=[];
  try{speechSynthesis.cancel()}catch{}
}
async function gmwwChatRefresh(){
  if(!state.roomCode||!state.participantId||!document.getElementById('gmwwChatPanel'))return;
  const seq=++gmwwChatSeq,room=state.roomCode;
  try{
    const result=await api('/api/rooms/'+encodeURIComponent(room)+'/chat?channel='+gmwwChatTarget,{headers:auth()});
    if(seq!==gmwwChatSeq||state.roomCode!==room)return;
    const panel=document.getElementById('gmwwChatPanel'),lines=document.getElementById('gmwwChatLines');
    if(!panel||!lines)return;
    panel.classList.toggle('secret',result.scope==='secret');
    document.getElementById('gmwwChatHeading').textContent=result.scope==='gm'?'🔒 Chat riêng GM':result.scope==='secret'?'🌙 Chat nhóm':'☀️ Chat Làng';
    document.getElementById('gmwwOnlineFooter')?.classList.toggle('gmww-chat-day',['morning','day'].includes(String(result.phase||''))&&state.room?.phase==='running');
    gmwwVillageTickerUpdate(result.notices,result.noticeCycleNight);
    // Public notices appear only in the ticker; these are conversation messages.
    const items=[...(Array.isArray(result.broadcasts)?result.broadcasts:[]),...(Array.isArray(result.messages)?result.messages:[])].sort((a,b)=>Number(a.at||0)-Number(b.at||0));
    const signature=JSON.stringify([gmwwChatTarget,items]);
    // Never expose message contents through room_state or the WebSocket.
    // The authenticated chat GET is the source of truth for a new-message cue.
    const key=room+'|'+gmwwChatTarget+'|'+String(result.channel||'');
    const last=items.filter(x=>!x.system).at(-1)||null;
    const lastId=String(last?.id||'');const previous=gmwwChatLatestByChannel.get(key);
    if(lastId){
      if(previous!==undefined&&previous!==lastId&&!gmwwChatOpen&&String(last?.senderId||'')!==String(state.member?.loginId||''))gmwwChatUnread(true);
    }
    gmwwChatLatestByChannel.set(key,lastId);
    if(gmwwChatOpen)gmwwChatUnread(false);
    if(lines.dataset.sig!==signature){
     const atBottom=lines.scrollHeight-lines.clientHeight-lines.scrollTop<30;lines.dataset.sig=signature;lines.replaceChildren();
     for(const item of items){
      const bubble=document.createElement('div');bubble.className='msg'+(item.isGM===true?' gm':item.system===true?' system':'')+(String(item.senderId||'').replace(/^member:/,'')===String(state.member?.loginId||'')&&!item.system?' is-self':'');
      bubble.style.color=item.isGM===true||item.system===true?'#ff5353':gmwwChatColor(item.senderId);
      const name=document.createElement('b');name.textContent=String(item.senderName||'Người chơi')+': ';
      if(item.kind==='voice'&&item.voiceId){
       bubble.append(name,gmwwChatVoiceCard(item));
      }else{
       const msg=document.createElement('span');msg.textContent=String(item.text||'');bubble.append(name,msg);
      }
      lines.appendChild(bubble);
     }
     if(atBottom)lines.scrollTop=lines.scrollHeight;
    }
    const input=document.getElementById('gmwwChatText'),send=document.getElementById('gmwwChatSubmit'),voice=document.getElementById('gmwwChatVoice');
    input.disabled=send.disabled=!result.canSend;
    if(voice&&gmwwChatVoiceRecorder?.state!=='recording')voice.disabled=!result.canSend;
    input.placeholder=result.canSend?(gmwwChatOpen?'Nhập tin nhắn…':'Chạm để chat…'):'Chạm xem thông cáo';
    const chatHelp=document.getElementById('gmwwChatHelp');
    const dead=result.reason==='CHAT_DEAD',expelled=result.reason==='CHAT_EXPELLED';chatHelp.classList?.toggle('gmww-chat-dead-notice',dead||expelled);
    chatHelp.textContent=dead?'Bạn đã chết nên không chat được.':expelled?'Bạn đã bị đuổi khỏi làng nên không chat được.':result.reason==='CHAT_FROZEN'?'Bạn đang bị đóng băng nên không chat được.':result.reason==='CHAT_MUTED_GM'?'GM đã cấm bạn chat.':result.reason==='CHAT_MUTED_ARTIFACT'?'Artifact Câm Lặng đang chặn Chat.':result.canSend?(result.scope==='secret'?'Chỉ người cùng lượt được xem tin.':''):result.channel?'Chưa được phép gửi Chat ở kênh này.':'Chưa đến lượt chat; vẫn xem được thông cáo công khai.';
  }catch(error){if(seq===gmwwChatSeq){const note=document.getElementById('gmwwChatHelp');if(note)note.textContent='Lỗi kết nối Chat. Vui lòng thử lại.'}}
}
async function gmwwChatSend(){
  const input=document.getElementById('gmwwChatText');if(!input||input.disabled||!state.roomCode)return;
  const text=input.value.trim();if(!text)return;input.disabled=true;
  try{await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/chat',{method:'POST',headers:auth(),body:JSON.stringify({text,channel:gmwwChatTarget})});input.value='';await gmwwChatRefresh()}
  catch(error){toast('Chat: '+String(error.message||'Không thể gửi'));await gmwwChatRefresh()}
}


/* Online action offers are delivered privately and validated again on Server. */
let gmwwOnlinePick=null,gmwwOnlineCanRestore=false,gmwwOnlineIconScope='';
let gmwwOnlineWitchBite=null,gmwwOnlineConfirmedTargets=[],gmwwOnlineConfirmedUntil=0,gmwwOnlineRevealTimer=null;
const gmwwOnlineIconPositions=new Map();
function gmwwOnlineClearPositions(){
 gmwwOnlineIconPositions.clear();gmwwOnlineConfirmedTargets=[];gmwwOnlineConfirmedUntil=0;
 for(const node of document.querySelectorAll('#gmwwOnlineDock button'))node.style.transform='';
 gmwwOnlineTurnEffects(state.onlineActions||[]);
}
async function gmwwOnlineRestore(){
 if(!gmwwOnlineCanRestore||state.room?.phase!=='running'||state.room?.cyclePhase!=='night'){
  toast('Không có hành động đã gửi hợp lệ để khôi phục.');return;
 }
 if(state.onlineBusy)return;
 state.onlineBusy=true;
 try{
  await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/undo-action',{
   method:'POST',headers:auth(),body:JSON.stringify({matchId:state.room?.matchId,cycleKey:state.room?.cycleKey})
  });
  gmwwOnlineCanRestore=false;gmwwOnlineConfirmedTargets=[];gmwwOnlineConfirmedUntil=0;gmwwOnlineTurnEffects(state.onlineActions||[]);toast('Đã khôi phục hành động gần nhất.');await refreshPrivateRole(true);
 }catch(e){
  if(e?.status===409)gmwwOnlineCanRestore=false;
  toast('Không thể khôi phục: '+String(e.message||'Lượt hoặc dữ liệu đã thay đổi.'));
 }finally{state.onlineBusy=false}
}
function gmwwOnlinePeople(){return (state.players||[]).filter(p=>p?.loginId).map(p=>({id:String(p.loginId),name:String(p.displayName||p.loginId)}))}
function gmwwOnlineStop(){gmwwOnlinePick=null;document.getElementById('gmwwOnlinePick')?.remove();if(!state.onlineBusy)gmwwCardRestore();gmwwOnlineTurnEffects(state.onlineActions||[])}
function gmwwOnlinePlayerCenter(id){
 const frame=document.getElementById('gmwwVillageFrame');id=String(id||'').replace(/^member:/,'');if(!frame||!id)return null;
 try{
   const rect=frame.getBoundingClientRect(),inner=frame.contentWindow;
   const sx=rect.width/Math.max(1,Number(inner?.innerWidth)||frame.clientWidth||rect.width);
   const sy=rect.height/Math.max(1,Number(inner?.innerHeight)||frame.clientHeight||rect.height);
   for(const node of frame.contentDocument.querySelectorAll('#players .player[data-player-id]')){
     if(String(node.dataset.playerId||'').replace(/^member:/,'')!==id)continue;
     const face=node.querySelector('img,.portrait,canvas')||node,b=face.getBoundingClientRect();
     if(!b.width||!b.height)continue;
     return {x:rect.left+(b.left+b.width/2)*sx,y:rect.top+(b.top+b.height/2)*sy};
   }
 }catch{}
 return null;
}
function gmwwOnlineFlyGhost(ghost,to,absorb){
 if(!ghost)return Promise.resolve();
 const from={x:parseFloat(ghost.style.left)||to.x,y:parseFloat(ghost.style.top)||to.y};
 ghost.classList?.toggle('is-magnet',!!absorb);
 ghost.style.left=to.x+'px';ghost.style.top=to.y+'px';
 if(typeof ghost.animate!=='function'||matchMedia?.('(prefers-reduced-motion: reduce)')?.matches)return Promise.resolve();
 const frames=absorb?
   [{left:from.x+'px',top:from.y+'px',transform:'translate(-50%,-50%) scale(1)',opacity:1},
    {left:to.x+'px',top:to.y+'px',transform:'translate(-50%,-50%) scale(1.18) rotate(-8deg)',opacity:1,offset:.45},
    {left:to.x+'px',top:to.y+'px',transform:'translate(-50%,-50%) scale(.1) rotate(160deg)',opacity:0}]:
   [{left:from.x+'px',top:from.y+'px',transform:'translate(-50%,-50%) scale(1)'},
    {left:to.x+'px',top:to.y+'px',transform:'translate(-50%,-50%) scale(1)'}];
 return ghost.animate(frames,{duration:absorb?360:240,easing:absorb?'cubic-bezier(.5,0,.7,.4)':'cubic-bezier(.2,.8,.3,1)',fill:'forwards'}).finished.catch(()=>{});
}
function gmwwOnlineRestoreHint(){
 const b=document.getElementById('gmwwPlayerRestore');if(!b)return;
 const ready=!!(gmwwOnlinePick||(gmwwOnlineCanRestore&&state.room?.phase==='running'&&state.room?.cyclePhase==='night'));
 b.classList.toggle('gmww-restore-ready',ready);
 b.title=ready?'Bấm Khôi phục để hoàn tác hành động/lựa chọn vừa làm':'Khôi phục lựa chọn hoặc hành động gần nhất của bạn';
}
// One batched read of every valid player's hit box/centre in parent-page pixels (V3.301 drag).
function gmwwOnlineTargetSnapshot(){
 const frame=document.getElementById('gmwwVillageFrame');if(!frame)return [];
 try{
   const rect=frame.getBoundingClientRect(),inner=frame.contentWindow;if(!rect.width||!rect.height)return [];
   const sx=rect.width/Math.max(1,Number(inner?.innerWidth)||frame.clientWidth||rect.width);
   const sy=rect.height/Math.max(1,Number(inner?.innerHeight)||frame.clientHeight||rect.height);
   const valid=new Set(gmwwOnlinePeople().map(p=>p.id)),out=[];
   for(const node of frame.contentDocument.querySelectorAll('#players .player[data-player-id]')){
     const id=String(node.dataset.playerId||'').replace(/^member:/,'');if(!valid.has(id))continue;
     const b=node.getBoundingClientRect();if(!b.width||!b.height)continue;
     const face=node.querySelector('img,.portrait,canvas')||node,f=face.getBoundingClientRect(),fb=f.width&&f.height?f:b;
     out.push({id,left:rect.left+b.left*sx,right:rect.left+b.right*sx,top:rect.top+b.top*sy,bottom:rect.top+b.bottom*sy,
       mx:rect.left+(b.left+b.width/2)*sx,my:rect.top+(b.top+b.height/2)*sy,
       cx:rect.left+(fb.left+fb.width/2)*sx,cy:rect.top+(fb.top+fb.height/2)*sy,
       radius:Math.max(55,Math.min(115,Math.max(b.width,b.height)*.85))*Math.max(sx,sy)});
   }
   return out;
 }catch{return []}
}
function gmwwOnlineTargetAt(x,y){
 const frame=document.getElementById('gmwwVillageFrame');if(!frame)return '';
 try{
   const rect=frame.getBoundingClientRect(),inner=frame.contentWindow;
   if(!rect.width||!rect.height)return '';
   // Coordinates crossing the scaled village iframe must be mapped back into its viewport.
   const sx=rect.width/Math.max(1,Number(inner?.innerWidth)||frame.clientWidth||rect.width);
   const sy=rect.height/Math.max(1,Number(inner?.innerHeight)||frame.clientHeight||rect.height);
   const localX=(x-rect.left)/sx,localY=(y-rect.top)/sy;
   const valid=new Set(gmwwOnlinePeople().map(p=>p.id));
   const idOf=node=>String(node?.dataset?.playerId||'').replace(/^member:/,'');
   // Prefer the player directly under the finger, not an adjacent avatar.
   const hit=frame.contentDocument?.elementFromPoint?.(localX,localY)?.closest?.('#players .player[data-player-id]');
   if(hit&&valid.has(idOf(hit)))return idOf(hit);
   let best='',distance=Infinity;
   for(const node of frame.contentDocument.querySelectorAll('#players .player[data-player-id]')){
     const id=idOf(node);if(!valid.has(id))continue;
     const b=node.getBoundingClientRect(),d=Math.hypot(localX-b.left-b.width/2,localY-b.top-b.height/2);
     const radius=Math.max(55,Math.min(115,Math.max(b.width,b.height)*.85));
     if(d<radius&&d<distance){best=id;distance=d}
   }
   return best;
 }catch{return ''}
}
function gmwwOnlinePickAction(action){
 if(gmwwOnlinePick?.action.key!==action.key)gmwwOnlineStop();
 if(!gmwwOnlinePick)gmwwOnlinePick={action,targets:[]};
 const box=document.getElementById('gmwwOnlinePick')||document.createElement('section');
 box.id='gmwwOnlinePick';box.replaceChildren();
 const h=document.createElement('strong');h.textContent=String(action.name||'Hành động');box.appendChild(h);
 const line=document.createElement('small');line.textContent='Chọn mục tiêu '+(gmwwOnlinePick.targets.length+1)+' / '+Math.max(0,Number(action.targetCount)||0);box.appendChild(line);
 const list=document.createElement('div');list.className='gmww-online-people';box.appendChild(list);
 const count=Math.max(0,Number(action.targetCount)||0);
 if(count)for(const p of gmwwOnlinePeople().filter(p=>(!action.noSelf||p.id!==state.member?.loginId)&&!gmwwOnlinePick.targets.includes(p.id))){
   const b=document.createElement('button');b.textContent=p.name;b.onclick=()=>gmwwOnlineTarget(p.id);list.appendChild(b);
 }else{line.textContent='Không cần mục tiêu';queueMicrotask(()=>{if(gmwwOnlinePick?.action.key===action.key)void gmwwOnlineSubmit()})}
 const cancel=document.createElement('button');cancel.textContent='✕ Hủy';cancel.onclick=gmwwOnlineStop;box.appendChild(cancel);
 document.body.appendChild(box);
}
function gmwwOnlineTarget(id){
 const pick=gmwwOnlinePick;if(!pick)return;id=String(id||'').replace(/^member:/,'');
 if(!gmwwOnlinePeople().some(p=>p.id===id)||pick.targets.includes(id)||(pick.action.noSelf&&id===state.member?.loginId))return;
 pick.targets.push(id);gmwwOnlineTurnEffects(state.onlineActions||[]);
 if(pick.targets.length>=Math.max(0,Number(pick.action.targetCount)||0))void gmwwOnlineSubmit();else toast('Đã chọn '+pick.targets.length+'/'+pick.action.targetCount+'; kéo icon tới người tiếp theo.');
}
function gmwwOnlineAssassinChoice(){
 const pick=gmwwOnlinePick;if(!pick||pick.action.actionId!=='action_assassin_mark')return;
 let box=document.getElementById('gmwwOnlinePick');
 if(!box){box=document.createElement('section');box.id='gmwwOnlinePick';document.body.appendChild(box)}
 box.replaceChildren();
 const title=document.createElement('strong');title.textContent='Sát Thủ · chọn dấu hiệu cho mục tiêu';box.appendChild(title);
 const choices=document.createElement('div');choices.className='gmww-online-people';box.appendChild(choices);
 for(const choice of ['👍','👎']){
  const b=document.createElement('button');b.type='button';b.textContent=choice;
  b.setAttribute('aria-label',choice==='👍'?'Sát Thủ chọn thích':'Sát Thủ chọn không thích');
  b.onclick=()=>{void gmwwOnlineSubmit(choice)};choices.appendChild(b);
 }
 const cancel=document.createElement('button');cancel.type='button';cancel.textContent='✕ Hủy';cancel.onclick=gmwwOnlineStop;box.appendChild(cancel);
}
async function gmwwOnlineSubmit(confirmedAssassinChoice=''){
 const pick=gmwwOnlinePick;if(!pick||state.onlineBusy)return;
 const action=(state.onlineActions||[]).find(a=>a.key===pick.action.key);
 if(!action||action.blocked||state.room?.phase!=='running'){gmwwOnlineStop();return}
 if(pick.targets.length!==Math.max(0,Number(action.targetCount)||0)){gmwwOnlinePickAction(action);return}
 const names=pick.targets.map(id=>gmwwOnlinePeople().find(p=>p.id===id)?.name||id);
  // Actor and targets are server-authoritative; do not ask for redundant confirmation.
 let direction,assassinChoice;
 if(action.actionId==='action_transfer_bite'){
   direction=prompt('Chọn hướng: left / none / right','none');
   if(direction===null)return;direction=direction.toLowerCase().trim();
   if(!['left','none','right'].includes(direction)){toast('Hướng không hợp lệ');return}
 }
 if(action.actionId==='action-fire-wolf-bite'){
   direction=prompt('Lửa Lan sang người bên nào? left / right','left');
   if(direction===null)return;direction=direction.toLowerCase().trim();
   if(!['left','right'].includes(direction)){toast('Hướng không hợp lệ');return}
 }
 if(action.actionId==='action_assassin_mark'){
   if(!['👍','👎'].includes(confirmedAssassinChoice)){gmwwOnlineAssassinChoice();return}
   assassinChoice=confirmedAssassinChoice;
 }
 state.onlineBusy=true;
 try{
   const d=await api('/api/rooms/'+encodeURIComponent(state.roomCode)+'/action',{method:'POST',headers:auth(),signal:AbortSignal.timeout(20000),body:JSON.stringify({matchId:state.room?.matchId,cycleKey:state.room?.cycleKey,actionKey:action.key,targetIds:pick.targets,direction,assassinChoice})});
   gmwwOnlineConfirmedTargets=pick.targets.slice();gmwwOnlineConfirmedUntil=Date.now()+5500;
   setTimeout(()=>gmwwOnlineTurnEffects(state.onlineActions||[]),5600);
   gmwwOnlineStop();gmwwOnlineCanRestore=state.room?.cyclePhase==='night';gmwwOnlineRestoreHint();toast('Đã thực hiện: '+String(action.name||'Hành động')+(gmwwOnlineCanRestore?' · bấm Khôi phục ở menu dưới nếu cần làm lại':''));
   if(d.revelation?.message)gmwwOnlineShowRevelation(d.revelation);
 }catch(e){toast(gmwwOnlineActionErrorText(e))}
 finally{state.onlineBusy=false;gmwwCardRestore(700);await refreshPrivateRole(true)}
}
function gmwwOnlineActionErrorText(e){
 if(e?.name==='TimeoutError'||e?.name==='AbortError')return 'Máy chủ phản hồi chậm, hãy thử lại.';
 const raw=String(e?.message||e||'').trim();
 const map={
  DEMO_ACTION_ALREADY_USED_OR_NOT_YOUR_TURN:'Bạn đã dùng hành động này hoặc chưa đến lượt của bạn.',
  ACTION_ALREADY_USED:'Bạn đã dùng hành động này rồi.',
  NOT_YOUR_TURN:'Chưa đến lượt của bạn.',
  UNAUTHORIZED:'Phiên đăng nhập đã hết hạn, hãy vào lại phòng.',
  ROOM_NOT_FOUND:'Không tìm thấy phòng.',
  NETWORK_ERROR:'Mất kết nối, hãy thử lại.'
 };
 if(map[raw])return map[raw];
 if(/^[A-Z0-9_]{4,}$/.test(raw))return 'Hành động chưa được chấp nhận. Hãy thử lại hoặc hỏi Quản trò.';
 return 'Hành động chưa được chấp nhận'+(raw?': '+raw:'.');
}
function gmwwOnlineShowRevelation(revelation){
 // GM uses revelation.message in battlePresentRevelation; never expose its raw JSON.
 const message=String(revelation?.message||'').trim();
 if(!message)return;
 document.getElementById('gmwwOnlineRevelation')?.remove();
 toast('Kết quả: '+message);
}
let gmwwWitchNoticeLast='';
function gmwwOnlineWitchNotice(){
 // Bite information is provided by the authenticated /me response ONLY for active Witch,
 // and never again after her save potion is spent. Shown through the shared notice centre.
 document.getElementById('gmwwOnlineWitchIntel')?.remove();
 const intel=gmwwOnlineWitchBite;
 if(!intel||state.room?.phase!=='running'||String(state.room?.cyclePhase||'')!=='night'){gmwwWitchNoticeLast='';return}
 const ids=Array.isArray(intel.targetIds)?intel.targetIds:[],
       names=ids.map(id=>gmwwOnlinePeople().find(p=>p.id===String(id))?.name||String(id)).filter(Boolean),
       text=intel.packDisabled?'🐺 Bầy Sói không thể cắn đêm nay.':names.length?
   '🐺 Người bị Sói cắn: '+names.join(', '):'🐺 Chưa có người bị Sói cắn.',
       key=String(state.room?.cycleNight||'')+'|'+text;
 if(key===gmwwWitchNoticeLast)return;
 gmwwWitchNoticeLast=key;toast(text);
}
// V3.308: drag the Role / Artifact mini card to act. Same private offers, same /action API,
// same Server validation; the card only chooses which offer a drop belongs to.
const gmwwCardLifted=new Set();let gmwwCardRestoreTimer=0,gmwwCardSafetyTimer=0;
function gmwwOnlineCardActions(type){
 const room=state.room;
 if(!room||room.demo===true||String(room.roomMode||'').toLowerCase()!=='online'||room.phase!=='running')return [];
 const offers=Array.isArray(state.onlineActions)?state.onlineActions:[];
 return offers.filter(a=>type==='artifact'?!!a.artifactId:!a.artifactId);
}
function gmwwCardLift(node){
 node.classList?.add('gmww-online-lifted');gmwwCardLifted.add(node);
 clearTimeout(gmwwCardSafetyTimer);gmwwCardSafetyTimer=setTimeout(()=>gmwwCardRestore(),9000);
}
function gmwwCardRestore(delay=0){
 clearTimeout(gmwwCardRestoreTimer);
 const run=()=>{clearTimeout(gmwwCardSafetyTimer);for(const n of gmwwCardLifted)n.classList?.remove('gmww-online-lifted');gmwwCardLifted.clear()};
 if(delay>0)gmwwCardRestoreTimer=setTimeout(run,delay);else run();
}
// Which of the card's offers can legally take this drop. target='' means an empty drop on the village.
function gmwwCardTargetActions(actions,target){
 const self=String(state.member?.loginId||'').replace(/^member:/,'');
 const bites=Array.isArray(gmwwOnlineWitchBite?.targetIds)?gmwwOnlineWitchBite.targetIds.map(x=>String(x||'').replace(/^member:/,'')):[];
 return actions.filter(a=>{
   if(a.blocked)return false;
   if(!target)return !(Number(a.targetCount)>0);
   if(!(Number(a.targetCount)>0))return false;
   if(a.noSelf&&target===self)return false;
   if(a.actionId==='action_witch_save'&&!a.artifactId&&bites.length&&!bites.includes(target))return false;
   return true;
 });
}
function gmwwCardChoose(list,target,done,cancel){
 document.getElementById('gmwwOnlinePick')?.remove();
 const box=document.createElement('section');box.id='gmwwOnlinePick';
 const name=target?(gmwwOnlinePeople().find(p=>p.id===target)?.name||target):'';
 const h=document.createElement('strong');h.textContent=name?'Chọn hành động với '+name:'Chọn hành động';box.appendChild(h);
 const row=document.createElement('div');row.className='gmww-online-people';box.appendChild(row);
 for(const a of list){
   const b=document.createElement('button');b.type='button';b.textContent=String(a.name||'Hành động');
   b.onclick=()=>{box.remove();done(a)};row.appendChild(b);
 }
 const c=document.createElement('button');c.type='button';c.textContent='✕ Hủy';c.onclick=()=>{box.remove();cancel()};box.appendChild(c);
 document.body.appendChild(box);
}
function gmwwOnlineIconDown(event,action,card){
 if(event.button!==undefined&&event.button!==0)return;
 event.preventDefault();event.stopPropagation();
 const node=event.currentTarget,startX=event.clientX,startY=event.clientY,pointerId=event.pointerId;
 const cardActions=card?card.actions:null;
 const lead=card?(cardActions.find(a=>!a.blocked)||cardActions[0]):action;
 if(!lead||lead.blocked){toast(String(lead?.blockedReason||'Bạn đang bị hiệu ứng, không thể thực hiện hành động.'));return}
 const excludeSelf=card?cardActions.every(a=>a.noSelf):!!action.noSelf;
 clearTimeout(gmwwPlayerTopMenuTimer);gmwwChatClosePanel();
 let ghost=null,finished=false,raf=0,lastX=startX,lastY=startY,baseX=startX,baseY=startY,ghostX=startX,ghostY=startY,hitList=null,hitAt=0;
 const selfId=String(state.member?.loginId||'').replace(/^member:/,'');
 const targetAt=(x,y)=>{
   const id=gmwwOnlineTargetAt(x,y);
   return excludeSelf&&id===selfId?'':id;
 };
 // Smooth drag (V3.301): read player geometry from the village iframe at most every
 // 350 ms instead of on every pointermove, and paint once per animation frame with a
 // GPU transform. Cross-iframe layout reads on each move made the icon stutter on iPhone.
 const hitAtPoint=(x,y)=>{
   const now=performance.now();
   if(!hitList||now-hitAt>350){hitList=gmwwOnlineTargetSnapshot().filter(t=>!(excludeSelf&&t.id===selfId));hitAt=now}
   const direct=hitList.find(t=>x>=t.left&&x<=t.right&&y>=t.top&&y<=t.bottom);if(direct)return direct;
   let best=null,distance=Infinity;
   for(const t of hitList){const d=Math.hypot(x-t.mx,y-t.my);if(d<t.radius&&d<distance){best=t;distance=d}}
   return best;
 };
 const paint=()=>{
   raf=0;if(!ghost||finished)return;
   const hit=hitAtPoint(lastX,lastY),c=hit?{x:hit.cx,y:hit.cy}:null;
   let x=lastX,y=lastY;
   // Near a valid player the icon is sucked toward that player's centre.
   if(c){x+=(c.x-x)*.7;y+=(c.y-y)*.7}
   ghost.classList?.toggle('is-magnet',!!c);
   ghostX=x;ghostY=y;
   ghost.style.transform='translate3d('+(x-baseX)+'px,'+(y-baseY)+'px,0) translate(-50%,-50%)';
 };
 // Before a fly animation, commit the transform offset back to left/top.
 const commitGhost=()=>{if(!ghost)return;if(raf){cancelAnimationFrame(raf);raf=0}ghost.style.left=ghostX+'px';ghost.style.top=ghostY+'px';ghost.style.transform=''};
 const move=e=>{
   if(e.pointerId!==pointerId||finished)return;
   if(!ghost&&Math.hypot(e.clientX-startX,e.clientY-startY)>6){
     // Lift the real icon off the campfire: the original hides and the carried copy follows the finger.
     const box=node.getBoundingClientRect();
     ghost=document.createElement('img');ghost.className='gmww-online-ghost'+(card?' is-card':'');
     ghost.src=card?(node.querySelector('img')?.currentSrc||node.querySelector('img')?.src||''):(action.iconUrl||'');ghost.alt='';ghost.draggable=false;
     if(card){const gw=Math.max(46,box.width*1.15);ghost.style.width=gw+'px';ghost.style.height=(gw/.72)+'px'}
     else{ghost.style.width=Math.max(44,box.width)+'px';ghost.style.height=Math.max(44,box.height)+'px'}
     baseX=ghostX=e.clientX;baseY=ghostY=e.clientY;
     ghost.style.left=baseX+'px';ghost.style.top=baseY+'px';
     document.body.appendChild(ghost);if(card)gmwwCardLift(node);else node.classList?.add('gmww-online-lifted');
   }
   if(ghost){
     e.preventDefault();
     lastX=e.clientX;lastY=e.clientY;
     if(!raf)raf=requestAnimationFrame(paint);
   }
 };
 const cleanup=()=>{
   if(raf){cancelAnimationFrame(raf);raf=0}
   document.removeEventListener('pointermove',move,true);document.removeEventListener('pointerup',end,true);document.removeEventListener('pointercancel',end,true);
   window.removeEventListener('blur',cancel);try{node.releasePointerCapture?.(pointerId)}catch{}
   revealPlayerTopMenu(true);
 };
 const settle=()=>{ghost?.remove();node.classList?.remove('gmww-online-lifted');if(card)gmwwCardLifted.delete(node)};
 const cancel=()=>{if(finished)return;finished=true;cleanup();settle()};
 const end=e=>{
   if(e.pointerId!==pointerId||finished)return;
   finished=true;const moved=!!ghost;
   cleanup();
   if(e.type==='pointercancel'){settle();return}
   if(!moved){settle();if(!card)gmwwOnlinePickAction(action);return}
   commitGhost();
   if(card){
     // A dragged card must not also count as a tap that opens the card viewer.
     node.dataset.gmwwMiniMoved='1';setTimeout(()=>{delete node.dataset.gmwwMiniMoved},300);
     cardDrop(e);return;
   }
   const target=targetAt(e.clientX,e.clientY);
   if(target){
     if(gmwwOnlinePick?.action.key!==action.key)gmwwOnlinePick={action,targets:[]};
     const c=gmwwOnlinePlayerCenter(target)||{x:e.clientX,y:e.clientY};
     gmwwOnlineFlyGhost(ghost,c,true).then(()=>{
       ghost.remove();
       // More targets needed → the icon returns to the campfire for the next drag.
       if(gmwwOnlinePick?.action.key===action.key&&gmwwOnlinePick.targets.length<Math.max(0,Number(action.targetCount)||0))node.classList?.remove('gmww-online-lifted');
       else setTimeout(()=>node.classList?.remove('gmww-online-lifted'),2200);
     });
     gmwwOnlineTarget(target);
   }
   else{
     const home=node.getBoundingClientRect();
     gmwwOnlineFlyGhost(ghost,{x:home.left+home.width/2,y:home.top+home.height/2},false).then(settle);
     // A missed drop never relocates the action icon: return it to the campfire.
     // Previously the icon stayed at the finger's last position (often off-screen on iPhone).
     gmwwOnlineIconPositions.delete(action.key);
     node.style.transform='';
   }
 };
 const cardDrop=e=>{
   let pool=gmwwOnlineCardActions(card.type);
   const pk=gmwwOnlinePick,continuing=!!(pk&&pk.targets.length>0);
   if(continuing){const same=pool.find(a=>a.key===pk.action.key);if(same)pool=[same]}
   const target=targetAt(e.clientX,e.clientY);
   const fr=document.getElementById('gmwwVillageFrame')?.getBoundingClientRect();
   const inVillage=!!fr&&e.clientX>=fr.left&&e.clientX<=fr.right&&e.clientY>=fr.top&&e.clientY<=fr.bottom;
   const valid=target?gmwwCardTargetActions(pool,target):(inVillage?gmwwCardTargetActions(pool,''):[]);
   const goHome=()=>{const h=node.getBoundingClientRect();gmwwOnlineFlyGhost(ghost,{x:h.left+h.width/2,y:h.top+h.height/2},false).then(settle)};
   if(!valid.length){
     if(!pool.length||!(target||inVillage)){goHome();return}
     toast(pool.every(a=>a.blocked)?String(pool[0].blockedReason||'Bạn đang bị hiệu ứng, không thể thực hiện hành động.'):'Không có hành động hợp lệ cho vị trí vừa thả.');
     goHome();return;
   }
   const c=target?(gmwwOnlinePlayerCenter(target)||{x:e.clientX,y:e.clientY}):{x:e.clientX,y:e.clientY};
   const run=a=>{
     if(Number(a.targetCount)>0&&target){gmwwOnlinePick={action:a,targets:[]};gmwwOnlineTarget(target)}
     else gmwwOnlinePickAction(a);
     // Still collecting targets: the card comes back for the next drag.
     const now=gmwwOnlinePick;
     if(now&&now.targets.length<Math.max(0,Number(now.action.targetCount)||0))gmwwCardRestore();
   };
   gmwwOnlineFlyGhost(ghost,c,true).then(()=>{
     ghost.remove();
     // Role/Artifact with 2+ actions (e.g. Witch save/poison): always confirm which one.
     if(pool.length>1&&!continuing)gmwwCardChoose(valid,target,run,()=>{gmwwOnlineStop();gmwwCardRestore()});
     else run(valid[0]);
   });
 };
 // Capture on the source AND listen on the parent document: iOS may move over the iframe.
 try{node.setPointerCapture?.(event.pointerId)}catch{}
 document.addEventListener('pointermove',move,true);
 document.addEventListener('pointerup',end,true);
 document.addEventListener('pointercancel',end,true);
 window.addEventListener('blur',cancel);
}
// Only authenticated action offers trigger this local effect; no private role is broadcast.
// Use the exact GM labels and green/yellow target highlights; only the authenticated
// player's own active role and privately confirmed choices are visible here.
function gmwwOnlineTurnEffects(offers){
 const active=Array.isArray(offers)&&offers.length>0&&state.room?.phase==='running';
 const me=String(state.member?.loginId||'').replace(/^member:/,'');
 const privateBites=Array.isArray(gmwwOnlineWitchBite?.targetIds)?gmwwOnlineWitchBite.targetIds:[];
 const chosen=[...(gmwwOnlinePick?.targets||[]),...(Date.now()<gmwwOnlineConfirmedUntil?gmwwOnlineConfirmedTargets:[]),...privateBites];
 const targets=new Set(chosen.map(id=>String(id||'').replace(/^member:/,'')));
 document.getElementById('gmwwPlayerTopMenu')?.classList.toggle('gmww-my-action-turn',active);
 gmwwOnlineRestoreHint();
 try{
  const doc=document.getElementById('gmwwVillageFrame')?.contentDocument;
  if(!doc)return;
  if(!doc.getElementById('gmwwMyActionGlowStyle')){
   const css=doc.createElement('style');css.id='gmwwMyActionGlowStyle';
   // Match the Server's battle-turn-mark/battle-target-mark placement and colors.
   css.textContent='#players .player.is-battle-actor .portrait{filter:drop-shadow(0 0 3px #fff1b8) drop-shadow(0 0 9px #ffe39a)!important}'+
    '#players .player.is-battle-target .portrait{filter:drop-shadow(0 0 5px #75efc9)!important}'+
    '#players .player .player-over>.battle-turn-mark,#players .player .player-over>.battle-target-mark{display:block!important;position:static!important;transform:none!important;margin:0 auto 2px!important;width:max-content;max-width:100%;white-space:nowrap;line-height:1.1!important;padding:3px 7px!important;font-size:9px!important;font-weight:900;border-radius:6px;pointer-events:none;box-sizing:border-box;text-shadow:none;box-shadow:0 2px 6px #0007}'+
    '#players .player .player-over>.battle-turn-mark{color:#0c3317;background:#7ee08a;order:-2}'+
    '#players .player .player-over>.battle-target-mark{color:#3d0b05;background:#ff6b5b;order:-1}'+
    '#players .player.is-battle-actor .portrait{animation:gmww-player-turn-pulse 1.2s ease-in-out infinite}'+
    '#players .player.is-battle-target .portrait{animation:gmww-player-target-pulse 1.4s ease-in-out infinite}'+
    '@keyframes gmww-player-turn-pulse{50%{filter:drop-shadow(0 0 15px #f5cf66) brightness(1.14)}}'+
    '@keyframes gmww-player-target-pulse{50%{filter:drop-shadow(0 0 15px #67e9ca) brightness(1.16)}}'+
    "#players .player .portrait{position:relative!important;overflow:visible!important}"+
    "#players .player .portrait>.gmww-online-orbit.gmww-sv-orbit{position:absolute;inset:0;left:0;top:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:20;display:block;background:transparent;border:0;border-radius:0;padding:0;margin:0;--orbit-radius:30px;--orbit-height:9px;--orbit-icon-size:12px}"+
    "#players .player .portrait>.gmww-online-orbit.gmww-sv-orbit>.gmww-sv-orbit-item{position:absolute;left:50%;top:50%;width:0;height:0;display:block;padding:0;margin:0;border:0;background:transparent;animation:gmwwSvVerticalOrbit 6s linear infinite;animation-delay:var(--orbit-delay,0s)}"+
    "#players .player .portrait>.gmww-online-orbit.gmww-sv-orbit>.gmww-sv-orbit-item>span{display:block;position:static;width:auto;height:auto;padding:0;margin:0;border:0;border-radius:0;background:transparent;color:inherit;font:normal var(--orbit-icon-size,12px)/1 system-ui;white-space:nowrap;transform:translate(-50%,-50%);text-shadow:0 0 5px rgba(120,220,255,.55)}"+
    "@keyframes gmwwSvVerticalOrbit{0%,100%{transform:translate(var(--orbit-radius),0)}12.5%{transform:translate(calc(var(--orbit-radius)*.707),calc(var(--orbit-height)*-.707))}25%{transform:translate(0,calc(-1*var(--orbit-height)))}37.5%{transform:translate(calc(var(--orbit-radius)*-.707),calc(var(--orbit-height)*-.707))}50%{transform:translate(calc(-1*var(--orbit-radius)),0)}62.5%{transform:translate(calc(var(--orbit-radius)*-.707),calc(var(--orbit-height)*.707))}75%{transform:translate(0,var(--orbit-height))}87.5%{transform:translate(calc(var(--orbit-radius)*.707),calc(var(--orbit-height)*.707))}}"+
    "@media(prefers-reduced-motion:reduce){#players .player.is-battle-actor .portrait,#players .player.is-battle-target .portrait{animation:none!important}#players .player .portrait>.gmww-online-orbit.gmww-sv-orbit>.gmww-sv-orbit-item{animation-duration:24s!important}}";
   doc.head.appendChild(css);
  }
  for(const node of doc.querySelectorAll('#players .player[data-player-id]')){
   const id=String(node.dataset.playerId||'').replace(/^member:/,'');
   const actor=active&&id===me,target=targets.has(id);
   node.classList.toggle('is-battle-actor',actor);
   node.classList.toggle('is-battle-target',target);
   const portrait=node.querySelector(':scope>.portrait.game-character')||node.querySelector(':scope>.portrait')||node;
   let orbit=node.querySelector('.gmww-online-orbit');
   if(actor||target){
     const kind=actor?'actor':'target',count=6;
     if(!orbit){
       orbit=doc.createElement('span');orbit.className='gmww-online-orbit gmww-sv-orbit';
       orbit.setAttribute('aria-hidden','true');portrait.appendChild(orbit);
     }else{
       if(orbit.parentElement!==portrait)portrait.appendChild(orbit);
       if(!orbit.classList.contains('gmww-sv-orbit'))orbit.classList.add('gmww-sv-orbit');
     }
     if(orbit.dataset.kind!==kind||orbit.childElementCount!==count){
       orbit.dataset.kind=kind;orbit.replaceChildren();
       for(let k=0;k<count;k++){
         const item=doc.createElement('span');item.className='gmww-sv-orbit-item';
         item.style.setProperty('--orbit-delay',(-6*k/count).toFixed(4)+'s');
         const icon=doc.createElement('span');icon.textContent=kind==='actor'?'🧞‍♂️':'🐦‍🔥';
         item.appendChild(icon);orbit.appendChild(item);
       }
     }
   }else orbit?.remove();
   const labels=node.querySelector('.player-over');
   if(!labels)continue;
   let mark=labels.querySelector(':scope>.battle-turn-mark');
   if(actor){if(!mark){mark=doc.createElement('span');mark.className='battle-turn-mark';mark.textContent='★ ĐẾN LƯỢT';mark.setAttribute('aria-hidden','true')}
     if(labels.firstElementChild!==mark)labels.prepend(mark);
   }else mark?.remove();
   let targetMark=labels.querySelector(':scope>.battle-target-mark');
   if(target){if(!targetMark){targetMark=doc.createElement('span');targetMark.className='battle-target-mark';targetMark.textContent='MỤC TIÊU';targetMark.setAttribute('aria-hidden','true')}
     if(actor&&mark?.parentElement===labels)mark.after(targetMark);
     else if(labels.firstElementChild!==targetMark)labels.prepend(targetMark);
   }else targetMark?.remove();
  }
 }catch{}
}
function renderOnlineActionDock(){
 let dock=document.getElementById('gmwwOnlineDock');
 const offers=state.room?.demo!==true&&String(state.room?.roomMode||'').toLowerCase()==='online'&&state.room?.phase==='running'?state.onlineActions||[]:[];
 gmwwOnlineTurnEffects(offers);
 if(!offers.length){dock?.remove();gmwwOnlineStop();gmwwOnlineWitchNotice();return}
 if(!document.getElementById('gmwwOnlineDockStyle')){
   const css=document.createElement('style');css.id='gmwwOnlineDockStyle';
   css.textContent='#gmwwOnlineDock{position:fixed;z-index:100010;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:4px;max-width:min(90vw,270px);overflow:visible;touch-action:none;user-select:none;scrollbar-width:none}'+
     '#gmwwOnlineDock.is-idle-hidden{opacity:1;pointer-events:auto}'+
     '#gmwwOnlineDock button[data-blocked="true"]{position:relative;opacity:.7;filter:grayscale(.55)}#gmwwOnlineDock button[data-blocked="true"]:after{content:attr(data-effect-icon);position:absolute;right:-3px;top:-5px;font-size:18px;text-shadow:0 1px 5px #000}'+
     '#gmwwOnlineDock button{flex:0 0 auto;position:relative;will-change:transform;width:clamp(28px,calc(48px * var(--online-action-scale,1)),72px);height:clamp(28px,calc(48px * var(--online-action-scale,1)),72px);border:0;padding:0;background:transparent;touch-action:none}'+
     '#gmwwOnlineDock img{display:block;width:100%;height:100%;object-fit:contain;pointer-events:none;filter:drop-shadow(0 4px 8px #000b)}'+
     '#game:not(.active)~#gmwwOnlineDock{display:none!important}'+
     '.gmww-online-ghost{position:fixed;z-index:100060;width:56px;height:56px;transform:translate(-50%,-50%);object-fit:contain;pointer-events:none;will-change:transform;contain:layout paint;filter:drop-shadow(0 6px 10px #000c) drop-shadow(0 0 9px #f7d58a)}'+
     '.gmww-online-ghost.is-card{object-fit:cover;border-radius:9px;border:1px solid #d5af68;background:#07111b}'+
     '.gmww-online-ghost.is-magnet{filter:drop-shadow(0 0 14px #7effba) drop-shadow(0 0 28px #7effba)}'+
     '#gmwwOnlineDock button.gmww-online-lifted{opacity:0!important;pointer-events:none}'+
     '#gmwwOnlinePick{position:fixed;z-index:100050;left:50%;bottom:calc(max(12px,env(safe-area-inset-bottom)) + 140px);transform:translateX(-50%);width:min(92vw,380px);max-height:48dvh;overflow:auto;display:grid;gap:8px;padding:12px;border:1px solid #deb56d;border-radius:15px;background:#092b40f2;color:white;box-shadow:0 12px 35px #000d}'+
     '#gmwwOnlinePick strong{font-size:14px}#gmwwOnlinePick .gmww-online-people{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));max-height:26dvh;overflow:auto;gap:6px}'+
     '#gmwwOnlinePick button{min-height:36px;background:#16506c;color:white;border:1px solid #7196a9;border-radius:9px;font-weight:700}';
   document.head.appendChild(css)
 }
 if(!dock){dock=document.createElement('div');dock.id='gmwwOnlineDock';document.body.appendChild(dock)}
 const scale=[25,50,75,100,125,150].includes(Number(state.actionIconScale))?Number(state.actionIconScale):100;
 dock.style.setProperty('--online-action-scale',String(scale/100));
 const scope=[state.roomCode,state.room?.matchId,state.room?.cycleKey].join('|');
  if(gmwwOnlineIconScope!==scope){gmwwOnlineIconScope=scope;gmwwOnlineIconPositions.clear();gmwwOnlineCanRestore=false;gmwwOnlineConfirmedTargets=[];gmwwOnlineConfirmedUntil=0}
  // Fail closed for any stale offsets from earlier drag logic, even if offers did not change.
  if(gmwwOnlineIconPositions.size)gmwwOnlineIconPositions.clear();
  for(const button of dock.querySelectorAll('button'))button.style.transform='';
  const sig=[scope,...offers.map(a=>[a.key,a.iconUrl,a.blocked,a.blockedReason,a.targetCount,a.noSelf].join(':'))].join('|');
 gmwwOnlineWitchNotice();gmwwOnlinePlaceAtFire(dock);setTimeout(()=>gmwwOnlinePlaceAtFire(document.getElementById('gmwwOnlineDock')),450);
 if(dock.dataset.sig===sig)return;dock.dataset.sig=sig;dock.replaceChildren();dock.classList.remove('is-idle-hidden');
 for(const action of offers){
   const btn=document.createElement('button');btn.type='button';btn.title=String(action.name||'Hành động')+(action.blocked?' • '+String(action.blockedReason||'Bị hiệu ứng chặn'):'');
   if(action.blocked){btn.dataset.blocked='true';btn.dataset.effectIcon=action.blockedType==='frozen'?'❄️':action.blockedType==='expelled'?'🚪':'⛔';}
   btn.setAttribute('aria-label',btn.title);
   const img=document.createElement('img');img.src=String(action.iconUrl||'/action-icons/v3/49_sang_tao_artifact.webp');img.alt='';img.draggable=false;btn.appendChild(img);
   // The entrance stairs are the only home of each action icon; never restore old drag offsets.
    btn.onpointerdown=e=>gmwwOnlineIconDown(e,action);
   btn.onclick=e=>{if(action.blocked){toast(String(action.blockedReason||'Bạn không thể thực hiện hành động ở lượt này.'));return}if(e.detail===0)gmwwOnlinePickAction(action)};
   dock.appendChild(btn);
 }
}

{const replace=()=>requestAnimationFrame(()=>gmwwOnlinePlaceAtFire(document.getElementById('gmwwOnlineDock')));window.addEventListener('resize',replace,{passive:true});window.visualViewport?.addEventListener?.('resize',replace,{passive:true});
 // Follow the footer when the chat opens/closes, so icons stay above the chat box.
 let watched=null;setInterval(()=>{const f=document.getElementById('gmwwOnlineFooter');if(f&&f!==watched&&typeof ResizeObserver==='function'){watched=f;new ResizeObserver(replace).observe(f)}},1500)}
function gmwwOnlinePlaceAtFire(dock){
 if(!dock)return;
 // V3.304: action icons rest at the village entrance stairs, just above the bottom menu
 // (same spot on GM and Player). Rows grow upward so nothing covers the footer.
 const vw=window.innerWidth,vh=window.innerHeight,footer=document.getElementById('gmwwOnlineFooter');
 // offsetTop ignores the idle-hide transform, so the icon does not jump when the menu hides.
 const footerTop=footer&&footer.offsetHeight>0&&Number.isFinite(footer.offsetTop)&&footer.offsetTop>vh*.5?footer.offsetTop:vh-Math.max(84,vh*.11);
 // V3.305: one notch higher so the icons never sit on the chat lines above the footer.
 const x=vw/2,bottom=Math.max(140,Math.min(vh-24,footerTop-48));
 dock.style.transform='translate(-50%,-100%)';
 dock.style.left=Math.max(32,Math.min(vw-32,x))+'px';
 dock.style.top=bottom+'px';
 const intel=document.getElementById('gmwwOnlineWitchIntel');if(intel?.style){intel.style.left=dock.style.left;intel.style.top=Math.max(105,bottom-dock.offsetHeight-30)+'px'}
}
