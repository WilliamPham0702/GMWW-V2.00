
function renderProfile(){
  const m=state.member;if(!m)return;ensureLobbyMotionToggle();
  const editing=!!$('#profileEditPanel')?.open,currentCharacter=String(m.gameCharacterId||state.gameCharacters[0]?.id||''),draftCharacter=String(state.profileDraftGameCharacterId||currentCharacter);
  if(!state.profileDraftGameCharacterId)state.profileDraftGameCharacterId=currentCharacter;
  const main=$('#profileAvatar'),edit=$('#profileEditAvatar');if(main){main.src=gameCharacterImageUrl(editing?draftCharacter:currentCharacter);main.dataset.gmwwWalkCharacter=editing?draftCharacter:currentCharacter}if(edit){edit.src=gameCharacterImageUrl(draftCharacter);edit.dataset.gmwwWalkCharacter=draftCharacter}
  const pd=$('#profileDisplay'),pi=$('#profileId');if(pd)pd.textContent=m.displayName||m.loginId;if(pi)pi.textContent=m.loginId;const pdi=$('#profileDisplayInput');if(pdi&&!editing)pdi.value=m.displayName||m.loginId;
  const wins=Math.max(0,Number(m?.stats?.wins||0)),losses=Math.max(0,Number(m?.stats?.losses||0)),total=wins+losses,rate=total?Math.round(wins*100/total):0,statValues=[String(wins),String(losses),rate+'%'];$$('#profile .stats .stat strong').forEach((el,i)=>{if(statValues[i]!=null)el.textContent=statValues[i]});
  const historyBox=$('#profile .history');if(historyBox){historyBox.innerHTML='';const rows=Array.isArray(m.history)?m.history.slice(0,10):[];if(!rows.length){const empty=document.createElement('div');empty.className='history-item';empty.textContent='Chưa có lịch sử ván chơi.';historyBox.appendChild(empty)}else rows.forEach(row=>{const item=document.createElement('div');item.className='history-item';const info=document.createElement('div'),title=document.createElement('b'),small=document.createElement('small'),badge=document.createElement('span');title.textContent=String(row.gameName||row.roomName||'Ván GMWW');small.textContent=[row.roleName,row.playedAt?new Date(row.playedAt).toLocaleDateString('vi-VN'):''].filter(Boolean).join(' • ');info.append(title,small);badge.className='badge '+(row.result==='win'?'win':'lose');badge.textContent=row.result==='win'?'THẮNG':'THUA';item.append(info,badge);historyBox.appendChild(item)})}
  const summary=$('#profileEditPanel>summary');if(summary)summary.textContent='✎ THAY ĐỔI AVATAR';const saveBtn=$('#profileSaveButton');if(saveBtn&&!saveBtn.disabled)saveBtn.textContent='LƯU AVATAR';updateVillageHud();ensureCharacterPreviewTicker();try{ensureMatchLibrary()}catch(e){console.warn('[GMWW library]',e)}try{renderProfileTop3()}catch(e){console.warn('[GMWW top3]',e)}
}

// Top 3 tỷ lệ thắng: chỉ hiện trong trang Thông Tin (tải khi mở trang, cache 60s).
function renderProfileTop3(){
  const profile=$('#profile');if(!profile)return;
  let box=$('#profileTop3');
  if(!box){
    box=document.createElement('div');box.id='profileTop3';box.className='panel';box.hidden=true;
    box.style.cssText='margin:10px 0;padding:10px 12px';
    const fold=$('#profile .history-fold');
    if(fold&&fold.parentNode)fold.parentNode.insertBefore(box,fold);else profile.appendChild(box)
  }
  const top=Array.isArray(state.setupTop3)?state.setupTop3.slice(0,3):[];
  if(!top.length){box.hidden=true;return}
  const sig=JSON.stringify(top.map(m=>[m.displayName,m.gameCharacterId,m.rate]));
  box.hidden=false;if(box.dataset.sig===sig)return;
  box.dataset.sig=sig;box.replaceChildren();
  const title=document.createElement('b');title.textContent='TOP 3 TỶ LỆ THẮNG';title.style.cssText='display:block;margin-bottom:8px';box.appendChild(title);
  const medals=['🥇','🥈','🥉'];
  top.forEach((m,idx)=>{
    const row=document.createElement('div');row.style.cssText='display:flex;align-items:center;gap:10px;padding:4px 0';
    const rk=document.createElement('span');rk.textContent=medals[idx];rk.style.fontSize='20px';
    const cid=String(m.gameCharacterId||'');
    row.appendChild(rk);
    if(/^character-(?:0[1-9]|[1-3][0-9]|4[0-2])$/.test(cid)){const img=document.createElement('img');img.alt='';img.decoding='async';img.style.cssText='width:36px;height:36px;object-fit:contain';img.src=gameCharacterImageUrl(cid);img.onerror=()=>img.remove();row.appendChild(img)}
    const nm=document.createElement('span');nm.textContent=String(m.displayName||'Thành viên');nm.style.cssText='flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap';
    const pc=document.createElement('b');pc.textContent=Math.round(Number(m.rate)||0)+'%';
    row.append(nm,pc);box.appendChild(row)
  })
}

// Thư viện: server-wide match history (public outcomes) + per-night summary. Text only via textContent.
function ensureMatchLibrary(){
  const profile=$('#profile');if(!profile)return null;
  let box=$('#matchLibrary');
  if(!box){
    box=document.createElement('details');box.id='matchLibrary';box.className='history-fold';
    const sum=document.createElement('summary');sum.textContent='THƯ VIỆN VÁN ĐẤU';
    const list=document.createElement('div');list.id='matchLibraryList';list.className='history';
    box.append(sum,list);
    const fold=$('#profile .history-fold');if(fold&&fold.parentNode)fold.parentNode.insertBefore(box,fold.nextSibling);else profile.appendChild(box);
    box.addEventListener('toggle',()=>{if(box.open)loadMatchLibrary()});
  }
  return box;
}
async function loadMatchLibrary(){
  const list=$('#matchLibraryList');if(!list||state.matchLibraryLoading)return;
  state.matchLibraryLoading=true;list.textContent='Đang tải...';
  try{const d=await api('/api/matches');renderMatchLibrary(Array.isArray(d?.matches)?d.matches:[])}
  catch(_){list.textContent='Không tải được Thư viện.'}
  finally{state.matchLibraryLoading=false}
}
function renderMatchLibrary(rows){
  const list=$('#matchLibraryList');if(!list)return;list.innerHTML='';
  if(!rows.length){const empty=document.createElement('div');empty.className='history-item';empty.textContent='Chưa có ván nào được lưu.';list.appendChild(empty);return}
  rows.forEach(r=>{
    const item=document.createElement('div');item.className='history-item';item.style.display='block';item.style.cursor='pointer';
    const head=document.createElement('div'),title=document.createElement('b'),small=document.createElement('small');
    title.textContent=String(r.gameName||r.roomName||'Ván GMWW');title.style.display='block';
    small.textContent=[r.winnerFaction||r.winnerLabel?displayFaction(r.winnerFaction||r.winnerLabel)+' thắng':'',r.endedAt?new Date(r.endedAt).toLocaleString('vi-VN'):'',r.playerCount?r.playerCount+' người':'',r.nightCount?r.nightCount+' đêm':''].filter(Boolean).join(' • ');
    head.append(title,small);item.appendChild(head);
    item.addEventListener('click',e=>{if(e.target.closest('.match-detail'))return;toggleMatchDetail(item,r.matchId)});
    list.appendChild(item);
  });
}
async function toggleMatchDetail(item,matchId){
  const old=item.querySelector('.match-detail');if(old){old.remove();return}
  const box=document.createElement('div');box.className='match-detail';box.style.cssText='margin-top:6px;padding-top:6px;border-top:1px solid rgba(255,244,218,.25);display:grid;gap:4px;font-size:10px;line-height:1.45';box.textContent='Đang tải...';item.appendChild(box);
  try{
    const d=await api('/api/matches?matchId='+encodeURIComponent(matchId)),m=d?.match||{};box.textContent='';
    (Array.isArray(m.summary)?m.summary:[]).forEach(line=>{const row=document.createElement('div');row.textContent=String(line);box.appendChild(row)});
    if(!box.childNodes.length)box.textContent='Ván này chưa có tóm tắt.';
    const roster=Array.isArray(m.players)?m.players:[];
    if(roster.length){const r=document.createElement('div');r.style.cssText='margin-top:4px;opacity:.9';r.textContent='Vai: '+roster.map(p=>p.name+(p.roleName?' ('+p.roleName+')':'')+(p.alive?'':' ✝')).join(', ');box.appendChild(r)}
  }catch(_){box.textContent='Không tải được chi tiết ván.'}
}
