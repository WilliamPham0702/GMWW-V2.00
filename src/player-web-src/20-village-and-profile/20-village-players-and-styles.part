    #gmwwSetupTop3 .top3-char img{transform-origin:50% 100%;animation:gmwwTop3Idle 2.8s ease-in-out infinite;will-change:transform}
    #gmwwSetupTop3 .place2 .top3-char img{animation-delay:-.9s}
    #gmwwSetupTop3 .place3 .top3-char img{animation-delay:-1.8s}
