const villageFrozenState=new Map();
let wolfRecognitionExpiryTimer=null;
function setPrivateWolfRecognition(value,room=state.room){
  if(wolfRecognitionExpiryTimer){clearTimeout(wolfRecognitionExpiryTimer);wolfRecognitionExpiryTimer=null}
  const battle=playerScenePolicy(room).mode==='battle'&&String(room?.cyclePhase||'')==='night';
  const isCurrent=battle&&value&&String(value.matchId||'')===String(room?.matchId||'')&&
    Number(value.night)===Number(room?.cycleNight)&&Array.isArray(value.labels);
  const expiration=Date.parse(value?.deadlineAt||'');
  const valid=!!isCurrent&&(!Number.isFinite(expiration)||expiration>Date.now()+Number(state.serverClockOffsetMs||0));
  state.wolfRecognition=valid?value:null;
  if(valid&&Number.isFinite(expiration)){
    const remaining=Math.max(0,expiration-(Date.now()+Number(state.serverClockOffsetMs||0)));
    wolfRecognitionExpiryTimer=setTimeout(()=>{state.wolfRecognition=null;wolfRecognitionExpiryTimer=null;syncVillageFrame(true)},remaining);
  }
  syncVillageFrame(true);
}
function villagePublicPlayers(rows){
  const seen=new Set(),out=[],battleStatic=playerScenePolicy(state.room).mode==='battle';
  for(const p of (Array.isArray(rows)?rows:[])){
    const id=String(p?.participantId||p?.id||'').slice(0,100);
    if(!id||seen.has(id))continue;seen.add(id);
    const selfId=String(state.participantId||('member:'+state.member?.loginId)),isSelf=id===selfId,characterId=isSelf?String(state.member?.gameCharacterId||p?.gameCharacterId||''):String(p?.gameCharacterId||''),ownEffects=isSelf?Object.values(state.roleEffects||{}).filter(Boolean):[],ownType=ownEffects.some(x=>x?.type==='dead')?'dead':ownEffects.some(x=>x?.type==='expelled')?'expelled':ownEffects.some(x=>x?.type==='frozen')?'frozen':'',statusKey=String(state.roomCode||'lobby')+':'+id;if(Object.prototype.hasOwnProperty.call(p||{},'frozen'))villageFrozenState.set(statusKey,p.frozen===true);const viewStatus=state.room?.statusDisplay||{},showLegacy=id=>viewStatus[id]===true||id==='gallows_vote'||(['morning','day'].includes(String(state.room?.cyclePhase||''))&&['dead','expelled','marked'].includes(id)),visibleOwnType=ownType&&showLegacy(ownType)?ownType:'',frozen=showLegacy('frozen')&&((villageFrozenState.get(statusKey)===true)||ownType==='frozen'),statusLabel=visibleOwnType==='dead'?'ĐÃ CHẾT':visibleOwnType==='expelled'?'BỊ ĐUỔI':visibleOwnType==='frozen'?'ĐÓNG BĂNG':p?.online===false?'':p?.ready?'READY':'ONLINE',
      wolfView=state.wolfRecognition&&String(state.wolfRecognition.matchId||'')===String(state.room?.matchId||'')&&Number(state.wolfRecognition.night)===Number(state.room?.cycleNight)&&String(state.room?.cyclePhase||'')==='night',
      wolfLabel=wolfView?(state.wolfRecognition.labels||[]).find(x=>x.loginId===String(p?.loginId||id).replace(/^member:/,'').toLowerCase()):null,
      roleName=isSelf?String(state.role?.roleCard?.name||state.role?.roleName||'').slice(0,80):wolfLabel?String(wolfLabel.roleName||'').slice(0,80)+(wolfLabel.converted?' · Phe Sói':''):'';out.push({id,participantId:id,displayName:String(p?.displayName||'Người chơi').slice(0,80),avatarId:String(p?.avatarId||'').slice(0,100),gameCharacterId:characterId.slice(0,100),statusLabel:(p?.statusTags||[]).some(x=>showLegacy(String(x?.statusId||''))&&x?.statusId==='dead')?'ĐÃ CHẾT':(p?.statusTags||[]).some(x=>showLegacy(String(x?.statusId||''))&&x?.statusId==='expelled')?'BỊ ĐUỔI':(p?.statusTags||[]).some(x=>showLegacy(String(x?.statusId||''))&&x?.statusId==='marked')?'BỊ ĐÁNH DẤU':statusLabel,roleName:playerScenePolicy(state.room).mode==='battle'?roleName:'',frozen,seatId:Number(p?.seatId||0)||null,positionX:p?.positionX==null?null:Number(p.positionX),positionY:p?.positionY==null?null:Number(p.positionY),movementStatus:battleStatic?'idle':p?.movementStatus==='moving'?'moving':'idle',villageActivity:battleStatic?'idle':String(p?.villageActivity||'idle').slice(0,40),sitStartedAt:battleStatic?null:Number(p?.sitStartedAt||0)||null,sitUntil:battleStatic?null:Number(p?.sitUntil||0)||null,moveId:battleStatic?'':String(p?.moveId||''),moveFromX:p?.moveFromX==null?null:Number(p.moveFromX),moveFromY:p?.moveFromY==null?null:Number(p.moveFromY),moveToX:p?.moveToX==null?null:Number(p.moveToX),moveToY:p?.moveToY==null?null:Number(p.moveToY),moveStartedAt:battleStatic?null:Number(p?.moveStartedAt||0)||null,moveDurationMs:battleStatic?null:Number(p?.moveDurationMs||0)||null,moveTargetSeatId:battleStatic?null:Number(p?.moveTargetSeatId||0)||null,statusTags:Array.isArray(p?.statusTags)?p.statusTags.filter(x=>showLegacy(String(x?.statusId||''))).slice(0,8).map(x=>({statusId:String(x?.statusId||'').slice(0,50),icon:String(x?.icon||'').slice(0,16),label:String(x?.label||'').slice(0,80)})):[],online:p?.online!==false,ready:!!p?.ready,setupComplete:!!p?.setupComplete});
    if(out.length>=30)break;
  }
  return out;
}
